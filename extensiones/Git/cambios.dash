# La extensión Git de Forja: las filas del panel "Cambios" (un panel de Forja, git.dash). Una fila por fichero con
# cambios: la casilla dice si va en el commit (preparado en el índice), la letra qué le pasa (M, A, D, U, ?) y la ruta.
# Un clic en la casilla lo prepara o lo quita (dashgit add / reset); un clic en la ruta la elige y otro clic en la
# elegida abre sus diferencias.
#
#   gc_fila_texto(l), gc_fila_color(l)   # "[x] M ruta" y su color, de una línea de git status ("XY ruta")
#   orden = gc_alternar(i)               # la orden de dashgit que prepara o quita la fila i
#   gc_ruta(gc_sel)                      # la ruta (desde la raíz del repositorio) de la fila elegida

import "estado.dash"

var gc_sel: Int = -1

# 0 sin preparar, 1 preparado, 2 a medias (preparado y con más cambios en el disco)
func gc_preparado(xy: String) -> Int
    x = xy[:1]
    y = xy[1:2]
    if x == " " or x == "?"
        return 0
    end
    if y != " "
        return 2
    end
    return 1
end

func gc_ruta(i: Int) -> String
    if i < 0 or i >= git_lineas.length
        return ""
    end
    return git_lineas[i][3:]
end

func gc_xy(i: Int) -> String
    if i < 0 or i >= git_lineas.length
        return ""
    end
    return git_lineas[i][:2]
end

# Cuántos ficheros van en el commit
func gc_preparados() -> Int
    n = 0
    for l in git_lineas
        if gc_preparado(l[:2]) != 0
            n = n + 1
        end
    end
    return n
end

# El texto de una fila del panel ("XY ruta" de git status): "[x] M ruta"; [ ] sin preparar, [x] preparado, [-] a medias
func gc_fila_texto(l: String) -> String
    p = gc_preparado(l[:2])
    c = "[ ]"
    if p == 1
        c = "[x]"
    elif p == 2
        c = "[-]"
    end
    return c + " " + git_letra_xy(l[:2]) + " " + l[3:]
end

# Su color (los de las líneas de un panel de Forja): A verde, D y U rojo, ? gris, las demás amarillo
func gc_fila_color(l: String) -> String
    letra = git_letra_xy(l[:2])
    if letra == "A"
        return "+"
    elif letra == "U" or letra == "D"
        return "-"
    elif letra == "?"
        return "#"
    end
    return "!"
end

# Prepara o quita la fila i: la orden de dashgit que toca ("" si no hay fila). La fila cambia ya.
func gc_alternar(i: Int) -> String
    if i < 0 or i >= git_lineas.length
        return ""
    end
    xy = gc_xy(i)
    ruta = gc_ruta(i)
    x0 = xy[:1]
    y0 = xy[1:2]
    nuevo = ""
    orden = ""
    if gc_preparado(xy) == 1
        # fuera del commit
        orden = "reset -q -- " + git_comillas(ruta)
        if xy == "A "
            nuevo = "??"
        else
            nuevo = " " + x0
        end
    else
        orden = "add -- " + git_comillas(ruta)
        if xy == "??"
            nuevo = "A "
        elif x0 != " "
            nuevo = x0 + " "
        else
            nuevo = y0 + " "
        end
    end
    git_lineas[i] = nuevo + " " + ruta
    return orden
end

# Para la sonda: la elegida y las filas ("XY ruta"); dónde está cada una lo dice la sonda de Forja (FORJA_PANELES)
func gc_sonda() -> String
    t = "#{gc_sel}"
    for l in git_lineas
        t = t + "|" + l
    end
    return t
end
