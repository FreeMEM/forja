# la música que toca la extensión
# ¿Suena la música de la extensión (la del visor de MOD, sin demo)?
func suena() -> Bool
    return music_playing()
end
var mus_pos: Int = 0
var mus_fila: Int = 0

# las pistas
var sy_ruta: String = ""
var sy_cambiado: Bool = false
