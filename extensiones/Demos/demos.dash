# Los .sync abiertos (varios a la vez). El de delante (sy_actual) vive en sync_pistas y en sy_*; los demás, aquí, con
# sus pistas en texto, su cursor y su deshacer
struct SyncFichero
    ruta: String
    texto: String
    cambiado: Bool
    fila: Int
    pista: Int
    primera: Int
    deshacer: [String]
    rehacer: [String]
end
var sy_ficheros: [SyncFichero] = []
var sy_actual: Int = -1

# Un texto del catálogo con cuatro huecos (%1 a %4)
func hueco4(t: String, a: String, b: String, c: String, d: String) -> String
    return str_replace(str_replace(hueco2(t, a, b), "%3", c), "%4", d)
end

func nombre_de(ruta: String) -> String
    i = ruta.length - 1
    while i >= 0
        c = ruta[i:i + 1]
        if c == "/" or c == ":"
            return ruta[i + 1:]
        end
        i = i - 1
    end
    return ruta
end

func cajon_de(ruta: String) -> String
    n = nombre_de(ruta)
    return ruta[0:ruta.length - n.length]
end

func avisar(texto: String, tipo: Int)
    mensaje = texto
    mensaje_tipo = tipo
    forja_aviso_tipo(texto, tipo)
    redibujar()
end

func redibujar()
    if abierta
        mui_canvas_redraw(lienzo)
    end
end

func conectada() -> Bool
    return demo_mem != 0
end

# La fila que suena: la de la demo, o la de la música de la extensión
func fila_ahora() -> Int
    if conectada()
        return demo_fila
    end
    if suena()
        return mus_pos * 64 + mus_fila
    end
    return -1
end

# --- La ventana ---

func hacer_ventana()
    win = mui_window_begin("Demos", 43)
    mui_menu_begin(tr(1, "Proyecto"))
    mui_menu_item(tr(2, "Abrir..."), "O", EV_ABRIR)
    mui_menu_item(tr(3, "Guardar las pistas"), "S", EV_GUARDAR)
    mui_menu_item(tr(4, "Guardar las pistas como..."), "", EV_GUARDAR_COMO)
    mui_menu_item(tr(5, "Exportar las pistas (pistas_datos.dash)"), "X", EV_EXPORTAR)
    mui_menu_item(tr(97, "Cerrar estas pistas"), "", EV_CERRAR_SYNC)
    mui_menu_separator()
    mui_menu_item(tr(6, "Compilar el programa"), "K", EV_COMPILAR)
    mui_menu_item(tr(7, "Ejecutar el programa"), "E", EV_EJECUTAR)
    mui_menu_separator()
    mui_menu_item(tr(8, "Cerrar"), "W", EV_CERRAR)
    mui_menu_separator()
    mui_menu_item(tr(94, "Salir de Forja"), "Q", EV_SALIR_FORJA)
    mui_menu_end()
    mui_menu_begin(tr(9, "Ver"))
    mui_menu_item(tr(10, "Copper"), "1", EV_PAGINA)
    mui_menu_item(tr(11, "Música"), "2", EV_PAGINA + 1)
    mui_menu_item(tr(12, "Sincronía"), "3", EV_PAGINA + 2)
    mui_menu_item(tr(13, "Medidor"), "4", EV_PAGINA + 3)
    mui_menu_item(tr(105, "Partes"), "5", EV_PAGINA + 4)
    mui_menu_end()
    mui_menu_begin(tr(14, "Pistas"))
    mui_menu_item(tr(15, "Deshacer"), "Z", EV_DESHACER)
    mui_menu_item(tr(16, "Rehacer"), "R", EV_REHACER)
    mui_menu_separator()
    mui_menu_item(tr(17, "Pista nueva (n)"), "", EV_PISTA_NUEVA)
    mui_menu_item(tr(18, "Cambiar el nombre (r)"), "", EV_PISTA_NOMBRE)
    mui_menu_item(tr(19, "Quitar la pista (Mayús Supr)"), "", EV_PISTA_QUITAR)
    mui_menu_item(tr(20, "Mover a la izquierda (Alt izquierda)"), "", EV_PISTA_IZQUIERDA)
    mui_menu_item(tr(21, "Mover a la derecha (Alt derecha)"), "", EV_PISTA_DERECHA)
    mui_menu_separator()
    mui_menu_item(tr(98, "Otro fichero de pistas (Tab)"), "", EV_SYNC_SIGUIENTE)
    mui_menu_end()
    mui_menu_begin(tr(22, "Copper"))
    mui_menu_item(tr(23, "Al código"), "", EV_AL_CODIGO)
    mui_menu_item(tr(24, "Leer del código"), "", EV_LEER_CODIGO)
    mui_menu_item(tr(25, "Probar en una pantalla"), "", EV_PROBAR)
    mui_menu_end()
    mui_menu_begin(tr(26, "Ventana"))
    mui_menu_item("Forja", "", EV_FORJA)
    mui_menu_end()
    lienzo = mui_canvas(480, 230)
    mui_window_end()
    mui_canvas_on_draw(lienzo, dibujar)
    mui_canvas_on_input(lienzo, EV_LIENZO)
    mui_canvas_on_drag(lienzo, EV_ARRASTRE)
    mui_canvas_take_keys(lienzo, true)
    # (Tab es de la zona: pasa de un .sync a otro, o de un bloque de copper a otro)
    mui_canvas_take_tab(lienzo, true)
    # (se ve de golpe: con la demo, se repinta varias veces por segundo)
    mui_canvas_buffered(lienzo, true)
    mui_on_close(win, EV_VENTANA)
    mui_window_size(win, 80, 80)
end

func abrir_ventana()
    if not abierta
        abierta = mui_window_open(win) != 0
        mui_timer(TIC_MS, EV_TIC)
    end
    mui_window_activate(win)
    redibujar()
end

func ver(p: Int)
    pagina = p
    mensaje = ""
    abrir_ventana()
end

# --- Colores ---

# El lápiz de un color de 12 bits (guardado: color_pen reserva uno en el Workbench)
func pen_rgb(rgb: Int) -> Int
    p = _pens.get(rgb, -9)
    if p == -9
        p = color_pen(((rgb >> 8) & 15) * 17, ((rgb >> 4) & 15) * 17, (rgb & 15) * 17)
        _pens[rgb] = p
        if p >= 0
            _pens_lista.push(p)
        end
    end
    if p < 0
        return tema.texto
    end
    return p
end

# El color de la vista, con 4 niveles por componente: en el Workbench cada color nuevo es un lápiz que se reserva (en
# una pantalla de 256 colores con tarjeta, cambiar la paleta tantas veces tardaba segundos con MUI 3.8)
func pen_vista(rgb: Int) -> Int
    r = ((rgb >> 8) & 15) / 5 * 5
    g = ((rgb >> 4) & 15) / 5 * 5
    b = (rgb & 15) / 5 * 5
    return pen_rgb((r << 8) | (g << 4) | b)
end

func soltar_pens()
    for p in _pens_lista
        color_pen_free(p)
    end
    _pens_lista.clear()
    _pens = {}
end

# --- Dibujar ---

func texto(x: Int, y: Int, t: String, pen: Int)
    gfx_pen(pen)
    gfx_text_at(x, y + base_letra, t)
end

# Qué dibuja la función de dibujo cuando la llama mui_canvas_update_area (pintar solo lo que cambia: con la demo en
# marcha, la fila que suena cambia unas 8 veces por segundo, y un dibujo entero en un A1200 con la demo gastando la
# CPU tardaba medio segundo)
const P_TODO = 0
const P_ESTADO = 1          # el estado de la demo, a la derecha de las pestañas
const P_CAB_SYNC = 2        # la línea de arriba de Sincronía (el cursor, la fila que suena)
const P_NOMBRES_SYNC = 3    # los nombres de las pistas
const P_FILA_SYNC = 4       # una fila de la tabla (_parte_fila)
const P_CAB_MUSICA = 5      # la línea de la posición en Música
const P_FILA_MUSICA = 6
const P_MEDIDOR = 7         # el texto y las barras nuevas del medidor
const P_COPPER = 8          # las marcas y la lista del copper
var _parte: Int = P_TODO
var _parte_fila: Int = 0
var ms_parcial: Int = 0
var _mensaje_visto: String = ""   # el aviso de abajo en el último dibujo entero (si cambió, hace falta otro)
var _ultimos: [Int] = []    # (para la sonda: lo que tardaron los últimos dibujos de una parte)
var parciales: Int = 0      # (para la sonda: cuántos dibujos de una parte)
var dibujos: Int = 0        # y cuántos enteros

func dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    tema_preparar()
    gfx_mode(0)
    if mui_canvas_updating() and _parte != P_TODO
        t0 = time_ms()
        dibujar_parte()
        ms_parcial = time_ms() - t0
        parciales = parciales + 1
        _ultimos.push(ms_parcial)
        if _ultimos.length > 16
            _ultimos.remove(0)
        end
        return
    end
    t0 = time_ms()
    dibujos = dibujos + 1
    zona_x = x
    zona_y = y
    zona_ancho = ancho
    zona_alto = alto
    _sy_ok = false
    _cu_ok = false
    _mu_ok = false
    _me_ok = false
    gfx_pen(tema.fondo)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    dibujar_pestanas(x, y, ancho)
    usar_codigo()
    cy = y + ALTO_PESTANAS + 4
    pie = y + alto - 2 * (alto_letra + 2) - 2
    if pagina == PAG_COPPER
        dibujar_copper(x + 4, cy, ancho - 8, pie - cy)
    elif pagina == PAG_MUSICA
        dibujar_musica(x + 4, cy, ancho - 8, pie - cy)
    elif pagina == PAG_SYNC
        dibujar_sync(x + 4, cy, ancho - 8, pie - cy)
    elif pagina == PAG_PARTES
        dibujar_partes(x + 4, cy, ancho - 8, pie - cy)
    else
        dibujar_medidor(x + 4, cy, ancho - 8, pie - cy)
    end
    # abajo: las teclas de la página y el último aviso
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, pie, x + ancho - 1, y + alto - 1)
    texto(x + 4, pie + 2, ayuda_teclas(), tema.tenue)
    pen = tema.texto
    if mensaje_tipo == 1
        pen = tema.error
    elif mensaje_tipo == 2
        pen = tema.bien
    end
    texto(x + 4, pie + alto_letra + 4, mensaje, pen)
    _mensaje_visto = mensaje
    ms_dibujo = time_ms() - t0
end

func dibujar_parte()
    if _parte == P_ESTADO
        usar_panel(0)
        dibujar_estado(zona_x, zona_y, zona_ancho)
        return
    end
    usar_codigo()
    if _parte == P_CAB_SYNC
        gfx_pen(tema.fondo)
        gfx_rect(_sy_x, _sy_y, _sy_x + _sy_ancho - 1, _sy_y + alto_letra)
        tabla_cabecera(_sy_x, _sy_y)
    elif _parte == P_NOMBRES_SYNC
        tabla_nombres(true)
    elif _parte == P_FILA_SYNC
        tabla_fila(_parte_fila, fila_ahora(), true)
    elif _parte == P_CAB_MUSICA
        musica_cabecera(true)
    elif _parte == P_FILA_MUSICA
        musica_fila(_parte_fila, true)
    elif _parte == P_MEDIDOR
        medidor_nuevas()
    elif _parte == P_COPPER
        gfx_pen(tema.fondo)
        gfx_rect(_cu_x + 161, _cu_y - 1, _cu_x + _cu_ancho - 1, _cu_y + _cu_alto)
        copper_marcas_lista(_cu_x, _cu_y, _cu_ancho, _cu_alto, cu_maximo())
    end
end

# Que se dibuje solo la parte p (en x, y, w, h desde la esquina de la zona)
func dibujar_solo(p: Int, x: Int, y: Int, w: Int, h: Int)
    if not abierta or w <= 0 or h <= 0
        return
    end
    _parte = p
    mui_canvas_update_area(lienzo, x, y, w, h)
    _parte = P_TODO
end

func ayuda_teclas() -> String
    if pagina == PAG_COPPER
        if cu_registros.length > 0 and not cu_es_color(cu_actual().reg)
            return tr(102, "arriba/abajo parada (May/Alt: línea)  izq/der registro  + - (< >: 16) valor  n nueva  Supr  a registro (May Supr quita)  c cuál  d modo  t código  Return al código  l leer  Tab bloque  p probar")
        end
        return tr(103, "arriba/abajo parada (May/Alt: línea)  izq/der registro  r g b (May: -)  n nueva  Supr  a registro (May Supr quita)  c cuál  d modo  t código  Return al código  l leer  Tab bloque  p probar")
    elif pagina == PAG_MUSICA
        return tr(28, "Espacio toca/para  izq/der posición  arriba/abajo fila  Return mete la fila en el código  s a la sincronía")
    elif pagina == PAG_SYNC
        return tr(29, "flechas (May: 16 filas)  cifras y Return clave  Supr quita  i tipo  n pista  Espacio pausa  g ir  v la demo delante/detrás  Tab otro .sync")
    elif pagina == PAG_PARTES
        return tr(106, "arriba/abajo parte  izq/der columna  cifras y Return (o + - < >) desde/hasta  n nueva  r nombre  Supr quita  g ir  c al código  l leer")
    end
    return tr(30, "Las líneas de raster de cada imagen de la demo (sync_fotograma y sync_fin)")
end

func dibujar_pestanas(x: Int, y: Int, ancho: Int)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + ALTO_PESTANAS - 1)
    usar_panel(0)
    _pest_x1.clear()
    _pest_x2.clear()
    tx = x + 4
    i = 0
    for t in [tr(53, "Copper"), tr(54, "Música"), tr(55, "Sincronía"), tr(56, "Medidor"), tr(105, "Partes")]
        w = font_text_width(t) + 20
        if i == pagina
            gfx_pen(tema.fondo)
            gfx_rect(tx, y + 2, tx + w - 1, y + ALTO_PESTANAS - 1)
            gfx_pen(tema.acento)
            gfx_rect(tx, y + 2, tx + w - 1, y + 3)
            gfx_pen(tema.texto)
        else
            gfx_pen(tema.tenue)
        end
        gfx_text_at(tx + 10, y + (ALTO_PESTANAS - font_height()) / 2 + 2 + font_baseline(), t)
        _pest_x1.push(tx - x)
        _pest_x2.push(tx + w - 1 - x)
        tx = tx + w + 2
        i = i + 1
    end
    _pest_fin = tx - x
    dibujar_estado(x, y, ancho)
end

var _pest_fin: Int = 0      # dónde acaban las pestañas (desde la esquina de la zona)

# A la derecha de las pestañas, la demo (con su fila: cambia a menudo, y se dibuja solo esto)
func dibujar_estado(x: Int, y: Int, ancho: Int)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x + _pest_fin, y, x + ancho - 1, y + ALTO_PESTANAS - 1)
    e = tr(31, "sin demo")
    pen = tema.tenue
    if conectada()
        e = hueco2(tr(57, "demo: fila %1, %2 líneas"), "#{demo_fila}", "#{demo_lineas}")
        if demo_pausa
            e = e + tr(32, " (pausa)")
        end
        pen = tema.bien
    end
    w = font_text_width(e)
    if x + _pest_fin + w + 8 < x + ancho
        gfx_pen(pen)
        gfx_text_at(x + ancho - w - 6, y + (ALTO_PESTANAS - font_height()) / 2 + 2 + font_baseline(), e)
    end
end

func redibujar_estado()
    if zona_ancho > 0
        dibujar_solo(P_ESTADO, _pest_fin, 0, zona_ancho - _pest_fin, ALTO_PESTANAS)
    end
end

func pestana_en(mx: Int, my: Int) -> Int
    if my < 0 or my >= ALTO_PESTANAS
        return -1
    end
    i = 0
    while i < _pest_x1.length
        if mx >= _pest_x1[i] and mx <= _pest_x2[i]
            return i
        end
        i = i + 1
    end
    return -1
end

# --- Copper ---

func dibujar_copper(x: Int, y: Int, ancho: Int, alto: Int)
    if cu_registros.length == 0
        cu_nuevo()
    end
    r = cu_actual()
    color = cu_es_color(r.reg)
    c = cu_colores()
    maximo = cu_maximo()
    # la vista del registro elegido: las 256 líneas en el alto que haya, 160 de ancho; un color, con sus colores; otro
    # registro, una barra por línea tan larga como su valor. Una caja por franja igual (una raya por línea tardaba 10 s
    # con MUI 3.8 en una pantalla de tarjeta)
    wv = 160
    yy = 0
    desde = 0
    clave_antes = -2
    while yy <= alto
        clave = -2
        if yy < alto
            v = c[yy * CU_LINEAS / alto]
            clave = v
        end
        if clave != clave_antes or yy == alto
            if clave_antes != -2 and yy > desde
                _cu_franja(x, y + desde, wv, yy - desde, clave_antes, color, maximo)
            end
            desde = yy
            clave_antes = clave
        end
        yy = yy + 1
    end
    gfx_pen(tema.borde)
    gfx_box(x - 1, y - 1, x + wv, y + alto)
    _cu_x = x
    _cu_y = y
    _cu_ancho = ancho
    _cu_alto = alto
    _cu_ok = true
    copper_marcas_lista(x, y, ancho, alto, maximo)
end

# La geometría de la página Copper en el último dibujo entero (para dibujar solo las marcas y la lista)
var _cu_ok: Bool = false
var _cu_x: Int = 0
var _cu_y: Int = 0
var _cu_ancho: Int = 0
var _cu_alto: Int = 0

# El máximo de los valores del registro elegido (para las barras de uno que no es color)
func cu_maximo() -> Int
    m = 1
    if not cu_es_color(cu_actual().reg)
        for v in cu_colores()
            if v > m
                m = v
            end
        end
    end
    return m
end

# Lo de la derecha de la vista: las marcas de las paradas y la lista (al elegir o arrastrar una parada se dibuja solo
# esto: un dibujo entero con la demo en marcha tardaba más de un segundo, y el arrastre llegaba tarde)
func copper_marcas_lista(x: Int, y: Int, ancho: Int, alto: Int, maximo: Int)
    r = cu_actual()
    color = cu_es_color(r.reg)
    wv = 160
    i = 0
    for p in cu_paradas
        py = y + p.linea * alto / CU_LINEAS
        pen = tema.tenue
        if i == cu_elegida
            pen = tema.cursor
        end
        gfx_pen(pen)
        gfx_line(x + wv + 2, py, x + wv + 10, py)
        i = i + 1
    end
    # la lista
    lx = x + wv + 16
    modo = tr(33, "degradado")
    if r.modo == CU_SECO
        modo = tr(34, "cambios secos")
    elif r.modo == CU_LINEAL
        modo = tr(99, "lineal")
    end
    cod = tr(35, "llamadas a copper_*")
    if cu_tabla
        cod = tr(36, "tabla para asm")
    end
    texto(lx, y, "copper_" + cu_nombre + ": " + cu_nombre_reg(r.reg) + " (#{cu_reg + 1}/#{cu_registros.length}), " + modo, tema.texto)
    texto(lx, y + alto_letra + 2, hueco2(tr(59, "Código: %1, %2 instrucciones"), cod, "#{cu_instrucciones() + 2}"), tema.tenue)
    # los registros del bloque, en una línea (el elegido, resaltado)
    rx = lx
    ry = y + 2 * (alto_letra + 2)
    k = 0
    for g in cu_registros
        n = cu_nombre_reg(g.reg)
        w = font_text_width(n)
        if rx + w > x + ancho
            break
        end
        pen = tema.tenue
        if k == cu_reg
            gfx_pen(tema.seleccion)
            gfx_rect(rx - 2, ry - 1, rx + w + 1, ry + alto_letra)
            pen = tema.texto
        end
        texto(rx, ry, n, pen)
        rx = rx + w + ancho_letra
        k = k + 1
    end
    ly = y + 3 * (alto_letra + 2) + 6
    i = 0
    for p in cu_paradas
        if ly + alto_letra > y + alto
            break
        end
        if i == cu_elegida
            gfx_pen(tema.seleccion)
            gfx_rect(lx - 2, ly - 1, lx + 22 * ancho_letra, ly + alto_letra)
        end
        if color
            gfx_pen(pen_vista(p.rgb))
            gfx_rect(lx, ly, lx + 2 * ancho_letra, ly + alto_letra - 2)
        else
            gfx_pen(tema.acento)
            gfx_rect(lx, ly + alto_letra / 2 - 1, lx + 2 * ancho_letra * p.rgb / maximo, ly + alto_letra / 2)
        end
        texto(lx + 3 * ancho_letra, ly, hueco(tr(60, "línea %1"), "#{p.linea}"), tema.texto)
        texto(lx + 14 * ancho_letra, ly, "$" + cu_valor_texto(r.reg, p.rgb), tema.sintaxis[4])
        ly = ly + alto_letra + 2
        i = i + 1
    end
end

# Una franja de la vista del copper (h líneas de la vista con el mismo valor v; -1: el de la pantalla)
func _cu_franja(x: Int, y: Int, w: Int, h: Int, v: Int, color: Bool, maximo: Int)
    if v < 0
        gfx_pen(tema.fondo_panel)
        gfx_rect(x, y, x + w - 1, y + h - 1)
    elif color
        gfx_pen(pen_vista(v))
        gfx_rect(x, y, x + w - 1, y + h - 1)
    else
        largo = (w - 1) * v / maximo
        gfx_pen(tema.fondo)
        gfx_rect(x, y, x + w - 1, y + h - 1)
        if largo > 0
            gfx_pen(tema.acento)
            gfx_rect(x, y, x + largo, y + h - 1)
        end
    end
end

func copper_tecla(k: Int, q: Int, ch: String)
    if cu_registros.length == 0
        cu_nuevo()
    end
    p = cu_paradas[cu_elegida]
    r = cu_actual()
    paso = 1
    if (q & Q_ALT) != 0
        paso = 8
    end
    if k == K_ARRIBA or k == K_ABAJO
        d = 1
        if k == K_ARRIBA
            d = -1
        end
        if (q & (Q_MAYUS | Q_ALT)) != 0
            p.linea = p.linea + d * paso
            if p.linea < 0
                p.linea = 0
            elif p.linea > CU_LINEAS - 1
                p.linea = CU_LINEAS - 1
            end
            cu_ordenar()
        else
            cu_elegida = cu_elegida + d
            if cu_elegida < 0
                cu_elegida = 0
            elif cu_elegida >= cu_paradas.length
                cu_elegida = cu_paradas.length - 1
            end
        end
    elif k == K_IZQUIERDA or k == K_DERECHA
        # otro registro del bloque
        if k == K_IZQUIERDA
            cu_elegir(cu_reg - 1)
        else
            cu_elegir(cu_reg + 1)
        end
    elif cu_es_color(r.reg) and (ch == "r" or ch == "g" or ch == "b" or ch == "R" or ch == "G" or ch == "B")
        sh = 0
        if ch == "r" or ch == "R"
            sh = 8
        elif ch == "g" or ch == "G"
            sh = 4
        end
        v = (p.rgb >> sh) & 15
        if ch == "r" or ch == "g" or ch == "b"
            v = v + 1
        else
            v = v - 1
        end
        if v >= 0 and v <= 15
            p.rgb = (p.rgb & (0xFFF - (15 << sh))) | (v << sh)
        end
    elif not cu_es_color(r.reg) and (ch == "+" or ch == "-" or ch == ">" or ch == "<")
        # el valor de otro registro: + y - de uno en uno, > y < de 16 en 16
        d = 1
        if ch == ">" or ch == "<"
            d = 16
        end
        if ch == "-" or ch == "<"
            d = 0 - d
        end
        p.rgb = (p.rgb + d) & 0xFFFF
    elif ch == "n"
        linea = p.linea + 16
        rgb = p.rgb
        if cu_elegida + 1 < cu_paradas.length
            s = cu_paradas[cu_elegida + 1]
            linea = (p.linea + s.linea) / 2
            c = cu_colores()
            rgb = c[linea]
        end
        if linea > CU_LINEAS - 1
            linea = CU_LINEAS - 1
        end
        cu_paradas.insert(cu_elegida + 1, CuParada(linea, rgb))
        cu_elegida = cu_elegida + 1
        cu_ordenar()
    elif (k == K_SUPR or k == K_RETROCESO) and (q & Q_MAYUS) != 0
        # Mayúsculas+Supr: quita el registro (si queda otro)
        if not cu_quitar_registro()
            avisar(tr(100, "El bloque necesita un registro como poco."), 1)
            return
        end
    elif (k == K_SUPR or k == K_RETROCESO) and cu_paradas.length > 1
        cu_paradas.remove(cu_elegida)
        if cu_elegida >= cu_paradas.length
            cu_elegida = cu_paradas.length - 1
        end
    elif ch == "a"
        # un registro más en el bloque
        if cu_anadir_registro() < 0
            avisar(tr(101, "Ya están todos los registros en el bloque."), 1)
            return
        end
    elif ch == "d"
        cu_otro_modo()
    elif ch == "t"
        cu_tabla = not cu_tabla
    elif ch == "c"
        cu_cambiar_registro(1)
    elif ch == "C"
        cu_cambiar_registro(-1)
    elif k == K_RETURN or k == K_INTRO
        al_codigo()
        return
    elif ch == "l"
        leer_codigo()
        return
    elif k == K_TAB
        if (q & Q_MAYUS) != 0
            otro_bloque(-1)
        else
            otro_bloque(1)
        end
        return
    elif ch == "p"
        probar()
        return
    else
        return
    end
    cu_vivo_cambio = true
    redibujar()
end

var arrastres: Int = 0             # (para la sonda: cuántos sucesos de arrastre y el último)
var ultimo_arrastre: String = ""
var cu_arrastrando: Bool = false    # se mueve la parada elegida con el ratón (el clic fue en la vista)

# Solo las marcas y la lista del copper (si no hay un dibujo entero de la página, el entero)
func copper_parcial()
    if not abierta or not _cu_ok or pagina != PAG_COPPER or mensaje != _mensaje_visto
        redibujar()
        return
    end
    dibujar_solo(P_COPPER, _cu_x - zona_x + 161, _cu_y - zona_y - 1, _cu_ancho - 161, _cu_alto + 2)
end

# Un clic en la vista elige la parada más cercana (y arrastrando se mueve); en la lista, esa parada
func copper_clic(mx: Int, my: Int)
    cu_arrastrando = false
    cy = ALTO_PESTANAS + 4
    alto = zona_alto - 2 * (alto_letra + 2) - 2 - cy
    lx = 4 + 160 + 16
    ly = cy + 3 * (alto_letra + 2) + 6
    # un clic en la fila de los registros elige ese registro
    ry = cy + 2 * (alto_letra + 2)
    if mx >= lx and my >= ry - 1 and my < ry + alto_letra + 1
        rx = lx
        k = 0
        for g in cu_registros
            w = font_text_width(cu_nombre_reg(g.reg))
            if mx >= rx - 2 and mx < rx + w + 2
                cu_elegir(k)
                redibujar()
                return
            end
            rx = rx + w + ancho_letra
            k = k + 1
        end
        return
    end
    if mx >= lx and my >= ly and my < cy + alto
        n = (my - ly) / (alto_letra + 2)
        if n >= 0 and n < cu_paradas.length
            cu_elegida = n
            copper_parcial()
        end
        return
    end
    if mx < 4 or mx > 4 + 172 or my < cy or my >= cy + alto
        return
    end
    cu_arrastrando = true
    l = (my - cy) * CU_LINEAS / alto
    mejor = 0
    dif = 9999
    i = 0
    for p in cu_paradas
        d = p.linea - l
        if d < 0
            d = 0 - d
        end
        if d < dif
            dif = d
            mejor = i
        end
        i = i + 1
    end
    cu_elegida = mejor
    copper_parcial()
end

# Arrastrar en la vista: la parada elegida va a la línea del puntero
func copper_arrastrar(my: Int, soltado: Bool)
    if not cu_arrastrando or cu_paradas.length == 0
        return
    end
    if soltado
        cu_arrastrando = false
    end
    cy = ALTO_PESTANAS + 4
    alto = zona_alto - 2 * (alto_letra + 2) - 2 - cy
    if alto <= 0
        return
    end
    l = (my - cy) * CU_LINEAS / alto
    if l < 0
        l = 0
    elif l > CU_LINEAS - 1
        l = CU_LINEAS - 1
    end
    p = cu_paradas[cu_elegida]
    if p.linea != l
        p.linea = l
        cu_ordenar()
        cu_vivo_cambio = true
    end
    # mientras se arrastra, solo las marcas y la lista; al soltar, la vista también
    if soltado
        redibujar()
    else
        copper_parcial()
    end
end

# Tab: el bloque de copper siguiente del fichero de delante de Forja (Mayúsculas+Tab, el anterior), leído como l
func otro_bloque(n: Int)
    t = forja_texto("")
    if forja_rc != 0
        avisar(tr(38, "No hay un fichero delante en Forja."), 1)
        return
    end
    var inicios: [Int] = []
    var nombres: [String] = []
    i = 0
    for linea in str_split(t, "\n")
        s = str_trim(linea)
        if str_starts(s, "# copper: ")
            r = s[10:]
            k = str_find(r, " ")
            if k > 0
                r = r[0:k]
            end
            inicios.push(i + 1)
            nombres.push(r)
        end
        i = i + 1
    end
    if inicios.length == 0
        avisar(tr(39, "No hay un bloque \"# copper:\" con sus líneas \"# registro:\" en el fichero."), 1)
        return
    end
    k = -1
    i = 0
    while i < nombres.length
        if nombres[i] == cu_nombre
            k = i
        end
        i = i + 1
    end
    if k < 0 and n < 0
        k = 0
    end
    k = (k + n + nombres.length) % nombres.length
    cu_vivo_cambio = true
    if cu_leer_codigo(t, inicios[k])
        avisar(hueco2(tr(63, "Leído %1 (%2 paradas)."), "copper_" + cu_nombre, "#{cu_paradas.length}") + " #{k + 1}/#{nombres.length}", 2)
    end
    redibujar()
end

# Pone el código en el fichero de delante de Forja: cambia su bloque si ya está; si no, lo mete en el cursor
func al_codigo()
    a = str_split(forja_activo(), "\n")
    if forja_rc != 0 or a.length < 4 or a[3] != "texto"
        avisar(tr(37, "Abre en Forja el .dash donde va el copper."), 1)
        return
    end
    ruta = a[0]
    t = forja_texto("")
    b = cu_buscar_bloque(t)
    codigo = cu_codigo()
    if b[0] > 0 and ruta != ""
        forja_cambiar(ruta, b[0], b[1], codigo[0:codigo.length - 1])
        avisar(hueco2(tr(61, "%1 cambiado en %2."), "copper_" + cu_nombre, nombre_de(ruta) + " (#{b[0]}-#{b[1]})"), 2)
    else
        forja_insertar(codigo)
        avisar(hueco2(tr(62, "%1 metido en el cursor de %2."), "copper_" + cu_nombre, a[1]), 2)
    end
end

# Lee el bloque de copper del fichero de delante (el del cursor, si hay varios)
func leer_codigo()
    t = forja_texto("")
    if forja_rc != 0
        avisar(tr(38, "No hay un fichero delante en Forja."), 1)
        return
    end
    forja_cursor()
    cu_vivo_cambio = true
    if cu_leer_codigo(t, forja_cursor_linea)
        avisar(hueco2(tr(63, "Leído %1 (%2 paradas)."), "copper_" + cu_nombre, "#{cu_paradas.length}"), 2)
    else
        avisar(tr(39, "No hay un bloque \"# copper:\" con sus líneas \"# registro:\" en el fichero."), 1)
    end
    redibujar()
end

# Lo enseña de verdad: una pantalla propia con la lista de copper, hasta un clic o 10 segundos
func probar()
    if not screen_open_custom(320, 256, 1, "Copper de Forja")
        avisar(tr(40, "No se puede abrir la pantalla."), 1)
        return
    end
    gfx_rgb(0, 0, 0, 0)
    gfx_rgb(1, 15, 15, 15)
    gfx_clear()
    gfx_pen(1)
    gfx_text_at(64, 16, hueco(tr(64, "%1: un clic vuelve"), "copper_" + cu_nombre))
    cu_instalar()
    if sonda
        env_set("FORJA_DEMOS_PROBANDO", "1", false)
    end
    n = 0
    while n < 500 and (peek_byte(0xBFE001) & 64) != 0
        wait_vblank()
        n = n + 1
    end
    copper_free()
    screen_close()
    env_set("FORJA_DEMOS_PROBANDO", "0", false)
    abrir_ventana()
end

# --- El copper, en vivo en la demo ---

var cu_vivo_cambio: Bool = false    # cambió el copper: se manda a la demo en la lectura siguiente
var cu_vivo_lista: [String] = []    # lo último que se mandó (COPPER)
var cu_vivo_cuenta: Int = 0         # las instrucciones que dijo la demo (0: no tiene la nuestra)
var cu_vivo_envios: Int = 0         # (para la sonda: cuántos COPPER y cuántos COPPERSET)
var cu_vivo_sets: Int = 0

# Manda el copper a la demo: si la lista tiene la misma forma que la última que se le mandó, solo los valores que
# cambiaron (COPPERSET, que la demo pone con copper_set); si no, la lista entera (COPPER: la rehace)
func copper_a_la_demo()
    cu_vivo_cambio = false
    if not conectada()
        return
    end
    l = cu_lista_vivo()
    igual = cu_vivo_cuenta > 0 and l.length == cu_vivo_lista.length
    if igual
        i = 0
        while i < l.length and igual
            a = l[i]
            b = cu_vivo_lista[i]
            if a != b
                pa = str_find(a, ":")
                pb = str_find(b, ":")
                igual = pa > 0 and pa == pb and a[0:pa] == b[0:pb]
            end
            i = i + 1
        end
    end
    if igual
        o = "COPPERSET"
        i = 0
        while i < l.length
            if l[i] != cu_vivo_lista[i]
                o = o + " #{i}:" + l[i][str_find(l[i], ":") + 1:]
            end
            i = i + 1
        end
        if o != "COPPERSET"
            mandar_demo(o)
            cu_vivo_sets = cu_vivo_sets + 1
        end
    else
        o = "COPPER"
        for t in l
            o = o + " " + t
        end
        r = mandar_demo(o)
        cu_vivo_cuenta = Int(r)
        cu_vivo_envios = cu_vivo_envios + 1
    end
    cu_vivo_lista = l
end

# --- Música ---

# La geometría de la tabla de Música en el último dibujo entero (para dibujar solo una fila)
var _mu_ok: Bool = false
var _mu_x: Int = 0
var _mu_y: Int = 0          # la línea de la posición
var _mu_ty: Int = 0         # la primera fila
var _mu_ancho: Int = 0
var _mu_n: Int = 0
var _mu_desde: Int = 0      # la primera fila que se ve (la vista se mueve solo cuando la fila sale de ella)
var _mu_pat: Int = -1       # el patrón que se ve
var _mu_fila: Int = -1      # la fila resaltada
var _mu_pos: Int = -1

# La posición y la fila que se ven: la de la demo, la que suena o la del cursor
func musica_donde()
    _mu_pos = mus_pos
    _mu_fila = mus_fila
    if conectada()
        _mu_pos = demo_fila / 64
        _mu_fila = demo_fila % 64
    end
end

func dibujar_musica(x: Int, y: Int, ancho: Int, alto: Int)
    if mod_datos == 0
        texto(x, y, tr(41, "Abre un .mod (Amiga-O, o desde el panel del proyecto de Forja)."), tema.tenue)
        return
    end
    musica_donde()
    _mu_pat = mod_patron(_mu_pos)
    texto(x, y, mod_titulo + "  (" + nombre_de(mod_ruta) + ")", tema.texto)
    _mu_x = x
    _mu_y = y + alto_letra + 2
    _mu_ancho = ancho
    musica_cabecera(false)
    _mu_ty = y + 2 * (alto_letra + 2) + 4
    _mu_n = (y + alto - _mu_ty) / (alto_letra + 1)
    if _mu_n < 1
        return
    end
    # la vista se mueve de página en página, como un tracker: así, al sonar, solo cambian dos filas
    if _mu_fila < _mu_desde or _mu_fila >= _mu_desde + _mu_n
        _mu_desde = _mu_fila - _mu_n / 4
    end
    if _mu_desde > 64 - _mu_n
        _mu_desde = 64 - _mu_n
    end
    if _mu_desde < 0
        _mu_desde = 0
    end
    _mu_ok = true
    k = 0
    while k < _mu_n
        musica_fila(_mu_desde + k, false)
        k = k + 1
    end
end

func musica_cabecera(fondo: Bool)
    if fondo
        gfx_pen(tema.fondo)
        gfx_rect(_mu_x, _mu_y, _mu_x + _mu_ancho - 1, _mu_y + alto_letra)
    end
    estado = tr(42, "parada")
    if conectada()
        estado = tr(43, "la de la demo")
    elif suena()
        estado = tr(44, "suena")
    end
    texto(_mu_x, _mu_y, hueco4(tr(65, "posición %1  patrón %2  fila %3  -> sincronía %4"), "#{_mu_pos}/#{mod_largo}", "#{_mu_pat}", "#{_mu_fila}", "#{_mu_pos * 64 + _mu_fila}") + "   " + estado, tema.acento)
end

func musica_fila(r: Int, fondo: Bool)
    k = r - _mu_desde
    if k < 0 or k >= _mu_n or r < 0 or r >= 64
        return
    end
    x = _mu_x
    ry = _mu_ty + k * (alto_letra + 1)
    if r == _mu_fila
        gfx_pen(tema.seleccion)
        gfx_rect(x, ry - 1, x + _mu_ancho - 1, ry + alto_letra - 1)
    elif fondo
        gfx_pen(tema.fondo)
        gfx_rect(x, ry - 1, x + _mu_ancho - 1, ry + alto_letra - 1)
    end
    num = "#{r}"
    if r < 10
        num = "0" + num
    end
    pen = tema.tenue
    if r % 4 == 0
        pen = tema.texto
    end
    texto(x, ry, num, pen)
    ch = 0
    while ch < 4
        cx = x + (3 + ch * 11) * ancho_letra
        if cx + 10 * ancho_letra < x + _mu_ancho
            texto(cx, ry, mod_celda(_mu_pat, r, ch), tema.sintaxis[4 + ch % 3])
        end
        ch = ch + 1
    end
end

# La fila que suena (o la del cursor) cambió: solo esas dos filas y la línea de la posición; false si hace falta el
# dibujo entero (otro patrón, o la fila fuera de lo que se ve)
func musica_parcial() -> Bool
    if not abierta or pagina != PAG_MUSICA or not _mu_ok or mensaje != _mensaje_visto
        return false
    end
    antes = _mu_fila
    pos_antes = _mu_pos
    musica_donde()
    if _mu_pos != pos_antes or mod_patron(_mu_pos) != _mu_pat or _mu_fila < _mu_desde or _mu_fila >= _mu_desde + _mu_n
        _mu_pos = pos_antes
        _mu_fila = antes
        return false
    end
    if _mu_fila == antes
        return true
    end
    zx = _mu_x - zona_x
    dibujar_solo(P_CAB_MUSICA, zx, _mu_y - zona_y, _mu_ancho, alto_letra + 1)
    for r in [antes, _mu_fila]
        _parte_fila = r
        dibujar_solo(P_FILA_MUSICA, zx, _mu_ty + (r - _mu_desde) * (alto_letra + 1) - 1 - zona_y, _mu_ancho, alto_letra + 1)
    end
    return true
end

func tocar(si: Bool)
    if si and mod_datos != 0 and not conectada()
        if music_load(mod_ruta)
            music_play()
            mus_pos = 0
            mus_fila = 0
        else
            avisar(hueco(tr(66, "music_load no puede con %1"), mod_ruta), 1)
        end
    elif not si and suena()
        music_stop()
        music_free()
    end
end

func musica_tecla(k: Int, q: Int, ch: String)
    if k == K_ESPACIO
        if conectada()
            mandar_demo(pausa_orden())
        else
            tocar(not suena())
        end
    elif k == K_IZQUIERDA or k == K_DERECHA
        d = 1
        if k == K_IZQUIERDA
            d = -1
        end
        p = mus_pos + d
        if p >= 0 and p < mod_largo
            mus_pos = p
            mus_fila = 0
            if suena()
                music_seek(p, 0)
            end
        end
    elif k == K_ARRIBA or k == K_ABAJO
        if k == K_ARRIBA and mus_fila > 0
            mus_fila = mus_fila - 1
        elif k == K_ABAJO and mus_fila < 63
            mus_fila = mus_fila + 1
        end
        if suena()
            # sonando, la música salta a esa fila
            music_seek(mus_pos, mus_fila)
        end
        if musica_parcial()
            return
        end
    elif k == K_RETURN or k == K_INTRO
        f = fila_musica()
        forja_insertar("#{f}")
        avisar(hueco2(tr(67, "Fila %1 metida en el código (posición y fila: %2)."), "#{f}", "#{f / 64}, #{f % 64}"), 2)
        return
    elif ch == "s"
        sy_fila = fila_musica()
        pagina = PAG_SYNC
    else
        return
    end
    redibujar()
end

func fila_musica() -> Int
    if conectada()
        return demo_fila
    end
    return mus_pos * 64 + mus_fila
end

func cargar_mod(ruta: String)
    tocar(false)
    if mod_leer(ruta)
        mus_pos = 0
        mus_fila = 0
        ver(PAG_MUSICA)
    else
        avisar(mod_error, 1)
    end
end

# --- Sincronía ---

# La geometría de la tabla de Sincronía en el último dibujo entero (para dibujar solo una fila)
var _sy_ok: Bool = false
var _sy_x: Int = 0
var _sy_y: Int = 0          # la línea de arriba
var _sy_hy: Int = 0         # los nombres de las pistas
var _sy_ty: Int = 0         # la primera fila
var _sy_ancho: Int = 0
var _sy_n: Int = 0          # cuántas filas caben
var _sy_cabe: Int = 0       # cuántas pistas caben
var _sy_desde: Int = 0      # la primera fila que se ve (la vista se mueve solo cuando el cursor sale de ella)
var _sy_cursor: Int = -1    # el cursor y la fila que suena del último dibujo
var _sy_pista: Int = -1
var _sy_suena: Int = -1

func dibujar_sync(x: Int, y: Int, ancho: Int, alto: Int)
    _sy_x = x
    _sy_y = y
    _sy_ancho = ancho
    tabla_cabecera(x, y)
    if sy_nombrando
        pregunta = tr(45, "Nueva pista (sin espacios; Return la hace, Esc no): ")
        if sy_renombrando
            pregunta = hueco(tr(68, "Nombre nuevo de %1 (Return lo cambia, Esc no): "), sync_pistas[sy_pista].nombre)
        end
        texto(x, y + alto_letra + 2, pregunta + sy_nombre + "_", tema.cursor)
        return
    end
    if sync_pistas.length == 0
        texto(x, y + 2 * (alto_letra + 2), tr(46, "Sin pistas: n hace una (zoom, fundido, escena...)."), tema.tenue)
        return
    end
    # cuántas pistas caben y cuál es la primera
    _sy_cabe = (ancho - 6 * ancho_letra) / (ANCHO_PISTA * ancho_letra)
    if _sy_cabe < 1
        _sy_cabe = 1
    end
    if sy_pista < sy_primera
        sy_primera = sy_pista
    elif sy_pista >= sy_primera + _sy_cabe
        sy_primera = sy_pista - _sy_cabe + 1
    end
    _sy_hy = y + alto_letra + 4
    tabla_nombres(false)
    _sy_ty = _sy_hy + alto_letra + 3
    _sy_n = (y + alto - _sy_ty) / (alto_letra + 1)
    if _sy_n < 1
        return
    end
    # la vista se mueve de página en página, como un tracker: con la demo en marcha, cada fila nueva cambia solo dos
    # filas de la tabla (antes se centraba en el cursor y todo se movía en cada fila)
    if sy_fila < _sy_desde or sy_fila >= _sy_desde + _sy_n
        _sy_desde = sy_fila - _sy_n / 4
        if _sy_desde < 0
            _sy_desde = 0
        end
    end
    _sy_ok = true
    _sy_cursor = sy_fila
    _sy_pista = sy_pista
    f = fila_ahora()
    _sy_suena = f
    k = 0
    while k < _sy_n
        tabla_fila(_sy_desde + k, f, false)
        k = k + 1
    end
end

func tabla_cabecera(x: Int, y: Int)
    nombre = tr(47, "(sin fichero)")
    if sy_ruta != ""
        nombre = nombre_de(sy_ruta)
    end
    if sy_cambiado
        nombre = nombre + " *"
    end
    if sy_ficheros.length > 1
        nombre = nombre + " (#{sy_actual + 1}/#{sy_ficheros.length}, Tab)"
    end
    f = fila_ahora()
    e = ""
    if f >= 0
        e = "  " + hueco(tr(69, "suena la fila %1"), "#{f}")
    end
    texto(x, y, nombre + "  " + hueco2(tr(70, "cursor: fila %1 (posición %2)"), "#{sy_fila}", "#{sy_fila / 64}, #{sy_fila % 64}") + e, tema.texto)
end

func tabla_nombres(fondo: Bool)
    if fondo
        gfx_pen(tema.fondo)
        gfx_rect(_sy_x, _sy_hy, _sy_x + _sy_ancho - 1, _sy_hy + alto_letra)
    end
    i = 0
    while i < _sy_cabe and sy_primera + i < sync_pistas.length
        p = sync_pistas[sy_primera + i]
        n = p.nombre
        if n.length > ANCHO_PISTA - 1
            n = n[0:ANCHO_PISTA - 1]
        end
        pen = tema.tenue
        if sy_primera + i == sy_pista
            pen = tema.acento
        end
        texto(_sy_x + (6 + i * ANCHO_PISTA) * ancho_letra, _sy_hy, n, pen)
        i = i + 1
    end
end

# La fila r de la tabla (si se ve), con la fila que suena (f) resaltada
func tabla_fila(r: Int, f: Int, fondo: Bool)
    k = r - _sy_desde
    if k < 0 or k >= _sy_n or r < 0
        return
    end
    x = _sy_x
    ancho = _sy_ancho
    ry = _sy_ty + k * (alto_letra + 1)
    if r == f
        gfx_pen(tema.parada)
        gfx_rect(x, ry - 1, x + ancho - 1, ry + alto_letra - 1)
    elif fondo
        gfx_pen(tema.fondo)
        gfx_rect(x, ry - 1, x + ancho - 1, ry + alto_letra - 1)
    end
    pen = tema.tenue
    if r % 16 == 0
        pen = tema.texto
    end
    texto(x, ry, "#{r}", pen)
    i = 0
    while i < _sy_cabe and sy_primera + i < sync_pistas.length
        j = sy_primera + i
        p = sync_pistas[j]
        cx = x + (6 + i * ANCHO_PISTA) * ancho_letra
        if r == sy_fila and j == sy_pista
            gfx_pen(tema.seleccion)
            gfx_rect(cx - 2, ry - 1, cx + (ANCHO_PISTA - 1) * ancho_letra, ry + alto_letra - 1)
        end
        c = sync_clave_en(p, r)
        if r == sy_fila and j == sy_pista and sy_buffer != ""
            texto(cx, ry, sy_buffer + "_", tema.cursor)
        elif c >= 0
            texto(cx, ry, sync_texto(p.valores[c]) + " " + _letra_tipo(p.tipos[c]), tema.sintaxis[4])
        elif p.filas.length > 0 and r > p.filas[0] and r < p.filas[p.filas.length - 1] + 1
            texto(cx, ry, "  " + sync_texto(sync_valor_en(p, r, Fixed(0))), tema.borde)
        end
        i = i + 1
    end
end

func _esta(ls: [Int], n: Int) -> Bool
    for k in ls
        if k == n
            return true
        end
    end
    return false
end

# El cursor, la pista o la fila que suena cambiaron (y nada más): solo las filas que cambian, la línea de arriba y, si
# cambió la pista, sus nombres. false si hace falta el dibujo entero (el cursor sale de lo que se ve)
func tabla_parcial() -> Bool
    if not abierta or pagina != PAG_SYNC or not _sy_ok or sy_nombrando or mensaje != _mensaje_visto
        return false
    end
    if sy_fila < _sy_desde or sy_fila >= _sy_desde + _sy_n or sy_pista < sy_primera or sy_pista >= sy_primera + _sy_cabe
        return false
    end
    f = fila_ahora()
    zx = _sy_x - zona_x
    dibujar_solo(P_CAB_SYNC, zx, _sy_y - zona_y, _sy_ancho, alto_letra + 1)
    if sy_pista != _sy_pista
        dibujar_solo(P_NOMBRES_SYNC, zx, _sy_hy - zona_y, _sy_ancho, alto_letra + 1)
    end
    var hechas: [Int] = []
    for r in [_sy_cursor, sy_fila, _sy_suena, f]
        if r >= _sy_desde and r < _sy_desde + _sy_n and not _esta(hechas, r)
            hechas.push(r)
            _parte_fila = r
            dibujar_solo(P_FILA_SYNC, zx, _sy_ty + (r - _sy_desde) * (alto_letra + 1) - 1 - zona_y, _sy_ancho, alto_letra + 1)
        end
    end
    _sy_cursor = sy_fila
    _sy_pista = sy_pista
    _sy_suena = f
    return true
end

func _letra_tipo(t: Int) -> String
    if t == SYNC_LINEAL
        return "/"
    elif t == SYNC_SUAVE
        return "~"
    elif t == SYNC_RAMPA
        return "^"
    end
    return "_"
end

func pausa_orden() -> String
    if demo_pausa
        return "SIGUE"
    end
    return "PAUSA"
end

# Una orden a la demo (sin quedarse esperando si no contesta)
func mandar_demo(o: String) -> String
    if not conectada()
        return ""
    end
    r = rexx_send_wait("DEMOSYNC", o, 1000)
    if rexx_rc() < 0
        avisar(hueco(tr(71, "La demo no contesta (%1)."), o), 1)
    end
    return r
end

func cambiado()
    sy_cambiado = true
end

func sync_tecla(k: Int, q: Int, ch: String)
    if sy_nombrando
        nombre_tecla(k, ch)
        return
    end
    var p: SyncPista = nil
    if sy_pista < sync_pistas.length
        p = sync_pistas[sy_pista]
    end
    # (moverse y escribir en la celda cambian solo unas filas: no hace falta el dibujo entero)
    parcial = false
    if k == K_ARRIBA or k == K_ABAJO
        parcial = true
        d = 1
        if (q & Q_MAYUS) != 0
            d = 16
        end
        if k == K_ARRIBA
            d = 0 - d
        end
        sy_fila = sy_fila + d
        if sy_fila < 0
            sy_fila = 0
        end
        sy_buffer = ""
    elif k == K_IZQUIERDA and sy_pista > 0 and (q & Q_ALT) == 0
        sy_pista = sy_pista - 1
        sy_buffer = ""
        parcial = true
    elif k == K_DERECHA and sy_pista + 1 < sync_pistas.length and (q & Q_ALT) == 0
        sy_pista = sy_pista + 1
        sy_buffer = ""
        parcial = true
    elif k == K_ESC
        sy_buffer = ""
        parcial = true
    elif k == K_TAB
        # otro de los .sync abiertos
        if (q & Q_MAYUS) != 0
            sy_otro(-1)
        else
            sy_otro(1)
        end
    elif (k == K_RETURN or k == K_INTRO) and p != nil and sy_buffer != ""
        v = sync_numero(sy_buffer)
        if sync_error != ""
            avisar(tr(72, "No es un número: ") + sy_buffer, 1)
            sy_buffer = ""
            return
        end
        tipo = SYNC_LINEAL
        c = sync_clave_en(p, sy_fila)
        if c >= 0
            tipo = p.tipos[c]
        end
        para_deshacer()
        sync_clave(p, sy_fila, v, tipo)
        mandar_pistas("CLAVE " + p.nombre + " #{sy_fila} " + sync_texto(v) + " " + sync_tipo_nombre(tipo))
        sy_buffer = ""
        cambiado()
    elif k == K_SUPR and (q & Q_MAYUS) != 0 and p != nil
        quitar_pista()
        return
    elif (k == K_IZQUIERDA or k == K_DERECHA) and (q & Q_ALT) != 0 and p != nil
        mover_pista(k == K_DERECHA)
        return
    elif k == K_RETROCESO and sy_buffer != ""
        sy_buffer = sy_buffer[0:sy_buffer.length - 1]
        parcial = true
    elif (k == K_SUPR or k == K_RETROCESO) and p != nil and sync_clave_en(p, sy_fila) >= 0
        para_deshacer()
        if sync_quitar(p, sy_fila)
            mandar_pistas("QUITAR " + p.nombre + " #{sy_fila}")
            cambiado()
        end
    elif ch != "" and str_find("0123456789.-", ch) >= 0 and p != nil
        sy_buffer = sy_buffer + ch
        parcial = true
    elif ch == "i" and p != nil
        c = sync_clave_en(p, sy_fila)
        if c >= 0
            para_deshacer()
            p.tipos[c] = (p.tipos[c] + 1) % 4
            mandar_pistas("CLAVE " + p.nombre + " #{sy_fila} " + sync_texto(p.valores[c]) + " " + sync_tipo_nombre(p.tipos[c]))
            avisar(tr(73, "Tipo de la clave: ") + sync_tipo_nombre(p.tipos[c]), 0)
            cambiado()
        end
    elif ch == "n"
        sy_nombrando = true
        sy_renombrando = false
        sy_nombre = ""
    elif ch == "r" and p != nil
        sy_nombrando = true
        sy_renombrando = true
        sy_nombre = p.nombre
    elif k == K_ESPACIO
        if conectada()
            mandar_demo(pausa_orden())
        elif mod_datos != 0
            tocar(not suena())
        end
    elif ch == "v" and conectada()
        # la pantalla de la demo, delante o detrás de la de Forja
        _demo_delante = not _demo_delante
        if _demo_delante
            mandar_demo("DELANTE")
        else
            mandar_demo("DETRAS")
        end
    elif ch == "g"
        if conectada()
            mandar_demo("IR #{sy_fila}")
        elif suena()
            music_seek(sy_fila / 64, sy_fila % 64)
        end
    else
        return
    end
    if not parcial or not tabla_parcial()
        redibujar()
    end
end

# n empieza a escribir el nombre de una pista nueva (en la tabla, sin otra ventana); Return la hace
var sy_nombre: String = ""
var sy_nombrando: Bool = false
var sy_renombrando: Bool = false   # r: el nombre nuevo de la pista del cursor

# --- Deshacer en las pistas: el texto de todas antes de cada cambio (son pocas y pequeñas) ---
const SY_DESHACER_MAX = 64
var sy_deshacer: [String] = []
var sy_rehacer: [String] = []

func para_deshacer()
    sy_deshacer.push(sync_a_texto())
    if sy_deshacer.length > SY_DESHACER_MAX
        sy_deshacer.remove(0)
    end
    sy_rehacer.clear()
end

# Todas las pistas, otra vez a la demo (tras deshacer, quitar, renombrar u ordenar)
func demo_recargar()
    if es_de_la_demo() and file_write_text("T:forja-demos.sync", sync_a_texto())
        mandar_demo("RECARGAR T:forja-demos.sync")
    end
end

func deshacer(rehacer: Bool)
    if rehacer and sy_rehacer.length == 0 or not rehacer and sy_deshacer.length == 0
        avisar(elegir(rehacer, tr(74, "Nada que rehacer."), tr(75, "Nada que deshacer.")), 0)
        return
    end
    ahora = sync_a_texto()
    t = ""
    if rehacer
        t = sy_rehacer.pop()
        sy_deshacer.push(ahora)
    else
        t = sy_deshacer.pop()
        sy_rehacer.push(ahora)
    end
    nombre = ""
    if sy_pista < sync_pistas.length
        nombre = sync_pistas[sy_pista].nombre
    end
    sync_de_texto(t)
    # el cursor, en la misma pista si sigue
    i = sync_buscar(nombre)
    if i >= 0
        sy_pista = i
    elif sy_pista >= sync_pistas.length
        sy_pista = sync_pistas.length - 1
    end
    if sy_pista < 0
        sy_pista = 0
    end
    sy_buffer = ""
    demo_recargar()
    cambiado()
    redibujar()
end

func elegir(si: Bool, a: String, b: String) -> String
    if si
        return a
    end
    return b
end

func renombrar_pista(n: String)
    if n == "" or sy_pista >= sync_pistas.length
        return
    end
    p = sync_pistas[sy_pista]
    if n == p.nombre
        return
    end
    if sync_buscar(n) >= 0
        avisar(hueco(tr(76, "Ya hay una pista %1."), n), 1)
        return
    end
    para_deshacer()
    viejo = p.nombre
    p.nombre = n
    # (el índice por nombre se rehace: sync_de_texto)
    sync_de_texto(sync_a_texto())
    demo_recargar()
    cambiado()
    avisar(hueco2(tr(78, "La pista %1 ahora es %2: cámbiala también en el código (sync_valor)."), viejo, n), 2)
end

func quitar_pista()
    if sy_pista >= sync_pistas.length
        return
    end
    para_deshacer()
    n = sync_pistas[sy_pista].nombre
    sync_pistas.remove(sy_pista)
    sync_de_texto(sync_a_texto())
    if sy_pista >= sync_pistas.length and sy_pista > 0
        sy_pista = sy_pista - 1
    end
    demo_recargar()
    cambiado()
    avisar(hueco(tr(79, "Pista %1 quitada (Amiga-Z la devuelve)."), n), 0)
end

func mover_pista(derecha: Bool)
    j = sy_pista - 1
    if derecha
        j = sy_pista + 1
    end
    if sy_pista >= sync_pistas.length or j < 0 or j >= sync_pistas.length
        return
    end
    para_deshacer()
    p = sync_pistas[sy_pista]
    sync_pistas[sy_pista] = sync_pistas[j]
    sync_pistas[j] = p
    sync_de_texto(sync_a_texto())
    sy_pista = j
    demo_recargar()
    cambiado()
    redibujar()
end

func nueva_pista(n: String)
    if n == ""
        return
    end
    if sync_buscar(n) >= 0
        avisar(hueco(tr(77, "Ya hay una pista %1."), n), 1)
        return
    end
    para_deshacer()
    sync_pista(n)
    sy_pista = sync_pistas.length - 1
    mandar_pistas("PISTA " + n)
    cambiado()
end

func nombre_tecla(k: Int, ch: String)
    if k == K_RETURN or k == K_INTRO
        sy_nombrando = false
        if sy_renombrando
            renombrar_pista(sy_nombre)
        else
            nueva_pista(sy_nombre)
        end
    elif k == K_ESC
        sy_nombrando = false
    elif k == K_RETROCESO
        if sy_nombre != ""
            sy_nombre = sy_nombre[0:sy_nombre.length - 1]
        end
    elif ch != "" and ch != " " and str_code(ch, 0) > 32
        sy_nombre = sy_nombre + ch
    end
    redibujar()
end

# Lo de delante, a su sitio en sy_ficheros (antes de poner otro delante)
func sy_apartar()
    if sy_actual < 0 or sy_actual >= sy_ficheros.length
        return
    end
    f = sy_ficheros[sy_actual]
    f.ruta = sy_ruta
    f.texto = sync_a_texto()
    f.cambiado = sy_cambiado
    f.fila = sy_fila
    f.pista = sy_pista
    f.primera = sy_primera
    f.deshacer = sy_deshacer
    f.rehacer = sy_rehacer
end

# Pone delante el .sync i de los abiertos
func sy_poner(i: Int)
    f = sy_ficheros[i]
    sy_actual = i
    sync_de_texto(f.texto)
    sy_ruta = f.ruta
    sy_cambiado = f.cambiado
    sy_fila = f.fila
    sy_pista = f.pista
    sy_primera = f.primera
    sy_deshacer = f.deshacer
    sy_rehacer = f.rehacer
    sy_buffer = ""
    sy_nombrando = false
end

# Al .sync siguiente (o al anterior) de los abiertos
func sy_otro(n: Int)
    if sy_ficheros.length < 2
        avisar(tr(95, "Solo hay un fichero de pistas abierto (Amiga-O abre otro)."), 0)
        return
    end
    sy_apartar()
    sy_poner((sy_actual + n + sy_ficheros.length) % sy_ficheros.length)
    avisar(hueco2(tr(96, "Pistas de %1 (%2)."), nombre_de(sy_ruta), "#{sy_actual + 1}/#{sy_ficheros.length}"), 0)
end

func sy_buscar_ruta(ruta: String) -> Int
    i = 0
    while i < sy_ficheros.length
        if str_lower(sy_ficheros[i].ruta) == str_lower(ruta)
            return i
        end
        i = i + 1
    end
    return -1
end

# Abre un .sync (o va a él si ya está abierto) y lo pone delante. Si lo de delante son unas pistas sin fichero, vacías
# y sin cambios, ocupa su sitio.
func cargar_sync(ruta: String) -> Bool
    i = sy_buscar_ruta(ruta)
    if i >= 0
        if i != sy_actual
            sy_apartar()
            sy_poner(i)
        end
        return true
    end
    t = file_read_text(ruta)
    if t == nil
        avisar(tr(80, "No se puede leer ") + ruta, 1)
        return false
    end
    sy_apartar()
    var d1: [String] = []
    var d2: [String] = []
    f = SyncFichero(ruta, t, false, 0, 0, 0, d1, d2)
    if sy_actual >= 0 and sy_ruta == "" and not sy_cambiado and sync_pistas.length == 0
        sy_ficheros[sy_actual] = f
    else
        sy_ficheros.push(f)
        sy_actual = sy_ficheros.length - 1
    end
    sy_poner(sy_actual)
    return true
end

# Abre un .sync sin ponerlo delante (el de la demo, al conectarse, si no estaba)
func sy_abrir_detras(ruta: String)
    t = file_read_text(ruta)
    if t != nil
        var d1: [String] = []
        var d2: [String] = []
        sy_ficheros.push(SyncFichero(ruta, t, false, 0, 0, 0, d1, d2))
    end
end

# Cierra el .sync de delante (pregunta si tiene cambios); false si se cancela. Queda delante otro, o unas pistas
# vacías sin fichero.
func cerrar_sync() -> Bool
    if sy_cambiado
        r = mui_request(win, "Demos", hueco(tr(88, "Las pistas de %1 tienen cambios sin guardar."), nombre_de(sy_ruta)), tr(89, "_Guardar|_Descartar|_Cancelar"))
        if r == 1
            guardar_sync(false)
            if sy_cambiado
                return false
            end
        elif r == 0
            return false
        end
    end
    sy_ficheros.remove(sy_actual)
    if sy_ficheros.length == 0
        var d1: [String] = []
        var d2: [String] = []
        sy_ficheros.push(SyncFichero("", "", false, 0, 0, 0, d1, d2))
    end
    if sy_actual >= sy_ficheros.length
        sy_actual = sy_ficheros.length - 1
    end
    sy_poner(sy_actual)
    redibujar()
    return true
end

# Al cerrar la ventana: cada .sync con cambios pregunta (Guardar, Descartar o Cancelar); false si se cancela
func cerrar_todos() -> Bool
    sy_apartar()
    i = 0
    while i < sy_ficheros.length
        if sy_ficheros[i].cambiado
            sy_poner(i)
            r = mui_request(win, "Demos", hueco(tr(88, "Las pistas de %1 tienen cambios sin guardar."), nombre_de(sy_ruta)), tr(89, "_Guardar|_Descartar|_Cancelar"))
            if r == 1
                guardar_sync(false)
                if sy_cambiado
                    return false
                end
            elif r == 0
                redibujar()
                return false
            end
            sy_apartar()
        end
        i = i + 1
    end
    return true
end

# GUARDAR de Forja (al salir con Guardar): todos los que tienen cambios
func guardar_todos()
    sy_apartar()
    antes = sy_actual
    i = 0
    while i < sy_ficheros.length
        if sy_ficheros[i].cambiado
            sy_poner(i)
            guardar_sync(false)
            sy_apartar()
        end
        i = i + 1
    end
    sy_poner(antes)
end

# ¿Es lo de delante lo que tiene la demo? (si no, los cambios de las pistas no se le mandan)
func es_de_la_demo() -> Bool
    return conectada() and (demo_fichero == "" or sy_ruta == "" or str_lower(demo_fichero) == str_lower(sy_ruta))
end

# Una orden de las pistas a la demo, solo si lo de delante es lo suyo
func mandar_pistas(o: String)
    if es_de_la_demo()
        mandar_demo(o)
    end
end

func guardar_sync(como: Bool)
    ruta = sy_ruta
    if ruta == "" or como
        abrir_ventana()
        if not file_save_dialog("Guardar las pistas", "#?.sync")
            return
        end
        ruta = file_fullpath()
        if not str_ends(str_lower(ruta), ".sync")
            ruta = ruta + ".sync"
        end
    end
    if sync_guardar(ruta)
        sy_ruta = ruta
        sy_cambiado = false
        forja_guardado(ruta)
        mensaje = tr(81, "Guardado: ") + nombre_de(ruta)
        mensaje_tipo = 2
        redibujar()
    else
        avisar(tr(87, "No se puede escribir ") + ruta, 1)
    end
end

# pistas_datos.dash junto al .sync: las pistas como tablas, para la versión final sin fichero ni puerto
func exportar()
    if sy_ruta == ""
        avisar(tr(48, "Guarda antes las pistas (Amiga-S): pistas_datos.dash va a su lado."), 1)
        return
    end
    t = "# Las pistas de " + nombre_de(sy_ruta) + " como datos, para la versión final de la demo: sin el fichero .sync ni\n"
    t = t + "# Forja (lo escribe Forja: Demos > Exportar las pistas; no se toca a mano). Lo usa sync.dash.\n\n"
    t = t + "func pistas_datos()\n"
    for p in sync_pistas
        if p.filas.length == 0
            t = t + "    sync_pista(\"" + p.nombre + "\")\n"
        else
            fs = ""
            vs = ""
            ts = ""
            i = 0
            while i < p.filas.length
                if i > 0
                    fs = fs + ", "
                    vs = vs + ", "
                    ts = ts + ", "
                end
                fs = fs + "#{p.filas[i]}"
                vs = vs + "Fixed(" + sync_texto(p.valores[i]) + ")"
                ts = ts + "#{p.tipos[i]}"
                i = i + 1
            end
            t = t + "    sync_pista_datos(\"" + p.nombre + "\", [" + fs + "], [" + vs + "], [" + ts + "])\n"
        end
    end
    t = t + "end\n"
    ruta = cajon_de(sy_ruta) + "pistas_datos.dash"
    if file_write_text(ruta, t)
        forja_guardado(ruta)
        avisar(hueco2(tr(82, "Exportadas %1 pistas a %2."), "#{sync_pistas.length}", ruta), 2)
    else
        avisar(tr(87, "No se puede escribir ") + ruta, 1)
    end
end

func decir_sin_guardar()
    var ns: [String] = []
    i = 0
    while i < sy_ficheros.length
        c = sy_ficheros[i].cambiado
        r = sy_ficheros[i].ruta
        if i == sy_actual
            c = sy_cambiado
            r = sy_ruta
        end
        if c
            n = nombre_de(r)
            if n == ""
                n = "pistas.sync"
            end
            ns.push(n)
        end
        i = i + 1
    end
    d = ""
    for n in ns
        d = d + "\n" + n
    end
    if d != sin_guardar_dicho
        sin_guardar_dicho = d
        forja_sin_guardar(ns)
    end
end

# EDITANDO: las pistas y el MOD que tiene (Forja los guarda en su sesión y los vuelve a abrir la próxima vez)
var abiertos_dicho: String = "-"
var salir_por_forja: Bool = false
func decir_abiertos(ninguno: Bool)
    var rs: [String] = []
    if not ninguno
        i = 0
        while i < sy_ficheros.length
            r = sy_ficheros[i].ruta
            if i == sy_actual
                r = sy_ruta
            end
            if r != ""
                rs.push(r)
            end
            i = i + 1
        end
        if mod_ruta != ""
            rs.push(mod_ruta)
        end
    end
    t = ""
    for r in rs
        t = t + "\n" + r
    end
    if t != abiertos_dicho
        abiertos_dicho = t
        forja_editando(rs)
    end
end

# --- Medidor ---

# El medidor: cada imagen de la demo, una barra en su sitio del anillo (la imagen n, en n % 64), como un osciloscopio
# que barre: en cada lectura solo se dibujan las barras nuevas y el texto de arriba (antes, las 64 barras se movían
# cada vez)
var _me_ok: Bool = false
var _me_x: Int = 0
var _me_y: Int = 0
var _me_ancho: Int = 0
var _me_gy: Int = 0
var _me_gh: Int = 0
var _me_w: Int = 2
var _me_indice: Int = 0     # el sitio del anillo hasta donde está dibujado

func dibujar_medidor(x: Int, y: Int, ancho: Int, alto: Int)
    if not conectada()
        texto(x, y, tr(49, "Sin demo. Ejecuta una que use sync.dash con VIVO = true (Amiga-E en Forja)."), tema.tenue)
        return
    end
    _me_x = x
    _me_y = y
    _me_ancho = ancho
    medidor_texto(false)
    arriba = alto_letra + 6
    if demo_partes.length > 0
        # (la leyenda de las partes, en otra línea)
        arriba = 2 * (alto_letra + 2) + 4
    end
    _me_gy = y + arriba
    _me_gh = alto - arriba - 2
    if _me_gh < 10
        return
    end
    _me_w = (ancho - 6) / SYNC_ANILLO
    if _me_w < 2
        _me_w = 2
    end
    # las rayas del 25, 50, 75 y 100 %, a la izquierda
    gfx_pen(tema.borde)
    k = 1
    while k <= 4
        ly = _me_gy + _me_gh - _me_gh * k / 4
        gfx_rect(x, ly, x + 3, ly)
        k = k + 1
    end
    gfx_rect(x + 3, _me_gy, x + 3, _me_gy + _me_gh - 1)
    _me_ok = true
    i = 0
    while i < SYNC_ANILLO
        medidor_barra(i)
        i = i + 1
    end
    _me_indice = demo_indice
end

func medidor_texto(fondo: Bool)
    if fondo
        gfx_pen(tema.fondo)
        alto = alto_letra
        if demo_partes.length > 0
            alto = 2 * (alto_letra + 2)
        end
        gfx_rect(_me_x, _me_y, _me_x + _me_ancho - 1, _me_y + alto)
    end
    n = 0
    suma = 0
    maximo = 0
    for v in demo_anillo
        if v >= 0
            suma = suma + v
            n = n + 1
            if v > maximo
                maximo = v
            end
        end
    end
    media = 0
    if n > 0
        media = suma / n
    end
    texto(_me_x, _me_y, hueco4(tr(83, "Última imagen: %1 líneas (%2 %)   media %3   máximo %4"), "#{demo_lineas}", "#{demo_lineas * 100 / demo_lineas_imagen}", "#{media}", "#{maximo}") + "   " + hueco(tr(84, "perdidas %1"), "#{demo_perdidos}"), tema.texto)
    if demo_partes.length > 0
        # la leyenda: el color de cada parte, su nombre y su media
        lx = _me_x
        ly = _me_y + alto_letra + 2
        k = 1
        while k <= demo_partes.length + 1
            j = k
            nombre = ""
            if k > demo_partes.length
                j = 0
                nombre = tr(104, "otro")
            else
                nombre = demo_partes[k - 1]
            end
            t = nombre + " #{media_parte(j)}"
            w = font_text_width(t) + ancho_letra * 2 + 6
            if lx + w > _me_x + _me_ancho
                break
            end
            gfx_pen(pen_parte(j))
            gfx_rect(lx, ly + 1, lx + ancho_letra, ly + alto_letra - 2)
            texto(lx + ancho_letra + 4, ly, t, tema.texto)
            lx = lx + w
            k = k + 1
        end
    end
end

# La barra del sitio i del anillo: su columna entera (el fondo y la barra; el sitio donde va la imagen siguiente,
# vacío: así se ve por dónde va). Solo dos cajas: las rayas del 25, 50, 75 y 100 % van a la izquierda, fuera de las
# barras (cruzarlas costaba 4 rayas más por barra)
func medidor_barra(i: Int)
    bx = _me_x + 6 + i * _me_w
    v = -1
    if i < demo_anillo.length and i != demo_indice
        v = demo_anillo[i]
    end
    h = 0
    if v > 0
        h = v * _me_gh / demo_lineas_imagen
        if h > _me_gh
            h = _me_gh
        end
    end
    if h < _me_gh
        gfx_pen(tema.fondo)
        gfx_rect(bx, _me_gy, bx + _me_w - 1, _me_gy + _me_gh - h - 1)
    end
    if h > 0 and demo_partes.length > 0 and (i + 1) * (SYNC_PARTES + 1) <= demo_anillo_partes.length
        # por partes: una encima de otra, de abajo arriba (la que no tiene nombre, la primera)
        yb = _me_gy + _me_gh
        suma = 0
        j = 0
        while j <= demo_partes.length
            g = demo_anillo_partes[i * (SYNC_PARTES + 1) + j]
            if g > 0
                suma = suma + g
                ya = _me_gy + _me_gh - suma * _me_gh / demo_lineas_imagen
                if ya < _me_gy
                    ya = _me_gy
                end
                if ya < yb
                    gfx_pen(pen_parte(j))
                    gfx_rect(bx, ya, bx + _me_w - 2, yb - 1)
                    yb = ya
                end
            end
            j = j + 1
        end
        if yb > _me_gy + _me_gh - h
            # (lo que no cuadra por redondeos o por las partes de más: del color de la que no tiene nombre)
            gfx_pen(pen_parte(0))
            gfx_rect(bx, _me_gy + _me_gh - h, bx + _me_w - 2, yb - 1)
        end
        if _me_w > 2
            gfx_pen(tema.fondo)
            gfx_rect(bx + _me_w - 1, _me_gy + _me_gh - h, bx + _me_w - 1, _me_gy + _me_gh - 1)
        end
    elif h > 0
        pen = tema.bien
        if v * 4 > demo_lineas_imagen * 3
            pen = tema.error
        elif v * 2 > demo_lineas_imagen
            pen = tema.cursor
        end
        gfx_pen(pen)
        gfx_rect(bx, _me_gy + _me_gh - h, bx + _me_w - 2, _me_gy + _me_gh - 1)
        if _me_w > 2
            gfx_pen(tema.fondo)
            gfx_rect(bx + _me_w - 1, _me_gy + _me_gh - h, bx + _me_w - 1, _me_gy + _me_gh - 1)
        end
    end
end

# Lo nuevo desde el último dibujo: el texto y las barras de las imágenes nuevas, de _me_indice a demo_indice (y la
# de demo_indice, la más vieja, que se ve como la siguiente en llenarse)
func medidor_nuevas()
    medidor_texto(true)
    i = _me_indice
    n = 0
    while n < SYNC_ANILLO
        medidor_barra(i)
        if i == demo_indice
            break
        end
        i = (i + 1) % SYNC_ANILLO
        n = n + 1
    end
    _me_indice = demo_indice
end

func medidor_parcial() -> Bool
    if not abierta or pagina != PAG_MEDIDOR or not _me_ok or not conectada() or mensaje != _mensaje_visto
        return false
    end
    if demo_indice == _me_indice
        return true
    end
    dibujar_solo(P_MEDIDOR, _me_x - zona_x, _me_y - zona_y, _me_ancho, _me_gy + _me_gh - _me_y)
    _me_indice = demo_indice
    return true
end

# Las partes del medidor (versión 2 del bloque de la demo): sus nombres, si cambiaron, y lo de cada imagen
func leer_partes_medidor()
    demo_version = peek_long(demo_mem + 4)
    if demo_version >= 3 and peek_long(demo_mem + 868) > 200
        demo_lineas_imagen = peek_long(demo_mem + 868)
    end
    if demo_version < 2
        demo_partes.clear()
        demo_anillo_partes.clear()
        return
    end
    n = peek_long(demo_mem + 160)
    if n < 0 or n > SYNC_PARTES
        n = 0
    end
    if n != demo_partes.length
        # (cambia el dibujo del medidor: la leyenda va en otra línea)
        _me_ok = false
        demo_partes.clear()
        k = 0
        while k < n
            d = demo_mem + 164 + k * 16
            t = ""
            j = 0
            while j < 15 and peek_byte(d + j) != 0
                t = t + str_char(peek_byte(d + j))
                j = j + 1
            end
            demo_partes.push(t)
            k = k + 1
        end
    end
    demo_anillo_partes.clear()
    if n == 0
        return
    end
    k = 0
    while k < SYNC_ANILLO * (SYNC_PARTES + 1)
        demo_anillo_partes.push(peek_word(demo_mem + 228 + k * 2))
        k = k + 1
    end
end

# El color de la parte j del medidor (0: la que no tiene nombre)
func pen_parte(j: Int) -> Int
    if j == 0
        return tema.tenue
    end
    var c: [Int] = [0x4C4, 0xE82, 0x48F, 0xC4C]
    return pen_rgb(c[(j - 1) % 4])
end

# La media de la parte j en el anillo (las imágenes medidas)
func media_parte(j: Int) -> Int
    n = 0
    suma = 0
    i = 0
    while i < SYNC_ANILLO and (i + 1) * (SYNC_PARTES + 1) <= demo_anillo_partes.length
        if i < demo_anillo.length and demo_anillo[i] > 0
            suma = suma + demo_anillo_partes[i * (SYNC_PARTES + 1) + j]
            n = n + 1
        end
        i = i + 1
    end
    if n == 0
        return 0
    end
    return suma / n
end

# Para la sonda: "partes n nombre:media ... otro:media"
func sonda_partes() -> String
    t = "medidor partes #{demo_partes.length} version #{demo_version}"
    if demo_partes.length > 0
        k = 0
        while k < demo_partes.length
            t = t + " " + demo_partes[k] + ":#{media_parte(k + 1)}"
            k = k + 1
        end
        t = t + " otro:#{media_parte(0)}"
    end
    return t
end

# --- Partes: la línea de tiempo de la demo ---

var pa_elegida: Int = 0
var pa_col: Int = 0              # 0 el nombre, 1 desde, 2 hasta
var pa_buffer: String = ""       # las cifras que se escriben en desde o hasta
var pa_nombrando: Bool = false   # n o r: se escribe el nombre en la lista
var pa_renombrando: Bool = false
var pa_nombre: String = ""
var _pa_x: Int = 0               # la geometría del último dibujo (para los clics)
var _pa_ancho: Int = 0
var _pa_by: Int = 0              # la barra de la línea de tiempo
var _pa_bh: Int = 0
var _pa_ly: Int = 0              # la primera fila de la lista
var _pa_fin: Int = 64            # la fila del final de la barra

func pen_pa(i: Int) -> Int
    var c: [Int] = [0x46A, 0xA64, 0x6A6, 0x96A, 0xAA4, 0x4AA]
    return pen_rgb(c[i % 6])
end

# Las filas que caben en la barra: hasta el final de la última parte, de la música si hay MOD, o 64 como poco
func pa_fin_barra() -> Int
    f = pa_fin()
    if mod_largo * 64 > f
        f = mod_largo * 64
    end
    if fila_ahora() + 1 > f
        f = fila_ahora() + 1
    end
    if f < 64
        f = 64
    end
    return f
end

func dibujar_partes(x: Int, y: Int, ancho: Int, alto: Int)
    _pa_x = x
    _pa_ancho = ancho
    fila = alto_letra + 2
    sin_sync = sy_ruta == "" and sync_pistas.length == 0 and sync_partes.length == 0
    if sin_sync
        texto(x, y, tr(107, "Las partes van en el .sync de la demo: ábrelo (Amiga-O, o desde Forja)."), tema.tenue)
    end
    # la línea de tiempo: una barra con una caja por parte y la fila que suena
    _pa_fin = pa_fin_barra()
    by = y + fila + 2
    bh = 2 * fila
    _pa_by = by
    _pa_bh = bh
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, by, x + ancho - 1, by + bh - 1)
    i = 0
    while i < sync_partes.length
        x1 = x + sync_partes_desde[i] * ancho / _pa_fin
        x2 = x + (sync_partes_hasta[i] + 1) * ancho / _pa_fin - 1
        if x2 < x1
            x2 = x1
        end
        gfx_pen(pen_pa(i))
        gfx_rect(x1, by, x2, by + bh - 1)
        if i == pa_elegida
            gfx_pen(tema.cursor)
            gfx_box(x1, by, x2, by + bh - 1)
        end
        n = sync_partes[i]
        while n.length > 0 and font_text_width(n) > x2 - x1 - 4
            n = n[0:n.length - 1]
        end
        if n != ""
            texto(x1 + 3, by + (bh - alto_letra) / 2, n, tema.texto)
        end
        i = i + 1
    end
    # una raya en cada patrón (64 filas) y su número debajo, si caben
    gfx_pen(tema.borde)
    gfx_box(x - 1, by - 1, x + ancho, by + bh)
    paso = 64
    while paso * ancho / _pa_fin < 6 * ancho_letra
        paso = paso * 2
    end
    f = 0
    while f <= _pa_fin
        tx = x + f * ancho / _pa_fin
        gfx_pen(tema.borde)
        gfx_rect(tx, by + bh, tx, by + bh + 2)
        if tx + 4 * ancho_letra <= x + ancho
            texto(tx + 1, by + bh + 2, "#{f}", tema.tenue)
        end
        f = f + paso
    end
    ahora = fila_ahora()
    if ahora >= 0
        ax = x + ahora * ancho / _pa_fin
        gfx_pen(tema.error)
        gfx_rect(ax, by - 2, ax + 1, by + bh + 1)
    end
    # arriba: la fila que suena y su parte; si se pisan, se dice
    t = ""
    if ahora >= 0
        k = sync_parte_de(ahora)
        t = hueco(tr(108, "suena la fila %1"), "#{ahora}")
        if k >= 0
            t = t + ": " + sync_partes[k]
        end
    end
    pisan = pa_se_pisan()
    if pisan != ""
        texto(x, y, hueco(tr(109, "Se pisan: %1"), pisan), tema.error)
    elif t != "" and not sin_sync
        texto(x, y, t, tema.texto)
    end
    # la lista: nombre, desde, hasta y cuántas filas
    ly = by + bh + fila + 6
    _pa_ly = ly
    texto(x, ly, tr(110, "parte"), tema.tenue)
    texto(x + 18 * ancho_letra, ly, tr(111, "desde"), tema.tenue)
    texto(x + 26 * ancho_letra, ly, tr(112, "hasta"), tema.tenue)
    texto(x + 34 * ancho_letra, ly, tr(113, "filas"), tema.tenue)
    ly = ly + fila
    i = 0
    n = sync_partes.length
    if pa_nombrando and not pa_renombrando
        n = n + 1
    end
    while i < n and ly + alto_letra <= y + alto
        if i == pa_elegida
            gfx_pen(tema.seleccion)
            gfx_rect(x - 2, ly - 1, x + 40 * ancho_letra, ly + alto_letra)
        end
        if i >= sync_partes.length
            texto(x, ly, pa_nombre + "_", tema.cursor)
        else
            gfx_pen(pen_pa(i))
            gfx_rect(x, ly + 1, x + ancho_letra - 2, ly + alto_letra - 2)
            nombre = sync_partes[i]
            d = "#{sync_partes_desde[i]}"
            h = "#{sync_partes_hasta[i]}"
            if i == pa_elegida and pa_nombrando and pa_renombrando
                nombre = pa_nombre + "_"
            elif i == pa_elegida and pa_buffer != "" and pa_col == 1
                d = pa_buffer + "_"
            elif i == pa_elegida and pa_buffer != "" and pa_col == 2
                h = pa_buffer + "_"
            end
            cols = [nombre, d, h]
            xs = [x + ancho_letra + 4, x + 18 * ancho_letra, x + 26 * ancho_letra]
            c = 0
            while c < 3
                pen = tema.texto
                if i == pa_elegida and c == pa_col
                    pen = tema.cursor
                end
                texto(xs[c], ly, cols[c], pen)
                c = c + 1
            end
            texto(x + 34 * ancho_letra, ly, "#{sync_partes_hasta[i] - sync_partes_desde[i] + 1}", tema.tenue)
        end
        ly = ly + fila
        i = i + 1
    end
end

# Un cambio en las partes: con deshacer (el de las pistas: van juntas en el .sync)
func pa_cambiar_limite(i: Int, col: Int, v: Int)
    if i < 0 or i >= sync_partes.length or v < 0
        return
    end
    para_deshacer()
    if col == 1
        sync_partes_desde[i] = v
        if sync_partes_hasta[i] < v
            sync_partes_hasta[i] = v
        end
    else
        sync_partes_hasta[i] = v
        if sync_partes_desde[i] > v
            sync_partes_desde[i] = v
        end
    end
    pa_elegida = pa_ordenar(i)
    cambiado()
end

func partes_tecla(k: Int, q: Int, ch: String)
    if pa_nombrando
        partes_nombre_tecla(k, ch)
        return
    end
    hay = pa_elegida >= 0 and pa_elegida < sync_partes.length
    if k == K_ARRIBA or k == K_ABAJO
        if k == K_ARRIBA
            pa_elegida = pa_elegida - 1
        else
            pa_elegida = pa_elegida + 1
        end
        if pa_elegida >= sync_partes.length
            pa_elegida = sync_partes.length - 1
        end
        if pa_elegida < 0
            pa_elegida = 0
        end
        pa_buffer = ""
    elif k == K_IZQUIERDA and pa_col > 0
        pa_col = pa_col - 1
        pa_buffer = ""
    elif k == K_DERECHA and pa_col < 2
        pa_col = pa_col + 1
        pa_buffer = ""
    elif k == K_ESC
        pa_buffer = ""
    elif ch != "" and str_find("0123456789", ch) >= 0 and hay and pa_col > 0
        pa_buffer = pa_buffer + ch
    elif k == K_RETROCESO and pa_buffer != ""
        pa_buffer = pa_buffer[0:pa_buffer.length - 1]
    elif (k == K_RETURN or k == K_INTRO) and pa_buffer != "" and hay
        pa_cambiar_limite(pa_elegida, pa_col, Int(pa_buffer))
        pa_buffer = ""
    elif (k == K_RETURN or k == K_INTRO) and hay and pa_col == 0
        pa_nombrando = true
        pa_renombrando = true
        pa_nombre = sync_partes[pa_elegida]
    elif (ch == "+" or ch == "-" or ch == ">" or ch == "<") and hay
        # el límite de la columna (o, en la del nombre, la parte entera)
        d = 1
        if ch == ">" or ch == "<"
            d = 16
        end
        if ch == "-" or ch == "<"
            d = 0 - d
        end
        if pa_col == 0
            if sync_partes_desde[pa_elegida] + d >= 0
                para_deshacer()
                sync_partes_desde[pa_elegida] = sync_partes_desde[pa_elegida] + d
                sync_partes_hasta[pa_elegida] = sync_partes_hasta[pa_elegida] + d
                pa_elegida = pa_ordenar(pa_elegida)
                cambiado()
            end
        elif pa_col == 1
            pa_cambiar_limite(pa_elegida, 1, sync_partes_desde[pa_elegida] + d)
        else
            pa_cambiar_limite(pa_elegida, 2, sync_partes_hasta[pa_elegida] + d)
        end
    elif ch == "n"
        pa_nombrando = true
        pa_renombrando = false
        pa_nombre = ""
        pa_elegida = sync_partes.length
    elif ch == "r" and hay
        pa_nombrando = true
        pa_renombrando = true
        pa_nombre = sync_partes[pa_elegida]
    elif (k == K_SUPR or (k == K_RETROCESO and pa_buffer == "")) and hay
        para_deshacer()
        n = sync_partes[pa_elegida]
        pa_quitar(pa_elegida)
        if pa_elegida >= sync_partes.length and pa_elegida > 0
            pa_elegida = pa_elegida - 1
        end
        cambiado()
        avisar(hueco(tr(114, "Parte %1 quitada (Amiga-Z la devuelve)."), n), 0)
    elif ch == "g" and hay
        # la demo (o la música) al principio de la parte
        f = sync_partes_desde[pa_elegida]
        if conectada()
            mandar_demo("IR #{f}")
        elif suena()
            music_seek(f / 64, f % 64)
        end
    elif ch == "c"
        partes_al_codigo()
        return
    elif ch == "l"
        partes_leer_codigo()
        return
    elif k == K_TAB
        if (q & Q_MAYUS) != 0
            sy_otro(-1)
        else
            sy_otro(1)
        end
    else
        return
    end
    redibujar()
end

func partes_nombre_tecla(k: Int, ch: String)
    if k == K_RETURN or k == K_INTRO
        pa_nombrando = false
        n = pa_limpiar(pa_nombre)
        if pa_renombrando
            if n != "" and pa_elegida < sync_partes.length and n != sync_partes[pa_elegida]
                if pa_buscar(n) >= 0
                    avisar(hueco(tr(115, "Ya hay una parte %1."), n), 1)
                else
                    para_deshacer()
                    sync_partes[pa_elegida] = n
                    cambiado()
                end
            end
        elif n != ""
            if pa_buscar(n) >= 0
                avisar(hueco(tr(115, "Ya hay una parte %1."), n), 1)
            else
                para_deshacer()
                pa_elegida = pa_nueva(n)
                cambiado()
            end
        end
        if pa_elegida >= sync_partes.length
            pa_elegida = sync_partes.length - 1
        end
        if pa_elegida < 0
            pa_elegida = 0
        end
    elif k == K_ESC
        pa_nombrando = false
        if pa_elegida >= sync_partes.length
            pa_elegida = sync_partes.length - 1
        end
        if pa_elegida < 0
            pa_elegida = 0
        end
    elif k == K_RETROCESO
        if pa_nombre != ""
            pa_nombre = pa_nombre[0:pa_nombre.length - 1]
        end
    elif ch != "" and ch != " " and str_code(ch, 0) > 32
        pa_nombre = pa_nombre + ch
    end
    redibujar()
end

# Un clic: en la barra elige la parte de esa fila; en la lista, esa parte (y la columna)
func partes_clic(mx: Int, my: Int)
    x = _pa_x - zona_x
    by = _pa_by - zona_y
    if my >= by and my < by + _pa_bh and _pa_ancho > 0
        f = (mx - x) * _pa_fin / _pa_ancho
        k = sync_parte_de(f)
        if k >= 0
            pa_elegida = k
            pa_buffer = ""
            redibujar()
        end
        return
    end
    ly = _pa_ly - zona_y + alto_letra + 2
    if my >= ly
        i = (my - ly) / (alto_letra + 2)
        if i >= 0 and i < sync_partes.length
            pa_elegida = i
            pa_buffer = ""
            c = 0
            if mx - x >= 26 * ancho_letra
                c = 2
            elif mx - x >= 18 * ancho_letra
                c = 1
            end
            pa_col = c
            redibujar()
        end
    end
end

# Pone el bloque de las partes en el fichero de delante de Forja: lo cambia si ya está; si no, en el cursor
func partes_al_codigo()
    if sync_partes.length == 0
        avisar(tr(116, "No hay partes: n hace una."), 1)
        return
    end
    a = str_split(forja_activo(), "\n")
    if forja_rc != 0 or a.length < 4 or a[3] != "texto"
        avisar(tr(117, "Abre en Forja el .dash de la demo."), 1)
        return
    end
    ruta = a[0]
    t = forja_texto("")
    b = pa_buscar_bloque(t)
    codigo = pa_codigo()
    if b[0] > 0 and ruta != ""
        forja_cambiar(ruta, b[0], b[1], codigo[0:codigo.length - 1])
        avisar(hueco(tr(118, "Partes cambiadas en %1."), nombre_de(ruta) + " (#{b[0]}-#{b[1]})"), 2)
    else
        forja_insertar(codigo)
        avisar(hueco(tr(119, "Partes metidas en el cursor de %1: llama a parte_cambio(sync_fila) en cada imagen."), a[1]), 2)
    end
end

# Lee las partes del bloque "# partes:" del fichero de delante (con deshacer)
func partes_leer_codigo()
    t = forja_texto("")
    if forja_rc != 0
        avisar(tr(38, "No hay un fichero delante en Forja."), 1)
        return
    end
    antes = sync_a_texto()
    if pa_leer_codigo(t)
        sy_deshacer.push(antes)
        sy_rehacer.clear()
        cambiado()
        pa_elegida = 0
        avisar(hueco(tr(120, "Leídas %1 partes del código."), "#{sync_partes.length}"), 2)
    else
        avisar(tr(121, "No hay un bloque \"# partes:\" en el fichero."), 1)
    end
    redibujar()
end

# Para la sonda: "partes n elegida col buffer [..] nombre [..] lista nombre:desde-hasta,..."
func partes_sonda() -> String
    t = "partes #{sync_partes.length} #{pa_elegida} #{pa_col} buffer [" + pa_buffer + "] nombre [" + pa_nombre + "] lista"
    i = 0
    while i < sync_partes.length
        t = t + " " + sync_partes[i] + ":#{sync_partes_desde[i]}-#{sync_partes_hasta[i]}"
        i = i + 1
    end
    # (dónde está la barra, desde la esquina de la zona, y su última fila: para los clics de la prueba)
    return t + " barra #{_pa_x - zona_x} #{_pa_by - zona_y} #{_pa_ancho} #{_pa_bh} #{_pa_fin}"
end

# --- La demo ---

func puerto_demo() -> Bool
    n = ports_read()
    i = 0
    while i < n
        if port_name(i) == "DEMOSYNC"
            return true
        end
        i = i + 1
    end
    return false
end

func conectar()
    r = rexx_send_wait("DEMOSYNC", "HOLA", 1000)
    if rexx_rc() != 0
        return
    end
    p = str_find(r, " ")
    dir = r
    fichero = ""
    if p > 0
        dir = r[0:p]
        fichero = r[p + 1:]
    end
    m = Int(dir)
    if m == 0 or peek_long(m) != SYNC_MAGIA
        return
    end
    demo_mem = m
    demo_fichero = fichero
    tocar(false)
    if fichero != "" and str_find(fichero, ":") > 0
        i = sy_buscar_ruta(fichero)
        if i < 0 and sy_ruta == "" and not sy_cambiado and sync_pistas.length == 0
            cargar_sync(fichero)
        elif i < 0
            # abierto, detrás de lo que se está mirando (Tab va a él)
            sy_abrir_detras(fichero)
        elif i == sy_actual and sy_cambiado
            # lo de Forja, sin guardar, a la demo
            if file_write_text("T:forja-demos.sync", sync_a_texto())
                mandar_demo("RECARGAR T:forja-demos.sync")
            end
        elif i != sy_actual and sy_ficheros[i].cambiado
            if file_write_text("T:forja-demos.sync", sy_ficheros[i].texto)
                mandar_demo("RECARGAR T:forja-demos.sync")
            end
        end
    end
    forja_aviso_tipo(hueco(tr(85, "Demos: la demo está conectada (%1)."), nombre_de(fichero)), 2)
    redibujar()
end

func desconectar()
    demo_mem = 0
    demo_anillo.clear()
    demo_partes.clear()
    demo_anillo_partes.clear()
    cu_vivo_lista.clear()
    cu_vivo_cuenta = 0
    forja_barra("")
    _barra_antes = ""
    forja_aviso(tr(50, "Demos: la demo ha acabado."))
    redibujar()
end

# Lo que cambió desde la última lectura, en la página que se ve: solo eso si se puede (tabla_parcial...), o el dibujo
# entero (como mucho 2,5 veces por segundo: con MUI 3.8 en una pantalla de tarjeta, uno entero tardaba casi un
# segundo en el emulador; si toca y no puede, queda pendiente para la siguiente lectura)
var _pendiente: Bool = false
func refrescar(cambio: Bool)
    if not abierta
        return
    end
    if cambio or _pendiente
        hecho = false
        if not _pendiente
            if pagina == PAG_SYNC
                hecho = tabla_parcial()
            elif pagina == PAG_MUSICA
                hecho = musica_parcial()
            elif pagina == PAG_MEDIDOR
                hecho = medidor_parcial()
            elif pagina == PAG_COPPER
                # (la vista del copper no cambia con la fila: solo el estado de la demo, arriba)
                hecho = true
            end
        end
        if not hecho
            if tics - _tic_dibujo >= 2
                _tic_dibujo = tics
                _pendiente = false
                redibujar()
                return
            end
            _pendiente = true
        end
    end
    # el estado de la demo, arriba a la derecha: con la fila (si no, decía otra que la tabla)
    if conectada()
        e = "#{demo_fila} #{demo_lineas} #{demo_pausa}"
        if e != _estado_visto
            _estado_visto = e
            redibujar_estado()
        end
    end
end

var _estado_visto: String = ""

# Cada TIC_MS: lee la demo (o la busca), y la música propia
func tic()
    tics = tics + 1
    antes_fila = fila_ahora()
    antes_cursor = sy_fila
    antes_indice = demo_indice
    if conectada() and cu_vivo_cambio
        copper_a_la_demo()
    end
    if conectada()
        if (tics % 5 == 0 and not puerto_demo()) or peek_long(demo_mem) != SYNC_MAGIA
            desconectar()
            return
        end
        demo_fila = peek_long(demo_mem + 8)
        demo_fotos = peek_long(demo_mem + 12)
        demo_lineas = peek_long(demo_mem + 16)
        demo_pausa = peek_long(demo_mem + 20) != 0
        demo_perdidos = peek_long(demo_mem + 28)
        demo_indice = peek_long(demo_mem + 24)
        if pagina == PAG_MEDIDOR or demo_anillo.length == 0
            # el anillo, cada imagen en su sitio (n % 64; las que aún no se han medido, 0)
            demo_anillo.clear()
            k = 0
            while k < SYNC_ANILLO
                demo_anillo.push(peek_word(demo_mem + 32 + k * 2))
                k = k + 1
            end
            leer_partes_medidor()
        end
        if not demo_pausa or not _pausa_vista
            sy_fila = demo_fila
        end
        _pausa_vista = demo_pausa
        if tics % 5 == 0
            b = hueco2(tr(58, "demo: fila %1, %2 líneas"), "#{demo_fila}", "#{demo_lineas}")
            if b != _barra_antes
                _barra_antes = b
                forja_barra(b)
            end
        end
        cambio = fila_ahora() != antes_fila or sy_fila != antes_cursor
        if pagina == PAG_MEDIDOR
            cambio = demo_indice != antes_indice
        end
        refrescar(cambio)
    elif tics % 5 == 0 and puerto_demo()
        conectar()
    end
    if suena() and not conectada()
        mus_pos = music_pos()
        mus_fila = music_row()
        sy_fila = mus_pos * 64 + mus_fila
        refrescar(fila_ahora() != antes_fila)
    end
end

# --- Sucesos ---

func en_lienzo()
    mx = mui_canvas_mouse_x(lienzo)
    my = mui_canvas_mouse_y(lienzo)
    q = mui_canvas_qualifiers(lienzo)
    if mui_canvas_button(lienzo) == 1
        p = pestana_en(mx, my)
        if p >= 0
            ver(p)
        elif pagina == PAG_COPPER
            copper_clic(mx, my)
        elif pagina == PAG_PARTES
            partes_clic(mx, my)
        end
        return
    end
    k = mui_canvas_key(lienzo)
    if k < 0 or (q & Q_AMIGA) != 0
        return
    end
    ch = mui_canvas_char(lienzo)
    mensaje = ""
    if pagina == PAG_COPPER
        copper_tecla(k, q, ch)
    elif pagina == PAG_MUSICA
        musica_tecla(k, q, ch)
    elif pagina == PAG_SYNC
        sync_tecla(k, q, ch)
    elif pagina == PAG_PARTES
        partes_tecla(k, q, ch)
    end
end

func editar(ruta: String)
    l = str_lower(ruta)
    if str_ends(l, ".mod")
        cargar_mod(ruta)
    elif str_ends(l, ".sync")
        if cargar_sync(ruta)
            ver(PAG_SYNC)
        end
    end
end

func evento(ev: Int) -> Bool
    if ev == EV_LIENZO
        en_lienzo()
    elif ev == EV_ARRASTRE
        arrastres = arrastres + 1
        ultimo_arrastre = "#{mui_canvas_drag(lienzo)} #{mui_canvas_mouse_y(lienzo)} #{cu_arrastrando}"
        if pagina == PAG_COPPER
            copper_arrastrar(mui_canvas_mouse_y(lienzo), mui_canvas_drag(lienzo) == 2)
        end
    elif ev == EV_TIC
        if abierta
            tic()
            mui_timer(TIC_MS, EV_TIC)
        end
    elif ev >= EV_PAGINA and ev <= EV_PAGINA + 4
        ver(ev - EV_PAGINA)
    elif ev == EV_ABRIR
        if file_open_dialog("Abrir pistas o MOD", "#?.(sync|mod)")
            editar(file_fullpath())
        end
    elif ev == EV_GUARDAR
        guardar_sync(false)
    elif ev == EV_GUARDAR_COMO
        guardar_sync(true)
    elif ev == EV_EXPORTAR
        exportar()
    elif ev == EV_COMPILAR or ev == EV_EJECUTAR
        r = sy_ruta
        if r == ""
            r = mod_ruta
        end
        if not forja_compilar(r, ev == EV_EJECUTAR)
            avisar(hueco(tr(86, "Forja no encuentra el programa de %1."), nombre_de(r)), 1)
        end
    elif ev == EV_AL_CODIGO
        al_codigo()
    elif ev == EV_LEER_CODIGO
        leer_codigo()
    elif ev == EV_PROBAR
        probar()
    elif ev == EV_SALIR_FORJA
        forja_salir()
    elif ev == EV_FORJA
        forja_delante()
    elif ev == EV_DESHACER or ev == EV_REHACER
        # (las pistas y las partes van juntas en el .sync: el mismo deshacer)
        if pagina != PAG_PARTES
            ver(PAG_SYNC)
        end
        deshacer(ev == EV_REHACER)
    elif ev == EV_PISTA_NUEVA or ev == EV_PISTA_NOMBRE
        if ev == EV_PISTA_NUEVA or sy_pista < sync_pistas.length
            sy_nombrando = true
            sy_renombrando = ev == EV_PISTA_NOMBRE
            sy_nombre = ""
            if sy_renombrando
                sy_nombre = sync_pistas[sy_pista].nombre
            end
        end
        ver(PAG_SYNC)
    elif ev == EV_PISTA_QUITAR
        ver(PAG_SYNC)
        quitar_pista()
    elif ev == EV_PISTA_IZQUIERDA or ev == EV_PISTA_DERECHA
        ver(PAG_SYNC)
        mover_pista(ev == EV_PISTA_DERECHA)
    elif ev == EV_CERRAR_SYNC
        ver(PAG_SYNC)
        cerrar_sync()
    elif ev == EV_SYNC_SIGUIENTE
        ver(PAG_SYNC)
        sy_otro(1)
    elif ev == EV_CERRAR or ev == EV_VENTANA
        return cerrar_todos()
    end
    return false
end

func mediana(ls: [Int]) -> Int
    if ls.length == 0
        return 0
    end
    var c: [Int] = []
    for n in ls
        c.push(n)
    end
    i = 1
    while i < c.length
        k = c[i]
        j = i - 1
        while j >= 0 and c[j] > k
            c[j + 1] = c[j]
            j = j - 1
        end
        c[j + 1] = k
        i = i + 1
    end
    return c[c.length / 2]
end

# Cuántas imágenes medidas hay en el anillo (para la sonda): las de la demo, hasta 64
func muestras() -> Int
    if demo_fotos > SYNC_ANILLO
        return SYNC_ANILLO
    end
    return demo_fotos
end

func publicar_sonda()
    t = "pagina #{pagina}\n"
    t = t + "demo #{demo_mem != 0} fila #{demo_fila} lineas #{demo_lineas} muestras #{muestras()} pausa #{demo_pausa}\n"
    t = t + cu_sonda() + " vivo #{cu_vivo_envios} #{cu_vivo_sets} #{cu_vivo_cuenta}\n"
    t = t + sonda_partes() + "\n"
    t = t + partes_sonda() + "\n"
    t = t + "mod " + nombre_de(mod_ruta) + " suena #{suena()} pos #{mus_pos} fila #{mus_fila} largo #{mod_largo} patrones #{mod_patrones} celda " + mod_celda(mod_patron(0), 0, 0) + "\n"
    t = t + "sync " + nombre_de(sy_ruta) + " pistas #{sync_pistas.length} cursor #{sy_fila} #{sy_pista} cambiado #{sy_cambiado} buffer [" + sy_buffer + "] nombre [" + sy_nombre + "] abiertos #{sy_ficheros.length} #{sy_actual}\n"
    if sy_pista < sync_pistas.length
        p = sync_pistas[sy_pista]
        c = sync_clave_en(p, sy_fila)
        clave = "-"
        if c >= 0
            clave = sync_texto(p.valores[c]) + " " + sync_tipo_nombre(p.tipos[c])
        end
        t = t + "pista " + p.nombre + " claves #{p.filas.length} aqui " + clave + " valor " + sync_texto(sync_valor_en(p, sy_fila, Fixed(0))) + "\n"
    end
    t = t + "mensaje " + mensaje + "\n"
    # (el puntero, desde la esquina de la zona: la prueba sabe así dónde está la zona en la ventana)
    t = t + "puntero #{mui_canvas_pointer_x(lienzo)} #{mui_canvas_pointer_y(lienzo)} arrastres #{arrastres} " + ultimo_arrastre + "\n"
    t = t + "dibujo #{ms_dibujo} pens #{_pens_lista.length} enteros #{dibujos} partes #{parciales} parte #{mediana(_ultimos)}\n"
    if t != sonda_antes
        sonda_antes = t
        n = 0
        while not file_write_text("RAM:forja-demos-sonda.txt", t) and n < 20
            time_delay(1)
            n = n + 1
        end
    end
    if abierta
        g = "#{zona_x} #{zona_y} #{zona_ancho} #{zona_alto}"
        if g != sonda_geo
            sonda_geo = g
            env_set("FORJA_DEMOS_LIENZO", g, false)
            env_set("FORJA_DEMOS_LETRA", "#{alto_letra}", false)
        end
    end
end

func suceso() -> Bool
    if forja_tipo == "SALIR"
        salir_por_forja = true
        return true
    elif forja_tipo == "EDITAR"
        editar(forja_dato)
    elif forja_tipo == "MENU"
        if forja_dato == "copper"
            ver(PAG_COPPER)
        elif forja_dato == "musica"
            ver(PAG_MUSICA)
        elif forja_dato == "medidor"
            ver(PAG_MEDIDOR)
        else
            ver(PAG_SYNC)
        end
    elif forja_tipo == "GUARDAR"
        guardar_todos()
    end
    return false
end

Main
    sonda = env_get("FORJA_SONDA") != ""
    if not forja_empezar("Demos")
        Print tr(52, "Demos es una extensión de Forja: la arranca Forja.")
    else
        app = mui_app_begin("ForjaDemos", "FORJADEMOS")
        if app == 0
            forja_aviso_tipo(tr(51, "Demos: no se puede abrir MUI."), 1)
        else
            cu_nuevo()
            var d1: [String] = []
            var d2: [String] = []
            sy_ficheros.push(SyncFichero("", "", false, 0, 0, 0, d1, d2))
            sy_actual = 0
            hacer_ventana()
            salir = false
            ev = 0
            while not salir
                if ev != 0 and evento(ev)
                    salir = true
                end
                s = forja_suceso(-1)
                while s != "" and not salir
                    if suceso()
                        salir = true
                    end
                    s = forja_suceso(-1)
                end
                if salir
                    break
                end
                decir_sin_guardar()
                decir_abiertos(false)
                if sonda
                    publicar_sonda()
                end
                ev = mui_wait_event_signals(forja_senal())
                if ev == -1
                    ev = EV_VENTANA
                end
            end
            tocar(false)
            if conectada()
                forja_barra("")
            end
            if not salir_por_forja
                # (se cerró su ventana: ya no tiene nada abierto)
                decir_abiertos(true)
            end
            if sonda
                file_write_text("RAM:forja-demos-sonda.txt", "acabada\n")
            end
            soltar_pens()
            mui_app_end()
        end
        forja_acabar()
    end
end
