# El juego del vídeo: carga (de su cajón: PROGDIR:) el mapa que se pinta en Forja (nivel.fmap) con su tileset, lo pinta entero y pone el
# muñeco del editor de sprites (muneco.iff) donde está el objeto "jugador". El muñeco anda solo: cae hasta lo sólido de
# la capa de choques, salta cuando tiene una pared delante y vuelve atrás al llegar al borde. Un clic lo acaba.

const T = 16                 # el lado de un tile

var mapa_x: Int = 0          # la esquina del mapa en la pantalla
var mapa_y: Int = 0
var choques: Int = -1        # la capa de choques

# Si la celda del píxel px, py del mapa es sólida (fuera del mapa, también)
func solido(px: Int, py: Int) -> Bool
    if px < 0 or py < 0 or px >= tilemap_width(0) * T
        return true
    end
    if choques < 0
        return false
    end
    v = tilemap_get(0, choques, px / T, py / T)
    return v == 1 or v == 2
end

# El trozo de mapa bajo un rectángulo de píxeles del mapa: todas las capas de tiles, otra vez. Se pinta con su
# esquina en ox, oy (en la pantalla, o en el bitmap aparte del muñeco)
func repintar_en(px: Int, py: Int, an: Int, al: Int, ox: Int, oy: Int)
    c0 = px / T
    f0 = py / T
    c1 = (px + an - 1) / T
    f1 = (py + al - 1) / T
    if c0 < 0
        c0 = 0
    end
    if f0 < 0
        f0 = 0
    end
    gfx_pen(0)
    gfx_rect(ox + c0 * T, oy + f0 * T, ox + (c1 + 1) * T - 1, oy + (f1 + 1) * T - 1)
    primera = true
    l = 0
    while l < tilemap_layers(0)
        if tilemap_layer_type(0, l) == 0
            if primera
                tilemap_draw(0, l, 1, c0, f0, c1 - c0 + 1, f1 - f0 + 1, ox + c0 * T, oy + f0 * T)
            else
                tilemap_draw_masked(0, l, 1, c0, f0, c1 - c0 + 1, f1 - f0 + 1, ox + c0 * T, oy + f0 * T)
            end
            primera = false
        end
        l = l + 1
    end
end

func repintar(px: Int, py: Int, an: Int, al: Int)
    repintar_en(px, py, an, al, mapa_x, mapa_y)
end

# El trozo de mapa donde estaba y donde está el muñeco, con el muñeco encima, compuesto en el bitmap 3 y copiado a
# la pantalla de una vez: sin parpadeo (borrar y pegar en la pantalla deja ver el fondo sin el muñeco)
func mover_muneco(ax: Int, ay: Int, x: Int, y: Int, w: Int, h: Int, fotograma: Int)
    x0 = ax
    if x < x0
        x0 = x
    end
    y0 = ay
    if y < y0
        y0 = y
    end
    c0 = x0 / T
    f0 = y0 / T
    if c0 < 0
        c0 = 0
    end
    if f0 < 0
        f0 = 0
    end
    ox = -c0 * T
    oy = -f0 * T
    bitmap_draw_to(3)
    repintar_en(c0 * T, f0 * T, 96, 96, ox, oy)
    bob_paste(2, fotograma, ox + x, oy + y)
    bitmap_draw_screen()
    bitmap_blit(3, 0, 0, 96, 96, mapa_x + c0 * T, mapa_y + f0 * T)
end

Main
    if not tilemap_load(0, "PROGDIR:nivel.fmap")
        Print "No se puede cargar nivel.fmap"
    elif not bob_load(1, "PROGDIR:" + tilemap_tileset(0))
        Print "No se puede cargar el tileset"
    elif not bob_load(2, "PROGDIR:muneco.iff")
        Print "No se puede cargar muneco.iff"
    elif not screen_open(8, "Juego")
        Print "No se abre la pantalla"
    elif not bitmap_create(3, 96, 96, 8)
        Print "No hay memoria"
    else
        bob_load_colors("PROGDIR:" + tilemap_tileset(0), 0)
        bob_load_colors("PROGDIR:muneco.iff", 16)
        l = 0
        while l < tilemap_layers(0)
            if tilemap_layer_type(0, l) == 1
                choques = l
            end
            l = l + 1
        end
        mapa_x = (screen_width() - tilemap_width(0) * T) / 2
        mapa_y = (screen_height() - tilemap_height(0) * T) / 2
        gfx_pen(0)
        gfx_rect(0, 0, screen_width() - 1, screen_height() - 1)
        repintar(0, 0, tilemap_width(0) * T, tilemap_height(0) * T)
        # el muñeco, donde está el objeto "jugador" (si no hay, arriba a la izquierda)
        x = T
        y = 0
        o = tilemap_object_find(0, "jugador", 0)
        if o < 0
            o = tilemap_object_find(0, "player", 0)
        end
        if o >= 0
            x = tilemap_object_x(0, o)
            y = tilemap_object_y(0, o)
        end
        w = bob_width(2)
        h = bob_height(2)
        vx = 2
        vy = 0
        paso = 0
        while not mouse_button(0)
            ax = x
            ay = y
            # cae hasta lo sólido; de pie, salta si tiene una pared delante
            vy = vy + 1
            if vy > 8
                vy = 8
            end
            ny = y + vy
            if vy > 0 and (solido(x + 4, ny + h) or solido(x + w - 5, ny + h))
                ny = ((ny + h) / T) * T - h
                vy = 0
                delante = x + w + 1
                if vx < 0
                    delante = x - 2
                end
                if solido(delante, y + h - 4)
                    vy = -10
                end
            end
            if vy < 0 and solido(x + w / 2, ny)
                vy = 0
                ny = y
            end
            y = ny
            # en los bordes del mapa da la vuelta; contra una pared espera (en el suelo ya ha saltado)
            nx = x + vx
            if nx < 0 or nx + w > tilemap_width(0) * T
                vx = -vx
                nx = x
            elif vx > 0 and solido(nx + w - 1, y + h - 6)
                nx = x
            elif vx < 0 and solido(nx, y + h - 6)
                nx = x
            end
            x = nx
            if y > tilemap_height(0) * T
                y = 0
            end
            paso = paso + 1
            wait_vblank()
            mover_muneco(ax, ay, x, y, w, h, (paso / 8) % bob_frames(2))
        end
        bitmap_free(3)
        screen_close()
    end
end
