# forja.dash: para escribir extensiones de Forja en Dash. La API entera está en docs/EXTENSIONES.md de Forja.
#
#   import "lib/forja.dash"
#
#   Main
#       if not forja_empezar("Contar")
#           Print "Es una extensión de Forja: la arranca Forja."
#       else
#           while forja_suceso(0) != "SALIR"     # espera sin gastar nada hasta el siguiente
#               if forja_tipo == "MENU"
#                   forja_aviso("Me han elegido: " + forja_dato)
#               end
#           end
#           forja_acabar()
#       end
#   end
#
# Con ventanas MUI: mui_wait_event_signals(forja_senal()) da 0 cuando hay sucesos; se leen con forja_suceso(-1), que
# no espera.
#
# Cómo va: Forja no espera nunca a una extensión. Le guarda los sucesos y le avisa escribiendo
# ENV:Forja/Avisos/<nombre>, que esta vigila (file_notify); entonces los recoge con SUCESOS. Las órdenes a Forja sí
# esperan su respuesta (rexx_send), y Forja contesta enseguida. El puerto FORJAEXT.<NOMBRE> le dice a Forja que la
# extensión sigue viva; se cierra solo al acabar, también si el programa falla.

var forja_puerto: String = "FORJA.1"
var forja_ext: String = ""        # su nombre: el de su cajón en Extensiones/
var forja_tipo: String = ""       # el último suceso: MENU, EDITAR, ABIERTO, GUARDADO, CERRADO, ACTIVO, ZONA, TECLA...
var forja_dato: String = ""       # lo que lo acompaña: la orden del menú, la ruta del fichero...
var forja_version: String = ""    # la de Forja (de HOLA)
var forja_rc: Int = 0             # el RC de la última orden: 0 bien, 5 o 10 si Forja no pudo, -1 si Forja no está
var _forja_cola: [String] = []
var _forja_vigilado: Int = 0
var _forja_hay: Bool = true       # recoger los sucesos sin esperar al aviso (al empezar)

# Empieza: lee de los argumentos el puerto de Forja y su nombre (los pone Forja al arrancarla; sin ellos, FORJA.1 y
# nombre), abre su puerto y saluda. false si Forja no está o la extensión ya estaba en marcha.
func forja_empezar(nombre: String) -> Bool
    forja_ext = nombre
    if arg_count() >= 1
        forja_puerto = arg(0)
    end
    if arg_count() >= 2
        forja_ext = arg(1)
    end
    # que no le quite tiempo a Forja (se puede subir con task_priority)
    task_priority(-1)
    # (si la de antes aún se está yendo, se espera un poco a que suelte el puerto)
    n = 0
    while not rexx_port("FORJAEXT." + str_upper(forja_ext))
        n = n + 1
        if n > 15
            return false
        end
        time_delay(10)
    end
    dir_create("ENV:Forja")
    dir_create("ENV:Forja/Avisos")
    _forja_vigilado = file_notify("ENV:Forja/Avisos/" + forja_ext)
    r = forja_orden("HOLA " + forja_ext)
    if forja_rc != 0
        return false
    end
    p = str_find(r, " ")
    if p >= 0
        forja_version = r[p + 1:]
    end
    return true
end

# Se despide: Forja quita sus marcas y su texto de la barra. Tras SALIR no hace falta (y Forja quizá ya no atiende)
func forja_acabar()
    if forja_tipo != "SALIR"
        forja_orden("ADIOS " + forja_ext)
    end
end

# La señal del aviso de Forja, para mui_wait_event_signals
func forja_senal() -> Int
    return file_notify_signal()
end

# El siguiente suceso ("MENU fecha", "GUARDADO Work:a/b.dash"...; también en forja_tipo y forja_dato). Si no hay,
# espera hasta ms milisegundos (0: sin límite; -1: no espera) y da "". "SALIR" si Forja se cierra, si ya no está o
# con Ctrl-C: entonces la extensión acaba.
func forja_suceso(ms: Int) -> String
    if _forja_cola.length == 0
        if _forja_hay or (_forja_vigilado > 0 and file_changed(_forja_vigilado))
            _forja_recoger()
        end
    end
    while _forja_cola.length == 0 and ms >= 0
        espera = ms
        if espera == 0
            espera = 3600000
        end
        if _forja_vigilado == 0 and espera > 500
            espera = 500
        end
        r = cx_wait(espera)
        if r == -1
            _forja_cola.push("SALIR")
        elif _forja_vigilado > 0 and file_changed(_forja_vigilado)
            _forja_recoger()
        elif _forja_vigilado == 0
            # sin el aviso (no se pudo vigilar el fichero): se pregunta cada medio segundo
            _forja_recoger()
        end
        if _forja_cola.length == 0 and ms > 0
            break
        end
    end
    if _forja_cola.length == 0
        forja_tipo = ""
        forja_dato = ""
        return ""
    end
    s = _forja_cola[0]
    _forja_cola.remove(0)
    p = str_find(s, " ")
    if p < 0
        forja_tipo = s
        forja_dato = ""
    else
        forja_tipo = s[0:p]
        forja_dato = s[p + 1:]
    end
    return s
end

func _forja_recoger()
    _forja_hay = false
    t = forja_orden("SUCESOS " + forja_ext)
    if forja_rc == -1
        _forja_cola.push("SALIR")
        return
    end
    for l in str_split(t, "\n")
        if l != ""
            _forja_cola.push(l)
        end
    end
end

# Una orden cualquiera a Forja (docs/EXTENSIONES.md): su respuesta; el RC en forja_rc
func forja_orden(orden: String) -> String
    r = rexx_send(forja_puerto, orden)
    forja_rc = rexx_rc()
    return r
end

# Varias órdenes de una línea en un solo viaje: sus respuestas, en el mismo orden
func forja_lote(ordenes: [String]) -> [String]
    t = "LOTE"
    for o in ordenes
        t = t + "\n" + o
    end
    r = forja_orden(t)
    return str_split(r, str_char(30))
end

# --- Leer ---

# El fichero activo: ruta ("" si no se ha guardado), nombre, cambiado (0/1), tipo (texto, dashui, sprite, mapa) y
# líneas, una por línea; "" si no hay ninguno
func forja_activo() -> String
    return forja_orden("ACTIVO")
end

# La ruta del fichero activo ("" sin guardar o sin ninguno)
func forja_fichero() -> String
    return str_split(forja_activo(), "\n")[0]
end

# Todo el texto del fichero activo (o del que se diga, si está abierto: ruta "")
func forja_texto(ruta: String) -> String
    if ruta == ""
        return forja_orden("TEXTO")
    end
    return forja_orden("TEXTO \"" + ruta + "\"")
end

# Las líneas desde..hasta (desde 1) del fichero activo
func forja_lineas(desde: Int, hasta: Int) -> String
    return forja_orden("LINEAS #{desde} #{hasta}")
end

func forja_linea(n: Int) -> String
    return forja_orden("LINEA #{n}")
end

# El cursor: forja_cursor_linea y forja_cursor_columna (desde 1)
var forja_cursor_linea: Int = 0
var forja_cursor_columna: Int = 0

func forja_cursor() -> Bool
    r = str_split(forja_orden("CURSOR"), " ")
    if forja_rc != 0 or r.length < 2
        return false
    end
    forja_cursor_linea = Int(r[0])
    forja_cursor_columna = Int(r[1])
    return true
end

# Lo elegido, tal cual ("" si nada)
func forja_seleccion() -> String
    r = forja_orden("ELEGIDO")
    p = str_find(r, "\n")
    if p < 0
        return ""
    end
    return r[p + 1:]
end

# El cajón del proyecto y sus ficheros (los cajones acaban en "/"): el primero es el cajón
func forja_proyecto() -> [String]
    var r: [String] = []
    for l in str_split(forja_orden("PROYECTO"), "\n")
        if l != "" or r.length == 0
            r.push(l)
        end
    end
    return r
end

# --- Escribir (todo con deshacer en Forja) ---

# En el cursor, en lugar de lo elegido
func forja_insertar(texto: String) -> Bool
    forja_orden("INSERTAR " + texto)
    return forja_rc == 0
end

# El texto entero del fichero activo
func forja_escribir(texto: String) -> Bool
    forja_orden("ESCRIBIR " + texto)
    return forja_rc == 0
end

# Las líneas desde..hasta del fichero ruta (hasta = desde - 1: mete texto antes de la línea desde)
func forja_cambiar(ruta: String, desde: Int, hasta: Int, texto: String) -> Bool
    forja_orden("CAMBIAR \"" + ruta + "\" #{desde} #{hasta} \"" + texto + "\"")
    return forja_rc == 0
end

func forja_ir(linea: Int, columna: Int)
    forja_orden("CURSOR #{linea} #{columna}")
end

func forja_elegir(l1: Int, c1: Int, l2: Int, c2: Int)
    forja_orden("ELEGIR #{l1} #{c1} #{l2} #{c2}")
end

func forja_abrir(ruta: String, linea: Int) -> Bool
    forja_orden("ABRIR \"" + ruta + "\" #{linea}")
    return forja_rc == 0
end

# --- La ventana de Forja ---

# Una línea en la salida: tipo 0 normal, 1 error, 2 bien
func forja_aviso_tipo(texto: String, tipo: Int)
    forja_orden("AVISO #{tipo} " + texto)
end

func forja_aviso(texto: String)
    forja_aviso_tipo(texto, 0)
end

# Su texto en la barra (a la derecha del título de la salida); "" lo quita
func forja_barra(texto: String)
    forja_orden("BARRA " + forja_ext + " " + texto)
end

# Sus marcas en el margen de un fichero: líneas (desde 1) y un símbolo cada una (+ añadida, - quitada, ~ cambiada,
# ! error; con otros, el color del texto). Sustituyen las suyas de ese fichero; sin líneas, las quita.
func forja_marcas(ruta: String, lineas: [Int], simbolos: [String])
    t = "MARCAS " + forja_ext + " \"" + ruta + "\""
    i = 0
    while i < lineas.length
        t = t + "\n#{lineas[i]} " + simbolos[i]
        i = i + 1
    end
    forja_orden(t)
end

# Sus letras en el panel del proyecto (rutas enteras): sustituyen todas las suyas
func forja_marcas_proyecto(rutas: [String], letras: [String])
    t = "MARCASPROYECTO " + forja_ext
    i = 0
    while i < rutas.length
        t = t + "\n" + letras[i] + " " + rutas[i]
        i = i + 1
    end
    forja_orden(t)
end

# Una opción más en su menú (el propio, si el manifiesto dice submenu; si no, en Extensiones) ("ctrl alt d", "f3"...
# o "" sin tecla): elegirla da MENU orden
func forja_menu(titulo: String, tecla: String, orden: String) -> Bool
    forja_orden("MENU " + forja_ext + " " + titulo + "|" + tecla + "|" + orden)
    return forja_rc == 0
end

# Su zona en la barra de botones, a la izquierda de Inferencia: un icono (uno de Forja, como "rama", o uno propio: 12
# filas de 12 separadas por "/", con "#" los píxeles), un texto y un detalle en otro color; si no cabe el detalle, el
# corto. Un clic en ella da el suceso ZONA. Con texto y detalle vacíos, la quita.
func forja_zona(icono: String, texto: String, detalle: String, corto: String)
    forja_orden("ZONA " + forja_ext + " " + icono + "|" + texto + "|" + detalle + "|" + corto)
end

# Una pestaña de solo lectura (o la suya de ese nombre, otra vez llena), delante: sus líneas y un color por línea (un
# carácter cada una: + verde, - rojo, @ azul, # gris, ! amarillo; otro, el del texto). Las teclas que se pulsan en ella
# (salvo las flechas y Esc) llegan como el suceso TECLA tecla línea nombre.
func forja_vista(nombre: String, lineas: [String], colores: String) -> Bool
    t = "VISTA " + forja_ext + " \"" + nombre + "\""
    i = 0
    while i < lineas.length
        c = " "
        if i < colores.length
            c = colores[i:i + 1]
        end
        t = t + "\n" + c + lineas[i]
        i = i + 1
    end
    forja_orden(t)
    return forja_rc == 0
end

# Cierra su pestaña de solo lectura de ese nombre (false si no la había)
func forja_cerrar_vista(nombre: String) -> Bool
    forja_orden("VISTA " + forja_ext + " \"" + nombre + "\"")
    return forja_rc == 0
end

# Una sugerencia en gris en el cursor del fichero activo (el copiloto): solo si el cursor está en esa línea y columna
# (desde 1), sin nada elegido, y el texto sigue en esa versión (forja_version_texto); si no, false. Puede tener varias
# líneas ("\n") y el cursor puede estar en medio de una (desde la API 6; antes, una línea al final). Tab la mete; se va
# al escribir o al mover el cursor. Texto "": quita la suya.
func forja_sugerencia(linea: Int, columna: Int, version: Int, texto: String) -> Bool
    if texto == ""
        forja_orden("SUGERENCIA " + forja_ext)
    else
        forja_orden("SUGERENCIA " + forja_ext + " #{linea} #{columna} #{version}\n" + texto)
    end
    return forja_rc == 0
end

# Sus rayas en el margen de un fichero, pegadas al texto: líneas (desde 1) y sus símbolos (+ añadida, ~ cambiada,
# - quitadas encima, _ quitadas debajo; "~-" las dos). Sustituyen las suyas de ese fichero; sin líneas, las quita.
# version: la del texto del que salen (forja_version_texto; -1 sin mirarla): si el texto ya cambió, Forja no las pone
# (forja_rc 5).
func forja_rayas(ruta: String, lineas: [Int], simbolos: [String], version: Int) -> Bool
    t = "RAYAS " + forja_ext + " \"" + ruta + "\""
    if version >= 0
        t = t + " #{version}"
    end
    i = 0
    while i < lineas.length
        t = t + "\n#{lineas[i]} " + simbolos[i]
        i = i + 1
    end
    forja_orden(t)
    return forja_rc == 0
end

# El texto de un fichero abierto como se guardaría (en UTF-8 si lo estaba; ruta "": el activo)
func forja_texto_disco(ruta: String) -> String
    if ruta == ""
        return forja_orden("TEXTODISCO")
    end
    return forja_orden("TEXTODISCO \"" + ruta + "\"")
end

# Cuántos cambios lleva el texto de un fichero abierto (sube con cada uno); -1 si no está abierto
func forja_version_texto(ruta: String) -> Int
    r = forja_orden("VERSION \"" + ruta + "\"")
    if forja_rc != 0
        return -1
    end
    return Int(r)
end

# --- Editores de otros tipos de fichero (tipos = y nuevo = en el manifiesto: Sprites, Mapas) ---

# Guardó un fichero suyo: Forja lo dice en la salida, lo cuenta a las demás extensiones (GUARDADO) y, si es del cajón
# del proyecto, lee otra vez el panel
func forja_guardado(ruta: String)
    forja_orden("GUARDADO " + forja_ext + " \"" + ruta + "\"")
end

# Sus ficheros con cambios sin guardar (los nombres; [] ninguno): Forja pregunta por ellos al salir y, si se elige
# Guardar, le manda el suceso GUARDAR y espera a que esta lista quede vacía (20 s como mucho)
func forja_sin_guardar(nombres: [String])
    t = "SINGUARDAR " + forja_ext
    for n in nombres
        t = t + "\n" + n
    end
    forja_orden(t)
end

# Sus ficheros abiertos (la ruta entera; [] ninguno): Forja los guarda en su sesión y, la próxima vez, los vuelve a
# abrir (con EDITAR, como al abrirlos desde Forja). Se dice cuando cambian (abrir, cerrar, guardar como).
func forja_editando(rutas: [String])
    t = "EDITANDO " + forja_ext
    for r in rutas
        t = t + "\n" + r
    end
    forja_orden(t)
end

# Que Forja se cierre, como con Amiga-Q en su ventana (para Amiga-Q en la de la extensión): Forja pregunta por lo que
# haya sin guardar (también lo de las extensiones, SINGUARDAR) y, si sale, manda SALIR a todas
func forja_salir()
    forja_orden("SALIR")
end

# Compilar (o compilar y ejecutar) el programa de un fichero que no es de Dash (un sprite, un mapa): el .dash con
# Main abierto de su cajón o el de encima, o su main.dash, o el del proyecto. ruta "": el fichero activo de Forja.
# forja_rc: 0 bien, 5 si Forja ya compila o ejecuta, 10 si no hay programa
func forja_compilar(ruta: String, ejecutar: Bool) -> Bool
    orden = "COMPILAR"
    if ejecutar
        orden = "EJECUTAR"
    end
    if ruta != ""
        orden = orden + " \"" + ruta + "\""
    end
    forja_orden(orden)
    return forja_rc == 0
end

# La ventana de Forja delante y activa
func forja_delante()
    forja_orden("DELANTE")
end

# --- Paneles dentro de la ventana de Forja (API 6) ---
# Una pestaña más junto al panel del proyecto (lado "izquierda") o junto a la salida ("abajo"), que pinta Forja: líneas
# con un color (los de forja_vista), una fila elegida, botones abajo y una entrada de texto si se pide. Lo que hace el
# usuario llega como sucesos: PANEL "título|línea|columna|otra_vez" (un clic en una línea; otra_vez 1 si ya era la
# elegida), PANELTECLA "título|tecla|línea", PANELBOTON "título|orden" y PANELTEXTO "título|texto" (Return en la
# entrada). forja_campo(n) da cada parte.

# Lo pone o lo vuelve a llenar (la fila elegida y lo desplazado se quedan). false si no caben más (8 entre todas)
func forja_panel(titulo: String, lado: String, lineas: [String], colores: String) -> Bool
    t = "PANEL " + forja_ext + " \"" + titulo + "\" " + lado
    i = 0
    while i < lineas.length
        c = " "
        if i < colores.length
            c = colores[i:i + 1]
        end
        t = t + "\n" + c + lineas[i]
        i = i + 1
    end
    forja_orden(t)
    return forja_rc == 0
end

func forja_panel_cerrar(titulo: String) -> Bool
    forja_orden("PANELCERRAR " + forja_ext + " \"" + titulo + "\"")
    return forja_rc == 0
end

# Delante en su lado; con entrada, su entrada toma el teclado
func forja_panel_ver(titulo: String, entrada: Bool) -> Bool
    t = "PANELVER " + forja_ext + " \"" + titulo + "\""
    if entrada
        t = t + " entrada"
    end
    forja_orden(t)
    return forja_rc == 0
end

# Sus botones, abajo: "texto|orden" cada uno ([]: ninguno)
func forja_panel_botones(titulo: String, botones: [String]) -> Bool
    t = "PANELBOTONES " + forja_ext + " \"" + titulo + "\""
    for b in botones
        t = t + "\n" + b
    end
    forja_orden(t)
    return forja_rc == 0
end

# Una entrada de una línea sobre los botones, con su etiqueta ("": sin entrada). El texto que tiene se queda
func forja_panel_entrada(titulo: String, etiqueta: String) -> Bool
    forja_orden("PANELENTRADA " + forja_ext + " \"" + titulo + "\" " + etiqueta)
    return forja_rc == 0
end

# Lo mismo, cambiando el texto que tiene ("" la vacía)
func forja_panel_entrada_texto(titulo: String, etiqueta: String, texto: String) -> Bool
    forja_orden("PANELENTRADA " + forja_ext + " \"" + titulo + "\" " + etiqueta + "\n" + texto)
    return forja_rc == 0
end

# La fila elegida (desde 1; 0 ninguna), a la vista
func forja_panel_cursor(titulo: String, linea: Int) -> Bool
    forja_orden("PANELCURSOR " + forja_ext + " \"" + titulo + "\" #{linea}")
    return forja_rc == 0
end

# La parte n (desde 0) del dato del último suceso, separado por "|": en PANEL, PANELTECLA, PANELBOTON y PANELTEXTO la 0
# es el título del panel. La última se lleva el resto (el texto de PANELTEXTO puede tener "|").
func forja_campo(n: Int) -> String
    d = forja_dato
    k = 0
    while k < n
        p = str_find(d, "|")
        if p < 0
            return ""
        end
        d = d[p + 1:]
        k = k + 1
    end
    if forja_tipo == "PANELTEXTO" and n >= 1
        return d
    end
    p = str_find(d, "|")
    if p >= 0
        return d[0:p]
    end
    return d
end

# Lo que Forja sabe de su panel (PANELES): [extensión, título, lado, delante (1/0), fila elegida (desde 1; 0 ninguna),
# líneas, texto de la entrada]; [] si no lo tiene
func forja_panel_estado(titulo: String) -> [String]
    var r: [String] = []
    for l in str_split(forja_orden("PANELES"), "\n")
        p = str_split(l, "|")
        if p.length >= 7 and str_lower(p[0]) == str_lower(forja_ext) and p[1] == titulo
            for k in (0..5)
                r.push(p[k])
            end
            # (el texto de la entrada puede llevar "|")
            n = 0
            i = 0
            while n < 6
                i = str_find_from(l, "|", i) + 1
                n = n + 1
            end
            r.push(l[i:])
            return r
        end
    end
    return r
end
