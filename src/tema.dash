# Los colores y las fuentes de Forja: fondo negro, texto claro.
#
#   tema_preparar()      # en la primera función de dibujo (color_pen necesita la pantalla)
#   gfx_pen(tema.fondo)
#
# Con los 4 colores del Workbench, color_pen da el más parecido: los fondos salen negros y el texto blanco.

import "lib/red/idioma.dash"

struct Tema
    fondo: Int          # el editor
    fondo_panel: Int    # proyecto y pestañas
    fondo_salida: Int
    fondo_linea: Int    # la línea del cursor
    texto: Int
    tenue: Int          # números de línea, títulos de los paneles
    acento: Int         # la pestaña activa, lo elegido
    error: Int
    bien: Int
    borde: Int
    seleccion: Int
    cursor: Int
    sintaxis: [Int]     # un color por tipo de trozo de sintaxis.dash
    parada: Int         # el fondo de la línea donde está parado el depurador
end

var tema: Tema = nil
var pen_logo: [Int] = []      # el logo de Dash: azul, naranja y blanco del Workbench
var fuente_codigo: Int = 0      # Topaz 8: todas las letras igual de anchas
var fuente_panel: Int = 0
var ancho_letra: Int = 8
var alto_letra: Int = 8
var base_letra: Int = 6

# Un texto traducido con sus huecos (%1, %2) llenos: hueco y hueco2, los de lib/red/idioma.dash (los usa también
# lib/red/http.dash, que importa actualizar.dash)

# Los colores y la fuente se pueden cambiar en ENVARC:Forja/tema (ENV: primero): una cosa por línea, "nombre = r g b"
# (de 0 a 255), y "fuente = nombre.font tamaño" (de letras igual de anchas, como topaz o xen). Los nombres: fondo,
# fondo_panel, fondo_salida, fondo_linea, texto, tenue, acento, error, bien, borde, seleccion, cursor, parada; y los
# de la sintaxis: clave, tipo, cadena, numero, comentario, llamada, constante, directiva, asm_instruccion,
# asm_registro, asm_etiqueta. "#" empieza un comentario. Lo que no se entiende, en tema_malas.
var tema_malas: String = ""
var _tema_colores: {String: String} = {}
var _tema_fuente: String = ""
var _tema_usados: {String: Int} = {}

func _tema_leer()
    t = file_read_text("ENV:Forja/tema")
    if t == nil
        t = file_read_text("ENVARC:Forja/tema")
    end
    if t == nil
        return
    end
    for linea in str_split(t, "\n")
        l = str_trim(linea)
        p = str_find(l, "=")
        if l != "" and not str_starts(l, "#")
            if p <= 0
                tema_malas = tema_malas + l + "\n"
            else
                nombre = str_lower(str_trim(l[0:p]))
                valor = str_trim(l[p + 1:])
                if nombre == "fuente"
                    _tema_fuente = valor
                elif str_split(valor, " ").length == 3
                    _tema_colores[nombre] = valor
                else
                    tema_malas = tema_malas + l + "\n"
                end
            end
        end
    end
end

# El color con ese nombre: el del fichero del tema, o r, g, b
func _color(nombre: String, r: Int, g: Int, b: Int) -> Int
    _tema_usados[nombre] = 1
    v = _tema_colores.get(nombre, "")
    if v == ""
        return color_pen(r, g, b)
    end
    # (en variables nuevas: ./dash no cambia bien un parámetro, ver docs/FORJA_LOOP.md)
    p = str_split(v, " ")
    return color_pen(Int(p[0]), Int(p[1]), Int(p[2]))
end

func tema_preparar()
    if tema != nil
        return
    end
    _tema_leer()
    texto = _color("texto", 220, 220, 210)
    tema = Tema(_color("fondo", 14, 14, 18), _color("fondo_panel", 26, 26, 32), _color("fondo_salida", 8, 8, 10), _color("fondo_linea", 30, 30, 38),
                texto, _color("tenue", 110, 110, 124), _color("acento", 90, 150, 230), _color("error", 230, 80, 70),
                _color("bien", 110, 200, 120), _color("borde", 50, 50, 60), _color("seleccion", 40, 70, 130), _color("cursor", 255, 200, 80), [], _color("parada", 80, 70, 20))
    # normal, palabra clave, tipo, texto, número, comentario, llamada, constante, directiva (@native...), y en los
    # bloques asm: instrucción, registro y etiqueta (S_* de sintaxis.dash)
    tema.sintaxis = [tema.texto, _color("clave", 200, 130, 230), _color("tipo", 100, 190, 230), _color("cadena", 150, 210, 110),
                     _color("numero", 240, 170, 90), _color("comentario", 120, 120, 136), _color("llamada", 240, 220, 140), _color("constante", 240, 170, 90),
                     _color("directiva", 230, 120, 160), _color("asm_instruccion", 90, 210, 200), _color("asm_registro", 240, 130, 110), _color("asm_etiqueta", 250, 230, 90)]
    # los nombres que no se usaron no son de ningún color
    for k in _tema_colores.keys()
        if _tema_usados.get(k, 0) == 0
            tema_malas = tema_malas + k + " = " + _tema_colores[k] + "\n"
        end
    end
    pen_logo = [color_pen(0, 85, 170), color_pen(255, 136, 0), color_pen(255, 255, 255)]
    fuente_codigo = 0
    if _tema_fuente != ""
        p = str_split(_tema_fuente, " ")
        tam = 8
        if p.length >= 2
            tam = Int(p[1])
        end
        nombre = p[0]
        if not str_ends(str_lower(nombre), ".font")
            nombre = nombre + ".font"
        end
        fuente_codigo = font_open(nombre, tam)
        if fuente_codigo == 0
            tema_malas = tema_malas + "fuente = " + _tema_fuente + "\n"
        end
    end
    if fuente_codigo == 0
        fuente_codigo = font_open("topaz.font", 8)
    end
    fuente_panel = font_open("helvetica.font", 11)
    if fuente_panel == 0
        fuente_panel = fuente_codigo
    end
    usar_codigo()
    ancho_letra = font_text_width("M")
    alto_letra = font_height()
    base_letra = font_baseline()
    if font_text_width("i") != ancho_letra
        # (de letras de distinto ancho: las columnas no casarían)
        tema_malas = tema_malas + "fuente = " + _tema_fuente + " (" + tr(870, "no es de ancho fijo") + ")\n"
    end
end

func usar_codigo()
    if fuente_codigo != 0
        font_use(fuente_codigo)
    end
    font_style(0)
end

func usar_panel(estilo: Int)
    if fuente_panel != 0
        font_use(fuente_panel)
    end
    font_style(estilo)
end
