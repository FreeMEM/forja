                "children": [
                  { "type": "label", "tr": 348, "text": "Abrir lo de la última vez:", "color": [220, 220, 210] },
                  { "type": "checkbox", "name": "recordar", "checked": true },
                  { "type": "label", "tr": 353, "text": "En su propia pantalla (al arrancar):", "color": [220, 220, 210] },
