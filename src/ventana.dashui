              { "type": "label", "tr": 336, "text": "Cambiar por:", "color": [220, 220, 210] },
              { "type": "string", "name": "cambio", "text": "", "max": 200 },
              { "type": "label", "tr": 337, "text": "Mayúsculas:", "color": [220, 220, 210] },
              { "type": "checkbox", "name": "mayus", "checked": false }
            ]
          },
          {
            "type": "hgroup",
            "children": [
              { "type": "button", "name": "siguiente", "tr": 338, "label": "_Siguiente", "event": 50, "background": [44, 44, 52], "color": [220, 220, 210] },
