        "type": "vgroup",
        "children": [
          { "type": "canvas", "name": "botones", "min_width": 200, "min_height": 24, "weight": 0 },
          {
            "type": "hgroup",
            "weight": 300,
            "children": [
              {
                "type": "hgroup", "weight": 25,
                "children": [
                  {
                    "type": "vgroup",
                    "children": [
                      { "type": "canvas", "name": "proyecto", "min_width": 100, "min_height": 80 },
                      { "type": "scrollbar", "name": "barra_variables", "vertical": false, "change": 23 }
                    ]
                  },
                  { "type": "scrollbar", "name": "barra_proyecto", "vertical": true, "change": 18 }
                ]
              },
              { "type": "balance" },
              { "type": "canvas", "name": "editor", "min_width": 240, "min_height": 80, "weight": 100 },
              { "type": "scrollbar", "name": "barra", "vertical": true, "change": 3 }
            ]
          },
          { "type": "balance", "name": "balance_salida" },
          {
            "type": "hgroup", "name": "grupo_salida", "weight": 25,
