                  { "type": "label", "tr": 374, "text": "Completar y ayuda de argumentos:", "color": [220, 220, 210] },
                  { "type": "checkbox", "name": "completar", "checked": true },
                  { "type": "label", "tr": 381, "text": "Buscar versiones nuevas de Dash al empezar:", "color": [220, 220, 210] },
