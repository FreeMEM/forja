# El editor de ventanas .dashui: el árbol de objetos a la izquierda y las propiedades del elegido a la derecha,
# en el lienzo del editor. La vista previa es la ventana MUI de verdad, hecha con lib/dashui.dash.
#
#   dv_cargar(texto)               # lee el .dashui; "" si bien, o por qué no
#   dv_dibujar(x, y, ancho, alto)  # desde la función de dibujo del editor (debajo de las pestañas)
#   dv_tecla(codigo, teclas, letra) / dv_clic(x, y)   # true si cambió el fichero: dv_texto() es el nuevo
#
# En el árbol: flechas para moverse; derecha o Return, a las propiedades; "+" añade (en un grupo, un hijo; en
# otro objeto, uno detrás, eligiendo su tipo; en la ventana, un menú; en un menú, una opción); Supr quita; Alt +
# arriba o abajo lo cambia de sitio con el de al lado. En las propiedades, Return edita y Esc vuelve.
#   dv_vista_previa(evento_cerrar, volver)  # la ventana de verdad (sin los eventos del fichero, para que no lleguen a Forja)
#
# El formato es el de la extensión de VS Code (docs/MUI_EDITOR.md de Dash) y se escribe igual que ella
# (json_pretty, dos espacios, como JSON.stringify(doc, null, 2)). Los textos del fichero van en UTF-8; aquí se ven
# y se escriben en Latin-1.

import "lib/dashui.dash"
import "tema.dash"

const DV_MARGEN = 8
const DV_SANGRIA = 14

const F_VENTANA = 0
const F_OBJETO = 1
const F_MENU = 2
const F_ELEMENTO = 3

struct Fila
    nodo: Json
    nivel: Int
    clase: Int        # F_VENTANA, F_OBJETO, F_MENU, F_ELEMENTO
    padre: Json       # la lista donde está (nil: la ventana y el grupo raíz, que no se quitan ni se mueven)
end

# Los tipos que se pueden añadir, en el orden de la lista para elegir
const TIPOS = "button|text|label|string|checkbox|cycle|slider|gauge|list|canvas|scrollbar|image|combo|space|balance|hgroup|vgroup|frame|columns|tabs|scroll"

var dv_raiz: Json = nil
var dv_ventana: Json = nil
var dv_filas: [Fila] = []
var dv_sel: Int = 0              # la fila elegida del árbol
var dv_primera: Int = 0          # la primera fila del árbol que se ve
var dv_prop: Int = -1            # la propiedad elegida (-1: se mueve por el árbol)
var dv_props: [String] = []      # las propiedades del elegido, en orden
var dv_editando: Bool = false
var dv_valor: String = ""        # lo que se escribe en la propiedad
var dv_cursor: Int = 0
var dv_mensaje: String = ""      # un error de la última propiedad
var dv_vista: Int = 0            # la ventana de la vista previa (0: ninguna)
# La geometría del último dibujo (desde la esquina de la zona)
var dv_y0: Int = 0
var dv_fila_alto: Int = 12
var dv_corte: Int = 200          # la x donde empiezan las propiedades
var dv_columna_valor: Int = 100
var dv_de: String = ""           # qué documento está cargado ("" ninguno)
var dv_error_carga: String = ""
var dv_eligiendo: Bool = false    # eligiendo el tipo del objeto nuevo
var dv_tipo: Int = 0
var _dv_buscar: Json = nil        # el nodo que debe quedar elegido al rehacer las filas

var _dv_tipos: {String: String} = {}

func _dv_preparar()
    if _dv_tipos.length > 0
        return
    end
    # las propiedades propias de cada tipo, delante de las comunes (docs/MUI_EDITOR.md)
    _dv_tipos["vgroup"] = ""
    _dv_tipos["hgroup"] = ""
    _dv_tipos["frame"] = "title|horizontal"
    _dv_tipos["columns"] = "columns"
    _dv_tipos["tabs"] = "titles|change"
    _dv_tipos["scroll"] = ""
    _dv_tipos["text"] = "text|color"
    _dv_tipos["label"] = "text|color"
    _dv_tipos["button"] = "label|event|color"
    _dv_tipos["string"] = "text|max|ack|change"
    _dv_tipos["checkbox"] = "checked|change"
    _dv_tipos["cycle"] = "options|change"
    _dv_tipos["slider"] = "min|max|value|change"
    _dv_tipos["gauge"] = "max"
    _dv_tipos["list"] = "change|double"
    _dv_tipos["canvas"] = "min_width|min_height|take_tab"
    _dv_tipos["scrollbar"] = "vertical|change"
    _dv_tipos["image"] = "file"
    _dv_tipos["image_button"] = "file|event"
    _dv_tipos["image_toggle"] = "file|group|checked|change"
    _dv_tipos["combo"] = "text|options|ack|change"
    _dv_tipos["space"] = ""
    _dv_tipos["balance"] = ""
end

func _dv_numerica(p: String) -> Bool
    for n in ["event", "change", "ack", "double", "weight", "id", "close", "max", "min", "value", "min_width", "min_height", "columns", "group"]
        if p == n
            return true
        end
    end
    return false
end

func _dv_logica(p: String) -> Bool
    for n in ["checked", "horizontal", "vertical", "disabled", "hidden", "take_tab", "check", "separator"]
        if p == n
            return true
        end
    end
    return false
end

func _dv_lista(p: String) -> Bool
    return p == "size" or p == "background" or p == "color" or p == "field_colors"
end

func _dv_fila(n: Json, nivel: Int, clase: Int, padre: Json)
    if _dv_buscar != nil and n == _dv_buscar
        dv_sel = dv_filas.length
    end
    dv_filas.push(Fila(n, nivel, clase, padre))
end

func _dv_anadir_filas(n: Json, nivel: Int, padre: Json)
    _dv_fila(n, nivel, F_OBJETO, padre)
    hijos = json_get(n, "children")
    if hijos != nil
        i = 0
        while i < json_length(hijos)
            _dv_anadir_filas(json_at(hijos, i), nivel + 1, hijos)
            i = i + 1
        end
    end
end

# Las filas del árbol: la ventana, sus objetos y sus menús con sus elementos
func _dv_hacer_filas()
    dv_filas.clear()
    _dv_fila(dv_ventana, 0, F_VENTANA, nil)
    raiz = json_get(dv_ventana, "root")
    if raiz != nil
        _dv_anadir_filas(raiz, 1, nil)
    end
    menus = json_get(dv_ventana, "menus")
    if menus != nil
        i = 0
        while i < json_length(menus)
            m = json_at(menus, i)
            _dv_fila(m, 1, F_MENU, menus)
            elementos = json_get(m, "items")
            if elementos != nil
                k = 0
                while k < json_length(elementos)
                    _dv_fila(json_at(elementos, k), 2, F_ELEMENTO, elementos)
                    k = k + 1
                end
            end
            i = i + 1
        end
    end
    _dv_buscar = nil
    if dv_sel >= dv_filas.length
        dv_sel = dv_filas.length - 1
    end
    _dv_listar_props()
end

# Lee el .dashui (la primera ventana); "" si bien, o por qué no
func dv_cargar(texto: String) -> String
    _dv_preparar()
    j = json_parse(texto)
    if j == nil
        return "No es JSON: " + json_error()
    end
    if json_get_int(j, "dashui") != 1
        return "No es un .dashui de la versión 1"
    end
    ventanas = json_get(j, "windows")
    if ventanas == nil or json_length(ventanas) == 0
        return "No tiene ninguna ventana"
    end
    dv_raiz = j
    dv_ventana = json_at(ventanas, 0)
    dv_editando = false
    dv_eligiendo = false
    _dv_hacer_filas()
    return ""
end

# El fichero como texto, escrito como la extensión de VS Code
func dv_texto() -> String
    return json_pretty(dv_raiz) + "\n"
end

func _dv_listar_props()
    dv_props.clear()
    f = dv_filas[dv_sel]
    n = f.nodo
    if f.clase == F_VENTANA
        for p in ["name", "title", "id", "size", "close", "background", "field_colors"]
            dv_props.push(p)
        end
    elif f.clase == F_MENU
        for p in ["title", "name", "disabled"]
            dv_props.push(p)
        end
    elif f.clase == F_ELEMENTO
        if json_get_bool(n, "separator")
            dv_props.push("separator")
        else
            for p in ["label", "key", "event", "check", "checked", "name", "disabled"]
                dv_props.push(p)
            end
        end
    else
        tipo = json_get_str(n, "type")
        propias = _dv_tipos.get(tipo, "")
        if propias != ""
            for p in str_split(propias, "|")
                dv_props.push(p)
            end
        end
        for p in ["name", "weight", "disabled", "hidden", "help", "background"]
            dv_props.push(p)
        end
    end
    if dv_prop >= dv_props.length
        dv_prop = dv_props.length - 1
    end
end

# El valor de una propiedad como se enseña ("" si no está)
func _dv_valor(n: Json, p: String) -> String
    v = json_get(n, p)
    if v == nil
        return ""
    end
    if v.kind == JSON_STRING
        return utf8_to_latin1(v.text)
    end
    return utf8_to_latin1(json_write(v))
end

func _dv_titulo(f: Fila, i: Int) -> String
    n = f.nodo
    if f.clase == F_VENTANA
        return tr(73, "ventana ") + utf8_to_latin1(json_get_str(n, "name"))
    end
    if f.clase == F_MENU
        return hueco(tr(74, "menú \"%1\""), utf8_to_latin1(json_get_str(n, "title")))
    end
    if f.clase == F_ELEMENTO
        if json_get_bool(n, "separator")
            return "----"
        end
        t = "\"" + utf8_to_latin1(json_get_str(n, "label")) + "\""
        if json_has(n, "key")
            t = t + "  Amiga-" + json_get_str(n, "key")
        end
        return t
    end
    t = json_get_str(n, "type")
    nombre = json_get_str(n, "name")
    if nombre != ""
        return t + "  " + utf8_to_latin1(nombre)
    end
    for p in ["label", "text", "title"]
        if json_has(n, p)
            return t + "  \"" + utf8_to_latin1(json_get_str(n, p)) + "\""
        end
    end
    return t
end

func _dv_nombre_valido(s: String) -> Bool
    if s == ""
        return false
    end
    i = 0
    while i < s.length
        c = str_code(s, i)
        letra = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        cifra = c >= 48 and c <= 57
        if not letra and not (cifra and i > 0)
            return false
        end
        i = i + 1
    end
    return true
end

# Pone la propiedad con lo escrito; false (y dv_mensaje) si no vale
func _dv_poner(n: Json, p: String, v: String) -> Bool
    dv_mensaje = ""
    if v == ""
        if p == "type"
            dv_mensaje = tr(32, "El tipo no se puede quitar")
            return false
        end
        json_remove(n, p)
        return true
    end
    if p == "name" and not _dv_nombre_valido(v)
        dv_mensaje = tr(33, "Un nombre lleva letras sin acentos, cifras y _, y no empieza por cifra")
        return false
    end
    if p == "key" and v.length != 1
        dv_mensaje = tr(34, "key es una letra (Amiga + esa tecla)")
        return false
    end
    if str_contains(v, "#{")
        dv_mensaje = tr(77, "Los textos no pueden llevar #") + "{"
        return false
    end
    if _dv_numerica(p)
        x = json_parse(v)
        if x == nil or x.kind != JSON_NUMBER
            dv_mensaje = p + tr(35, " es un número")
            return false
        end
        json_set(n, p, x)
    elif _dv_logica(p)
        b = str_lower(v)
        if b == "true" or b == "sí" or b == "si"
            json_set_bool(n, p, true)
        elif b == "false" or b == "no"
            json_set_bool(n, p, false)
        else
            dv_mensaje = p + tr(36, " es true o false")
            return false
        end
    elif _dv_lista(p)
        x = json_parse(v)
        if x == nil or x.kind != JSON_ARRAY
            dv_mensaje = p + tr(37, " es una lista, como [20, 20, 24]")
            return false
        end
        json_set(n, p, x)
    else
        json_set_str(n, p, latin1_to_utf8(v))
    end
    return true
end

# --- Añadir, quitar y mover ---

func _dv_es_grupo(n: Json) -> Bool
    t = json_get_str(n, "type")
    return t == "vgroup" or t == "hgroup" or t == "frame" or t == "columns" or t == "tabs" or t == "scroll"
end

func _dv_nuevo(tipo: String) -> Json
    n = json_object()
    json_set_str(n, "type", tipo)
    if tipo == "text"
        json_set_str(n, "text", latin1_to_utf8("Texto"))
    elif tipo == "label"
        json_set_str(n, "text", latin1_to_utf8("Etiqueta:"))
    elif tipo == "string" or tipo == "combo"
        json_set_str(n, "text", "")
    elif tipo == "cycle"
        json_set_str(n, "options", "Uno|Dos")
    elif tipo == "frame"
        json_set_str(n, "title", "Marco")
    elif tipo == "tabs"
        json_set_str(n, "titles", "Una|Dos")
    elif tipo == "canvas"
        json_set_int(n, "min_width", 64)
        json_set_int(n, "min_height", 32)
    end
    if _dv_es_grupo(n)
        json_set(n, "children", json_array())
    end
    if tipo == "button"
        json_set_str(n, "label", latin1_to_utf8("Botón"))
    end
    return n
end

# Mete v en la lista a delante de la posición i
func _dv_meter(a: Json, i: Int, v: Json)
    if i >= a.items.length
        a.items.push(v)
    else
        a.items.insert(i, v)
    end
end

func _dv_posicion(a: Json, n: Json) -> Int
    i = 0
    while i < a.items.length
        if a.items[i] == n
            return i
        end
        i = i + 1
    end
    return -1
end

# "+": en un grupo, un hijo al final; en otro objeto, uno detrás; en la ventana, un menú; en un menú o un
# elemento, un elemento. Los objetos piden antes el tipo (dv_eligiendo). true si cambió.
func _dv_anadir() -> Bool
    f = dv_filas[dv_sel]
    if f.clase == F_OBJETO
        dv_eligiendo = true
        return false
    end
    nuevo = json_object()
    if f.clase == F_VENTANA
        json_set_str(nuevo, "title", latin1_to_utf8("Menú"))
        json_set(nuevo, "items", json_array())
        menus = json_get(dv_ventana, "menus")
        if menus == nil
            menus = json_array()
            json_set(dv_ventana, "menus", menus)
        end
        menus.items.push(nuevo)
    else
        json_set_str(nuevo, "label", latin1_to_utf8("Opción"))
        if f.clase == F_MENU
            elementos = json_get(f.nodo, "items")
            if elementos == nil
                elementos = json_array()
                json_set(f.nodo, "items", elementos)
            end
            elementos.items.push(nuevo)
        else
            _dv_meter(f.padre, _dv_posicion(f.padre, f.nodo) + 1, nuevo)
        end
    end
    _dv_buscar = nuevo
    _dv_hacer_filas()
    return true
end

func _dv_anadir_tipo(tipo: String) -> Bool
    dv_eligiendo = false
    f = dv_filas[dv_sel]
    nuevo = _dv_nuevo(tipo)
    if f.padre == nil or _dv_es_grupo(f.nodo)
        hijos = json_get(f.nodo, "children")
        if hijos == nil
            hijos = json_array()
            json_set(f.nodo, "children", hijos)
        end
        hijos.items.push(nuevo)
    else
        _dv_meter(f.padre, _dv_posicion(f.padre, f.nodo) + 1, nuevo)
    end
    _dv_buscar = nuevo
    _dv_hacer_filas()
    return true
end

func _dv_quitar() -> Bool
    f = dv_filas[dv_sel]
    if f.padre == nil
        dv_mensaje = tr(38, "La ventana y su grupo raíz no se quitan")
        return false
    end
    i = _dv_posicion(f.padre, f.nodo)
    f.padre.items.remove(i)
    if i > 0
        _dv_buscar = f.padre.items[i - 1]
    elif dv_sel > 0
        dv_sel = dv_sel - 1
    end
    _dv_hacer_filas()
    return true
end

# Alt + arriba o abajo: cambia el sitio con el de al lado
func _dv_mover(paso: Int) -> Bool
    f = dv_filas[dv_sel]
    if f.padre == nil
        return false
    end
    i = _dv_posicion(f.padre, f.nodo)
    j = i + paso
    if j < 0 or j >= f.padre.items.length
        return false
    end
    otro = f.padre.items[j]
    f.padre.items[j] = f.nodo
    f.padre.items[i] = otro
    _dv_buscar = f.nodo
    _dv_hacer_filas()
    return true
end

# --- Teclado y ratón ---

# true si cambió el fichero
func dv_tecla(codigo: Int, teclas: Int, letra: String) -> Bool
    if dv_editando
        if codigo == 0x44 or codigo == 0x43
            dv_editando = false
            n = dv_filas[dv_sel].nodo
            antes = _dv_valor(n, dv_props[dv_prop])
            if dv_valor == antes
                return false
            end
            if _dv_poner(n, dv_props[dv_prop], dv_valor)
                return true
            end
            dv_editando = true
        elif codigo == 0x45
            dv_editando = false
            dv_mensaje = ""
        elif codigo == 0x41
            if dv_cursor > 0
                dv_valor = dv_valor[0:dv_cursor - 1] + dv_valor[dv_cursor:]
                dv_cursor = dv_cursor - 1
            end
        elif codigo == 0x46
            if dv_cursor < dv_valor.length
                dv_valor = dv_valor[0:dv_cursor] + dv_valor[dv_cursor + 1:]
            end
        elif codigo == 0x4F
            if (teclas & 4) != 0
                dv_cursor = 0
            elif dv_cursor > 0
                dv_cursor = dv_cursor - 1
            end
        elif codigo == 0x4E
            if (teclas & 4) != 0
                dv_cursor = dv_valor.length
            elif dv_cursor < dv_valor.length
                dv_cursor = dv_cursor + 1
            end
        elif letra != "" and str_code(letra, 0) >= 32 and str_code(letra, 0) != 127
            dv_valor = dv_valor[0:dv_cursor] + letra + dv_valor[dv_cursor:]
            dv_cursor = dv_cursor + 1
        end
        return false
    end
    if dv_eligiendo
        tipos = str_split(TIPOS, "|")
        if codigo == 0x4C and dv_tipo > 0
            dv_tipo = dv_tipo - 1
        elif codigo == 0x4D and dv_tipo < tipos.length - 1
            dv_tipo = dv_tipo + 1
        elif codigo == 0x44 or codigo == 0x43
            return _dv_anadir_tipo(tipos[dv_tipo])
        elif codigo == 0x45
            dv_eligiendo = false
        end
        return false
    end
    if dv_prop < 0
        if letra == "+"
            return _dv_anadir()
        end
        if codigo == 0x46
            return _dv_quitar()
        end
        if (teclas & 4) != 0 and (codigo == 0x4C or codigo == 0x4D)
            if codigo == 0x4C
                return _dv_mover(-1)
            end
            return _dv_mover(1)
        end
    end
    if codigo == 0x4C
        if dv_prop >= 0
            if dv_prop > 0
                dv_prop = dv_prop - 1
            end
        elif dv_sel > 0
            dv_sel = dv_sel - 1
            _dv_listar_props()
        end
    elif codigo == 0x4D
        if dv_prop >= 0
            if dv_prop < dv_props.length - 1
                dv_prop = dv_prop + 1
            end
        elif dv_sel < dv_filas.length - 1
            dv_sel = dv_sel + 1
            _dv_listar_props()
        end
    elif codigo == 0x4E or ((codigo == 0x44 or codigo == 0x43) and dv_prop < 0)
        if dv_prop < 0 and dv_props.length > 0
            dv_prop = 0
        end
    elif codigo == 0x4F or (codigo == 0x45 and dv_prop >= 0)
        dv_prop = -1
    elif codigo == 0x44 or codigo == 0x43
        _dv_empezar_edicion()
    end
    dv_mensaje = ""
    return false
end

func _dv_empezar_edicion()
    if dv_prop < 0
        return
    end
    dv_valor = _dv_valor(dv_filas[dv_sel].nodo, dv_props[dv_prop])
    dv_cursor = dv_valor.length
    dv_editando = true
end

# Un clic en la zona: elige una fila del árbol, o una propiedad (y empieza a editarla)
func dv_clic(x: Int, y: Int)
    if y < dv_y0
        return
    end
    i = (y - dv_y0) / dv_fila_alto
    dv_editando = false
    dv_mensaje = ""
    if x < dv_corte
        i = i + dv_primera
        if i < dv_filas.length
            dv_sel = i
            dv_prop = -1
            _dv_listar_props()
        end
    elif i < dv_props.length
        dv_prop = i
        _dv_empezar_edicion()
    end
end

# --- Vista previa ---

# Una copia sin eventos ni atajos (no deben llegar a Forja), y cerrar da evento_cerrar
func _dv_sin_eventos(n: Json)
    if n == nil
        return
    end
    if n.kind == JSON_OBJECT
        for p in ["event", "change", "ack", "double", "key", "close"]
            json_remove(n, p)
        end
        i = 0
        while i < json_length(n)
            _dv_sin_eventos(json_value_at(n, i))
            i = i + 1
        end
    elif n.kind == JSON_ARRAY
        i = 0
        while i < json_length(n)
            _dv_sin_eventos(json_at(n, i))
            i = i + 1
        end
    end
end

# Abre (o rehace) la ventana de verdad; "" si bien, o por qué no. volver: el teclado se queda en Forja
func dv_vista_previa(evento_cerrar: Int, volver: Bool) -> String
    copia = json_parse(json_write(dv_ventana))
    _dv_sin_eventos(copia)
    # sin el número de ventana: MUI recordaría su sitio, y puede ser el mismo que el de Forja
    json_remove(copia, "id")
    # los colores de los campos son de toda la aplicación: cambiarían los de Forja
    json_remove(copia, "field_colors")
    json_set_int(copia, "close", evento_cerrar)
    doc = json_object()
    json_set_int(doc, "dashui", 1)
    lista = json_array()
    json_push(lista, copia)
    json_set(doc, "windows", lista)
    ui = dashui_window(json_write(doc), "")
    if ui.error != ""
        return ui.error
    end
    if dv_vista != 0
        mui_window_dispose(dv_vista)
    end
    dv_vista = ui.window
    if volver
        # rehecha tras un cambio: sin quitarle el teclado a Forja
        mui_window_open_back(dv_vista)
    else
        mui_window_open(dv_vista)
    end
    return ""
end

func dv_cerrar_vista()
    mui_window_dispose(dv_vista)
    dv_vista = 0
end

# --- Dibujar ---

# La lista de tipos, con el elegido a la vista
func _dv_dibujar_tipos(px: Int, y: Int, derecha: Int, alto: Int)
    tipos = str_split(TIPOS, "|")
    gfx_pen(tema.tenue)
    gfx_text_at(px + DV_MARGEN, y + 4 + font_baseline(), tr(75, "Tipo del objeto nuevo (Return):"))
    caben = (alto - 8) / dv_fila_alto - 1
    desde = dv_tipo - caben + 1
    if desde < 0
        desde = 0
    end
    fy = y + 4 + dv_fila_alto
    i = desde
    while i < tipos.length and fy + dv_fila_alto <= y + alto
        if i == dv_tipo
            gfx_pen(tema.seleccion)
            gfx_rect(px, fy, derecha, fy + dv_fila_alto - 1)
        end
        gfx_pen(tema.texto)
        gfx_text_at(px + DV_MARGEN + 8, fy + 1 + font_baseline(), tipos[i])
        fy = fy + dv_fila_alto
        i = i + 1
    end
end

# arriba: lo que hay entre la esquina de la zona e y (las pestañas), para los clics
func dv_dibujar(x: Int, y: Int, ancho: Int, alto: Int, arriba: Int)
    gfx_pen(tema.fondo)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    usar_panel(0)
    dv_fila_alto = font_height() + 3
    dv_y0 = arriba + 4
    if dv_error_carga != ""
        gfx_pen(tema.error)
        gfx_text_at(x + DV_MARGEN, y + 4 + font_baseline(), dv_error_carga)
        gfx_pen(tema.tenue)
        gfx_text_at(x + DV_MARGEN, y + 4 + dv_fila_alto + font_baseline(), tr(76, "Amiga-D enseña el fichero como texto."))
        return
    end
    dv_corte = ancho * 45 / 100
    # el árbol, desde la fila que deja ver la elegida
    caben = (alto - 8) / dv_fila_alto
    if caben < 1
        caben = 1
    end
    if dv_sel < dv_primera
        dv_primera = dv_sel
    end
    if dv_sel >= dv_primera + caben
        dv_primera = dv_sel - caben + 1
    end
    if dv_primera > dv_filas.length - caben
        dv_primera = dv_filas.length - caben
    end
    if dv_primera < 0
        dv_primera = 0
    end
    fy = y + 4
    i = dv_primera
    while i < dv_filas.length
        f = dv_filas[i]
        if fy + dv_fila_alto > y + alto
            break
        end
        if i == dv_sel
            gfx_pen(tema.fondo_linea)
            if dv_prop < 0
                gfx_pen(tema.seleccion)
            end
            gfx_rect(x, fy, x + dv_corte - 4, fy + dv_fila_alto - 1)
        end
        gfx_pen(tema.texto)
        if i == 0
            gfx_pen(tema.acento)
        end
        gfx_text_at(x + DV_MARGEN + f.nivel * DV_SANGRIA, fy + 1 + font_baseline(), _dv_titulo(f, i))
        fy = fy + dv_fila_alto
        i = i + 1
    end
    # las propiedades (o la lista de tipos para el objeto nuevo)
    px = x + dv_corte
    gfx_pen(tema.fondo_panel)
    gfx_rect(px, y, x + ancho - 1, y + alto - 1)
    if dv_eligiendo
        _dv_dibujar_tipos(px, y, x + ancho - 1, alto)
        return
    end
    n = dv_filas[dv_sel].nodo
    dv_columna_valor = 0
    for p in dv_props
        w = font_text_width(p)
        if w > dv_columna_valor
            dv_columna_valor = w
        end
    end
    dv_columna_valor = px + DV_MARGEN + dv_columna_valor + 12
    fy = y + 4
    i = 0
    for p in dv_props
        if fy + dv_fila_alto > y + alto - dv_fila_alto
            break
        end
        if i == dv_prop
            gfx_pen(tema.seleccion)
            gfx_rect(px, fy, x + ancho - 1, fy + dv_fila_alto - 1)
        end
        base = fy + 1 + font_baseline()
        gfx_pen(tema.tenue)
        gfx_text_at(px + DV_MARGEN, base, p)
        valor = _dv_valor(n, p)
        if i == dv_prop and dv_editando
            valor = dv_valor
        end
        gfx_pen(tema.texto)
        gfx_text_at(dv_columna_valor, base, valor)
        if i == dv_prop and dv_editando
            cx = dv_columna_valor + font_text_width(dv_valor[0:dv_cursor])
            gfx_pen(tema.cursor)
            gfx_rect(cx, fy, cx + 1, fy + dv_fila_alto - 1)
        end
        fy = fy + dv_fila_alto
        i = i + 1
    end
    if dv_mensaje != ""
        gfx_pen(tema.error)
        gfx_text_at(px + DV_MARGEN, y + alto - 4 - font_height() + font_baseline(), dv_mensaje)
    end
end
