# El editor de ventanas .dashui: el árbol de objetos a la izquierda y las propiedades del elegido a la derecha,
# en el lienzo del editor. La vista previa es la ventana MUI de verdad, hecha con lib/dashui.dash.
#
#   dv_cargar(texto)               # lee el .dashui; "" si bien, o por qué no
#   dv_dibujar(x, y, ancho, alto)  # desde la función de dibujo del editor (debajo de las pestañas)
#   dv_tecla(codigo, teclas, letra) / dv_clic(x, y)   # true si cambió el fichero: dv_texto() es el nuevo
#
# En el árbol: flechas para moverse; derecha o Return, a las propiedades; "+" añade (en un grupo, un hijo; en
# otro objeto, uno detrás, eligiendo su tipo; en la ventana, un menú; en un menú, una opción); Supr quita; Alt +
# arriba o abajo lo cambia de sitio con el de al lado. En las propiedades, Return edita y Esc vuelve.
#   dv_vista_previa(evento_cerrar, volver)  # la ventana de verdad (sin los eventos del fichero, para que no lleguen a Forja)
#
# El formato es el de la extensión de VS Code (docs/MUI_EDITOR.md de Dash) y se escribe igual que ella
# (json_pretty, dos espacios, como JSON.stringify(doc, null, 2)). Los textos del fichero van en UTF-8; aquí se ven
# y se escriben en Latin-1.

import "lib/dashui.dash"
import "tema.dash"
import "lienzo.dash"

const DV_MARGEN = 8
const DV_SANGRIA = 14

const F_VENTANA = 0
const F_OBJETO = 1
const F_MENU = 2
const F_ELEMENTO = 3

struct Fila
    nodo: Json
    nivel: Int
    clase: Int        # F_VENTANA, F_OBJETO, F_MENU, F_ELEMENTO
    padre: Json       # la lista donde está (nil: la ventana y el grupo raíz, que no se quitan ni se mueven)
end

# Los tipos que se pueden añadir, en el orden de la lista para elegir
const TIPOS = "button|text|label|string|checkbox|cycle|slider|gauge|list|canvas|scrollbar|image|combo|space|balance|hgroup|vgroup|frame|columns|tabs|scroll"

var dv_raiz: Json = nil
var dv_ventana: Json = nil
var dv_filas: [Fila] = []
var dv_sel: Int = 0              # la fila elegida del árbol
var dv_primera: Int = 0          # la primera fila del árbol que se ve
var dv_prop: Int = -1            # la propiedad elegida (-1: se mueve por el árbol)
var dv_props: [String] = []      # las propiedades del elegido, en orden
var dv_editando: Bool = false
var dv_valor: String = ""        # lo que se escribe en la propiedad
var dv_cursor: Int = 0
var dv_mensaje: String = ""      # un error de la última propiedad
var dv_vista: Int = 0            # la ventana de la vista previa (0: ninguna)
# La geometría del último dibujo (desde la esquina de la zona)
var dv_y0: Int = 0
var dv_arriba: Int = 0           # dónde empieza la zona en el lienzo de Forja (debajo de las pestañas)
var dv_fila_alto: Int = 12
var dv_corte: Int = 200          # la x donde empiezan las propiedades
var dv_columna_valor: Int = 100
var dv_de: String = ""           # qué documento está cargado ("" ninguno)
var dv_error_carga: String = ""
var dv_eligiendo: Bool = false    # eligiendo el tipo del objeto nuevo
var dv_tipo: Int = 0
var _dv_buscar: Json = nil        # el nodo que debe quedar elegido al rehacer las filas

var _dv_tipos: {String: String} = {}

# El lienzo (lo pidió Jose): la ventana dibujada, con la paleta de objetos encima. Tab cambia entre la ventana y
# el árbol.
var dv_ver_arbol: Bool = false
var dv_paleta_alto: Int = 0       # lo que ocupa la paleta, desde arriba de la zona
var _dv_chips_x: [Int] = []       # los botones de la paleta: dónde está cada uno (el último, Ventana/Árbol)
var _dv_chips_y: [Int] = []
var _dv_chips_w: [Int] = []
var _dv_vx0: Int = 0              # dónde se dibujó la ventana y la paleta (para la sonda de las pruebas)
var _dv_vy0: Int = 0
var _dv_px0: Int = 0
var _dv_py0: Int = 0
var dv_encima: Int = -1          # el botón de la paleta con el puntero encima (-1: ninguno)
var dv_herramienta: String = ""   # el tipo elegido en la paleta: un clic en la ventana lo pone ahí
var dv_arr_tipo: String = ""      # lo que se arrastra: uno nuevo de la paleta...
var dv_arr_nodo: Json = nil       # ...o un objeto de la ventana
var dv_arrastrando: Bool = false
var _dv_clic_ms: Int = -10000     # el último clic en la ventana, para el doble clic
var _dv_clic_nodo: Json = nil
const DV_DOBLE_MS = 500

func _dv_preparar()
    if _dv_tipos.length > 0
        return
    end
    # las propiedades propias de cada tipo, delante de las comunes (docs/MUI_EDITOR.md)
    _dv_tipos["vgroup"] = ""
    _dv_tipos["hgroup"] = ""
    _dv_tipos["frame"] = "title|horizontal"
    _dv_tipos["columns"] = "columns"
    _dv_tipos["tabs"] = "titles|change"
    _dv_tipos["scroll"] = ""
    _dv_tipos["text"] = "text|color"
    _dv_tipos["label"] = "text|color"
    _dv_tipos["button"] = "label|event|color"
    _dv_tipos["string"] = "text|max|ack|change"
    _dv_tipos["checkbox"] = "checked|change"
    _dv_tipos["cycle"] = "options|change"
    _dv_tipos["slider"] = "min|max|value|change"
    _dv_tipos["gauge"] = "max"
    _dv_tipos["list"] = "change|double"
    _dv_tipos["canvas"] = "min_width|min_height|take_tab"
    _dv_tipos["scrollbar"] = "vertical|change"
    _dv_tipos["image"] = "file"
    _dv_tipos["image_button"] = "file|event"
    _dv_tipos["image_toggle"] = "file|group|checked|change"
    _dv_tipos["combo"] = "text|options|ack|change"
    _dv_tipos["space"] = ""
    _dv_tipos["balance"] = ""
end

# El nombre de un tipo en la paleta
func dv_nombre_tipo(tipo: String) -> String
    tipos = str_split(TIPOS, "|")
    var nombres: [String] = str_split(tr(1101, "Botón|Texto|Etiqueta|Campo|Casilla|Ciclo|Deslizador|Medidor|Lista|Lienzo|Barra|Imagen|Combo|Espacio|Separador|Grupo H|Grupo V|Marco|Tabla|Pestañas|Desplazable"), "|")
    i = 0
    while i < tipos.length
        if tipos[i] == tipo and i < nombres.length
            return nombres[i]
        end
        i = i + 1
    end
    return tipo
end

func _dv_numerica(p: String) -> Bool
    for n in ["event", "change", "ack", "double", "weight", "id", "close", "max", "min", "value", "min_width", "min_height", "columns", "group"]
        if p == n
            return true
        end
    end
    return false
end

func _dv_logica(p: String) -> Bool
    for n in ["checked", "horizontal", "vertical", "disabled", "hidden", "take_tab", "check", "separator"]
        if p == n
            return true
        end
    end
    return false
end

func _dv_lista(p: String) -> Bool
    return p == "size" or p == "background" or p == "color" or p == "field_colors"
end

func _dv_fila(n: Json, nivel: Int, clase: Int, padre: Json)
    if _dv_buscar != nil and n == _dv_buscar
        dv_sel = dv_filas.length
    end
    dv_filas.push(Fila(n, nivel, clase, padre))
end

func _dv_anadir_filas(n: Json, nivel: Int, padre: Json)
    _dv_fila(n, nivel, F_OBJETO, padre)
    hijos = json_get(n, "children")
    if hijos != nil
        i = 0
        while i < json_length(hijos)
            _dv_anadir_filas(json_at(hijos, i), nivel + 1, hijos)
            i = i + 1
        end
    end
end

# Las filas del árbol: la ventana, sus objetos y sus menús con sus elementos
func _dv_hacer_filas()
    dv_filas.clear()
    _dv_fila(dv_ventana, 0, F_VENTANA, nil)
    raiz = json_get(dv_ventana, "root")
    if raiz != nil
        _dv_anadir_filas(raiz, 1, nil)
    end
    menus = json_get(dv_ventana, "menus")
    if menus != nil
        i = 0
        while i < json_length(menus)
            m = json_at(menus, i)
            _dv_fila(m, 1, F_MENU, menus)
            elementos = json_get(m, "items")
            if elementos != nil
                k = 0
                while k < json_length(elementos)
                    _dv_fila(json_at(elementos, k), 2, F_ELEMENTO, elementos)
                    k = k + 1
                end
            end
            i = i + 1
        end
    end
    _dv_buscar = nil
    if dv_sel >= dv_filas.length
        dv_sel = dv_filas.length - 1
    end
    _dv_listar_props()
end

# Lee el .dashui (la primera ventana); "" si bien, o por qué no
func dv_cargar(texto: String) -> String
    _dv_preparar()
    j = json_parse(texto)
    if j == nil
        return "No es JSON: " + json_error()
    end
    if json_get_int(j, "dashui") != 1
        return "No es un .dashui de la versión 1"
    end
    ventanas = json_get(j, "windows")
    if ventanas == nil or json_length(ventanas) == 0
        return "No tiene ninguna ventana"
    end
    dv_raiz = j
    dv_ventana = json_at(ventanas, 0)
    dv_editando = false
    dv_eligiendo = false
    _dv_hacer_filas()
    return ""
end

# El fichero como texto, escrito como la extensión de VS Code
func dv_texto() -> String
    return json_pretty(dv_raiz) + "\n"
end

func _dv_listar_props()
    dv_props.clear()
    f = dv_filas[dv_sel]
    n = f.nodo
    if f.clase == F_VENTANA
        for p in ["name", "title", "id", "size", "close", "background", "field_colors"]
            dv_props.push(p)
        end
    elif f.clase == F_MENU
        for p in ["title", "name", "disabled"]
            dv_props.push(p)
        end
    elif f.clase == F_ELEMENTO
        if json_get_bool(n, "separator")
            dv_props.push("separator")
        else
            for p in ["label", "key", "event", "check", "checked", "name", "disabled"]
                dv_props.push(p)
            end
        end
    else
        tipo = json_get_str(n, "type")
        propias = _dv_tipos.get(tipo, "")
        if propias != ""
            for p in str_split(propias, "|")
                dv_props.push(p)
            end
        end
        for p in ["name", "weight", "disabled", "hidden", "help", "background"]
            dv_props.push(p)
        end
    end
    if dv_prop >= dv_props.length
        dv_prop = dv_props.length - 1
    end
end

# El valor de una propiedad como se enseña ("" si no está)
func _dv_valor(n: Json, p: String) -> String
    v = json_get(n, p)
    if v == nil
        return ""
    end
    if v.kind == JSON_STRING
        return utf8_to_latin1(v.text)
    end
    return utf8_to_latin1(json_write(v))
end

func _dv_titulo(f: Fila, i: Int) -> String
    n = f.nodo
    if f.clase == F_VENTANA
        return tr(73, "ventana ") + utf8_to_latin1(json_get_str(n, "name"))
    end
    if f.clase == F_MENU
        return hueco(tr(74, "menú \"%1\""), utf8_to_latin1(json_get_str(n, "title")))
    end
    if f.clase == F_ELEMENTO
        if json_get_bool(n, "separator")
            return "----"
        end
        t = "\"" + utf8_to_latin1(json_get_str(n, "label")) + "\""
        if json_has(n, "key")
            t = t + "  Amiga-" + json_get_str(n, "key")
        end
        return t
    end
    t = json_get_str(n, "type")
    nombre = json_get_str(n, "name")
    if nombre != ""
        return t + "  " + utf8_to_latin1(nombre)
    end
    for p in ["label", "text", "title"]
        if json_has(n, p)
            return t + "  \"" + utf8_to_latin1(json_get_str(n, p)) + "\""
        end
    end
    return t
end

func _dv_nombre_valido(s: String) -> Bool
    if s == ""
        return false
    end
    i = 0
    while i < s.length
        c = str_code(s, i)
        letra = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        cifra = c >= 48 and c <= 57
        if not letra and not (cifra and i > 0)
            return false
        end
        i = i + 1
    end
    return true
end

# Pone la propiedad con lo escrito; false (y dv_mensaje) si no vale
func _dv_poner(n: Json, p: String, v: String) -> Bool
    dv_mensaje = ""
    if v == ""
        if p == "type"
            dv_mensaje = tr(32, "El tipo no se puede quitar")
            return false
        end
        json_remove(n, p)
        return true
    end
    if p == "name" and not _dv_nombre_valido(v)
        dv_mensaje = tr(33, "Un nombre lleva letras sin acentos, cifras y _, y no empieza por cifra")
        return false
    end
    if p == "key" and v.length != 1
        dv_mensaje = tr(34, "key es una letra (Amiga + esa tecla)")
        return false
    end
    if str_contains(v, "#{")
        dv_mensaje = tr(77, "Los textos no pueden llevar #") + "{"
        return false
    end
    if _dv_numerica(p)
        x = json_parse(v)
        if x == nil or x.kind != JSON_NUMBER
            dv_mensaje = p + tr(35, " es un número")
            return false
        end
        json_set(n, p, x)
    elif _dv_logica(p)
        b = str_lower(v)
        if b == "true" or b == "sí" or b == "si"
            json_set_bool(n, p, true)
        elif b == "false" or b == "no"
            json_set_bool(n, p, false)
        else
            dv_mensaje = p + tr(36, " es true o false")
            return false
        end
    elif _dv_lista(p)
        x = json_parse(v)
        if x == nil or x.kind != JSON_ARRAY
            dv_mensaje = p + tr(37, " es una lista, como [20, 20, 24]")
            return false
        end
        json_set(n, p, x)
    else
        json_set_str(n, p, latin1_to_utf8(v))
    end
    return true
end

# --- Añadir, quitar y mover ---

func _dv_es_grupo(n: Json) -> Bool
    t = json_get_str(n, "type")
    return t == "vgroup" or t == "hgroup" or t == "frame" or t == "columns" or t == "tabs" or t == "scroll"
end

func _dv_nuevo(tipo: String) -> Json
    n = json_object()
    json_set_str(n, "type", tipo)
    if tipo == "text"
        json_set_str(n, "text", latin1_to_utf8("Texto"))
    elif tipo == "label"
        json_set_str(n, "text", latin1_to_utf8("Etiqueta:"))
    elif tipo == "string" or tipo == "combo"
        json_set_str(n, "text", "")
    elif tipo == "cycle"
        json_set_str(n, "options", "Uno|Dos")
    elif tipo == "frame"
        json_set_str(n, "title", "Marco")
    elif tipo == "tabs"
        json_set_str(n, "titles", "Una|Dos")
    elif tipo == "canvas"
        json_set_int(n, "min_width", 64)
        json_set_int(n, "min_height", 32)
    end
    if _dv_es_grupo(n)
        json_set(n, "children", json_array())
    end
    if tipo == "button"
        json_set_str(n, "label", latin1_to_utf8("Botón"))
    end
    return n
end

# Mete v en la lista a delante de la posición i
func _dv_meter(a: Json, i: Int, v: Json)
    if i >= a.items.length
        a.items.push(v)
    else
        a.items.insert(i, v)
    end
end

func _dv_posicion(a: Json, n: Json) -> Int
    i = 0
    while i < a.items.length
        if a.items[i] == n
            return i
        end
        i = i + 1
    end
    return -1
end

# "+": en un grupo, un hijo al final; en otro objeto, uno detrás; en la ventana, un menú; en un menú o un
# elemento, un elemento. Los objetos piden antes el tipo (dv_eligiendo). true si cambió.
func _dv_anadir() -> Bool
    f = dv_filas[dv_sel]
    if f.clase == F_OBJETO
        dv_eligiendo = true
        return false
    end
    nuevo = json_object()
    if f.clase == F_VENTANA
        json_set_str(nuevo, "title", latin1_to_utf8("Menú"))
        json_set(nuevo, "items", json_array())
        menus = json_get(dv_ventana, "menus")
        if menus == nil
            menus = json_array()
            json_set(dv_ventana, "menus", menus)
        end
        menus.items.push(nuevo)
    else
        json_set_str(nuevo, "label", latin1_to_utf8("Opción"))
        if f.clase == F_MENU
            elementos = json_get(f.nodo, "items")
            if elementos == nil
                elementos = json_array()
                json_set(f.nodo, "items", elementos)
            end
            elementos.items.push(nuevo)
        else
            _dv_meter(f.padre, _dv_posicion(f.padre, f.nodo) + 1, nuevo)
        end
    end
    _dv_buscar = nuevo
    _dv_hacer_filas()
    return true
end

func _dv_anadir_tipo(tipo: String) -> Bool
    dv_eligiendo = false
    f = dv_filas[dv_sel]
    nuevo = _dv_nuevo(tipo)
    if f.padre == nil or _dv_es_grupo(f.nodo)
        hijos = json_get(f.nodo, "children")
        if hijos == nil
            hijos = json_array()
            json_set(f.nodo, "children", hijos)
        end
        hijos.items.push(nuevo)
    else
        _dv_meter(f.padre, _dv_posicion(f.padre, f.nodo) + 1, nuevo)
    end
    _dv_buscar = nuevo
    _dv_hacer_filas()
    return true
end

func _dv_quitar() -> Bool
    f = dv_filas[dv_sel]
    if f.padre == nil
        dv_mensaje = tr(38, "La ventana y su grupo raíz no se quitan")
        return false
    end
    i = _dv_posicion(f.padre, f.nodo)
    f.padre.items.remove(i)
    if i > 0
        _dv_buscar = f.padre.items[i - 1]
    elif dv_sel > 0
        dv_sel = dv_sel - 1
    end
    _dv_hacer_filas()
    return true
end

# Alt + arriba o abajo: cambia el sitio con el de al lado
func _dv_mover(paso: Int) -> Bool
    f = dv_filas[dv_sel]
    if f.padre == nil
        return false
    end
    i = _dv_posicion(f.padre, f.nodo)
    j = i + paso
    if j < 0 or j >= f.padre.items.length
        return false
    end
    otro = f.padre.items[j]
    f.padre.items[j] = f.nodo
    f.padre.items[i] = otro
    _dv_buscar = f.nodo
    _dv_hacer_filas()
    return true
end

# --- Teclado y ratón ---

# true si cambió el fichero
func dv_tecla(codigo: Int, teclas: Int, letra: String) -> Bool
    if dv_editando
        if codigo == 0x44 or codigo == 0x43
            dv_editando = false
            n = dv_filas[dv_sel].nodo
            antes = _dv_valor(n, dv_props[dv_prop])
            if dv_valor == antes
                return false
            end
            if _dv_poner(n, dv_props[dv_prop], dv_valor)
                return true
            end
            dv_editando = true
        elif codigo == 0x45
            dv_editando = false
            dv_mensaje = ""
        elif codigo == 0x41
            if dv_cursor > 0
                dv_valor = dv_valor[0:dv_cursor - 1] + dv_valor[dv_cursor:]
                dv_cursor = dv_cursor - 1
            end
        elif codigo == 0x46
            if dv_cursor < dv_valor.length
                dv_valor = dv_valor[0:dv_cursor] + dv_valor[dv_cursor + 1:]
            end
        elif codigo == 0x4F
            if (teclas & 4) != 0
                dv_cursor = 0
            elif dv_cursor > 0
                dv_cursor = dv_cursor - 1
            end
        elif codigo == 0x4E
            if (teclas & 4) != 0
                dv_cursor = dv_valor.length
            elif dv_cursor < dv_valor.length
                dv_cursor = dv_cursor + 1
            end
        elif letra != "" and str_code(letra, 0) >= 32 and str_code(letra, 0) != 127
            dv_valor = dv_valor[0:dv_cursor] + letra + dv_valor[dv_cursor:]
            dv_cursor = dv_cursor + 1
        end
        return false
    end
    if dv_eligiendo
        tipos = str_split(TIPOS, "|")
        if codigo == 0x4C and dv_tipo > 0
            dv_tipo = dv_tipo - 1
        elif codigo == 0x4D and dv_tipo < tipos.length - 1
            dv_tipo = dv_tipo + 1
        elif codigo == 0x44 or codigo == 0x43
            return _dv_anadir_tipo(tipos[dv_tipo])
        elif codigo == 0x45
            dv_eligiendo = false
        end
        return false
    end
    if codigo == 0x42 and (teclas & 7) == 0
        # Tab: la ventana o el árbol
        dv_ver_arbol = not dv_ver_arbol
        dv_herramienta = ""
        return false
    end
    if codigo == 0x45 and dv_herramienta != ""
        dv_herramienta = ""
        return false
    end
    if dv_prop < 0
        if letra == "+"
            return _dv_anadir()
        end
        if codigo == 0x46
            return _dv_quitar()
        end
        if (teclas & 4) != 0 and (codigo == 0x4C or codigo == 0x4D)
            if codigo == 0x4C
                return _dv_mover(-1)
            end
            return _dv_mover(1)
        end
    end
    if codigo == 0x4C
        if dv_prop >= 0
            if dv_prop > 0
                dv_prop = dv_prop - 1
            end
        elif dv_sel > 0
            dv_sel = dv_sel - 1
            _dv_listar_props()
        end
    elif codigo == 0x4D
        if dv_prop >= 0
            if dv_prop < dv_props.length - 1
                dv_prop = dv_prop + 1
            end
        elif dv_sel < dv_filas.length - 1
            dv_sel = dv_sel + 1
            _dv_listar_props()
        end
    elif codigo == 0x4E or ((codigo == 0x44 or codigo == 0x43) and dv_prop < 0)
        if dv_prop < 0 and dv_props.length > 0
            dv_prop = 0
        end
    elif codigo == 0x4F or (codigo == 0x45 and dv_prop >= 0)
        dv_prop = -1
    elif codigo == 0x44 or codigo == 0x43
        _dv_empezar_edicion()
    end
    dv_mensaje = ""
    return false
end

func _dv_empezar_edicion()
    if dv_prop < 0
        return
    end
    dv_valor = _dv_valor(dv_filas[dv_sel].nodo, dv_props[dv_prop])
    dv_cursor = dv_valor.length
    dv_editando = true
end

# Elige en el árbol la fila de ese nodo
func _dv_elegir_nodo(n: Json)
    i = 0
    while i < dv_filas.length
        if dv_filas[i].nodo == n
            if dv_sel != i
                dv_prop = -1
            end
            dv_sel = i
            _dv_listar_props()
            return
        end
        i = i + 1
    end
end

# El botón de la paleta en ese punto (desde la esquina de la zona): su número, o -1
func _dv_chip_en(x: Int, y: Int) -> Int
    i = 0
    while i < _dv_chips_x.length
        if x >= _dv_chips_x[i] and x < _dv_chips_x[i] + _dv_chips_w[i] and y >= _dv_chips_y[i] and y < _dv_chips_y[i] + dv_fila_alto
            return i
        end
        i = i + 1
    end
    return -1
end

# Pone lo arrastrado (uno nuevo de tipo, o el nodo movido) donde dijo lz_destino; true si cambió
func _dv_soltar(tipo: String, movido: Json) -> Bool
    lista = lz_dest_lista
    if lista == nil
        return false
    end
    i = lz_dest_indice
    var n: Json = nil
    if movido != nil
        # se quita de su lista (si es la misma y estaba antes, el sitio de destino corre uno)
        var f: Fila = nil
        for fi in dv_filas
            if fi.nodo == movido
                f = fi
            end
        end
        if f == nil or f.padre == nil
            return false
        end
        k = _dv_posicion(f.padre, movido)
        if f.padre == lista and (k == i or k == i - 1)
            return false
        end
        f.padre.items.remove(k)
        if f.padre == lista and k < i
            i = i - 1
        end
        n = movido
    else
        n = _dv_nuevo(tipo)
    end
    _dv_meter(lista, i, n)
    _dv_buscar = n
    _dv_hacer_filas()
    return true
end

# Un clic en la zona (desde la esquina del lienzo de Forja; la zona empieza en dv_arriba). Da 0 si solo cambió lo
# que se ve, 1 si cambió el fichero (dv_texto() es el nuevo) y 2 si fue un doble clic en un objeto de la ventana
# (Forja va a su manejador: dv_evento_elegido).
func dv_clic(x: Int, y: Int) -> Int
    dv_editando = false
    dv_mensaje = ""
    dv_arr_tipo = ""
    dv_arr_nodo = nil
    dv_arrastrando = false
    zy = y - dv_arriba
    if zy < 0
        return 0
    end
    if zy < dv_paleta_alto
        k = _dv_chip_en(x, zy)
        if k < 0
            return 0
        end
        if k == _dv_chips_x.length - 1
            dv_ver_arbol = not dv_ver_arbol
            dv_herramienta = ""
            return 0
        end
        tipo = str_split(TIPOS, "|")[k]
        if dv_ver_arbol
            # sin la ventana a la vista: como "+" con ese tipo
            if dv_filas[dv_sel].clase == F_OBJETO
                return _dv_resultado(_dv_anadir_tipo(tipo))
            end
            return 0
        end
        # se elige (otro clic en él lo suelta); arrastrándolo, se pone donde se suelte
        if dv_herramienta == tipo
            dv_herramienta = ""
        else
            dv_herramienta = tipo
        end
        dv_arr_tipo = tipo
        return 0
    end
    if y < dv_y0
        return 0
    end
    i = (y - dv_y0) / dv_fila_alto
    if x < dv_corte and not dv_ver_arbol
        lx = x
        ly = zy - dv_paleta_alto
        c = lz_en(lx, ly)
        if dv_herramienta != ""
            # con un tipo elegido en la paleta: uno nuevo donde se pulsó
            tipo = dv_herramienta
            dv_herramienta = ""
            lz_destino(lx, ly, nil)
            return _dv_resultado(_dv_soltar(tipo, nil))
        end
        if c == nil
            return 0
        end
        n = c.nodo
        if lz_en_titulo(lx, ly)
            n = dv_ventana
        end
        p = lz_pestana_en(c, lx, ly)
        if p >= 0
            lz_poner_pagina(c.nodo, p)
        end
        _dv_elegir_nodo(n)
        ahora = time_ms()
        if n == _dv_clic_nodo and ahora - _dv_clic_ms < DV_DOBLE_MS
            _dv_clic_nodo = nil
            return 2
        end
        _dv_clic_nodo = n
        _dv_clic_ms = ahora
        if c.padre != nil and n != dv_ventana
            dv_arr_nodo = n
        end
        return 0
    end
    if x < dv_corte
        i = i + dv_primera
        if i < dv_filas.length
            dv_sel = i
            dv_prop = -1
            _dv_listar_props()
        end
    elif i < dv_props.length
        dv_prop = i
        _dv_empezar_edicion()
    end
    return 0
end

func _dv_resultado(cambio: Bool) -> Int
    if cambio
        return 1
    end
    return 0
end

# Arrastrando con el ratón (estado 1: moviendo, 2: soltado), desde un botón de la paleta o un objeto de la
# ventana; true si cambió el fichero
func dv_arrastre(x: Int, y: Int, estado: Int) -> Bool
    if dv_arr_tipo == "" and dv_arr_nodo == nil
        return false
    end
    lx = x
    ly = y - dv_arriba - dv_paleta_alto
    dentro = not dv_ver_arbol and x >= 0 and x < dv_corte and ly >= 0
    if estado == 1
        dv_arrastrando = true
        if dentro
            lz_destino(lx, ly, dv_arr_nodo)
        else
            lz_dest_lista = nil
        end
        return false
    end
    tipo = dv_arr_tipo
    movido = dv_arr_nodo
    dv_arr_tipo = ""
    dv_arr_nodo = nil
    dv_arrastrando = false
    if not dentro
        lz_dest_lista = nil
        return false
    end
    dv_herramienta = ""
    lz_destino(lx, ly, movido)
    r = _dv_soltar(tipo, movido)
    lz_dest_lista = nil
    return r
end

# Para las pruebas: dónde se ve cada cosa, desde la esquina de la ventana de Forja ("tipo:x,y,ancho,alto" de cada
# botón de la paleta, "nombre:x,y,ancho,alto" de cada objeto con nombre de la ventana, "titulo:..." de su barra y
# "props:..." de la primera fila de las propiedades, separados por espacios)
func dv_sonda() -> String
    r = ""
    tipos = str_split(TIPOS, "|")
    i = 0
    while i < _dv_chips_x.length
        t = "vista"
        if i < tipos.length
            t = tipos[i]
        end
        r = r + "#{t}:#{_dv_px0 + _dv_chips_x[i]},#{_dv_py0 + _dv_chips_y[i]},#{_dv_chips_w[i]},#{dv_fila_alto} "
        i = i + 1
    end
    if not dv_ver_arbol
        # (los que no tienen nombre, como "_tipoN": el N-ésimo sin nombre de ese tipo, en el orden del dibujo)
        var vistos: {String: Int} = {}
        for c in lz_cajas
            nombre = json_get_str(c.nodo, "name")
            if nombre == ""
                k = vistos.get(c.tipo, 0) + 1
                vistos[c.tipo] = k
                nombre = "_" + c.tipo + "#{k}"
            end
            r = r + "#{nombre}:#{_dv_vx0 + c.x},#{_dv_vy0 + c.y},#{c.w},#{c.h} "
        end
        r = r + "titulo:#{_dv_vx0 + lz_vx},#{_dv_vy0 + lz_vy},#{lz_vw},#{lz_titulo_alto} "
    end
    # la primera fila de las propiedades (las demás van debajo, de dv_fila_alto en dv_fila_alto)
    r = r + "props:#{_dv_props_px},#{_dv_props_y},#{_dv_props_derecha - _dv_props_px},#{dv_fila_alto}"
    return r
end

# --- El evento del elegido (el doble clic; lo pidió Jose) ---

var dv_ev_clave: String = ""      # la propiedad del evento ("event", "change", "ack", "double", "close")
var dv_ev_objeto: String = ""     # el nombre del objeto (para la constante del código)
var dv_ev_cambio: Bool = false    # se le puso número o nombre: el fichero cambió (dv_texto())

# La propiedad del evento de un nodo, según su tipo ("" si no da eventos)
func _dv_clave_evento(f: Fila) -> String
    n = f.nodo
    if f.clase == F_VENTANA
        return "close"
    end
    if f.clase == F_MENU
        return ""
    end
    if f.clase == F_ELEMENTO
        if json_get_bool(n, "separator") or json_has(n, "submenu")
            return ""
        end
        return "event"
    end
    tipo = json_get_str(n, "type")
    if tipo == "button" or tipo == "image_button"
        return "event"
    end
    if tipo == "checkbox" or tipo == "cycle" or tipo == "slider" or tipo == "scrollbar" or tipo == "tabs" or tipo == "image_toggle"
        return "change"
    end
    if tipo == "list"
        if json_has(n, "double") and not json_has(n, "change")
            return "double"
        end
        return "change"
    end
    if tipo == "string" or tipo == "combo" or tipo == "text_editor"
        if json_has(n, "change") and not json_has(n, "ack")
            return "change"
        end
        return "ack"
    end
    # otro tipo con un evento puesto a mano
    for p in ["event", "change", "ack", "double"]
        if json_has(n, p)
            return p
        end
    end
    return ""
end

# Los números de evento del fichero (de todos los objetos, menús y ventanas)
func _dv_numeros(n: Json, r: [Int])
    if n == nil
        return
    end
    if n.kind == JSON_OBJECT
        for p in ["event", "change", "ack", "double", "close"]
            v = json_get(n, p)
            if v != nil and v.kind == JSON_NUMBER
                r.push(json_num(v))
            end
        end
        i = 0
        while i < json_length(n)
            _dv_numeros(json_value_at(n, i), r)
            i = i + 1
        end
    elif n.kind == JSON_ARRAY
        i = 0
        while i < json_length(n)
            _dv_numeros(json_at(n, i), r)
            i = i + 1
        end
    end
end

# Los nombres que ya hay en la ventana
func _dv_nombres(n: Json, r: [String])
    if n == nil
        return
    end
    if n.kind == JSON_OBJECT
        if json_has(n, "name")
            r.push(json_get_str(n, "name"))
        end
        i = 0
        while i < json_length(n)
            _dv_nombres(json_value_at(n, i), r)
            i = i + 1
        end
    elif n.kind == JSON_ARRAY
        i = 0
        while i < json_length(n)
            _dv_nombres(json_at(n, i), r)
            i = i + 1
        end
    end
end

# las palabras del lenguaje (las de compiler/dashui.py reserved() de Dash) y window, el campo de la ventana
const DV_RESERVADAS = "EventLoop|Main|Print|Ptr|Stop|Wait|Window|and|borrow|break|const|continue|elif|else|end|enum|false|fn|for|func|if|import|in|interface|nil|not|or|return|self|step|struct|true|var|weak|while|window"

# Un nombre de campo sacado de un texto ("_Saludar" -> "saludar"), o "" si no sale uno que valga
func dv_nombre_de(texto: String) -> String
    t = str_lower(texto)
    de = "áéíóúàèìòùäëïöüâêîôûñç"
    a = "aeiouaeiouaeiouaeiounc"
    r = ""
    i = 0
    while i < t.length
        c = t[i:i + 1]
        k = str_find(de, c)
        if k >= 0
            c = a[k:k + 1]
        end
        o = str_code(c, 0)
        if (o >= 97 and o <= 122) or (o >= 48 and o <= 57)
            r = r + c
        elif (o == 32 or o == 45 or o == 46) and r != "" and not str_ends(r, "_")
            r = r + "_"
        end
        i = i + 1
    end
    while str_ends(r, "_")
        r = r[0:r.length - 1]
    end
    while r != "" and str_code(r, 0) >= 48 and str_code(r, 0) <= 57
        r = r[1:]
    end
    if r.length > 24
        r = r[0:24]
    end
    for p in str_split(DV_RESERVADAS, "|")
        if r == str_lower(p)
            return ""
        end
    end
    return r
end

# El evento del elegido para ir a su código: su número (0 si no da eventos: dv_mensaje dice por qué). Si no tenía
# número, le pone el menor libre (que no esté en el fichero ni en ocupados, los const del .dash); si no tenía
# nombre, uno de su texto o de su tipo (dv_ev_cambio). dv_ev_objeto: su nombre.
func dv_evento(ocupados: [Int]) -> Int
    dv_ev_cambio = false
    dv_mensaje = ""
    f = dv_filas[dv_sel]
    clave = _dv_clave_evento(f)
    dv_ev_clave = clave
    if clave == ""
        if f.clase == F_OBJETO
            dv_mensaje = hueco(tr(1107, "Un objeto %1 no da eventos."), dv_nombre_tipo(json_get_str(f.nodo, "type")))
        else
            dv_mensaje = tr(1108, "Esto no da eventos.")
        end
        return 0
    end
    n = f.nodo
    # el nombre: el que tenga, o uno nuevo (la ventana siempre lo tiene)
    nombre = json_get_str(n, "name")
    if nombre == "" and f.clase != F_VENTANA
        var usados: [String] = []
        _dv_nombres(dv_ventana, usados)
        base = ""
        for p in ["label", "text", "title"]
            if base == "" and json_has(n, p)
                base = dv_nombre_de(lz_texto(json_get_str(n, p)))
            end
        end
        if base == ""
            if f.clase == F_ELEMENTO
                base = dv_nombre_de(tr(1109, "opcion"))
            else
                base = dv_nombre_de(dv_nombre_tipo(json_get_str(n, "type")))
            end
        end
        nombre = base
        k = 1
        while true
            repetido = false
            for u in usados
                if u == nombre
                    repetido = true
                end
            end
            if not repetido
                break
            end
            nombre = base + "#{k}"
            k = k + 1
        end
        json_set_str(n, "name", nombre)
        dv_ev_cambio = true
    end
    dv_ev_objeto = nombre
    v = json_get(n, clave)
    if v != nil and v.kind == JSON_NUMBER and json_num(v) > 0
        if dv_ev_cambio
            _dv_buscar = n
            _dv_hacer_filas()
        end
        return json_num(v)
    end
    var hay: [Int] = []
    _dv_numeros(dv_raiz, hay)
    for o in ocupados
        hay.push(o)
    end
    libre = 1
    while true
        esta = false
        for h in hay
            if h == libre
                esta = true
            end
        end
        if not esta
            break
        end
        libre = libre + 1
    end
    json_set_int(n, clave, libre)
    dv_ev_cambio = true
    _dv_buscar = n
    _dv_hacer_filas()
    return libre
end

# --- Vista previa ---

# Una copia sin eventos ni atajos (no deben llegar a Forja), y cerrar da evento_cerrar
func _dv_sin_eventos(n: Json)
    if n == nil
        return
    end
    if n.kind == JSON_OBJECT
        for p in ["event", "change", "ack", "double", "key", "close"]
            json_remove(n, p)
        end
        i = 0
        while i < json_length(n)
            _dv_sin_eventos(json_value_at(n, i))
            i = i + 1
        end
    elif n.kind == JSON_ARRAY
        i = 0
        while i < json_length(n)
            _dv_sin_eventos(json_at(n, i))
            i = i + 1
        end
    end
end

# Abre (o rehace) la ventana de verdad; "" si bien, o por qué no. volver: el teclado se queda en Forja
func dv_vista_previa(evento_cerrar: Int, volver: Bool) -> String
    copia = json_parse(json_write(dv_ventana))
    _dv_sin_eventos(copia)
    # sin el número de ventana: MUI recordaría su sitio, y puede ser el mismo que el de Forja
    json_remove(copia, "id")
    # los colores de los campos son de toda la aplicación: cambiarían los de Forja
    json_remove(copia, "field_colors")
    json_set_int(copia, "close", evento_cerrar)
    doc = json_object()
    json_set_int(doc, "dashui", 1)
    lista = json_array()
    json_push(lista, copia)
    json_set(doc, "windows", lista)
    ui = dashui_window(json_write(doc), "")
    if ui.error != ""
        return ui.error
    end
    if dv_vista != 0
        mui_window_dispose(dv_vista)
    end
    dv_vista = ui.window
    if volver
        # rehecha tras un cambio: sin quitarle el teclado a Forja
        mui_window_open_back(dv_vista)
    else
        mui_window_open(dv_vista)
    end
    return ""
end

func dv_cerrar_vista()
    mui_window_dispose(dv_vista)
    dv_vista = 0
end

# --- Dibujar ---

# La lista de tipos, con el elegido a la vista
func _dv_dibujar_tipos(px: Int, y: Int, derecha: Int, alto: Int)
    tipos = str_split(TIPOS, "|")
    gfx_pen(tema.tenue)
    gfx_text_at(px + DV_MARGEN, y + 4 + font_baseline(), tr(75, "Tipo del objeto nuevo (Return):"))
    caben = (alto - 8) / dv_fila_alto - 1
    desde = dv_tipo - caben + 1
    if desde < 0
        desde = 0
    end
    fy = y + 4 + dv_fila_alto
    i = desde
    while i < tipos.length and fy + dv_fila_alto <= y + alto
        if i == dv_tipo
            gfx_pen(tema.seleccion)
            gfx_rect(px, fy, derecha, fy + dv_fila_alto - 1)
        end
        gfx_pen(tema.texto)
        gfx_text_at(px + DV_MARGEN + 8, fy + 1 + font_baseline(), tipos[i])
        fy = fy + dv_fila_alto
        i = i + 1
    end
end

# arriba: lo que hay entre la esquina de la zona e y (las pestañas), para los clics
func dv_dibujar(x: Int, y: Int, ancho: Int, alto: Int, arriba: Int)
    gfx_pen(tema.fondo)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    usar_panel(0)
    dv_fila_alto = font_height() + 3
    dv_arriba = arriba
    dv_paleta_alto = 0
    dv_y0 = arriba + 4
    if dv_error_carga != ""
        gfx_pen(tema.error)
        gfx_text_at(x + DV_MARGEN, y + 4 + font_baseline(), dv_error_carga)
        gfx_pen(tema.tenue)
        gfx_text_at(x + DV_MARGEN, y + 4 + dv_fila_alto + font_baseline(), tr(76, "Amiga-D enseña el fichero como texto."))
        return
    end
    # la paleta, arriba, de lado a lado; debajo, la ventana o el árbol, y las propiedades
    dv_paleta_alto = _dv_dibujar_paleta(x, y, ancho)
    y = y + dv_paleta_alto
    alto = alto - dv_paleta_alto
    dv_y0 = arriba + dv_paleta_alto + 4
    dv_corte = ancho * 45 / 100
    if not dv_ver_arbol
        dv_corte = ancho * 62 / 100
        _dv_dibujar_ventana(x, y, dv_corte - 4, alto)
        if lz_vy < 0
            # la ventana bajada tapa la paleta: otra vez encima
            _dv_dibujar_paleta(x, y - dv_paleta_alto, ancho)
        end
    else
        _dv_dibujar_arbol(x, y, alto)
    end
    _dv_dibujar_props(x, y, ancho, alto)
end

# Un icono de la paleta, de 12 x 9 desde (x, y)
func _dv_icono(tipo: String, x: Int, y: Int)
    x2 = x + 11
    y2 = y + 8
    gfx_pen(tema.texto)
    if tipo == "button"
        gfx_box(x, y + 1, x2, y2 - 1)
        gfx_pen(tema.tenue)
        gfx_line(x + 1, y2, x2 + 1, y2)
        gfx_line(x2 + 1, y + 2, x2 + 1, y2)
    elif tipo == "text"
        gfx_line(x, y + 1, x2, y + 1)
        gfx_line(x, y + 4, x2 - 2, y + 4)
        gfx_line(x, y + 7, x2 - 4, y + 7)
    elif tipo == "label"
        gfx_line(x + 3, y + 4, x2 - 1, y + 4)
        gfx_rect(x2, y + 2, x2, y + 2)
        gfx_rect(x2, y + 6, x2, y + 6)
    elif tipo == "string"
        gfx_box(x, y + 1, x2, y2 - 1)
        gfx_line(x + 3, y + 3, x + 3, y2 - 3)
    elif tipo == "checkbox"
        gfx_box(x + 2, y, x + 10, y2)
        gfx_line(x + 4, y + 4, x + 6, y + 6)
        gfx_line(x + 6, y + 6, x + 9, y + 2)
    elif tipo == "cycle"
        gfx_box(x, y + 1, x2, y2 - 1)
        gfx_line(x + 4, y + 1, x + 4, y2 - 1)
        gfx_line(x + 1, y + 3, x + 3, y + 3)
    elif tipo == "slider"
        gfx_line(x, y + 4, x2, y + 4)
        gfx_rect(x + 4, y + 1, x + 6, y2 - 1)
    elif tipo == "gauge"
        gfx_box(x, y + 2, x2, y2 - 2)
        gfx_rect(x + 1, y + 3, x + 6, y2 - 3)
    elif tipo == "list"
        gfx_box(x, y, x2, y2)
        gfx_line(x + 2, y + 2, x2 - 2, y + 2)
        gfx_line(x + 2, y + 4, x2 - 2, y + 4)
        gfx_line(x + 2, y + 6, x2 - 4, y + 6)
    elif tipo == "canvas"
        gfx_box(x, y, x2, y2)
        gfx_line(x, y, x2, y2)
        gfx_line(x, y2, x2, y)
    elif tipo == "scrollbar"
        gfx_box(x + 3, y, x + 8, y2)
        gfx_rect(x + 4, y + 2, x + 7, y + 4)
    elif tipo == "image"
        gfx_box(x, y, x2, y2)
        gfx_line(x + 1, y2 - 1, x + 5, y + 3)
        gfx_line(x + 5, y + 3, x + 8, y + 6)
        gfx_rect(x + 8, y + 2, x + 9, y + 3)
    elif tipo == "combo"
        gfx_box(x, y + 1, x + 7, y2 - 1)
        gfx_line(x + 8, y + 3, x2, y + 3)
        gfx_line(x + 9, y + 4, x2 - 1, y + 4)
        gfx_rect(x + 10, y + 5, x + 10, y + 5)
    elif tipo == "space"
        gfx_pattern(0xAAAA)
        gfx_box(x, y, x2, y2)
        gfx_pattern(0xFFFF)
    elif tipo == "balance"
        gfx_line(x + 4, y, x + 4, y2)
        gfx_line(x + 7, y, x + 7, y2)
    elif tipo == "hgroup"
        gfx_box(x, y + 2, x + 3, y2 - 2)
        gfx_box(x + 4, y + 2, x + 7, y2 - 2)
        gfx_box(x + 8, y + 2, x2, y2 - 2)
    elif tipo == "vgroup"
        gfx_box(x + 2, y, x2 - 2, y + 2)
        gfx_box(x + 2, y + 3, x2 - 2, y + 5)
        gfx_box(x + 2, y + 6, x2 - 2, y2)
    elif tipo == "frame"
        gfx_line(x, y + 2, x + 2, y + 2)
        gfx_line(x + 9, y + 2, x2, y + 2)
        gfx_line(x, y + 2, x, y2)
        gfx_line(x2, y + 2, x2, y2)
        gfx_line(x, y2, x2, y2)
        gfx_line(x + 4, y + 1, x + 7, y + 1)
    elif tipo == "columns"
        gfx_box(x, y, x2, y2)
        gfx_line(x + 6, y, x + 6, y2)
        gfx_line(x, y + 4, x2, y + 4)
    elif tipo == "tabs"
        gfx_box(x, y + 3, x2, y2)
        gfx_box(x, y, x + 5, y + 3)
        gfx_line(x + 6, y + 1, x + 9, y + 1)
        gfx_line(x + 9, y + 1, x + 9, y + 3)
    elif tipo == "scroll"
        gfx_box(x, y, x2, y2)
        gfx_line(x2 - 3, y, x2 - 3, y2)
        gfx_rect(x2 - 2, y + 2, x2 - 1, y + 4)
    end
end

# La paleta: un icono por tipo y, al final, el botón que cambia entre la ventana y el árbol; a su derecha, el
# nombre de lo que tiene el puntero encima. Da su alto.
func _dv_dibujar_paleta(x: Int, y: Int, ancho: Int) -> Int
    _dv_chips_x.clear()
    _dv_chips_y.clear()
    _dv_chips_w.clear()
    tipos = str_split(TIPOS, "|")
    cambio = tr(1103, "Árbol")
    if dv_ver_arbol
        cambio = tr(1102, "Ventana")
    end
    cx = DV_MARGEN / 2
    cy = 2
    i = 0
    while i <= tipos.length
        w = 17
        if i == tipos.length
            w = font_text_width(cambio) + 10
            cx = cx + 4
        end
        if cx + w > ancho - 2 and cx > DV_MARGEN / 2
            cx = DV_MARGEN / 2
            cy = cy + dv_fila_alto + 1
        end
        _dv_chips_x.push(cx)
        _dv_chips_y.push(cy)
        _dv_chips_w.push(w)
        cx = cx + w + 1
        i = i + 1
    end
    h = cy + dv_fila_alto + 3
    _dv_px0 = x
    _dv_py0 = y
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + h - 1)
    i = 0
    while i <= tipos.length
        bx = x + _dv_chips_x[i]
        by = y + _dv_chips_y[i]
        bx2 = bx + _dv_chips_w[i] - 1
        by2 = by + dv_fila_alto - 1
        if i < tipos.length
            elegido = tipos[i] == dv_herramienta or (dv_arrastrando and tipos[i] == dv_arr_tipo)
            if elegido
                gfx_pen(tema.seleccion)
                gfx_rect(bx, by, bx2, by2)
            end
            if i == dv_encima
                gfx_pen(tema.borde)
                gfx_box(bx, by, bx2, by2)
            end
            _dv_icono(tipos[i], bx + 2, by + (dv_fila_alto - 9) / 2)
        else
            gfx_pen(tema.acento)
            gfx_box(bx, by, bx2, by2)
            gfx_text_at(bx + 5, by + 1 + font_baseline(), cambio)
        end
        i = i + 1
    end
    # el nombre de lo que tiene el puntero encima (o del tipo elegido), detrás del último botón
    nombre = ""
    if dv_encima >= 0 and dv_encima < tipos.length
        nombre = dv_nombre_tipo(tipos[dv_encima])
    elif dv_herramienta != ""
        nombre = dv_nombre_tipo(dv_herramienta)
    end
    k = tipos.length
    nx = x + _dv_chips_x[k] + _dv_chips_w[k] + 8
    if nombre != "" and nx + font_text_width(nombre) < x + ancho
        gfx_pen(tema.tenue)
        gfx_text_at(nx, y + _dv_chips_y[k] + 1 + font_baseline(), nombre)
    end
    gfx_pen(tema.borde)
    gfx_line(x, y + h - 1, x + ancho - 1, y + h - 1)
    return h
end

# El puntero se mueve sobre la zona (sin botón): true si hay que redibujar (cambió el icono de debajo)
func dv_mover(x: Int, y: Int) -> Bool
    k = -1
    zy = y - dv_arriba
    if zy >= 0 and zy < dv_paleta_alto
        k = _dv_chip_en(x, zy)
    end
    if k == dv_encima
        return false
    end
    dv_encima = k
    return true
end

# La rueda sobre la ventana dibujada la sube o la baja (si no cabe)
func dv_rueda(paso: Int)
    lz_desplazado = lz_desplazado - paso * 12
    if lz_desplazado < 0
        lz_desplazado = 0
    end
end

# Las pestañas que esconden a n enseñan su página
func _dv_mostrar(raiz: Json, n: Json) -> Bool
    if raiz == n
        return true
    end
    hijos = json_get(raiz, "children")
    if hijos == nil
        return false
    end
    i = 0
    while i < json_length(hijos)
        if _dv_mostrar(json_at(hijos, i), n)
            if json_get_str(raiz, "type") == "tabs"
                lz_poner_pagina(raiz, i)
            end
            return true
        end
        i = i + 1
    end
    return false
end

# La ventana dibujada, con lo elegido marcado y, si se arrastra algo, dónde caería
func _dv_dibujar_ventana(x: Int, y: Int, ancho: Int, alto: Int)
    elegido = dv_filas[dv_sel].nodo
    if dv_filas[dv_sel].clase == F_OBJETO
        raiz = json_get(dv_ventana, "root")
        if raiz != nil
            _dv_mostrar(raiz, elegido)
        end
    elif dv_filas[dv_sel].clase != F_VENTANA
        elegido = nil
    end
    lz_disponer(dv_ventana, ancho, alto)
    # que lo elegido se vea (y que no sobre hueco abajo si la ventana cabe)
    maximo = lz_vh + 12 - alto + font_height() + 4
    if maximo < 0
        maximo = 0
    end
    if lz_desplazado > maximo
        lz_desplazado = maximo
        lz_disponer(dv_ventana, ancho, alto)
    end
    if elegido != nil and not dv_arrastrando
        c = lz_caja_de(elegido)
        if c != nil and (c.y < 0 or c.y + c.h > alto - font_height() - 6)
            lz_desplazado = lz_desplazado + c.y - (alto - c.h) / 2
            if lz_desplazado < 0
                lz_desplazado = 0
            end
            lz_disponer(dv_ventana, ancho, alto)
        end
    end
    _dv_vx0 = x
    _dv_vy0 = y
    lz_dibujar(x, y, elegido)
    if dv_arrastrando
        lz_dibujar_destino(x, y)
    end
    gfx_pen(tema.tenue)
    ayuda = ""
    if dv_herramienta != ""
        ayuda = hueco(tr(1104, "Un clic en la ventana pone ahí: %1 (Esc, nada)."), dv_nombre_tipo(dv_herramienta))
    else
        ayuda = tr(1105, "Arrastra para mover. Doble clic: a su código.")
    end
    gfx_text_at(x + DV_MARGEN, y + alto - 4 - font_height() + font_baseline(), ayuda)
end

# El árbol, desde la fila que deja ver la elegida
func _dv_dibujar_arbol(x: Int, y: Int, alto: Int)
    caben = (alto - 8) / dv_fila_alto
    if caben < 1
        caben = 1
    end
    if dv_sel < dv_primera
        dv_primera = dv_sel
    end
    if dv_sel >= dv_primera + caben
        dv_primera = dv_sel - caben + 1
    end
    if dv_primera > dv_filas.length - caben
        dv_primera = dv_filas.length - caben
    end
    if dv_primera < 0
        dv_primera = 0
    end
    fy = y + 4
    i = dv_primera
    while i < dv_filas.length
        f = dv_filas[i]
        if fy + dv_fila_alto > y + alto
            break
        end
        if i == dv_sel
            gfx_pen(tema.fondo_linea)
            if dv_prop < 0
                gfx_pen(tema.seleccion)
            end
            gfx_rect(x, fy, x + dv_corte - 4, fy + dv_fila_alto - 1)
        end
        gfx_pen(tema.texto)
        if i == 0
            gfx_pen(tema.acento)
        end
        gfx_text_at(x + DV_MARGEN + f.nivel * DV_SANGRIA, fy + 1 + font_baseline(), _dv_titulo(f, i))
        fy = fy + dv_fila_alto
        i = i + 1
    end
end

# Las propiedades del elegido (o la lista de tipos para el objeto nuevo)
var _dv_props_px: Int = 0
var _dv_props_y: Int = 0
var _dv_props_derecha: Int = 0
var dv_solo_fila: Bool = false    # con mui_canvas_update: solo la propiedad que se escribe

# Solo la propiedad que se está escribiendo (escribir no cambia nada más: no hace falta dibujarlo todo)
func dv_dibujar_fila_editada()
    if dv_prop < 0 or dv_prop >= dv_props.length
        return
    end
    fy = _dv_props_y + dv_prop * dv_fila_alto
    gfx_pen(tema.seleccion)
    gfx_rect(_dv_props_px, fy, _dv_props_derecha, fy + dv_fila_alto - 1)
    base = fy + 1 + font_baseline()
    gfx_pen(tema.tenue)
    gfx_text_at(_dv_props_px + DV_MARGEN, base, dv_props[dv_prop])
    gfx_pen(tema.texto)
    gfx_text_at(dv_columna_valor, base, dv_valor)
    cx = dv_columna_valor + font_text_width(dv_valor[0:dv_cursor])
    gfx_pen(tema.cursor)
    gfx_rect(cx, fy, cx + 1, fy + dv_fila_alto - 1)
end

# Dónde está esa fila en el lienzo de Forja: [x, y, ancho, alto]
func dv_zona_fila_editada(ancho: Int) -> [Int]
    return [dv_corte, dv_y0 + dv_prop * dv_fila_alto, ancho - dv_corte, dv_fila_alto]
end

func _dv_dibujar_props(x: Int, y: Int, ancho: Int, alto: Int)
    px = x + dv_corte
    gfx_pen(tema.fondo_panel)
    gfx_rect(px, y, x + ancho - 1, y + alto - 1)
    if dv_eligiendo
        _dv_dibujar_tipos(px, y, x + ancho - 1, alto)
        return
    end
    n = dv_filas[dv_sel].nodo
    dv_columna_valor = 0
    for p in dv_props
        w = font_text_width(p)
        if w > dv_columna_valor
            dv_columna_valor = w
        end
    end
    dv_columna_valor = px + DV_MARGEN + dv_columna_valor + 12
    _dv_props_px = px
    _dv_props_y = y + 4
    _dv_props_derecha = x + ancho - 1
    fy = y + 4
    i = 0
    for p in dv_props
        if fy + dv_fila_alto > y + alto - dv_fila_alto
            break
        end
        if i == dv_prop
            gfx_pen(tema.seleccion)
            gfx_rect(px, fy, x + ancho - 1, fy + dv_fila_alto - 1)
        end
        base = fy + 1 + font_baseline()
        gfx_pen(tema.tenue)
        gfx_text_at(px + DV_MARGEN, base, p)
        valor = _dv_valor(n, p)
        if i == dv_prop and dv_editando
            valor = dv_valor
        end
        gfx_pen(tema.texto)
        gfx_text_at(dv_columna_valor, base, valor)
        if i == dv_prop and dv_editando
            cx = dv_columna_valor + font_text_width(dv_valor[0:dv_cursor])
            gfx_pen(tema.cursor)
            gfx_rect(cx, fy, cx + 1, fy + dv_fila_alto - 1)
        end
        fy = fy + dv_fila_alto
        i = i + 1
    end
    if dv_mensaje != ""
        gfx_pen(tema.error)
        gfx_text_at(px + DV_MARGEN, y + alto - 4 - font_height() + font_baseline(), dv_mensaje)
    end
end
