# El editor de sprites: dibujar y animar sprites de hardware y BOBs (docs/SPRITES_LOOP.md).
#
#   s = sp_nuevo(true)           # un sprite de hardware: 16 de ancho, 2 planos (3 colores y el transparente)
#   s = sp_nuevo(false)          # un BOB: 32x32, 4 planos
#   c = sp_px(s, f, x, y)        # el color de un píxel del fotograma f
#   sp_poner(s, f, x, y, c)
#   sp_apuntar(s, f)             # antes de un cambio: f el fotograma que se toca, -1 si cambia todo
#   sp_deshacer(s) / sp_rehacer(s)
#
# Un fotograma es una lista de ancho * alto colores, fila a fila. El color 0 es el transparente.

import "tema.dash"

const SP_MAX_DESHACER = 50

# Herramientas
const SP_LAPIZ = 0
const SP_LINEA = 1
const SP_CAJA = 2
const SP_RELLENO = 3
const SP_GOTAS = 4
const SP_AGARRE = 5

struct Sprite
    ancho: Int            # de un fotograma
    alto: Int
    planos: Int           # 2^planos colores
    hardware: Bool        # sprite de hardware: 16 de ancho y 2 planos
    paleta: [Int]         # 256 colores 0xRRGGBB (se guardan los 2^planos primeros)
    fotos: [[Int]]
    actual: Int           # el fotograma que se dibuja
    color: Int
    herramienta: Int
    velocidad: Int        # tics (1/50 s) por fotograma
    cebolla: Bool
    agarre_x: Int         # el punto de agarre (GRAB)
    agarre_y: Int
    deshacer: [SpPaso]
    rehacer: [SpPaso]
end

# Lo que había antes de un cambio: un fotograma (foto >= 0), o todo (foto -1)
struct SpPaso
    foto: Int
    px: [Int]
    fotos: [[Int]]
    paleta: [Int]
    ancho: Int
    alto: Int
    planos: Int
    hardware: Bool
    actual: Int
end

# Los 32 primeros colores de un BOB; del 32 al 247, un cubo de 6x6x6; del 248 al 255, grises
var _SP_PALETA: [Int] = [0x000000, 0xFFFFFF, 0x777777, 0xBBBBBB, 0x444444, 0xAA0000, 0xFF5555, 0xAA5500,
                    0xFFAA00, 0xFFFF55, 0x00AA00, 0x55FF55, 0x00AAAA, 0x55FFFF, 0x0000AA, 0x5555FF,
                    0xAA00AA, 0xFF55FF, 0x553311, 0x996633, 0xDDAA77, 0xFFDDBB, 0x113355, 0x336699,
                    0x6699CC, 0x224422, 0x447744, 0x88AA66, 0x552255, 0x884488, 0xCC77AA, 0x333344]

func sp_paleta_inicial(hardware: Bool) -> [Int]
    var p: [Int] = []
    for c in _SP_PALETA
        p.push(c)
    end
    while p.length < 248
        i = p.length - 32
        p.push(((i / 36) % 6) * 51 * 65536 + ((i / 6) % 6) * 51 * 256 + (i % 6) * 51)
    end
    while p.length < 256
        g = (p.length - 247) * 28
        p.push(g * 65536 + g * 256 + g)
    end
    if hardware
        p[1] = 0xE0E0E0
        p[2] = 0xE08030
        p[3] = 0x3060C0
    end
    return p
end

func sp_vacio(ancho: Int, alto: Int) -> [Int]
    var px: [Int] = []
    n = ancho * alto
    i = 0
    while i < n
        px.push(0)
        i = i + 1
    end
    return px
end

func sp_nuevo(hardware: Bool) -> Sprite
    ancho = 32
    alto = 32
    planos = 4
    if hardware
        ancho = 16
        alto = 16
        planos = 2
    end
    var fotos: [[Int]] = []
    fotos.push(sp_vacio(ancho, alto))
    var d1: [SpPaso] = []
    var d2: [SpPaso] = []
    return Sprite(ancho, alto, planos, hardware, sp_paleta_inicial(hardware), fotos, 0, 1, SP_LAPIZ, 6, false, 0, 0, d1, d2)
end

func sp_colores(s: Sprite) -> Int
    return 1 << s.planos
end

func sp_px(s: Sprite, f: Int, x: Int, y: Int) -> Int
    if x < 0 or y < 0 or x >= s.ancho or y >= s.alto
        return 0
    end
    return s.fotos[f][y * s.ancho + x]
end

func sp_poner(s: Sprite, f: Int, x: Int, y: Int, c: Int)
    if x >= 0 and y >= 0 and x < s.ancho and y < s.alto
        s.fotos[f][y * s.ancho + x] = c
    end
end

# --- Deshacer ---

func _sp_copia_fotos(s: Sprite) -> [[Int]]
    var r: [[Int]] = []
    for f in s.fotos
        r.push(f[0:f.length])
    end
    return r
end

func _sp_paso(s: Sprite, foto: Int) -> SpPaso
    var vacio: [Int] = []
    var ninguno: [[Int]] = []
    if foto >= 0
        px = s.fotos[foto]
        return SpPaso(foto, px[0:px.length], ninguno, vacio, s.ancho, s.alto, s.planos, s.hardware, s.actual)
    end
    return SpPaso(-1, vacio, _sp_copia_fotos(s), s.paleta[0:s.paleta.length], s.ancho, s.alto, s.planos, s.hardware, s.actual)
end

# Deja s como estaba en p
func _sp_volver(s: Sprite, p: SpPaso)
    if p.foto >= 0
        s.fotos[p.foto] = p.px
        s.actual = p.foto
        return
    end
    s.fotos = p.fotos
    s.paleta = p.paleta
    s.ancho = p.ancho
    s.alto = p.alto
    s.planos = p.planos
    s.hardware = p.hardware
    s.actual = p.actual
    if s.actual >= s.fotos.length
        s.actual = s.fotos.length - 1
    end
    if s.color >= sp_colores(s)
        s.color = sp_colores(s) - 1
    end
end

# Antes de cambiar el fotograma foto (o todo, con -1)
func sp_apuntar(s: Sprite, foto: Int)
    s.deshacer.push(_sp_paso(s, foto))
    if s.deshacer.length > SP_MAX_DESHACER
        s.deshacer.remove(0)
    end
    s.rehacer.clear()
end

func sp_deshacer(s: Sprite) -> Bool
    if s.deshacer.length == 0
        return false
    end
    p = s.deshacer.pop()
    s.rehacer.push(_sp_paso(s, p.foto))
    _sp_volver(s, p)
    return true
end

func sp_rehacer(s: Sprite) -> Bool
    if s.rehacer.length == 0
        return false
    end
    p = s.rehacer.pop()
    s.deshacer.push(_sp_paso(s, p.foto))
    _sp_volver(s, p)
    return true
end

# --- Ficheros: IFF ILBM ---
# Los fotogramas van uno al lado del otro. FRJA (texto): "1 tipo ancho velocidad", tipo 1 sprite de hardware, 0
# BOB. GRAB: el punto de agarre. Se escribe sin comprimir; se lee también ByteRun1 y el plano de máscara.

var sp_error: String = ""     # por qué no se pudo leer o escribir

func _sp_texto_en(b: Int, o: Int, t: String)
    i = 0
    while i < t.length
        buffer_set_byte(b, o + i, str_code(t, i))
        i = i + 1
    end
end

# Un trozo: su nombre y su largo; devuelve dónde van sus datos
func _sp_trozo(b: Int, o: Int, nombre: String, largo: Int) -> Int
    _sp_texto_en(b, o, nombre)
    buffer_set_long(b, o + 4, largo)
    return o + 8
end

func sp_escribir(s: Sprite, ruta: String) -> Bool
    nf = s.fotos.length
    w = s.ancho * nf
    h = s.alto
    planos = s.planos
    fila = ((w + 15) / 16) * 2
    cuerpo = fila * h * planos
    ncol = 1 << planos
    cmap = ncol * 3
    tipo = 0
    if s.hardware
        tipo = 1
    end
    frja = "1 #{tipo} #{s.ancho} #{s.velocidad}"
    largo_frja = frja.length + (frja.length & 1)
    total = 4 + 28 + 8 + cmap + (cmap & 1) + 12 + 8 + largo_frja + 8 + cuerpo
    b = buffer_alloc(total + 8)
    if b == 0
        sp_error = tr(80, "No hay memoria para el fichero.")
        return false
    end
    buffer_fill(b, 0, total + 8, 0)
    o = _sp_trozo(b, 0, "FORM", total)
    _sp_texto_en(b, o, "ILBM")
    o = _sp_trozo(b, o + 4, "BMHD", 20)
    buffer_set_word(b, o, w)
    buffer_set_word(b, o + 2, h)
    buffer_set_byte(b, o + 8, planos)
    buffer_set_byte(b, o + 9, 2)              # masking 2: el color transparente
    buffer_set_byte(b, o + 14, 10)            # proporción del píxel
    buffer_set_byte(b, o + 15, 11)
    buffer_set_word(b, o + 16, w)
    buffer_set_word(b, o + 18, h)
    o = _sp_trozo(b, o + 20, "CMAP", cmap)
    i = 0
    while i < ncol
        c = s.paleta[i]
        buffer_set_byte(b, o + i * 3, (c >> 16) & 255)
        buffer_set_byte(b, o + i * 3 + 1, (c >> 8) & 255)
        buffer_set_byte(b, o + i * 3 + 2, c & 255)
        i = i + 1
    end
    o = _sp_trozo(b, o + cmap + (cmap & 1), "GRAB", 4)
    buffer_set_word(b, o, s.agarre_x)
    buffer_set_word(b, o + 2, s.agarre_y)
    o = _sp_trozo(b, o + 4, "FRJA", frja.length)
    _sp_texto_en(b, o, frja)
    o = _sp_trozo(b, o + largo_frja, "BODY", cuerpo)
    y = 0
    while y < h
        f = 0
        while f < nf
            px = s.fotos[f]
            x = 0
            while x < s.ancho
                c = px[y * s.ancho + x]
                if c != 0
                    gx = f * s.ancho + x
                    bit = 0x80 >> (gx & 7)
                    p = 0
                    while p < planos
                        if (c >> p) & 1 != 0
                            d = o + (y * planos + p) * fila + (gx >> 3)
                            buffer_set_byte(b, d, buffer_get_byte(b, d) | bit)
                        end
                        p = p + 1
                    end
                end
                x = x + 1
            end
            f = f + 1
        end
        y = y + 1
    end
    ok = false
    fh = file_open(ruta, 1006)
    if fh != 0
        ok = file_write(fh, b, total + 8) == total + 8
        file_close(fh)
    end
    buffer_free(b)
    if not ok
        sp_error = tr(81, "No se puede escribir ") + ruta
    end
    return ok
end

# Una fila de un plano a partir de pos del BODY, en la fila de destino (ByteRun1 si comprimido); la posición que
# sigue, o -1 si el BODY se acaba antes
func _sp_fila(b: Int, pos: Int, fin: Int, comprimido: Bool, destino: Int, largo: Int) -> Int
    if not comprimido
        if pos + largo > fin
            return -1
        end
        buffer_copy(destino, 0, b, pos, largo)
        return pos + largo
    end
    n = 0
    while n < largo
        if pos >= fin
            return -1
        end
        c = buffer_get_byte(b, pos)
        pos = pos + 1
        if c < 128
            k = c + 1
            if pos + k > fin
                return -1
            end
            if n + k > largo
                k = largo - n
            end
            buffer_copy(destino, n, b, pos, k)
            pos = pos + c + 1
            n = n + k
        elif c > 128
            k = 257 - c
            if pos >= fin
                return -1
            end
            if n + k > largo
                k = largo - n
            end
            buffer_fill(destino, n, k, buffer_get_byte(b, pos))
            pos = pos + 1
            n = n + k
        end
    end
    return pos
end

func _sp_leer_error(b: Int, texto: String) -> Sprite
    if b != 0
        buffer_free(b)
    end
    sp_error = texto
    return nil
end

# Lee un IFF ILBM; nil si no se puede (sp_error dice por qué)
func sp_leer(ruta: String) -> Sprite
    n = file_size(ruta)
    if n < 12
        return _sp_leer_error(0, tr(82, "No se puede leer ") + ruta)
    end
    b = buffer_alloc(n)
    if b == 0
        return _sp_leer_error(0, tr(80, "No hay memoria para el fichero."))
    end
    fh = file_open(ruta, 1005)
    leidos = 0
    if fh != 0
        leidos = file_read(fh, b, n)
        file_close(fh)
    end
    if leidos != n
        return _sp_leer_error(b, tr(82, "No se puede leer ") + ruta)
    end
    if not buffer_equals(b, 0, 4, "FORM") or not buffer_equals(b, 8, 4, "ILBM")
        return _sp_leer_error(b, ruta + tr(83, " no es una imagen IFF ILBM."))
    end
    w = 0
    h = 0
    planos = 0
    mascara = 0
    comp = 0
    ncol = 0
    cmap = 0
    cuerpo = -1
    fin_cuerpo = 0
    gx = 0
    gy = 0
    frja = ""
    pos = 12
    while pos + 8 <= n
        nombre = str_from_buffer(b, pos, 4)
        largo = buffer_get_long(b, pos + 4)
        d = pos + 8
        if largo < 0 or d + largo > n
            largo = n - d
        end
        if nombre == "BMHD" and largo >= 20
            w = buffer_get_word(b, d)
            h = buffer_get_word(b, d + 2)
            planos = buffer_get_byte(b, d + 8)
            mascara = buffer_get_byte(b, d + 9)
            comp = buffer_get_byte(b, d + 10)
        elif nombre == "CMAP"
            cmap = d
            ncol = largo / 3
        elif nombre == "GRAB" and largo >= 4
            gx = buffer_get_word(b, d)
            gy = buffer_get_word(b, d + 2)
        elif nombre == "FRJA"
            frja = str_from_buffer(b, d, largo)
        elif nombre == "BODY"
            cuerpo = d
            fin_cuerpo = d + largo
        end
        pos = d + largo + (largo & 1)
    end
    if w <= 0 or h <= 0 or cuerpo < 0
        return _sp_leer_error(b, ruta + tr(84, ": a la imagen le falta BMHD o BODY."))
    end
    if planos < 1 or planos > 8 or comp > 1
        return _sp_leer_error(b, ruta + tr(85, ": solo imágenes de 1 a 8 planos, sin comprimir o con ByteRun1."))
    end
    # los píxeles de toda la tira
    fila = ((w + 15) / 16) * 2
    tmp = buffer_alloc(fila)
    var img: [Int] = sp_vacio(w, h)
    p_total = planos
    if mascara == 1
        p_total = planos + 1
    end
    pos = cuerpo
    y = 0
    while y < h
        p = 0
        while p < p_total
            pos = _sp_fila(b, pos, fin_cuerpo, comp == 1, tmp, fila)
            if pos < 0
                buffer_free(tmp)
                return _sp_leer_error(b, ruta + tr(86, ": la imagen está cortada."))
            end
            if p < planos
                bit = 1 << p
                i = 0
                while i < fila
                    v = buffer_get_byte(tmp, i)
                    if v != 0
                        k = 0
                        while k < 8
                            x = i * 8 + k
                            if (v & (0x80 >> k)) != 0 and x < w
                                img[y * w + x] = img[y * w + x] | bit
                            end
                            k = k + 1
                        end
                    end
                    i = i + 1
                end
            end
            p = p + 1
        end
        y = y + 1
    end
    buffer_free(tmp)
    # el ancho del fotograma: el de FRJA, o la regla de bob_load (fotogramas cuadrados)
    hardware = false
    velocidad = 6
    fw = w
    if w > h and w % h == 0
        fw = h
    end
    partes = str_split(str_trim(frja), " ")
    if partes.length >= 4 and partes[0] == "1"
        a = Int(partes[2])
        if a > 0 and w % a == 0
            fw = a
        end
        if Int(partes[3]) > 0
            velocidad = Int(partes[3])
        end
        hardware = partes[1] == "1" and fw == 16 and planos <= 2
    end
    paleta = sp_paleta_inicial(hardware)
    i = 0
    while i < ncol and i < 256
        paleta[i] = buffer_get_byte(b, cmap + i * 3) * 65536 + buffer_get_byte(b, cmap + i * 3 + 1) * 256 + buffer_get_byte(b, cmap + i * 3 + 2)
        i = i + 1
    end
    buffer_free(b)
    if hardware
        planos = 2
    end
    var fotos: [[Int]] = []
    f = 0
    while f < w / fw
        px = sp_vacio(fw, h)
        y = 0
        while y < h
            x = 0
            while x < fw
                px[y * fw + x] = img[y * w + f * fw + x]
                x = x + 1
            end
            y = y + 1
        end
        fotos.push(px)
        f = f + 1
    end
    var d1: [SpPaso] = []
    var d2: [SpPaso] = []
    sp_error = ""
    return Sprite(fw, h, planos, hardware, paleta, fotos, 0, 1, SP_LAPIZ, velocidad, false, gx, gy, d1, d2)
end

# --- En Forja ---

const SP_PATRON = "#?.(iff|ilbm|lbm|brush|bob|spr)"

# ¿Un nombre de imagen? (por la extensión)
func sp_extension(nombre: String) -> Bool
    n = str_lower(nombre)
    for e in [".iff", ".ilbm", ".lbm", ".brush", ".bob", ".spr"]
        if str_ends(n, e)
            return true
        end
    end
    return false
end

# ¿Empieza el fichero por FORM....ILBM?
func sp_es_ilbm(ruta: String) -> Bool
    b = buffer_alloc(12)
    if b == 0
        return false
    end
    ok = false
    fh = file_open(ruta, 1005)
    if fh != 0
        ok = file_read(fh, b, 12) == 12 and buffer_equals(b, 0, 4, "FORM") and buffer_equals(b, 8, 4, "ILBM")
        file_close(fh)
    end
    buffer_free(b)
    return ok
end

func _sp_hex(c: Int, cifras: Int) -> String
    t = str_upper(str_from_int(c, 16))
    while t.length < cifras
        t = "0" + t
    end
    return t
end

# Para las pruebas: "ancho alto planos hardware fotos actual color herramienta velocidad agarre_x agarre_y cebolla", las filas de cada
# fotograma, un color por cifra hexadecimal (dos con más de 4 planos), y "paleta RRGGBB ..."
func sp_sonda(s: Sprite) -> String
    t = "#{s.ancho} #{s.alto} #{s.planos} #{s.hardware} #{s.fotos.length} #{s.actual} #{s.color} #{s.herramienta} #{s.velocidad} #{s.agarre_x} #{s.agarre_y} #{s.cebolla}\n"
    cifras = 1
    if s.planos > 4
        cifras = 2
    end
    for px in s.fotos
        y = 0
        while y < s.alto
            x = 0
            while x < s.ancho
                t = t + _sp_hex(px[y * s.ancho + x], cifras)
                x = x + 1
            end
            t = t + "\n"
            y = y + 1
        end
    end
    t = t + "paleta"
    i = 0
    while i < sp_colores(s)
        t = t + " " + _sp_hex(s.paleta[i], 6)
        i = i + 1
    end
    return t + "\n"
end

# --- Dibujar ---
# La zona: la rejilla con zoom a la izquierda, el panel a la derecha (herramientas, paleta, vista), la tira de
# fotogramas debajo de la rejilla y la barra de estado abajo. La geometría del último dibujo se guarda para los clics
# (coordenadas de la ventana; sp_geometria() las da desde la esquina de la zona).

const SP_REJILLA_DESDE = 6     # con este zoom o más, líneas entre los píxeles

var sp_ms_dibujo: Int = 0
var _sp_pens: [Int] = []       # el lápiz de la pantalla de cada color de la paleta
var _sp_zx: Int = 0            # la esquina de la zona
var _sp_zy: Int = 0
var _sp_gx: Int = 0            # la esquina de la rejilla
var _sp_gy: Int = 0
var _sp_z: Int = 1             # el zoom: lado de un píxel en la pantalla
var sp_con_tira: Bool = true   # si cupo la tira de fotogramas
var sp_mensaje: String = ""    # un aviso para la barra de estado (con un sprite, la salida está oculta)
var sp_mensaje_tipo: Int = 0   # 0 normal, 1 error, 2 bien

# Los lápices de la pantalla de cada color; el 0 (transparente) es un gris del tema, distinto del negro
func _sp_preparar_pens(s: Sprite)
    _sp_pens = []
    i = 0
    while i < sp_colores(s)
        c = s.paleta[i]
        _sp_pens.push(color_pen((c >> 16) & 255, (c >> 8) & 255, c & 255))
        i = i + 1
    end
    _sp_pens[0] = tema.fondo_linea
end

func sp_panel_ancho(ancho: Int) -> Int
    if ancho >= 480
        return 168
    end
    return 128
end

# El alto de una miniatura de la tira (el doble si es bajo; las muy altas, muestreadas a 64)
func sp_miniatura_alto(s: Sprite) -> Int
    if s.alto <= 24
        return s.alto * 2
    end
    if s.alto <= 64
        return s.alto
    end
    return 64
end

# "x y zoom" de la rejilla, desde la esquina de la zona (para las pruebas)
func sp_geometria() -> String
    return "#{_sp_gx - _sp_zx} #{_sp_gy - _sp_zy} #{_sp_z}"
end

# La rejilla: cada fila por tramos del mismo color; con zoom grande, un hueco de 1 píxel entre filas y líneas
# verticales encima
func _sp_dibujar_rejilla(s: Sprite)
    px = s.fotos[s.actual]
    pens = _sp_pens
    z = _sp_z
    hueco = 0
    if z >= SP_REJILLA_DESDE
        hueco = 1
        gfx_pen(tema.borde)
        gfx_rect(_sp_gx - 1, _sp_gy - 1, _sp_gx + s.ancho * z - 1, _sp_gy + s.alto * z - 1)
    end
    ancho = s.ancho
    gx = _sp_gx
    puesto = -1
    y = 0
    i = 0
    while y < s.alto
        fy = _sp_gy + y * z
        fy2 = fy + z - 1 - hueco
        fin = i + ancho
        x = 0
        while i < fin
            c = px[i]
            i2 = i + 1
            while i2 < fin and px[i2] == c
                i2 = i2 + 1
            end
            p = pens[c]
            if p != puesto
                gfx_pen(p)
                puesto = p
            end
            x2 = x + i2 - i
            gfx_rect(gx + x * z, fy, gx + x2 * z - 1 - hueco, fy2)
            x = x2
            i = i2
        end
        y = y + 1
    end
    if hueco == 1
        gfx_pen(tema.borde)
        x = 1
        while x < ancho
            lx = gx + x * z - 1
            gfx_rect(lx, _sp_gy, lx, _sp_gy + s.alto * z - 2)
            x = x + 1
        end
    end
    # la piel de cebolla: el fotograma anterior, como un punto en las celdas vacías
    if s.cebolla and s.fotos.length > 1 and z >= 3
        ant = s.fotos[sp_anterior(s)]
        i = 0
        while i < px.length
            if px[i] == 0 and ant[i] != 0
                _sp_punto_cebolla(s, i, ant[i], hueco)
            end
            i = i + 1
        end
    end
    # la línea o la caja que se está arrastrando
    if _sp_figura
        gfx_pen(_sp_pens[_sp_con])
        for i in _sp_puntos_figura(s)
            cx = gx + (i % ancho) * z
            cy = _sp_gy + (i / ancho) * z
            gfx_rect(cx, cy, cx + z - 1 - hueco, cy + z - 1 - hueco)
        end
    end
    # el punto de agarre, con la herramienta de agarre
    if s.herramienta == SP_AGARRE
        ax = gx + s.agarre_x * z + z / 2
        ay = _sp_gy + s.agarre_y * z + z / 2
        gfx_pen(tema.cursor)
        gfx_rect(ax - z, ay, ax + z, ay)
        gfx_rect(ax, ay - z, ax, ay + z)
    end
end

# El fotograma de antes del actual (el último si el actual es el primero: las animaciones dan la vuelta)
func sp_anterior(s: Sprite) -> Int
    return (s.actual + s.fotos.length - 1) % s.fotos.length
end

# Un punto en el centro de la celda i, del color c, de un tercio de su lado
func _sp_punto_cebolla(s: Sprite, i: Int, c: Int, hueco: Int)
    lado = (_sp_z - hueco) / 3
    if lado < 1
        lado = 1
    end
    cx = _sp_gx + (i % s.ancho) * _sp_z + (_sp_z - hueco - lado) / 2
    cy = _sp_gy + (i / s.ancho) * _sp_z + (_sp_z - hueco - lado) / 2
    gfx_pen(_sp_pens[c])
    gfx_rect(cx, cy, cx + lado - 1, cy + lado - 1)
end

# Solo la rejilla (mientras se arrastra una línea o una caja)
func sp_dibujar_rejilla_sola(s: Sprite)
    _sp_dibujar_rejilla(s)
end

# x, y, ancho y alto de la rejilla, desde la esquina de la zona
func sp_zona_rejilla(s: Sprite) -> [Int]
    return [_sp_gx - _sp_zx - 1, _sp_gy - _sp_zy - 1, s.ancho * _sp_z + 2, s.alto * _sp_z + 2]
end

# Un fotograma en pequeño: cada píxel de e x e en la pantalla, tomando uno de cada k (para los muy altos)
func _sp_miniatura(s: Sprite, f: Int, x: Int, y: Int, e: Int, k: Int)
    px = s.fotos[f]
    pens = _sp_pens
    puesto = -1
    fy = 0
    yy = 0
    while yy < s.alto
        fila = yy * s.ancho
        xx = 0
        fx = 0
        while xx < s.ancho
            c = px[fila + xx]
            x2 = xx + k
            n = 1
            while x2 < s.ancho and px[fila + x2] == c
                x2 = x2 + k
                n = n + 1
            end
            p = pens[c]
            if p != puesto
                gfx_pen(p)
                puesto = p
            end
            gfx_rect(x + fx * e, y + fy * e, x + (fx + n) * e - 1, y + fy * e + e - 1)
            fx = fx + n
            xx = x2
        end
        yy = yy + k
        fy = fy + 1
    end
end

# La escala de las miniaturas: e (aumento) y k (uno de cada k píxeles)
func _sp_escala_miniatura(s: Sprite) -> [Int]
    if s.alto <= 24
        return [2, 1]
    end
    if s.alto <= 64
        return [1, 1]
    end
    return [1, (s.alto + 63) / 64]
end

# La tira de fotogramas: una miniatura por fotograma (el actual enmarcado) y un "+" al final; se desplaza para
# que se vea el actual
func _sp_dibujar_tira(s: Sprite, x: Int, y: Int, ancho: Int, alto: Int)
    gfx_pen(tema.fondo_salida)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    ek = _sp_escala_miniatura(s)
    e = ek[0]
    k = ek[1]
    mw = ((s.ancho + k - 1) / k) * e
    mh = ((s.alto + k - 1) / k) * e
    paso = mw + 8
    caben = (ancho - 16 - 20) / paso
    if caben < 1
        caben = 1
    end
    desde = 0
    if s.actual >= caben
        desde = s.actual - caben + 1
    end
    my = y + (alto - mh) / 2
    f = desde
    mx = x + 8
    while f < s.fotos.length and mx + mw <= x + ancho - 28
        if f == s.actual
            gfx_pen(tema.cursor)
            gfx_box(mx - 2, my - 2, mx + mw + 1, my + mh + 1)
        end
        _sp_miniatura(s, f, mx, my, e, k)
        _sp_boton(mx, my, mx + mw - 1, my + mh - 1, SP_A_FOTO + f)
        mx = mx + paso
        f = f + 1
    end
    usar_panel(0)
    _sp_boton_texto(mx, y + alto / 2 - 8, mx + 16, y + alto / 2 + 8, "+", false, SP_A_FOTO_NUEVO)
end

func sp_nombre_herramienta(h: Int) -> String
    nombres = [tr(93, "Lápiz"), tr(94, "Línea"), tr(95, "Caja"), tr(96, "Relleno"), tr(97, "Cuentagotas"), tr(98, "Agarre")]
    return nombres[h]
end

func _sp_dibujar_estado(s: Sprite, x: Int, y: Int, ancho: Int, alto: Int)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    usar_panel(0)
    tipo = "BOB"
    if s.hardware
        tipo = tr(87, "Sprite de hardware")
    end
    t = tipo + "  #{s.ancho} x #{s.alto}  " + hueco2(tr(99, "fotograma %1 de %2"), "#{s.actual + 1}", "#{s.fotos.length}") + "  " + hueco(tr(100, "color %1"), "#{s.color}") + "  " + sp_nombre_herramienta(s.herramienta)
    if s.cebolla
        t = t + "  " + tr(118, "cebolla")
    end
    gfx_pen(tema.texto)
    if sp_mensaje != ""
        t = sp_mensaje
        if sp_mensaje_tipo == 1
            gfx_pen(tema.error)
        elif sp_mensaje_tipo == 2
            gfx_pen(tema.bien)
        end
    end
    gfx_text_at(x + 8, y + (alto - font_height()) / 2 + font_baseline(), t)
end

# --- Botones del lienzo: cada dibujo apunta sus zonas (rectángulo y acción); un clic las busca ---

const SP_A_COLOR = 1000        # + el número del color
const SP_A_BARRA = 2000        # + 0 rojo, 1 verde, 2 azul
const SP_A_HERR = 3000         # + la herramienta
const SP_A_ANCHO_MENOS = 4000
const SP_A_ANCHO_MAS = 4001
const SP_A_ALTO_MENOS = 4002
const SP_A_ALTO_MAS = 4003
const SP_A_PLANOS_MENOS = 4004
const SP_A_PLANOS_MAS = 4005
const SP_A_TIPO = 4006
const SP_A_PAGINA = 5000       # + la página del panel
const SP_A_FOTO = 6000         # + el número del fotograma (una miniatura de la tira)
const SP_A_FOTO_NUEVO = 5999   # el "+" del final de la tira

# El panel va en páginas, con pestañas arriba: en 640x256 no cabe todo a la vez
const SP_PAG_DIBUJO = 0
const SP_PAG_TAMANO = 1
var sp_pagina: Int = 0

var _sp_bx1: [Int] = []
var _sp_by1: [Int] = []
var _sp_bx2: [Int] = []
var _sp_by2: [Int] = []
var _sp_bacc: [Int] = []
var _sp_panel: String = ""     # para las pruebas: "x y lado columnas" de la paleta y "x y ancho paso" de las barras

func _sp_boton(x1: Int, y1: Int, x2: Int, y2: Int, accion: Int)
    _sp_bx1.push(x1)
    _sp_by1.push(y1)
    _sp_bx2.push(x2)
    _sp_by2.push(y2)
    _sp_bacc.push(accion)
end

# El botón bajo x, y de la ventana (su número en las listas); -1 si no hay
func _sp_boton_en(ax: Int, ay: Int) -> Int
    i = 0
    while i < _sp_bacc.length
        if ax >= _sp_bx1[i] and ax <= _sp_bx2[i] and ay >= _sp_by1[i] and ay <= _sp_by2[i]
            return i
        end
        i = i + 1
    end
    return -1
end

var _sp_panel_herr: String = ""   # "x y paso_x paso_y" de los botones de herramientas

func sp_geometria_panel() -> String
    return _sp_panel + " " + _sp_panel_herr
end

# Para las pruebas: "acción,x,y" del centro de cada botón, desde la esquina de la zona
func sp_botones() -> String
    t = ""
    i = 0
    while i < _sp_bacc.length
        t = t + "#{_sp_bacc[i]},#{(_sp_bx1[i] + _sp_bx2[i]) / 2 - _sp_zx},#{(_sp_by1[i] + _sp_by2[i]) / 2 - _sp_zy} "
        i = i + 1
    end
    return t
end

func _sp_titulo(x: Int, y: Int, texto: String) -> Int
    usar_panel(2)
    gfx_pen(tema.tenue)
    gfx_text_at(x, y + font_baseline(), texto)
    font_style(0)
    return y + font_height() + 3
end

func _sp_hex6(c: Int) -> String
    return "#" + _sp_hex(c, 6)
end

# La paleta (una cuadrícula), el color elegido y sus barras R G B; devuelve la y de debajo
func _sp_dibujar_paleta(s: Sprite, x: Int, y: Int, ancho: Int) -> Int
    n = sp_colores(s)
    # el título y, a la derecha, el color elegido: número y valor
    c = s.paleta[s.color]
    usar_panel(0)
    valor = "#{s.color}: " + _sp_hex6(c)
    gfx_pen(tema.texto)
    gfx_text_at(x + ancho - font_text_width(valor), y + font_baseline(), valor)
    y = _sp_titulo(x, y, tr(101, "PALETA"))
    cols = 8
    if n > 32
        cols = 16
    end
    if n < cols
        cols = n
    end
    lado = ancho / cols
    if lado > 16
        lado = 16
    end
    i = 0
    while i < n
        cx = x + (i % cols) * lado
        cy = y + (i / cols) * lado
        if i == 0
            gfx_pen(tema.fondo_linea)
            gfx_rect(cx, cy, cx + lado - 2, cy + lado - 2)
            gfx_pen(tema.tenue)
            gfx_line(cx, cy + lado - 2, cx + lado - 2, cy)
        else
            gfx_pen(_sp_pens[i])
            gfx_rect(cx, cy, cx + lado - 2, cy + lado - 2)
        end
        _sp_boton(cx, cy, cx + lado - 2, cy + lado - 2, SP_A_COLOR + i)
        i = i + 1
    end
    # el elegido, enmarcado
    ex = x + (s.color % cols) * lado
    ey = y + (s.color / cols) * lado
    gfx_pen(tema.cursor)
    gfx_box(ex - 1, ey - 1, ex + lado - 1, ey + lado - 1)
    panel = "#{x - _sp_zx} #{y - _sp_zy} #{lado} #{cols}"
    y = y + ((n + cols - 1) / cols) * lado + 4
    usar_panel(0)
    # las barras R G B (con clic o arrastrando)
    bx = x + 12
    bw = ancho - 14
    paso = 10
    k = 0
    for letra in ["R", "G", "B"]
        v = (c >> (16 - k * 8)) & 255
        by = y + k * paso
        gfx_pen(tema.tenue)
        gfx_text_at(x, by + font_baseline() - 1, letra)
        gfx_pen(tema.fondo)
        gfx_rect(bx, by, bx + bw - 1, by + 7)
        gfx_pen(tema.acento)
        gfx_rect(bx, by, bx + (bw - 1) * v / 255, by + 7)
        _sp_boton(bx, by, bx + bw - 1, by + 7, SP_A_BARRA + k)
        k = k + 1
    end
    _sp_panel = panel + " #{bx - _sp_zx} #{y - _sp_zy} #{bw} #{paso}"
    return y + 3 * paso + 4
end

# Un botón con texto, encendido o no
func _sp_boton_texto(x1: Int, y1: Int, x2: Int, y2: Int, texto: String, encendido: Bool, accion: Int)
    gfx_pen(tema.fondo_linea)
    if encendido
        gfx_pen(tema.seleccion)
    end
    gfx_rect(x1, y1, x2, y2)
    gfx_pen(tema.texto)
    w = font_text_width(texto)
    gfx_text_at(x1 + (x2 - x1 + 1 - w) / 2, y1 + (y2 - y1 + 1 - font_height()) / 2 + font_baseline(), texto)
    _sp_boton(x1, y1, x2, y2, accion)
end

# Las seis herramientas, en 3 columnas; devuelve la y de debajo
func _sp_dibujar_herramientas(s: Sprite, x: Int, y: Int, ancho: Int) -> Int
    usar_panel(0)
    bw = (ancho - 4) / 3
    bh = font_height() + 4
    cortos = [tr(93, "Lápiz"), tr(94, "Línea"), tr(95, "Caja"), tr(96, "Relleno"), tr(103, "Gotas"), tr(98, "Agarre")]
    h = 0
    while h < 6
        bx = x + (h % 3) * (bw + 2)
        by = y + (h / 3) * (bh + 2)
        _sp_boton_texto(bx, by, bx + bw - 1, by + bh - 1, cortos[h], h == s.herramienta, SP_A_HERR + h)
        h = h + 1
    end
    _sp_panel_herr = "#{x - _sp_zx} #{y - _sp_zy} #{bw + 2} #{bh + 2}"
    return y + 2 * (bh + 2) + 6
end

# Una fila "nombre  [-] valor [+]"; devuelve la y de debajo
func _sp_fila_numero(x: Int, y: Int, ancho: Int, nombre: String, valor: String, menos: Int, mas: Int) -> Int
    bh = font_height() + 2
    bw = bh + 4
    gfx_pen(tema.tenue)
    gfx_text_at(x, y + 1 + font_baseline(), nombre)
    _sp_boton_texto(x + ancho - 2 * bw - 40, y, x + ancho - bw - 41, y + bh - 1, "-", false, menos)
    gfx_pen(tema.texto)
    gfx_text_at(x + ancho - bw - 36, y + 1 + font_baseline(), valor)
    _sp_boton_texto(x + ancho - bw, y, x + ancho - 1, y + bh - 1, "+", false, mas)
    return y + bh + 2
end

# Ancho, alto, colores y el tipo; devuelve la y de debajo
func _sp_dibujar_tamano(s: Sprite, x: Int, y: Int, ancho: Int) -> Int
    y = _sp_titulo(x, y, tr(104, "TAMAÑO"))
    usar_panel(0)
    y = _sp_fila_numero(x, y, ancho, tr(105, "Ancho"), "#{s.ancho}", SP_A_ANCHO_MENOS, SP_A_ANCHO_MAS)
    y = _sp_fila_numero(x, y, ancho, tr(106, "Alto"), "#{s.alto}", SP_A_ALTO_MENOS, SP_A_ALTO_MAS)
    y = _sp_fila_numero(x, y, ancho, tr(107, "Colores"), "#{sp_colores(s)}", SP_A_PLANOS_MENOS, SP_A_PLANOS_MAS)
    tipo = tr(108, "Es un BOB (T)")
    if s.hardware
        tipo = tr(109, "Sprite de hardware (T)")
    end
    bh = font_height() + 4
    _sp_boton_texto(x, y, x + ancho - 1, y + bh - 1, tipo, false, SP_A_TIPO)
    return y + bh + 6
end

func _sp_dibujar_panel(s: Sprite, x: Int, y: Int, ancho: Int, alto: Int)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    # las pestañas de las páginas
    usar_panel(0)
    nombres = [tr(114, "Dibujo"), tr(104, "Tamaño")]
    bh = font_height() + 4
    bw = (ancho - 12) / nombres.length
    i = 0
    while i < nombres.length
        bx = x + 6 + i * bw
        _sp_boton_texto(bx, y + 4, bx + bw - 2, y + 4 + bh - 1, nombres[i], i == sp_pagina, SP_A_PAGINA + i)
        i = i + 1
    end
    y2 = y + 4 + bh + 6
    if sp_pagina == SP_PAG_TAMANO
        _sp_dibujar_tamano(s, x + 6, y2, ancho - 12)
    else
        y2 = _sp_dibujar_herramientas(s, x + 6, y2, ancho - 12)
        _sp_dibujar_paleta(s, x + 6, y2, ancho - 12)
    end
end

# x, y, ancho, alto: la zona bajo las pestañas; arriba: el alto de las pestañas (para la esquina de la zona)
func sp_dibujar(s: Sprite, x: Int, y: Int, ancho: Int, alto: Int, arriba: Int)
    t0 = time_ms()
    _sp_zx = x
    _sp_zy = y - arriba
    _sp_preparar_pens(s)
    _sp_bx1 = []
    _sp_by1 = []
    _sp_bx2 = []
    _sp_by2 = []
    _sp_bacc = []
    gfx_pen(tema.fondo)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    usar_panel(0)
    estado_alto = font_height() + 6
    panel = sp_panel_ancho(ancho)
    # la tira de fotogramas, si con ella la rejilla aún tiene zoom 4 (en una pantalla baja no cabe)
    tira = sp_miniatura_alto(s) + 12
    if (alto - estado_alto - tira - 8) / s.alto < 4
        tira = 0
    end
    sp_con_tira = tira > 0
    _sp_dibujar_panel(s, x + ancho - panel, y, panel, alto)
    if tira > 0
        _sp_dibujar_tira(s, x, y + alto - estado_alto - tira, ancho - panel, tira)
    end
    # la rejilla, del mayor zoom que quepa
    gw = ancho - panel - 8
    gh = alto - estado_alto - tira - 8
    z = gw / s.ancho
    if gh / s.alto < z
        z = gh / s.alto
    end
    if z > 32
        z = 32
    end
    if z < 1
        z = 1
    end
    _sp_z = z
    _sp_gx = x + 4 + (gw - s.ancho * z) / 2
    _sp_gy = y + 4 + (gh - s.alto * z) / 2
    _sp_dibujar_rejilla(s)
    _sp_dibujar_estado(s, x, y + alto - estado_alto, ancho - panel, estado_alto)
    sp_ms_dibujo = time_ms() - t0
end

# --- Ratón ---
# sp_clic y sp_arrastrar devuelven lo que hay que hacer, sumado: SP_CAMBIO (el documento cambió), SP_TODO
# (redibujar todo) y SP_CELDAS (redibujar solo las celdas de sp_tocados, con sp_zona_celda y sp_celda_sola).

const SP_CAMBIO = 1
const SP_TODO = 2
const SP_CELDAS = 4
const SP_REJILLA = 8           # redibujar solo la rejilla (sp_zona_rejilla, con sp_solo_rejilla)

const SP_Q_MAYUS = 1

var sp_solo_rejilla: Bool = false

const SP_Q_CTRL = 2
const SP_Q_ALT = 4

var sp_tocados: [Int] = []     # los píxeles (y * ancho + x) que cambió el último evento
var sp_celda_sola: Int = -1    # con mui_canvas_update: dibujar solo este píxel
var _sp_trazando: Bool = false
var _sp_figura: Bool = false   # arrastrando una línea o una caja (se ve, aún no está en el dibujo)
var _sp_rellena: Bool = false  # la caja, rellena (Mayúsculas al empezar)
var _sp_ix: Int = 0            # donde empezó la figura
var _sp_iy: Int = 0
var _sp_apuntado: Bool = false # el trazo ya guardó su paso de deshacer
var _sp_con: Int = 0           # el color del trazo
var _sp_ux: Int = 0            # el último píxel del trazo
var _sp_uy: Int = 0
var _sp_barra: Int = -1        # la barra de color que se arrastra (0 R, 1 G, 2 B), -1 ninguna
var _sp_barra_x: Int = 0       # dónde empieza y lo que mide (en la ventana)
var _sp_barra_w: Int = 1
var _sp_px: Int = 0            # lo que devuelve _sp_celda
var _sp_py: Int = 0

# El píxel bajo x, y de la zona (en _sp_px, _sp_py); false si cae fuera de la rejilla
func _sp_celda(s: Sprite, x: Int, y: Int) -> Bool
    ax = x + _sp_zx - _sp_gx
    ay = y + _sp_zy - _sp_gy
    if ax < 0 or ay < 0
        return false
    end
    _sp_px = ax / _sp_z
    _sp_py = ay / _sp_z
    return _sp_px < s.ancho and _sp_py < s.alto
end

# x, y, ancho y alto de la celda del píxel i, desde la esquina de la zona
func sp_zona_celda(s: Sprite, i: Int) -> [Int]
    return [_sp_gx - _sp_zx + (i % s.ancho) * _sp_z, _sp_gy - _sp_zy + (i / s.ancho) * _sp_z, _sp_z, _sp_z]
end

func sp_dibujar_celda(s: Sprite, i: Int)
    hueco = 0
    if _sp_z >= SP_REJILLA_DESDE
        hueco = 1
    end
    cx = _sp_gx + (i % s.ancho) * _sp_z
    cy = _sp_gy + (i / s.ancho) * _sp_z
    c = s.fotos[s.actual][i]
    gfx_pen(_sp_pens[c])
    gfx_rect(cx, cy, cx + _sp_z - 1 - hueco, cy + _sp_z - 1 - hueco)
    if c == 0 and s.cebolla and s.fotos.length > 1 and _sp_z >= 3
        a = s.fotos[sp_anterior(s)][i]
        if a != 0
            _sp_punto_cebolla(s, i, a, hueco)
        end
    end
end

# Pinta un píxel del trazo (guarda el paso de deshacer antes del primer cambio)
func _sp_pintar(s: Sprite, x: Int, y: Int)
    i = y * s.ancho + x
    px = s.fotos[s.actual]
    if px[i] == _sp_con
        return
    end
    if not _sp_apuntado
        sp_apuntar(s, s.actual)
        _sp_apuntado = true
    end
    px[i] = _sp_con
    sp_tocados.push(i)
end

# Una línea de píxeles (Bresenham), para que un arrastre rápido no deje huecos
func _sp_linea(s: Sprite, x0: Int, y0: Int, x1: Int, y1: Int)
    dx = x1 - x0
    sx = 1
    if dx < 0
        dx = -dx
        sx = -1
    end
    dy = y1 - y0
    sy = 1
    if dy < 0
        dy = -dy
        sy = -1
    end
    err = dx - dy
    while true
        _sp_pintar(s, x0, y0)
        if x0 == x1 and y0 == y1
            break
        end
        e2 = err * 2
        if e2 > -dy
            err = err - dy
            x0 = x0 + sx
        end
        if e2 < dx
            err = err + dx
            y0 = y0 + sy
        end
    end
end

# Un clic en la zona (x, y desde su esquina; teclas: las de mui_canvas_qualifiers)
# Pone la componente k (0 R, 1 G, 2 B) del color elegido según la x de la barra; en un sprite de hardware, en pasos
# de 4 bits (lo que da sprite_color)
func _sp_barra_poner(s: Sprite, ax: Int)
    v = (ax - _sp_barra_x) * 255 / (_sp_barra_w - 1)
    if v < 0
        v = 0
    end
    if v > 255
        v = 255
    end
    if s.hardware
        v = ((v + 8) / 17) * 17
    end
    desp = 16 - _sp_barra * 8
    c = s.paleta[s.color]
    s.paleta[s.color] = (c & ~(255 << desp)) | (v << desp)
end

# Los píxeles de la línea o la caja de _sp_ix, _sp_iy a _sp_ux, _sp_uy
func _sp_puntos_figura(s: Sprite) -> [Int]
    var r: [Int] = []
    if s.herramienta == SP_LINEA
        x0 = _sp_ix
        y0 = _sp_iy
        dx = _sp_ux - x0
        sx = 1
        if dx < 0
            dx = -dx
            sx = -1
        end
        dy = _sp_uy - y0
        sy = 1
        if dy < 0
            dy = -dy
            sy = -1
        end
        err = dx - dy
        while true
            r.push(y0 * s.ancho + x0)
            if x0 == _sp_ux and y0 == _sp_uy
                break
            end
            e2 = err * 2
            if e2 > -dy
                err = err - dy
                x0 = x0 + sx
            end
            if e2 < dx
                err = err + dx
                y0 = y0 + sy
            end
        end
        return r
    end
    x1 = _sp_ix
    x2 = _sp_ux
    if x2 < x1
        x1 = _sp_ux
        x2 = _sp_ix
    end
    y1 = _sp_iy
    y2 = _sp_uy
    if y2 < y1
        y1 = _sp_uy
        y2 = _sp_iy
    end
    y = y1
    while y <= y2
        x = x1
        while x <= x2
            if _sp_rellena or y == y1 or y == y2 or x == x1 or x == x2
                r.push(y * s.ancho + x)
            end
            x = x + 1
        end
        y = y + 1
    end
    return r
end

# Rellena desde x, y los píxeles del mismo color unidos por los lados (con una pila, sin recursión)
func _sp_rellenar(s: Sprite, x: Int, y: Int)
    px = s.fotos[s.actual]
    viejo = px[y * s.ancho + x]
    if viejo == _sp_con
        return
    end
    sp_apuntar(s, s.actual)
    var pila: [Int] = [y * s.ancho + x]
    while pila.length > 0
        i = pila.pop()
        if px[i] == viejo
            px[i] = _sp_con
            cx = i % s.ancho
            if cx > 0
                pila.push(i - 1)
            end
            if cx < s.ancho - 1
                pila.push(i + 1)
            end
            if i >= s.ancho
                pila.push(i - s.ancho)
            end
            if i + s.ancho < px.length
                pila.push(i + s.ancho)
            end
        end
    end
    sp_tocados.push(y * s.ancho + x)
end

func sp_clic(s: Sprite, x: Int, y: Int, teclas: Int) -> Int
    sp_mensaje = ""
    sp_tocados = []
    _sp_trazando = false
    _sp_barra = -1
    if not _sp_celda(s, x, y)
        b = _sp_boton_en(x + _sp_zx, y + _sp_zy)
        if b < 0
            return 0
        end
        a = _sp_bacc[b]
        if a >= SP_A_COLOR and a < SP_A_COLOR + 256
            s.color = a - SP_A_COLOR
            return SP_TODO
        end
        if a >= SP_A_FOTO
            s.actual = a - SP_A_FOTO
            return SP_TODO
        end
        if a == SP_A_FOTO_NUEVO
            return sp_nuevo_fotograma(s, false)
        end
        if a >= SP_A_PAGINA and a <= SP_A_PAGINA + SP_PAG_TAMANO
            sp_pagina = a - SP_A_PAGINA
            return SP_TODO
        end
        if a == SP_A_ANCHO_MENOS or a == SP_A_ANCHO_MAS
            return sp_cambiar_tamano(s, (a - SP_A_ANCHO_MENOS) * 2 - 1, 0)
        end
        if a == SP_A_ALTO_MENOS or a == SP_A_ALTO_MAS
            return sp_cambiar_tamano(s, 0, (a - SP_A_ALTO_MENOS) * 2 - 1)
        end
        if a == SP_A_PLANOS_MENOS or a == SP_A_PLANOS_MAS
            return sp_cambiar_planos(s, (a - SP_A_PLANOS_MENOS) * 2 - 1)
        end
        if a == SP_A_TIPO
            return sp_cambiar_tipo(s)
        end
        if a >= SP_A_HERR and a <= SP_A_HERR + SP_AGARRE
            s.herramienta = a - SP_A_HERR
            return SP_TODO
        end
        if a >= SP_A_BARRA and a <= SP_A_BARRA + 2
            sp_apuntar(s, -1)
            _sp_barra = a - SP_A_BARRA
            _sp_barra_x = _sp_bx1[b]
            _sp_barra_w = _sp_bx2[b] - _sp_bx1[b] + 1
            _sp_barra_poner(s, x + _sp_zx)
            return SP_CAMBIO | SP_TODO
        end
        return 0
    end
    if (teclas & SP_Q_CTRL) != 0 or s.herramienta == SP_GOTAS
        s.color = sp_px(s, s.actual, _sp_px, _sp_py)
        return SP_TODO
    end
    _sp_con = s.color
    if (teclas & SP_Q_ALT) != 0
        _sp_con = 0
    end
    if s.herramienta == SP_AGARRE
        s.agarre_x = _sp_px
        s.agarre_y = _sp_py
        return SP_CAMBIO | SP_TODO
    end
    if s.herramienta == SP_RELLENO
        _sp_rellenar(s, _sp_px, _sp_py)
        if sp_tocados.length > 0
            return SP_CAMBIO | SP_TODO
        end
        return 0
    end
    if s.herramienta == SP_LINEA or s.herramienta == SP_CAJA
        _sp_figura = true
        _sp_rellena = (teclas & SP_Q_MAYUS) != 0
        _sp_ix = _sp_px
        _sp_iy = _sp_py
        _sp_ux = _sp_px
        _sp_uy = _sp_py
        return SP_REJILLA
    end
    _sp_trazando = true
    _sp_apuntado = false
    _sp_ux = _sp_px
    _sp_uy = _sp_py
    _sp_pintar(s, _sp_px, _sp_py)
    if sp_tocados.length > 0
        return SP_CAMBIO | SP_TODO
    end
    return SP_TODO
end

# El ratón arrastrado (soltado: se soltó el botón)
func sp_arrastrar(s: Sprite, x: Int, y: Int, soltado: Bool) -> Int
    sp_tocados = []
    if _sp_barra >= 0
        _sp_barra_poner(s, x + _sp_zx)
        if soltado
            _sp_barra = -1
        end
        return SP_CAMBIO | SP_TODO
    end
    if _sp_figura
        if _sp_celda(s, x, y)
            _sp_ux = _sp_px
            _sp_uy = _sp_py
        end
        if not soltado
            return SP_REJILLA
        end
        # al soltar, la figura pasa al dibujo
        _sp_figura = false
        _sp_con2 = _sp_con
        puntos = _sp_puntos_figura(s)
        px = s.fotos[s.actual]
        cambia = false
        for i in puntos
            if px[i] != _sp_con2
                cambia = true
            end
        end
        if not cambia
            return SP_TODO
        end
        sp_apuntar(s, s.actual)
        for i in puntos
            px[i] = _sp_con2
        end
        return SP_CAMBIO | SP_TODO
    end
    if not _sp_trazando
        return 0
    end
    # al soltar también se pinta hasta donde se soltó: el último movimiento puede no haber llegado ahí
    dentro = _sp_celda(s, x, y)
    if dentro
        _sp_linea(s, _sp_ux, _sp_uy, _sp_px, _sp_py)
        _sp_ux = _sp_px
        _sp_uy = _sp_py
    end
    if soltado
        _sp_trazando = false
        if sp_tocados.length > 0
            return SP_CAMBIO | SP_TODO
        end
        return SP_TODO
    end
    if sp_tocados.length == 0
        return 0
    end
    return SP_CAMBIO | SP_CELDAS
end

# --- Tamaño, colores y tipo (todo con deshacer) ---

# Cada fotograma pasa a ancho x alto: lo que sobra se corta, lo que falta queda en el color 0
func _sp_redimensionar(s: Sprite, ancho: Int, alto: Int)
    var fotos: [[Int]] = []
    for px in s.fotos
        nuevo = sp_vacio(ancho, alto)
        y = 0
        while y < alto and y < s.alto
            x = 0
            while x < ancho and x < s.ancho
                nuevo[y * ancho + x] = px[y * s.ancho + x]
                x = x + 1
            end
            y = y + 1
        end
        fotos.push(nuevo)
    end
    s.fotos = fotos
    s.ancho = ancho
    s.alto = alto
    if s.agarre_x >= ancho
        s.agarre_x = ancho - 1
    end
    if s.agarre_y >= alto
        s.agarre_y = alto - 1
    end
end

# Deja solo los colores que caben en planos (los bits bajos, como sprite_load)
func _sp_poner_planos(s: Sprite, planos: Int)
    mascara = (1 << planos) - 1
    for px in s.fotos
        i = 0
        while i < px.length
            px[i] = px[i] & mascara
            i = i + 1
        end
    end
    s.planos = planos
    if s.color > mascara
        s.color = mascara
    end
end

func sp_cambiar_tamano(s: Sprite, dw: Int, dh: Int) -> Int
    if s.hardware and dw != 0
        sp_mensaje = tr(110, "Un sprite de hardware mide 16 de ancho (T lo pasa a BOB).")
        return SP_TODO
    end
    w = s.ancho + dw
    h = s.alto + dh
    if w < 1 or h < 1 or w > 256 or h > 256
        return 0
    end
    sp_apuntar(s, -1)
    _sp_redimensionar(s, w, h)
    return SP_CAMBIO | SP_TODO
end

func sp_cambiar_planos(s: Sprite, d: Int) -> Int
    if s.hardware
        sp_mensaje = tr(111, "Un sprite de hardware tiene 3 colores y el transparente (T lo pasa a BOB).")
        return SP_TODO
    end
    p = s.planos + d
    if p < 1 or p > 8
        return 0
    end
    sp_apuntar(s, -1)
    _sp_poner_planos(s, p)
    return SP_CAMBIO | SP_TODO
end

# De BOB a sprite de hardware (16 de ancho, 2 planos: se corta lo que no cabe) o al revés
func sp_cambiar_tipo(s: Sprite) -> Int
    sp_apuntar(s, -1)
    if s.hardware
        s.hardware = false
        sp_mensaje = tr(112, "Ahora es un BOB.")
        return SP_CAMBIO | SP_TODO
    end
    if s.ancho != 16
        _sp_redimensionar(s, 16, s.alto)
    end
    if s.planos != 2
        _sp_poner_planos(s, 2)
    end
    s.hardware = true
    sp_mensaje = tr(113, "Ahora es un sprite de hardware: 16 de ancho y 4 colores.")
    return SP_CAMBIO | SP_TODO
end

# --- Fotogramas ---

var _sp_copia: [Int] = []      # el fotograma copiado (Amiga-C), y su tamaño
var _sp_copia_ancho: Int = 0
var _sp_copia_alto: Int = 0

func sp_ir_fotograma(s: Sprite, paso: Int) -> Int
    n = s.fotos.length
    s.actual = ((s.actual + paso) % n + n) % n
    return SP_TODO
end

# Uno nuevo detrás del actual: vacío, o copia del actual
func sp_nuevo_fotograma(s: Sprite, copia: Bool) -> Int
    sp_apuntar(s, -1)
    nuevo = sp_vacio(s.ancho, s.alto)
    if copia
        px = s.fotos[s.actual]
        nuevo = px[0:px.length]
    end
    s.fotos.insert(s.actual + 1, nuevo)
    s.actual = s.actual + 1
    return SP_CAMBIO | SP_TODO
end

func sp_quitar_fotograma(s: Sprite) -> Int
    if s.fotos.length < 2
        sp_mensaje = tr(115, "Hace falta al menos un fotograma.")
        return SP_TODO
    end
    sp_apuntar(s, -1)
    s.fotos.remove(s.actual)
    if s.actual >= s.fotos.length
        s.actual = s.fotos.length - 1
    end
    return SP_CAMBIO | SP_TODO
end

# Cambia el actual de sitio con su vecino (paso -1 o 1)
func sp_mover_fotograma(s: Sprite, paso: Int) -> Int
    otro = s.actual + paso
    if otro < 0 or otro >= s.fotos.length
        return 0
    end
    sp_apuntar(s, -1)
    px = s.fotos[s.actual]
    s.fotos[s.actual] = s.fotos[otro]
    s.fotos[otro] = px
    s.actual = otro
    return SP_CAMBIO | SP_TODO
end

func sp_vaciar_fotograma(s: Sprite) -> Int
    sp_apuntar(s, s.actual)
    s.fotos[s.actual] = sp_vacio(s.ancho, s.alto)
    return SP_CAMBIO | SP_TODO
end

# Espejo (horizontal: izquierda y derecha) del fotograma actual
func sp_espejo(s: Sprite, horizontal: Bool) -> Int
    sp_apuntar(s, s.actual)
    px = s.fotos[s.actual]
    nuevo = sp_vacio(s.ancho, s.alto)
    y = 0
    while y < s.alto
        x = 0
        while x < s.ancho
            if horizontal
                nuevo[y * s.ancho + x] = px[y * s.ancho + s.ancho - 1 - x]
            else
                nuevo[y * s.ancho + x] = px[(s.alto - 1 - y) * s.ancho + x]
            end
            x = x + 1
        end
        y = y + 1
    end
    s.fotos[s.actual] = nuevo
    return SP_CAMBIO | SP_TODO
end

# Desplaza el dibujo del fotograma actual dx, dy píxeles; lo que sale por un lado entra por el otro
func sp_desplazar(s: Sprite, dx: Int, dy: Int) -> Int
    sp_apuntar(s, s.actual)
    px = s.fotos[s.actual]
    nuevo = sp_vacio(s.ancho, s.alto)
    y = 0
    while y < s.alto
        x = 0
        while x < s.ancho
            nx = (x + dx + s.ancho) % s.ancho
            ny = (y + dy + s.alto) % s.alto
            nuevo[ny * s.ancho + nx] = px[y * s.ancho + x]
            x = x + 1
        end
        y = y + 1
    end
    s.fotos[s.actual] = nuevo
    return SP_CAMBIO | SP_TODO
end

func sp_copiar_fotograma(s: Sprite)
    px = s.fotos[s.actual]
    _sp_copia = px[0:px.length]
    _sp_copia_ancho = s.ancho
    _sp_copia_alto = s.alto
    sp_mensaje = tr(116, "Fotograma copiado.")
end

# Pega lo copiado como un fotograma nuevo detrás del actual (si el tamaño es otro, desde la esquina y cortado)
func sp_pegar_fotograma(s: Sprite) -> Int
    if _sp_copia.length == 0
        sp_mensaje = tr(117, "No hay ningún fotograma copiado.")
        return SP_TODO
    end
    sp_apuntar(s, -1)
    nuevo = sp_vacio(s.ancho, s.alto)
    mascara = sp_colores(s) - 1
    y = 0
    while y < s.alto and y < _sp_copia_alto
        x = 0
        while x < s.ancho and x < _sp_copia_ancho
            nuevo[y * s.ancho + x] = _sp_copia[y * _sp_copia_ancho + x] & mascara
            x = x + 1
        end
        y = y + 1
    end
    s.fotos.insert(s.actual + 1, nuevo)
    s.actual = s.actual + 1
    return SP_CAMBIO | SP_TODO
end

# --- Teclado (sin Amiga) ---

const SP_T_ARRIBA = 0x4C
const SP_T_ABAJO = 0x4D

const SP_T_DERECHA = 0x4E
const SP_T_SUPRIMIR = 0x46
const SP_T_RETROCESO = 0x41
const SP_T_IZQUIERDA = 0x4F

func sp_tecla(s: Sprite, codigo: Int, teclas: Int, letra: String) -> Int
    sp_mensaje = ""
    n = sp_colores(s)
    if (teclas & SP_Q_CTRL) != 0
        if codigo == SP_T_DERECHA
            return sp_cambiar_tamano(s, 1, 0)
        elif codigo == SP_T_IZQUIERDA
            return sp_cambiar_tamano(s, -1, 0)
        elif codigo == SP_T_ABAJO
            return sp_cambiar_tamano(s, 0, 1)
        elif codigo == SP_T_ARRIBA
            return sp_cambiar_tamano(s, 0, -1)
        end
    end
    if str_lower(letra) == "t"
        return sp_cambiar_tipo(s)
    end
    if (teclas & SP_Q_MAYUS) != 0
        if codigo == SP_T_DERECHA
            return sp_desplazar(s, 1, 0)
        elif codigo == SP_T_IZQUIERDA
            return sp_desplazar(s, -1, 0)
        elif codigo == SP_T_ABAJO
            return sp_desplazar(s, 0, 1)
        elif codigo == SP_T_ARRIBA
            return sp_desplazar(s, 0, -1)
        end
    end
    if (teclas & SP_Q_ALT) != 0 and (codigo == SP_T_DERECHA or codigo == SP_T_IZQUIERDA)
        if codigo == SP_T_DERECHA
            return sp_mover_fotograma(s, 1)
        end
        return sp_mover_fotograma(s, -1)
    end
    if codigo == SP_T_DERECHA
        return sp_ir_fotograma(s, 1)
    end
    if codigo == SP_T_IZQUIERDA
        return sp_ir_fotograma(s, -1)
    end
    if codigo == SP_T_SUPRIMIR
        return sp_quitar_fotograma(s)
    end
    if codigo == SP_T_RETROCESO
        return sp_vaciar_fotograma(s)
    end
    l = str_lower(letra)
    if l == "o"
        s.cebolla = not s.cebolla
        return SP_TODO
    end
    if l == "n"
        return sp_nuevo_fotograma(s, false)
    elif l == "d"
        return sp_nuevo_fotograma(s, true)
    elif l == "h"
        return sp_espejo(s, true)
    elif l == "v"
        return sp_espejo(s, false)
    end
    if codigo == SP_T_ARRIBA
        s.color = (s.color + n - 1) % n
        return SP_TODO
    end
    if codigo == SP_T_ABAJO
        s.color = (s.color + 1) % n
        return SP_TODO
    end
    letras = "plbfka"
    h = str_find(letras, str_lower(letra))
    if letra.length == 1 and h >= 0
        s.herramienta = h
        return SP_TODO
    end
    if letra.length == 1 and str_code(letra, 0) >= 48 and str_code(letra, 0) <= 57
        c = str_code(letra, 0) - 48
        if c < n
            s.color = c
            return SP_TODO
        end
    end
    return 0
end
