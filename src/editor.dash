# El editor: los ficheros abiertos (pestañas), el cursor, la selección, deshacer y cómo se dibujan.
#
#   ed_abrir_texto("main.dash", "Work:juego/main.dash", texto)
#   ed_dibujar(x, y, ancho, alto)        # desde la función de dibujo del canvas
#   ed_tecla(codigo, teclas, letra)      # una tecla sobre el editor; true si hay que redibujar
#   ed_clic(x, y, extender) / ed_arrastrar(x, y)
#
# El texto va en Latin-1, una línea por elemento, sin tabuladores (al abrir pasan a 4 espacios). Las posiciones
# son (línea, columna) desde 0. La selección va del ancla (al, ac) al cursor (cl, cc); al = -1 si no hay.

import "tema.dash"
import "sintaxis.dash"
import "diseno.dash"
import "codigo.dash"
import "marcas.dash"
import "errores.dash"

const ALTO_PESTANAS = 18
const LISTA_FILAS = 8      # las filas de la lista para completar
const MARGEN_TEXTO = 6
const SANGRIA = 4
const MAX_DESHACER = 300

const INSERTAR = 1
const BORRAR = 2

# Teclas en bruto
const T_TAB = 0x42
const T_RETURN = 0x44
const T_ENTER = 0x43
const T_RETROCESO = 0x41
const T_SUPRIMIR = 0x46
const T_ESC = 0x45
const T_ARRIBA = 0x4C
const T_ABAJO = 0x4D
const T_DERECHA = 0x4E
const T_IZQUIERDA = 0x4F
# Teclas de calificación (mui_canvas_qualifiers)
const Q_MAYUS = 1
const Q_CTRL = 2
const Q_ALT = 4
const Q_AMIGA = 8

struct Cambio
    tipo: Int         # INSERTAR o BORRAR
    l: Int
    c: Int
    texto: String
    seguido: Bool     # letras escritas una tras otra: se deshacen juntas
    junto: Bool       # se deshace con el cambio de antes (escribir sobre una selección: borrarla y meter)
    marcas: [Int] = nil     # al quitar varias líneas: los marcadores que había en ellas (desde su primera línea), para
    plegadas: [Int] = nil   # dejarlos como estaban al volver a meterlas (deshacer, rehacer); y lo plegado
end

struct Documento
    nombre: String
    ruta: String          # "" si aún no se ha guardado
    lineas: [String]
    primera: Int          # la primera línea que se ve
    izquierda: Int        # la primera columna que se ve
    cl: Int               # el cursor
    cc: Int
    al: Int               # el ancla de la selección (-1: no hay)
    ac: Int
    cambiado: Bool
    utf8: Bool            # el fichero estaba en UTF-8 (de un PC): se guarda igual
    deshacer: [Cambio]
    rehacer: [Cambio]
    diseno: Bool          # un .dashui que se ve con el editor de ventanas (Amiga-D: como texto)
    puntos: [Int]         # las líneas (desde 1) con punto de parada
    version: Int = 0      # sube con cada cambio del texto (codigo.dash vuelve a leerlo si cambió)
    vista: Int = 0        # 1: una pestaña de solo lectura de una extensión (VISTA, docs/EXTENSIONES.md)
    vista_ext: String = ""    # de qué extensión es la vista
    colores: String = ""      # el color de cada línea de la vista: un carácter por línea (ed_color_vista)
    temporal: String = ""     # un ejemplo de la ayuda sin nombre (Probar): el fichero de T: desde el que se compila
    marcadores: [Int] = nil   # las líneas (desde 0) con marcador, en orden; siguen a su texto al escribir
    plegados: [Int] = nil     # las líneas (desde 0) de los bloques plegados, en orden
    puntos_antes: [Int] = nil # al escribir, los puntos siguen a su texto: la línea que tenía antes cada uno de puntos
                              # (en el mismo orden), hasta que se pasa a los del proyecto (ed_puntos_movidos)
end

var documentos: [Documento] = []

# La sugerencia de una extensión (SUGERENCIA, docs/EXTENSIONES.md: el copiloto): un texto en gris tras el cursor, al
# final de la línea, que Tab mete. Vale mientras el texto y el cursor sigan donde estaban.
var ed_sug_texto: String = ""
var ed_sug_ext: String = ""
var ed_sug_doc: Documento = nil
var ed_sug_version: Int = -1
var ed_sug_l: Int = -1          # el cursor, desde 0
var ed_sug_c: Int = -1
var activo: Int = -1
# La geometría del último dibujo (desde la esquina de la zona)
var ed_visibles: Int = 1
var ed_columnas: Int = 1
var ed_margen: Int = 40
var ed_alto_fila: Int = 10
var ed_zona_x: Int = 0
var ed_zona_y: Int = 0
var ed_zona_ancho: Int = 0
var ed_zona_alto: Int = 0
var ed_solo_linea: Int = -1    # con mui_canvas_update: dibujar solo esta línea
var ed_ms_dibujo: Int = 0      # lo que tardó el último dibujo entero
var ed_dibujos: Int = 0        # cuántos dibujos enteros del texto (para la sonda: depurar no repinta todo)
var ed_anotar_vistas: Bool = false     # para las pruebas (con la sonda): la primera línea de cada dibujo entero
var ed_vistas: String = ""
# Lo que va encima del texto: la lista para completar y la ayuda de los argumentos (desde la esquina de la zona;
# alto 0 si no se ve)
var ed_lista_x: Int = 0
var ed_lista_y: Int = 0
var ed_lista_ancho: Int = 0
var ed_lista_alto: Int = 0
var ed_lista_filas: Int = LISTA_FILAS
var ed_ayuda_x: Int = 0
var ed_ayuda_y: Int = 0
var ed_ayuda_ancho: Int = 0
var ed_ayuda_alto: Int = 0
var _ayuda_lineas: [String] = []    # la descripción, partida en líneas
# el valor bajo el ratón al depurar (paso 4.1): su texto y dónde empieza lo que vale eso (línea y columna, desde 0)
var ed_valor_texto: String = ""
var ed_valor_l: Int = -1
var ed_valor_c: Int = 0
var ed_valor_x: Int = 0
var ed_valor_y: Int = 0
var ed_valor_ancho: Int = 0
var ed_valor_alto: Int = 0
# los puntos de parada con condición o contador ("ruta en minúsculas:línea"): se dibujan distintos
var ed_puntos_raros: [String] = []
# Las pestañas que se ven: de dónde a dónde, desde la esquina de la zona
var _pestana_x1: [Int] = []
var _pestana_x2: [Int] = []
# Lo que devuelven las funciones de posiciones
# Dónde está parado el programa que se depura (la línea, desde 1; 0 si no está parado)
var ed_dbg_ruta: String = ""
var ed_dbg_linea: Int = 0
var ed_sel_desde: Int = 0
var ed_sel_hasta: Int = 0
var _fin_l: Int = 0
var _fin_c: Int = 0
# Las marcas de las extensiones (marcas.dash) del fichero que se dibuja: su ruta en minúsculas y el ancho de su
# columna en el margen (0 si no tiene)
var ed_marca_ruta: String = ""
var ed_err_ruta: String = ""   # la del documento para sus errores (errores.dash): la ruta, o la de T: de un ejemplo
var ed_ancho_marca: Int = 0
var _fila_asm: Bool = false    # la fila que se dibuja está dentro de un bloque asm (sus propios colores)
var _l1: Int = 0
var _c1: Int = 0
var _l2: Int = 0
var _c2: Int = 0

# --- Abrir ---

# ¿Es UTF-8? Si tiene letras de fuera de ASCII y pasar a Latin-1 y volver lo deja igual, o si tiene la
# puntuación de UTF-8 más corriente (comillas, guiones y puntos suspensivos empiezan por E2 80)
func es_utf8(t: String) -> Bool
    if str_contains(t, str_char(0xE2) + str_char(0x80))
        return true
    end
    alto = false
    for c in [0xC2, 0xC3]
        if str_contains(t, str_char(c))
            alto = true
        end
    end
    return alto and latin1_to_utf8(utf8_to_latin1(t)) == t
end

func _lineas_de(texto: String) -> [String]
    t = str_replace(str_replace(texto, "\r\n", "\n"), "\t", "    ")
    return str_split(t, "\n")
end

func ed_abrir_texto(nombre: String, ruta: String, texto: String)
    utf8 = es_utf8(texto)
    if utf8
        texto = utf8_to_latin1(texto)
    end
    var d1: [Cambio] = []
    var d2: [Cambio] = []
    diseno = str_ends(str_lower(nombre), ".dashui")
    var pp: [Int] = []
    documentos.push(Documento(nombre, ruta, _lineas_de(texto), 0, 0, 0, 0, -1, 0, false, utf8, d1, d2, diseno, pp))
    activo = documentos.length - 1
end

# Una pestaña de solo lectura de la extensión ext, con un color por línea (colores: un carácter por línea, ver
# ed_color_vista); si ya tiene una con ese nombre, la vuelve a llenar
func ed_abrir_vista(ext: String, nombre: String, lineas: [String], colores: String)
    i = 0
    for d in documentos
        if d.vista != 0 and d.vista_ext == ext and d.nombre == nombre
            d.lineas = lineas
            d.colores = colores
            d.primera = 0
            d.cl = 0
            d.cc = 0
            d.al = -1
            d.version = d.version + 1
            activo = i
            return
        end
        i = i + 1
    end
    var d1: [Cambio] = []
    var d2: [Cambio] = []
    var pp: [Int] = []
    if lineas.length == 0
        lineas.push("")
    end
    documentos.push(Documento(nombre, "", lineas, 0, 0, 0, 0, -1, 0, false, false, d1, d2, false, pp, 0, 1, ext, colores))
    activo = documentos.length - 1
end

# El color de una línea de una vista, por su carácter: + verde (añadido), - rojo (quitado), @ el del acento, # tenue,
# ! amarillo; los demás, el del texto
func ed_color_vista(c: String) -> Int
    if c == "+"
        return tema.bien
    elif c == "-"
        return tema.error
    elif c == "@"
        return tema.acento
    elif c == "#"
        return tema.tenue
    elif c == "!"
        return tema.cursor
    end
    return tema.texto
end

func ed_actual() -> Documento
    if activo < 0
        return nil
    end
    return documentos[activo]
end

# La pestaña del fichero con esa ruta; -1 si no está abierto
func ed_buscar_ruta(ruta: String) -> Int
    i = 0
    for d in documentos
        if ruta != "" and str_lower(d.ruta) == str_lower(ruta)
            return i
        end
        i = i + 1
    end
    return -1
end

# Como ed_ir_a, pero si la línea ya se ve (sin selección), la vista no se mueve: al depurar, cada parada centraba la
# línea y el código saltaba arriba y abajo entre dos líneas cercanas (lo contó David Martínez). true si la vista se
# quedó donde estaba: basta repintar las líneas que cambian
func ed_ir_a_quieto(n: Int, c: Int) -> Bool
    d = ed_actual()
    if d == nil
        return false
    end
    margen = 0
    if ed_visibles > 8
        margen = 2
    elif ed_visibles > 4
        margen = 1
    end
    l = n - 1
    # (un clic deja el ancla puesta, d.al, sin que haya nada elegido: eso no cuenta como selección; antes centraba la
    # línea y el código daba un salto al pulsar en el editor depurando, lo contó David Martínez)
    if ed_hay_seleccion(d) or l >= d.lineas.length or l < d.primera - ed_visibles or l >= d.primera + 2 * ed_visibles
        ed_ir_a(n, c)
        return false
    end
    izquierda = d.izquierda
    primera = d.primera
    d.al = -1
    d.cl = l
    d.cc = c - 1
    if d.cc < 0
        d.cc = 0
    end
    if d.cc > d.lineas[d.cl].length
        d.cc = d.lineas[d.cl].length
    end
    # cerca de lo que se ve, pero fuera (o en el borde): el código se mueve lo justo, como con las flechas, en vez de
    # centrar la línea (en una ventana pequeña, cada paso del depurador hacía saltar el código unas líneas)
    if l < d.primera + margen
        d.primera = l - margen
    elif l >= d.primera + ed_visibles - margen
        d.primera = l - ed_visibles + margen + 1
    end
    if d.primera > d.lineas.length - ed_visibles
        d.primera = d.lineas.length - ed_visibles
    end
    if d.primera < 0
        d.primera = 0
    end
    ed_seguir_cursor(d)
    return d.izquierda == izquierda and d.primera == primera
end

# Lleva el cursor a la línea n (desde 1) y la columna c (desde 1) del documento activo, y la deja a la vista
func ed_ir_a(n: Int, c: Int)
    d = ed_actual()
    if d == nil
        return
    end
    d.cl = n - 1
    if d.cl < 0
        d.cl = 0
    end
    if d.cl > d.lineas.length - 1
        d.cl = d.lineas.length - 1
    end
    d.cc = c - 1
    if d.cc < 0
        d.cc = 0
    end
    if d.cc > d.lineas[d.cl].length
        d.cc = d.lineas[d.cl].length
    end
    d.al = -1
    # la línea, hacia la mitad de lo que se ve
    ed_destapar(d, d.cl)
    d.primera = ed_filas_desde(d, d.cl, -(ed_visibles / 2))
    if d.primera < 0
        d.primera = 0
    end
    ed_seguir_cursor(d)
end

# Cambia las líneas desde..hasta (desde 1, las dos incluidas) del documento por texto, con deshacer.
# Con hasta = desde - 1 mete texto como líneas nuevas antes de la línea desde.
func ed_cambiar_lineas(d: Documento, desde: Int, hasta: Int, texto: String) -> Bool
    if desde < 1 or desde > d.lineas.length + 1 or hasta < desde - 1 or hasta > d.lineas.length
        return false
    end
    if hasta == desde - 1
        if desde == d.lineas.length + 1
            # al final: detrás de la última línea
            d.cl = d.lineas.length - 1
            d.cc = d.lineas[d.cl].length
            d.al = -1
            ed_escribir(d, "\n" + texto)
        else
            d.cl = desde - 1
            d.cc = 0
            d.al = -1
            ed_escribir(d, texto + "\n")
        end
    else
        # las mismas líneas que había (comentar, cambiar en el proyecto...): los marcadores y los plegados se quedan
        var marcas: [Int] = nil
        var plegados: [Int] = nil
        var puntos: [Int] = nil
        var puntos_antes: [Int] = nil
        if str_split(texto, "\n").length == hasta - desde + 1
            marcas = _copia(d.marcadores)
            plegados = _copia(d.plegados)
            puntos = _copia(d.puntos)
            puntos_antes = d.puntos_antes
        end
        d.al = desde - 1
        d.ac = 0
        d.cl = hasta - 1
        d.cc = d.lineas[hasta - 1].length
        ed_escribir(d, texto)
        if marcas != nil
            d.marcadores = marcas
        end
        if plegados != nil
            d.plegados = plegados
        end
        if puntos != nil
            d.puntos = puntos
            d.puntos_antes = puntos_antes
        end
    end
    ed_seguir_cursor(d)
    return true
end

func _copia(ls: [Int]) -> [Int]
    if ls == nil
        return nil
    end
    var r: [Int] = []
    for k in ls
        r.push(k)
    end
    return r
end

# La selección exacta, "l1 c1 l2 c2" (desde 1, en orden); sin selección, el cursor dos veces
func ed_elegido(d: Documento) -> String
    if not ed_hay_seleccion(d)
        return "#{d.cl + 1} #{d.cc + 1} #{d.cl + 1} #{d.cc + 1}"
    end
    _orden(d)
    return "#{_l1 + 1} #{_c1 + 1} #{_l2 + 1} #{_c2 + 1}"
end

# Una línea (desde 0) dentro del documento
func _linea_valida(d: Documento, l: Int) -> Int
    if l < 0
        return 0
    end
    if l > d.lineas.length - 1
        return d.lineas.length - 1
    end
    return l
end

func _columna_valida(d: Documento, l: Int, c: Int) -> Int
    if c < 0
        return 0
    end
    if c > d.lineas[l].length
        return d.lineas[l].length
    end
    return c
end

# El cursor a la línea l y la columna c (desde 1), sin selección, y a la vista
func ed_poner_cursor(d: Documento, l: Int, c: Int)
    d.cl = _linea_valida(d, l - 1)
    d.cc = _columna_valida(d, d.cl, c - 1)
    d.al = -1
    ed_seguir_cursor(d)
end

# Elige de (l1, c1) a (l2, c2), desde 1; el cursor queda en (l2, c2)
func ed_elegir(d: Documento, l1: Int, c1: Int, l2: Int, c2: Int)
    d.al = _linea_valida(d, l1 - 1)
    d.ac = _columna_valida(d, d.al, c1 - 1)
    d.cl = _linea_valida(d, l2 - 1)
    d.cc = _columna_valida(d, d.cl, c2 - 1)
    ed_seguir_cursor(d)
end

# Las líneas de la selección (desde 1) en ed_sel_desde y ed_sel_hasta; sin selección, la del cursor
func ed_lineas_seleccion(d: Documento)
    if ed_hay_seleccion(d)
        _orden(d)
        ed_sel_desde = _l1 + 1
        ed_sel_hasta = _l2 + 1
        # una selección que acaba al principio de una línea no la incluye
        if _c2 == 0 and _l2 > _l1
            ed_sel_hasta = _l2
        end
    else
        ed_sel_desde = d.cl + 1
        ed_sel_hasta = d.cl + 1
    end
end

# Buscar con expresiones regulares (la casilla de la ventana de buscar): t es un patrón de regex_find de Dash, y en
# lo que lo cambia, $1 a $9 son sus grupos ($0 todo lo encontrado, $$ un $)
var ed_regex: Bool = false
var ed_hallado: Int = 0        # el largo de lo último encontrado por ed_buscar_en

# La posición de t en s desde la columna desde (-1 si no está; su largo en ed_hallado); sin mayus, sin mirar
# mayúsculas
func ed_buscar_en(s: String, t: String, desde: Int, mayus: Bool) -> Int
    if desde > s.length
        return -1
    end
    if ed_regex
        p = regex_find(t, s, desde, not mayus)
        ed_hallado = regex_length()
        return p
    end
    ed_hallado = t.length
    if not mayus
        s = str_lower(s)
        t = str_lower(t)
    end
    return str_find_from(s, t, desde)
end

# ¿Está mal el patrón? (con expresiones regulares): por qué, o ""
func ed_patron_malo(t: String) -> String
    if not ed_regex
        return ""
    end
    regex_find(t, "", 0, false)
    return regex_error()
end

# Lo que cambia lo último encontrado: nuevo, con los grupos puestos si es una expresión regular
func ed_texto_cambio(nuevo: String) -> String
    if not ed_regex or not str_contains(nuevo, "$")
        return nuevo
    end
    r = ""
    i = 0
    while i < nuevo.length
        c = str_code(nuevo, i)
        k = str_code(nuevo, i + 1)
        if c == 36 and k >= 48 and k <= 57
            r = r + regex_group(k - 48)
            i = i + 2
        elif c == 36 and k == 36
            r = r + "$"
            i = i + 2
        else
            r = r + nuevo[i:i + 1]
            i = i + 1
        end
    end
    return r
end

# La línea s con todo lo que encaja con t cambiado por nuevo; cuántas veces, en ed_veces
var ed_veces: Int = 0

func ed_cambiar_en(s: String, t: String, nuevo: String, mayus: Bool) -> String
    ed_veces = 0
    r = ""
    desde = 0
    p = ed_buscar_en(s, t, 0, mayus)
    while p >= 0
        largo = ed_hallado
        r = r + s[desde:p] + ed_texto_cambio(nuevo)
        ed_veces = ed_veces + 1
        desde = p + largo
        if largo == 0
            # (lo vacío encaja en todas partes: se pasa al carácter siguiente)
            if p >= s.length
                return r
            end
            r = r + s[p:p + 1]
            desde = p + 1
        end
        p = ed_buscar_en(s, t, desde, mayus)
    end
    return r + s[desde:]
end

# La última posición de t en s que empieza antes de la columna hasta (-1 si no hay)
func _buscar_antes(s: String, t: String, hasta: Int, mayus: Bool) -> Int
    ultima = -1
    largo = 0
    p = ed_buscar_en(s, t, 0, mayus)
    while p >= 0 and p < hasta
        ultima = p
        largo = ed_hallado
        # (desde el final de lo encontrado: con una expresión regular, desde p + 1 saldría un trozo de lo mismo)
        siguiente = p + largo
        if largo == 0
            siguiente = p + 1
        end
        p = ed_buscar_en(s, t, siguiente, mayus)
    end
    ed_hallado = largo
    return ultima
end

# Busca t desde el cursor (hacia delante o hacia atrás, dando la vuelta al texto) y lo deja elegido
func ed_buscar(d: Documento, t: String, mayus: Bool, adelante: Bool) -> Bool
    if t == "" or str_contains(t, "\n")
        return false
    end
    n = d.lineas.length
    if adelante
        l = d.cl
        c = d.cc
        k = 0
        if ed_regex and not ed_hay_seleccion(d)
            # (lo vacío encontrado en el cursor no cuenta: siguiente)
            p = ed_buscar_en(d.lineas[l], t, c, mayus)
            if p == c and ed_hallado == 0
                c = c + 1
            end
        end
        while k <= n
            p = ed_buscar_en(d.lineas[l], t, c, mayus)
            if p >= 0
                d.al = l
                d.ac = p
                d.cl = l
                d.cc = p + ed_hallado
                ed_seguir_cursor(d)
                return true
            end
            l = (l + 1) % n
            c = 0
            k = k + 1
        end
        return false
    end
    # hacia atrás: antes del principio de lo elegido
    l = d.cl
    c = d.cc
    if ed_hay_seleccion(d)
        _orden(d)
        l = _l1
        c = _c1
    end
    k = 0
    while k <= n
        p = _buscar_antes(d.lineas[l], t, c, mayus)
        if p >= 0
            d.al = l
            d.ac = p
            d.cl = l
            d.cc = p + ed_hallado
            ed_seguir_cursor(d)
            return true
        end
        l = (l - 1 + n) % n
        c = d.lineas[l].length + 1
        k = k + 1
    end
    return false
end

# Lo elegido es t (para Cambiar)
func ed_elegido_es(d: Documento, t: String, mayus: Bool) -> Bool
    s = ed_seleccion(d)
    if ed_regex
        return regex_match(t, s, not mayus)
    end
    if mayus
        return s == t
    end
    return str_lower(s) == str_lower(t)
end

# Cambia todas las veces que está t por nuevo, en un solo paso de deshacer; cuántas
func ed_cambiar_todo(d: Documento, t: String, nuevo: String, mayus: Bool) -> Int
    if t == "" or str_contains(t, "\n")
        return 0
    end
    veces = 0
    var lineas: [String] = []
    for linea in d.lineas
        lineas.push(ed_cambiar_en(linea, t, nuevo, mayus))
        veces = veces + ed_veces
    end
    if veces > 0
        texto = ""
        i = 0
        for linea in lineas
            if i > 0
                texto = texto + "\n"
            end
            texto = texto + linea
            i = i + 1
        end
        cl = d.cl
        ed_cambiar_lineas(d, 1, d.lineas.length, texto)
        d.cl = cl
        if d.cl > d.lineas.length - 1
            d.cl = d.lineas.length - 1
        end
        d.cc = 0
        d.al = -1
        ed_seguir_cursor(d)
    end
    return veces
end

func ed_cerrar(i: Int)
    documentos.remove(i)
    if activo >= documentos.length
        activo = documentos.length - 1
    end
end

# La pestaña (su número) en x, y de la zona; -1 si no hay ninguna ahí
func ed_pestana_en(x: Int, y: Int) -> Int
    if y >= ALTO_PESTANAS
        return -1
    end
    i = 0
    while i < _pestana_x1.length
        if x >= _pestana_x1[i] and x <= _pestana_x2[i]
            return i
        end
        i = i + 1
    end
    return -1
end

# Los centros de las pestañas, desde la esquina de la ventana: "x,y x,y..." (para las pruebas)
func ed_pestanas_ventana() -> String
    r = ""
    i = 0
    while i < _pestana_x1.length
        if r != ""
            r = r + " "
        end
        r = r + "#{ed_zona_x + (_pestana_x1[i] + _pestana_x2[i]) / 2},#{ed_zona_y + ALTO_PESTANAS / 2}"
        i = i + 1
    end
    return r
end

# El texto tal como va al disco: en UTF-8 si venía así
func ed_texto_disco(d: Documento) -> String
    t = ed_texto(d)
    if d.utf8
        return latin1_to_utf8(t)
    end
    return t
end

# Todo el texto, con saltos de línea
func ed_texto(d: Documento) -> String
    t = ""
    i = 0
    for l in d.lineas
        if i > 0
            t = t + "\n"
        end
        t = t + l
        i = i + 1
    end
    return t
end

# --- Cambios en el texto (sin deshacer) ---

func _trozo(s: String, desde: Int, hasta: Int) -> String
    if desde < 0
        desde = 0
    end
    if hasta > s.length
        hasta = s.length
    end
    if desde >= hasta
        return ""
    end
    return s[desde:hasta]
end

# Mete t en (l, c); el final de lo metido queda en _fin_l, _fin_c
func _meter(d: Documento, l: Int, c: Int, t: String)
    linea = d.lineas[l]
    antes = _trozo(linea, 0, c)
    despues = _trozo(linea, c, linea.length)
    partes = str_split(t, "\n")
    if partes.length == 1
        d.lineas[l] = antes + t + despues
        _fin_l = l
        _fin_c = c + t.length
        return
    end
    d.lineas[l] = antes + partes[0]
    i = 1
    while i < partes.length - 1
        d.lineas.insert(l + i, partes[i])
        i = i + 1
    end
    ultima = partes[partes.length - 1]
    d.lineas.insert(l + i, ultima + despues)
    _fin_l = l + i
    _fin_c = ultima.length
    _lineas_metidas(d, l, c, partes.length - 1, despues != "")
end

func _texto_entre(d: Documento, l1: Int, c1: Int, l2: Int, c2: Int) -> String
    if l1 == l2
        return _trozo(d.lineas[l1], c1, c2)
    end
    t = _trozo(d.lineas[l1], c1, d.lineas[l1].length)
    l = l1 + 1
    while l < l2
        t = t + "\n" + d.lineas[l]
        l = l + 1
    end
    return t + "\n" + _trozo(d.lineas[l2], 0, c2)
end

# Lo que _quitar encontró en las líneas que quitó (varias): los marcadores y lo plegado de l1 a l2, desde l1 (nil si
# era una sola línea)
var _q_marcas: [Int] = nil
var _q_plegadas: [Int] = nil

func _de_rango(ls: [Int], l1: Int, l2: Int) -> [Int]
    if ls == nil
        return nil
    end
    var r: [Int] = []
    for m in ls
        if m >= l1 and m <= l2
            r.push(m - l1)
        end
    end
    return r
end

# Tras volver a meter las líneas l a l + n (deshacer o rehacer un cambio que las quitó): sus marcadores y lo plegado,
# como estaban (al quitarlas, los marcadores se juntaron en la primera)
func _rango_como_estaba(ls: [Int], l: Int, n: Int, como: [Int])
    if ls == nil or como == nil
        return
    end
    i = 0
    while i < ls.length
        if ls[i] >= l and ls[i] <= l + n
            ls.remove(i)
        else
            i = i + 1
        end
    end
    for o in como
        if o <= n
            ls.push(l + o)
        end
    end
    _ordenar(ls)
end

# Quita de (l1, c1) a (l2, c2) y devuelve lo quitado
func _quitar(d: Documento, l1: Int, c1: Int, l2: Int, c2: Int) -> String
    _q_marcas = nil
    _q_plegadas = nil
    if l2 > l1
        _q_marcas = _de_rango(d.marcadores, l1, l2)
        _q_plegadas = _de_rango(d.plegados, l1, l2)
    end
    t = _texto_entre(d, l1, c1, l2, c2)
    resto = _trozo(d.lineas[l2], c2, d.lineas[l2].length)
    d.lineas[l1] = _trozo(d.lineas[l1], 0, c1) + resto
    n = l2 - l1
    while n > 0
        d.lineas.remove(l1 + 1)
        n = n - 1
    end
    if l2 > l1
        _lineas_quitadas(d, l1, l2)
    end
    return t
end

# Los marcadores y los plegados siguen a su texto: n líneas nuevas tras la línea l (metidas en su columna c: en la
# columna 0, el texto de la línea l también baja)
func _lineas_metidas(d: Documento, l: Int, c: Int, n: Int, resto: Bool)
    if d.puntos.length > 0
        _puntos_correr(d, l, c == 0 and resto, n)
    end
    if d.marcadores != nil
        _correr(d.marcadores, l, c == 0 and resto, n)
    end
    if d.plegados != nil
        _correr(d.plegados, l, c == 0 and resto, n)
    end
end

# (baja: el texto de la línea l pasó entero a la última de las metidas)
func _correr(ls: [Int], l: Int, baja: Bool, n: Int)
    i = 0
    while i < ls.length
        if ls[i] > l or (ls[i] == l and baja)
            ls[i] = ls[i] + n
        end
        i = i + 1
    end
end

# Se quitaron las líneas l1 + 1 a l2 (lo que quedaba de l2 pasó a l1)
func _lineas_quitadas(d: Documento, l1: Int, l2: Int)
    if d.puntos.length > 0
        _puntos_encoger(d, l1, l2)
    end
    if d.marcadores != nil
        _encoger(d.marcadores, l1, l2, true)
    end
    if d.plegados != nil
        _encoger(d.plegados, l1, l2, false)
    end
end

func _encoger(ls: [Int], l1: Int, l2: Int, juntar: Bool)
    n = l2 - l1
    i = 0
    while i < ls.length
        if ls[i] > l2
            ls[i] = ls[i] - n
            i = i + 1
        elif ls[i] > l1
            # su línea ya no está: un marcador pasa a l1 (si no tiene ya uno); un plegado se quita
            if juntar and not _tiene(ls, l1)
                ls[i] = l1
                i = i + 1
            else
                ls.remove(i)
            end
        else
            i = i + 1
        end
    end
    _ordenar(ls)
end

# Los puntos de parada siguen a su texto como los marcadores (sus líneas van desde 1). Se mueven en su sitio, sin
# ordenar, y puntos_antes guarda la línea de antes de cada uno: main lo pasa a los puntos del proyecto (con su
# condición) con ed_puntos_movidos
func _puntos_guardar(d: Documento)
    if d.puntos_antes == nil or d.puntos_antes.length != d.puntos.length
        d.puntos_antes = _copia(d.puntos)
    end
end

func _puntos_correr(d: Documento, l: Int, baja: Bool, n: Int)
    _puntos_guardar(d)
    i = 0
    while i < d.puntos.length
        p = d.puntos[i] - 1
        if p > l or (p == l and baja)
            d.puntos[i] = d.puntos[i] + n
        end
        i = i + 1
    end
end

func _puntos_encoger(d: Documento, l1: Int, l2: Int)
    _puntos_guardar(d)
    n = l2 - l1
    i = 0
    while i < d.puntos.length
        p = d.puntos[i] - 1
        if p > l2
            d.puntos[i] = d.puntos[i] - n
            i = i + 1
        elif p > l1
            # su línea ya no está: pasa a l1, si no tiene ya uno; si lo tiene, se va
            if not _tiene(d.puntos, l1 + 1)
                d.puntos[i] = l1 + 1
                i = i + 1
            else
                d.puntos.remove(i)
                d.puntos_antes.remove(i)
            end
        else
            i = i + 1
        end
    end
end

# Si sus puntos se movieron al escribir: true, y deja en ed_movidos_antes y ed_movidos_ahora la línea de antes y la
# de ahora de cada uno (un punto que había en antes y no está ya se quitó). Después, ya no cuentan como movidos.
var ed_movidos_antes: [Int] = []
var ed_movidos_ahora: [Int] = []
func ed_puntos_movidos(d: Documento) -> Bool
    if d.puntos_antes == nil
        return false
    end
    ed_movidos_antes = d.puntos_antes
    ed_movidos_ahora = _copia(d.puntos)
    d.puntos_antes = nil
    return true
end

func _tiene(ls: [Int], n: Int) -> Bool
    for k in ls
        if k == n
            return true
        end
    end
    return false
end

func _ordenar(ls: [Int])
    # (pocos y casi en orden: por inserción)
    i = 1
    while i < ls.length
        k = ls[i]
        j = i - 1
        while j >= 0 and ls[j] > k
            ls[j + 1] = ls[j]
            j = j - 1
        end
        ls[j + 1] = k
        i = i + 1
    end
end

# --- Marcadores (paso 2.5) ---

# Pone o quita el marcador de la línea del cursor; true si queda puesto
func ed_marcador(d: Documento) -> Bool
    if d.marcadores == nil
        d.marcadores = []
    end
    i = 0
    while i < d.marcadores.length
        if d.marcadores[i] == d.cl
            d.marcadores.remove(i)
            return false
        end
        i = i + 1
    end
    d.marcadores.push(d.cl)
    _ordenar(d.marcadores)
    return true
end

func ed_tiene_marcador(d: Documento, n: Int) -> Bool
    return d.marcadores != nil and _tiene(d.marcadores, n)
end

# Al marcador siguiente (o anterior), dando la vuelta; false si no hay
func ed_ir_marcador(d: Documento, adelante: Bool) -> Bool
    if d.marcadores == nil or d.marcadores.length == 0
        return false
    end
    var destino: Int = -1
    if adelante
        destino = d.marcadores[0]
        for m in d.marcadores
            if m > d.cl
                destino = m
                break
            end
        end
    else
        destino = d.marcadores[d.marcadores.length - 1]
        i = d.marcadores.length - 1
        while i >= 0
            if d.marcadores[i] < d.cl
                destino = d.marcadores[i]
                break
            end
            i = i - 1
        end
    end
    ed_ir_a_quieto(destino + 1, d.cc + 1)
    return true
end

# El final de un texto metido en (l, c)
func _fin_de(l: Int, c: Int, t: String)
    partes = str_split(t, "\n")
    if partes.length == 1
        _fin_l = l
        _fin_c = c + t.length
    else
        _fin_l = l + partes.length - 1
        _fin_c = partes[partes.length - 1].length
    end
end

# --- Cambios con deshacer ---

func _apuntar(d: Documento, c: Cambio)
    d.version = d.version + 1
    d.rehacer.clear()
    if d.deshacer.length > 0 and c.seguido
        u = d.deshacer[d.deshacer.length - 1]
        if u.tipo == INSERTAR and u.seguido
            _fin_de(u.l, u.c, u.texto)
            if _fin_l == c.l and _fin_c == c.c
                u.texto = u.texto + c.texto
                return
            end
        end
    end
    d.deshacer.push(c)
    if d.deshacer.length > MAX_DESHACER
        d.deshacer.remove(0)
    end
end

func _insertar(d: Documento, t: String, seguido: Bool)
    l = d.cl
    c = d.cc
    _meter(d, l, c, t)
    d.cl = _fin_l
    d.cc = _fin_c
    d.cambiado = true
    _apuntar(d, Cambio(INSERTAR, l, c, t, seguido, false))
end

func _borrar_rango(d: Documento, l1: Int, c1: Int, l2: Int, c2: Int)
    if l1 == l2 and c1 == c2
        return
    end
    t = _quitar(d, l1, c1, l2, c2)
    d.cl = l1
    d.cc = c1
    d.cambiado = true
    c = Cambio(BORRAR, l1, c1, t, false, false)
    c.marcas = _q_marcas
    c.plegadas = _q_plegadas
    _apuntar(d, c)
end

func ed_hay_seleccion(d: Documento) -> Bool
    return d.al >= 0 and (d.al != d.cl or d.ac != d.cc)
end

# La selección en orden: (_l1, _c1) a (_l2, _c2)
func _orden(d: Documento)
    if d.al < d.cl or (d.al == d.cl and d.ac <= d.cc)
        _l1 = d.al
        _c1 = d.ac
        _l2 = d.cl
        _c2 = d.cc
    else
        _l1 = d.cl
        _c1 = d.cc
        _l2 = d.al
        _c2 = d.ac
    end
end

func ed_seleccion(d: Documento) -> String
    if not ed_hay_seleccion(d)
        return ""
    end
    _orden(d)
    return _texto_entre(d, _l1, _c1, _l2, _c2)
end

func ed_borrar_seleccion(d: Documento) -> Bool
    if not ed_hay_seleccion(d)
        d.al = -1
        return false
    end
    _orden(d)
    d.al = -1
    _borrar_rango(d, _l1, _c1, _l2, _c2)
    return true
end

# Escribe t donde está el cursor, en lugar de la selección
func ed_escribir(d: Documento, t: String)
    if ed_borrar_seleccion(d)
        _insertar(d, t, false)
        if t != ""
            d.deshacer[d.deshacer.length - 1].junto = true
        end
    else
        _insertar(d, t, t.length == 1)
    end
end

func _blancos(n: Int) -> String
    r = ""
    while n > 0
        r = r + " "
        n = n - 1
    end
    return r
end

func _espacios_delante(s: String) -> Int
    n = 0
    while n < s.length and s[n:n + 1] == " "
        n = n + 1
    end
    return n
end

# La primera palabra de una línea ya sin sangría ("func", "if", "end"...)
func _primera_palabra(t: String) -> String
    i = 0
    while i < t.length and str_code(t, i) != 32 and str_code(t, i) != 40 and str_code(t, i) != 9
        i = i + 1
    end
    return t[0:i]
end

# La línea sin el comentario del final (un " #" fuera de un texto) y sin blancos alrededor
func _sin_nota(t: String) -> String
    dentro = false
    i = 0
    while i < t.length
        c = str_code(t, i)
        if c == 34
            dentro = not dentro
        elif c == 35 and not dentro and (i == 0 or str_code(t, i - 1) == 32)
            return str_trim(t[0:i])
        end
        i = i + 1
    end
    return str_trim(t)
end

# ¿Abre un bloque que acaba en end? (como increaseIndentPattern de la extensión de VS Code): func, if, elif, else,
# while, for, struct, enum, Window, Main, EventLoop, On y @c, sin su end en la misma línea
func _abre_bloque(linea: String) -> Bool
    t = _sin_nota(linea)
    p = _primera_palabra(t)
    if str_starts(t, "@native") and str_contains(t, " func ")
        p = "func"
    end
    if p == "asm"
        return sx_clase_linea(linea) == SXL_ASM
    end
    for k in ["func", "if", "elif", "else", "while", "for", "struct", "enum", "Window", "Main", "EventLoop", "On", "@c", "interface"]
        if p == k
            return t != "end" and not str_ends(t, " end")
        end
    end
    return false
end

# La línea con texto de antes de la n (desde 0), o -1
func _anterior_con_texto(d: Documento, n: Int) -> Int
    k = n - 1
    while k >= 0 and str_trim(d.lineas[k]) == ""
        k = k - 1
    end
    return k
end

func ed_nueva_linea(d: Documento)
    ed_borrar_seleccion(d)
    linea = d.lineas[d.cl]
    sangria = _espacios_delante(linea)
    if sangria > d.cc
        sangria = d.cc
    end
    junto = false
    # Return al final de una línea de código: la sangría sigue los bloques, como en la extensión de VS Code. Un end,
    # else o elif vuelve a la altura de su bloque, y tras lo que abre un bloque (if, func, Main...) se entra un nivel.
    if str_trim(linea[d.cc:]) == "" and str_trim(linea) != "" and es_codigo_dash(d)
        if _bajar_cierre(d)
            sangria = _espacios_delante(d.lineas[d.cl])
            junto = true
        end
        if _abre_bloque(d.lineas[d.cl])
            sangria = _espacios_delante(d.lineas[d.cl]) + SANGRIA
        end
    end
    # tras abrir un bloque que aún no tiene su end, el end debajo (en el mismo paso de deshacer)
    if ed_auto_end and es_codigo_dash(d) and d.cc == d.lineas[d.cl].length and _falta_end(d, d.cl)
        base = _blancos(_espacios_delante(d.lineas[d.cl]))
        _insertar(d, "\n" + _blancos(sangria) + "\n" + base + "end", false)
        d.cl = d.cl - 1
        d.cc = sangria
    else
        _insertar(d, "\n" + _blancos(sangria), false)
    end
    if junto
        d.deshacer[d.deshacer.length - 1].junto = true
    end
end

# Un end, else o elif (la línea del cursor, el cursor al final) a la altura de su bloque: la de la línea de antes si
# esa abre un bloque, si no un nivel menos. Solo baja, nunca sube. true si cambió algo (un paso de deshacer).
func _bajar_cierre(d: Documento) -> Bool
    linea = d.lineas[d.cl]
    p = _primera_palabra(str_trim(linea))
    if p != "end" and p != "else" and p != "elif"
        return false
    end
    k = _anterior_con_texto(d, d.cl)
    if k < 0
        return false
    end
    # (la sangría de la línea, antes que la otra: con "_espacios_delante(linea) - objetivo", ./dash de Dash 2.10 copia
    # en línea la función en el registro de objetivo, y la resta da 0)
    actual = _espacios_delante(linea)
    objetivo = _espacios_delante(d.lineas[k])
    if not _abre_bloque(d.lineas[k])
        objetivo = objetivo - SANGRIA
    end
    if objetivo < 0
        objetivo = 0
    end
    quitar = actual - objetivo
    if quitar <= 0
        return false
    end
    cc = d.cc
    d.al = d.cl
    d.ac = 0
    d.cc = quitar
    ed_escribir(d, "")
    d.cc = cc - quitar
    return true
end

# Al escribir la última letra de un end, else o elif solos en su línea, baja a la altura de su bloque (como en VS
# Code); deshacer (un paso) lo deja como estaba
func ed_tras_letra(d: Documento, letra: String)
    if (letra != "d" and letra != "e" and letra != "f") or not es_codigo_dash(d)
        return
    end
    t = str_trim(d.lineas[d.cl])
    if d.cc != d.lineas[d.cl].length or (t != "end" and t != "else" and t != "elif")
        return
    end
    _bajar_cierre(d)
end

# La sangría de los bloques, solo en el código de Dash (no en un .dashui ni en otro texto)
func es_codigo_dash(d: Documento) -> Bool
    return not d.diseno and d.vista == 0 and not str_ends(str_lower(d.nombre), ".dashui")
end

func ed_tabulador(d: Documento)
    ed_borrar_seleccion(d)
    _insertar(d, _blancos(SANGRIA - d.cc % SANGRIA), false)
end

# Mayúsculas + Tab: quita una sangría a la línea (o a las de la selección)
func ed_quitar_sangria(d: Documento)
    desde = d.cl
    hasta = d.cl
    if ed_hay_seleccion(d)
        _orden(d)
        desde = _l1
        hasta = _l2
    end
    l = desde
    while l <= hasta
        n = _espacios_delante(d.lineas[l])
        if n > SANGRIA
            n = SANGRIA
        end
        if n > 0
            t = _quitar(d, l, 0, l, n)
            _apuntar(d, Cambio(BORRAR, l, 0, t, false, false))
            d.cambiado = true
            if l == d.cl
                d.cc = d.cc - n
                if d.cc < 0
                    d.cc = 0
                end
            end
            if l == d.al
                d.ac = d.ac - n
                if d.ac < 0
                    d.ac = 0
                end
            end
        end
        l = l + 1
    end
end

func ed_retroceso(d: Documento)
    if ed_borrar_seleccion(d)
        return
    end
    if _quitar_pareja(d)
        return
    end
    if d.cc > 0
        n = 1
        # en la sangría, hasta la parada anterior
        if _espacios_delante(d.lineas[d.cl]) >= d.cc
            n = (d.cc - 1) % SANGRIA + 1
        end
        _borrar_rango(d, d.cl, d.cc - n, d.cl, d.cc)
    elif d.cl > 0
        _borrar_rango(d, d.cl - 1, d.lineas[d.cl - 1].length, d.cl, 0)
    end
end

func ed_suprimir(d: Documento)
    if ed_borrar_seleccion(d)
        return
    end
    if d.cc < d.lineas[d.cl].length
        _borrar_rango(d, d.cl, d.cc, d.cl, d.cc + 1)
    elif d.cl < d.lineas.length - 1
        _borrar_rango(d, d.cl, d.cc, d.cl + 1, 0)
    end
end

func _aplicar(d: Documento, c: Cambio, al_reves: Bool)
    meter = c.tipo == INSERTAR
    if al_reves
        meter = not meter
    end
    if meter
        _meter(d, c.l, c.c, c.texto)
        d.cl = _fin_l
        d.cc = _fin_c
        if _fin_l > c.l
            # las líneas vuelven: sus marcadores y lo plegado, como estaban al quitarlas (si no, se quedaban todos
            # juntos en la primera)
            if _rango_como_estaba_marcas(d, c)
                _pl_cambios = _pl_cambios + 1
            end
        end
    else
        _fin_de(c.l, c.c, c.texto)
        _quitar(d, c.l, c.c, _fin_l, _fin_c)
        c.marcas = _q_marcas
        c.plegadas = _q_plegadas
        d.cl = c.l
        d.cc = c.c
    end
    d.al = -1
    d.cambiado = true
    d.version = d.version + 1
end

func _rango_como_estaba_marcas(d: Documento, c: Cambio) -> Bool
    n = _fin_l - c.l
    _rango_como_estaba(d.marcadores, c.l, n, c.marcas)
    if c.plegadas != nil and d.plegados != nil
        _rango_como_estaba(d.plegados, c.l, n, c.plegadas)
        return true
    end
    return false
end

func ed_deshacer(d: Documento) -> Bool
    if d.deshacer.length == 0
        return false
    end
    c = d.deshacer.pop()
    _aplicar(d, c, true)
    d.rehacer.push(c)
    while c.junto and d.deshacer.length > 0
        c = d.deshacer.pop()
        _aplicar(d, c, true)
        d.rehacer.push(c)
    end
    return true
end

func ed_rehacer(d: Documento) -> Bool
    if d.rehacer.length == 0
        return false
    end
    c = d.rehacer.pop()
    _aplicar(d, c, false)
    d.deshacer.push(c)
    while d.rehacer.length > 0 and d.rehacer[d.rehacer.length - 1].junto
        c = d.rehacer.pop()
        _aplicar(d, c, false)
        d.deshacer.push(c)
    end
    return true
end

# Cambia lo escrito desde la columna desde hasta el cursor por palabra (lo elegido en la lista para completar)
func ed_completar(d: Documento, desde: Int, palabra: String)
    if desde > d.cc
        return
    end
    d.al = d.cl
    d.ac = desde
    if desde == d.cc
        d.al = -1
    end
    ed_escribir(d, palabra)
    ed_seguir_cursor(d)
end

func ed_seleccionar_todo(d: Documento)
    d.al = 0
    d.ac = 0
    d.cl = d.lineas.length - 1
    d.cc = d.lineas[d.cl].length
end

# --- Comodidades de línea (paso 2.2 de docs/FORJA_LOOP.md) ---
# Cada una es un paso de deshacer. Trabajan con las líneas de la selección, o con la del cursor.

var ed_cerrar_solo: Bool = true    # cerrar solos paréntesis, corchetes, llaves y comillas (preferencia)
var ed_auto_end: Bool = true       # el end solo al pulsar Return tras abrir un bloque (preferencia)

# Las líneas a..b (desde 0), unidas con saltos de línea
func _lineas_texto(d: Documento, a: Int, b: Int) -> String
    t = ""
    l = a
    while l <= b
        if l > a
            t = t + "\n"
        end
        t = t + d.lineas[l]
        l = l + 1
    end
    return t
end

# ¿Es un comentario la línea (a partir de su sangría)?
func _es_comentario(t: String, marca: String) -> Bool
    e = _espacios_delante(t)
    return e < t.length and t[e:e + 1] == marca
end

# Comenta o descomenta: si todas las líneas con texto ya lo son, les quita el "#" (y el espacio de detrás); si no,
# pone "# " a todas a la altura de la menos sangrada. Dentro de un bloque asm, con ";".
func ed_comentar(d: Documento) -> Bool
    ed_lineas_seleccion(d)
    a = ed_sel_desde - 1
    b = ed_sel_hasta - 1
    marca = "#"
    if ed_en_asm(d, a) and sx_clase_linea(d.lineas[a]) == SXL_NADA
        marca = ";"
    end
    todas = true
    alguna = false
    minimo = 10000
    l = a
    while l <= b
        t = d.lineas[l]
        if str_trim(t) != ""
            alguna = true
            e = _espacios_delante(t)
            if e < minimo
                minimo = e
            end
            if not _es_comentario(t, marca)
                todas = false
            end
        end
        l = l + 1
    end
    if not alguna
        return false
    end
    hubo_sel = ed_hay_seleccion(d)
    cl = d.cl
    cc = d.cc
    paso = 0
    var nuevas: [String] = []
    l = a
    while l <= b
        t = d.lineas[l]
        if str_trim(t) == ""
            nuevas.push(t)
        elif todas
            e = _espacios_delante(t)
            quita = 1
            if str_code(t, e + 1) == 32
                quita = 2
            end
            nuevas.push(t[0:e] + t[e + quita:])
            if l == cl
                paso = -quita
            end
        else
            nuevas.push(t[0:minimo] + marca + " " + t[minimo:])
            if l == cl
                paso = 2
            end
        end
        l = l + 1
    end
    texto = ""
    i = 0
    for t in nuevas
        if i > 0
            texto = texto + "\n"
        end
        texto = texto + t
        i = i + 1
    end
    ed_cambiar_lineas(d, a + 1, b + 1, texto)
    if hubo_sel
        d.al = a
        d.ac = 0
        d.cl = b
        d.cc = d.lineas[b].length
    else
        d.cl = cl
        d.cc = _columna_valida(d, cl, cc + paso)
        d.al = -1
    end
    ed_seguir_cursor(d)
    return true
end

# Duplica las líneas (la del cursor o las de la selección) debajo; el cursor (o la selección) pasa a la copia
func ed_duplicar(d: Documento) -> Bool
    ed_lineas_seleccion(d)
    a = ed_sel_desde - 1
    b = ed_sel_hasta - 1
    hubo_sel = ed_hay_seleccion(d)
    cl = d.cl
    cc = d.cc
    al = d.al
    ac = d.ac
    ed_cambiar_lineas(d, b + 2, b + 1, _lineas_texto(d, a, b))
    n = b - a + 1
    d.cl = cl + n
    d.cc = cc
    d.al = -1
    if hubo_sel
        d.al = al + n
        d.ac = ac
    end
    ed_seguir_cursor(d)
    return true
end

# Sube (o baja) las líneas una posición; el cursor y la selección van con ellas
func ed_mover_lineas(d: Documento, arriba: Bool) -> Bool
    ed_lineas_seleccion(d)
    a = ed_sel_desde - 1
    b = ed_sel_hasta - 1
    if (arriba and a == 0) or (not arriba and b >= d.lineas.length - 1)
        return false
    end
    hubo_sel = ed_hay_seleccion(d)
    cl = d.cl
    cc = d.cc
    al = d.al
    ac = d.ac
    paso = 1
    if arriba
        ed_cambiar_lineas(d, a, b + 1, _lineas_texto(d, a, b) + "\n" + d.lineas[a - 1])
        paso = -1
    else
        ed_cambiar_lineas(d, a + 1, b + 2, d.lineas[b + 1] + "\n" + _lineas_texto(d, a, b))
    end
    # los marcadores y los puntos de parada van con sus líneas
    if d.puntos.length > 0
        _puntos_guardar(d)
        i = 0
        while i < d.puntos.length
            m = d.puntos[i] - 1
            if m >= a and m <= b
                d.puntos[i] = d.puntos[i] + paso
            elif arriba and m == a - 1
                d.puntos[i] = b + 1
            elif not arriba and m == b + 1
                d.puntos[i] = a + 1
            end
            i = i + 1
        end
    end
    if d.marcadores != nil
        i = 0
        while i < d.marcadores.length
            m = d.marcadores[i]
            if m >= a and m <= b
                d.marcadores[i] = m + paso
            elif arriba and m == a - 1
                d.marcadores[i] = b
            elif not arriba and m == b + 1
                d.marcadores[i] = a
            end
            i = i + 1
        end
        _ordenar(d.marcadores)
    end
    d.cl = cl + paso
    d.cc = _columna_valida(d, d.cl, cc)
    d.al = -1
    if hubo_sel
        d.al = al + paso
        d.ac = ac
    end
    ed_seguir_cursor(d)
    return true
end

# Borra las líneas enteras (la del cursor o las de la selección)
func ed_borrar_lineas(d: Documento) -> Bool
    ed_lineas_seleccion(d)
    a = ed_sel_desde - 1
    b = ed_sel_hasta - 1
    cc = d.cc
    d.al = -1
    if b < d.lineas.length - 1
        _borrar_rango(d, a, 0, b + 1, 0)
    elif a > 0
        _borrar_rango(d, a - 1, d.lineas[a - 1].length, b, d.lineas[b].length)
        a = a - 1
    elif d.lineas[b] != "" or a != b
        _borrar_rango(d, a, 0, b, d.lineas[b].length)
    else
        return false
    end
    d.cl = a
    d.cc = _columna_valida(d, a, cc)
    ed_seguir_cursor(d)
    return true
end

# --- Cerrar solos paréntesis y comillas ---

func _cierre_de(c: Int) -> Int
    if c == 40
        return 41
    elif c == 91
        return 93
    elif c == 123
        return 125
    elif c == 34
        return 34
    end
    return 0
end

# ¿Está la columna c de la línea dentro de un texto? (cuenta las comillas de antes, sin las escapadas)
func _comillas_impares(s: String, c: Int) -> Bool
    dentro = false
    i = 0
    while i < c and i < s.length
        k = str_code(s, i)
        if k == 92 and dentro
            i = i + 1
        elif k == 34
            dentro = not dentro
        elif k == 35 and not dentro
            return false
        end
        i = i + 1
    end
    return dentro
end

# Una letra escrita con ed_cerrar_solo: "(" mete "()" con el cursor dentro (o rodea la selección), ")" sobre un ")"
# solo avanza; igual con [ ], { } y las comillas. true si ya está hecho
func _cerrar_solo(d: Documento, letra: String) -> Bool
    if letra.length != 1 or not es_codigo_dash(d)
        return false
    end
    c = str_code(letra, 0)
    linea = d.lineas[d.cl]
    sig = str_code(linea, d.cc)
    if d.cc >= linea.length
        sig = 0
    end
    hay_sel = ed_hay_seleccion(d)
    if not hay_sel and (c == 41 or c == 93 or c == 125 or c == 34) and sig == c
        # sobre el que cierra: avanzar (una comilla, solo si cierra un texto)
        if c != 34 or _comillas_impares(linea, d.cc)
            d.cc = d.cc + 1
            d.al = -1
            return true
        end
    end
    cierre = _cierre_de(c)
    if cierre == 0
        return false
    end
    if hay_sel
        _orden(d)
        if _l1 != _l2
            return false
        end
        l1 = _l1
        c1 = _c1
        t = ed_seleccion(d)
        ed_escribir(d, letra + t + str_char(cierre))
        d.al = l1
        d.ac = c1 + 1
        d.cl = l1
        d.cc = c1 + 1 + t.length
        return true
    end
    # solo si detrás no hay nada (o solo blancos) o algo que cierra: escribiendo delante de un texto no se cierra
    if sig != 0 and sig != 41 and sig != 93 and sig != 125 and sig != 44 and sig != 58 and str_trim(linea[d.cc:]) != ""
        return false
    end
    if _comillas_impares(linea, d.cc)
        return false
    end
    if c == 34
        antes = 0
        if d.cc > 0
            antes = str_code(linea, d.cc - 1)
        end
        if _es_letra(linea, d.cc - 1) or antes == 34
            return false
        end
    end
    ed_escribir(d, letra + str_char(cierre))
    d.cc = d.cc - 1
    return true
end

# Retroceso entre dos que hacen pareja y están vacíos, "(|)": los quita los dos
func _quitar_pareja(d: Documento) -> Bool
    if not ed_cerrar_solo or ed_hay_seleccion(d) or d.cc == 0 or not es_codigo_dash(d)
        return false
    end
    linea = d.lineas[d.cl]
    if d.cc >= linea.length
        return false
    end
    a = str_code(linea, d.cc - 1)
    b = str_code(linea, d.cc)
    if _cierre_de(a) == 0 or _cierre_de(a) != b
        return false
    end
    _borrar_rango(d, d.cl, d.cc - 1, d.cl, d.cc + 1)
    return true
end

# --- El end solo (como dash.editor.autoEnd de la extensión de VS Code, endwise.js) ---

# ¿Abre la línea un bloque que acaba en end? (como _abre_bloque, sin elif ni else)
func _abre_con_end(linea: String) -> Bool
    if not _abre_bloque(linea)
        return false
    end
    p = _primera_palabra(str_trim(linea))
    return p != "elif" and p != "else"
end

func _en_blanco(t: String) -> Bool
    e = _espacios_delante(t)
    return e >= t.length or str_code(t, e) == 35
end

# ¿Le falta el end al bloque que abre la línea fila? La primera línea de después que no está más adentro: si es su
# end (o un elif o else de su if), lo tiene
func _falta_end(d: Documento, fila: Int) -> Bool
    linea = d.lineas[fila]
    if not _abre_con_end(linea)
        return false
    end
    # "@extern(...)" y luego "func f(...)": una declaración, sin cuerpo ni end
    k = _anterior_con_texto(d, fila)
    if k >= 0 and str_starts(str_trim(d.lineas[k]), "@extern")
        return false
    end
    sangria = _espacios_delante(linea)
    i = fila + 1
    while i < d.lineas.length
        t = d.lineas[i]
        if not _en_blanco(t)
            e = _espacios_delante(t)
            if e <= sangria
                p = _primera_palabra(t[e:])
                return not (e == sangria and (p == "end" or p == "elif" or p == "else"))
            end
        end
        i = i + 1
    end
    return true
end

# --- La pareja: el paréntesis (o corchete, o llave) que casa con el del cursor, y el end de un bloque ---
# ed_par_l1 = -1 si no hay; las dos puntas: línea, columna y largo (1 en un paréntesis; el de la palabra en un
# bloque)

var ed_par_l1: Int = -1
var ed_par_c1: Int = 0
var ed_par_n1: Int = 0
var ed_par_l2: Int = -1
var ed_par_c2: Int = 0
var ed_par_n2: Int = 0
var ed_par_doc: Documento = nil
var ed_par_version: Int = -1
var ed_par_cl: Int = -1
var ed_par_cc: Int = -1
var _par_pos: [Int] = []    # los paréntesis de una línea fuera de textos y comentarios: columna
var _par_car: [Int] = []    # y carácter
const PAR_LINEAS = 1000     # las líneas que se miran como mucho para buscar la pareja

func _par_linea(s: String)
    _par_pos.clear()
    _par_car.clear()
    texto = false
    i = 0
    while i < s.length
        c = str_code(s, i)
        if texto
            if c == 92
                i = i + 1
            elif c == 34
                texto = false
            end
        elif c == 34
            texto = true
        elif c == 35 and str_code(s, i + 1) != 123
            return
        elif c == 40 or c == 41 or c == 91 or c == 93 or c == 123 or c == 125
            _par_pos.push(i)
            _par_car.push(c)
        end
        i = i + 1
    end
end

# La clase de bloque de una línea: 1 abre un bloque con end, -1 es un end, 2 elif o else, 0 nada. Rápida: casi todas
# las líneas se descartan por su primera letra, y la palabra se saca una vez
func _clase_bloque(t: String) -> Int
    n = t.length
    e = 0
    while e < n and str_code(t, e) == 32
        e = e + 1
    end
    if e >= n
        return 0
    end
    c = str_code(t, e)
    if c != 102 and c != 105 and c != 119 and c != 115 and c != 101 and c != 77 and c != 69 and c != 79 and c != 87 and c != 64 and c != 97
        return 0
    end
    j = e + 1
    while j < n and (_es_letra(t, j) or str_code(t, j) == 64)
        j = j + 1
    end
    if j - e < 2 or j - e > 9
        return 0
    end
    p = t[e:j]
    if p == "end"
        if sx_clase_linea(t) == SXL_END
            return -1
        end
        return 0
    end
    if p == "elif" or p == "else"
        return 2
    end
    if p == "asm"
        if sx_clase_linea(t) == SXL_ASM
            return 1
        end
        return 0
    end
    if p == "@native"
        if not str_contains(t, " func ")
            return 0
        end
    elif p != "func" and p != "if" and p != "while" and p != "for" and p != "struct" and p != "enum" and p != "Window" and p != "Main" and p != "EventLoop" and p != "On" and p != "@c" and p != "interface"
        return 0
    end
    # "enum E A, B end" en una línea: no abre nada
    if str_contains(t, " end") and not _abre_con_end(t)
        return 0
    end
    return 1
end

# Como _clase_bloque, y un func tras @extern es una declaración (sin end)
func _clase_bloque_en(d: Documento, l: Int) -> Int
    k = _clase_bloque(d.lineas[l])
    if k == 1 and str_contains(d.lineas[l], "func")
        a = _anterior_con_texto(d, l)
        if a >= 0 and str_starts(str_trim(d.lineas[a]), "@extern")
            return 0
        end
    end
    return k
end

# Calcula la pareja de lo que hay en el cursor; true si cambió (hay que repintar sus líneas: las de antes y las de
# ahora). Solo en el código de Dash.
var ed_par_antes_l1: Int = -1
var ed_par_antes_l2: Int = -1

func ed_pareja_calcular(d: Documento) -> Bool
    if d == ed_par_doc and d.version == ed_par_version and d.cl == ed_par_cl and d.cc == ed_par_cc
        return false
    end
    ed_par_antes_l1 = ed_par_l1
    ed_par_antes_l2 = ed_par_l2
    a1 = ed_par_l1
    a2 = ed_par_l2
    b1 = ed_par_c1
    b2 = ed_par_c2
    ed_par_doc = d
    ed_par_version = d.version
    ed_par_cl = d.cl
    ed_par_cc = d.cc
    ed_par_l1 = -1
    ed_par_l2 = -1
    if d != nil and es_codigo_dash(d) and d.cl < d.lineas.length
        if not _pareja_parentesis(d)
            _pareja_bloque(d)
        end
    end
    return a1 != ed_par_l1 or a2 != ed_par_l2 or b1 != ed_par_c1 or b2 != ed_par_c2
end

func _pareja_parentesis(d: Documento) -> Bool
    linea = d.lineas[d.cl]
    _par_linea(linea)
    # el de detrás del cursor, o si no el de delante
    k = -1
    i = 0
    while i < _par_pos.length
        if _par_pos[i] == d.cc - 1 or (_par_pos[i] == d.cc and k < 0)
            k = i
        end
        i = i + 1
    end
    if k < 0
        return false
    end
    c = _par_car[k]
    col = _par_pos[k]
    var abre: Int = 0
    var cierra: Int = 0
    adelante = true
    if c == 40 or c == 91 or c == 123
        abre = c
        cierra = _cierre_de(c)
    else
        cierra = c
        abre = 40
        if c == 93
            abre = 91
        elif c == 125
            abre = 123
        end
        adelante = false
    end
    ed_par_l1 = d.cl
    ed_par_c1 = col
    ed_par_n1 = 1
    nivel = 0
    l = d.cl
    vueltas = 0
    while l >= 0 and l < d.lineas.length and vueltas < PAR_LINEAS
        if l != d.cl
            _par_linea(d.lineas[l])
        end
        if adelante
            i = 0
            while i < _par_pos.length
                if l != d.cl or _par_pos[i] > col
                    if _par_car[i] == abre
                        nivel = nivel + 1
                    elif _par_car[i] == cierra
                        if nivel == 0
                            ed_par_l2 = l
                            ed_par_c2 = _par_pos[i]
                            ed_par_n2 = 1
                            return true
                        end
                        nivel = nivel - 1
                    end
                end
                i = i + 1
            end
            l = l + 1
        else
            i = _par_pos.length - 1
            while i >= 0
                if l != d.cl or _par_pos[i] < col
                    if _par_car[i] == cierra
                        nivel = nivel + 1
                    elif _par_car[i] == abre
                        if nivel == 0
                            ed_par_l2 = l
                            ed_par_c2 = _par_pos[i]
                            ed_par_n2 = 1
                            return true
                        end
                        nivel = nivel - 1
                    end
                end
                i = i - 1
            end
            l = l - 1
        end
        vueltas = vueltas + 1
    end
    # sin pareja: el del cursor solo (en rojo)
    ed_par_l2 = -2
    return true
end

func _pareja_bloque(d: Documento)
    linea = d.lineas[d.cl]
    e = _espacios_delante(linea)
    p = _primera_palabra(linea[e:])
    # el cursor sobre la primera palabra (o justo detrás)
    if d.cc < e or d.cc > e + p.length
        return
    end
    clase = _clase_bloque(linea)
    if clase == 0
        return
    end
    ed_par_l1 = d.cl
    ed_par_c1 = e
    ed_par_n1 = p.length
    nivel = 0
    vueltas = 0
    if clase == 1
        # hacia abajo, hasta su end
        l = d.cl + 1
        while l < d.lineas.length and vueltas < PAR_LINEAS
            k = _clase_bloque_en(d, l)
            if k == 1
                nivel = nivel + 1
            elif k == -1
                if nivel == 0
                    ed_par_l2 = l
                    ed_par_c2 = _espacios_delante(d.lineas[l])
                    ed_par_n2 = 3
                    return
                end
                nivel = nivel - 1
            end
            l = l + 1
            vueltas = vueltas + 1
        end
        ed_par_l2 = -2
        return
    end
    # end, elif, else: hacia arriba, hasta lo que abre el bloque
    l = d.cl - 1
    while l >= 0 and vueltas < PAR_LINEAS
        k = _clase_bloque_en(d, l)
        if k == -1
            nivel = nivel + 1
        elif k == 1
            if nivel == 0
                ed_par_l2 = l
                ed_par_c2 = _espacios_delante(d.lineas[l])
                ed_par_n2 = _primera_palabra(d.lineas[l][ed_par_c2:]).length
                return
            end
            nivel = nivel - 1
        end
        l = l - 1
        vueltas = vueltas + 1
    end
    ed_par_l2 = -2
end

# Al otro lado de la pareja (true si hay)
func ed_ir_pareja(d: Documento) -> Bool
    ed_par_doc = nil
    ed_pareja_calcular(d)
    if ed_par_l1 < 0 or ed_par_l2 < 0
        return false
    end
    d.al = -1
    if d.cl == ed_par_l2 and d.cc >= ed_par_c2 and d.cc <= ed_par_c2 + ed_par_n2
        d.cl = ed_par_l1
        d.cc = ed_par_c1
    else
        d.cl = ed_par_l2
        d.cc = ed_par_c2
    end
    if ed_par_n1 == 1 and ed_par_n2 == 1
        # tras el paréntesis, para que siga siendo la pareja
        d.cc = d.cc + 1
    end
    ed_seguir_cursor(d)
    return true
end

# La caja de la pareja en la fila n (si es una de sus puntas)
func _dibujar_pareja(d: Documento, n: Int, tx: Int, fy: Int)
    if d != ed_par_doc or ed_par_l1 < 0 or d.version != ed_par_version
        return
    end
    color = tema.acento
    if ed_par_l2 == -2
        color = tema.error
    end
    gfx_pen(color)
    if n == ed_par_l1
        _caja_pareja(d, ed_par_c1, ed_par_n1, tx, fy)
    end
    if n == ed_par_l2
        _caja_pareja(d, ed_par_c2, ed_par_n2, tx, fy)
    end
end

func _caja_pareja(d: Documento, c: Int, n: Int, tx: Int, fy: Int)
    a = c - d.izquierda
    if a < 0 or a > ed_columnas
        return
    end
    x1 = tx + a * ancho_letra - 1
    x2 = tx + (a + n) * ancho_letra
    gfx_box(x1, fy, x2, fy + ed_alto_fila - 1)
end

# --- Plegado de bloques (paso 2.7) ---
# Un bloque plegado enseña solo su primera línea (con " ... end" detrás); las de dentro y su end no se ven. Sin nada
# plegado (lo normal), todo va como siempre: las cuentas con líneas ocultas solo se hacen si hay alguno.

var _pl_doc: Documento = nil
var _pl_version: Int = -1
var _pl_cambios: Int = 0         # sube al plegar o desplegar (las líneas ocultas se vuelven a calcular)
var _pl_visto: Int = -1
var _pl_desde: [Int] = []        # las líneas ocultas: de _pl_desde[i] a _pl_hasta[i], las dos incluidas
var _pl_hasta: [Int] = []

func _hay_plegados(d: Documento) -> Bool
    return d.plegados != nil and d.plegados.length > 0
end

# El end del bloque que abre la línea l (desde 0); -1 si no lo abre o no tiene
func ed_fin_de_bloque(d: Documento, l: Int) -> Int
    if _clase_bloque_en(d, l) != 1
        return -1
    end
    nivel = 0
    k = l + 1
    while k < d.lineas.length
        c = _clase_bloque_en(d, k)
        if c == 1
            nivel = nivel + 1
        elif c == -1
            if nivel == 0
                return k
            end
            nivel = nivel - 1
        end
        k = k + 1
    end
    return -1
end

# Las líneas ocultas, al día (si cambió el texto o lo plegado); quita los plegados que ya no abren un bloque
func _plegado_al_dia(d: Documento)
    if d == _pl_doc and d.version == _pl_version and _pl_cambios == _pl_visto
        return
    end
    _pl_doc = d
    _pl_version = d.version
    _pl_visto = _pl_cambios
    _pl_desde.clear()
    _pl_hasta.clear()
    if not _hay_plegados(d)
        return
    end
    i = 0
    while i < d.plegados.length
        l = d.plegados[i]
        fin = -1
        if l >= 0 and l < d.lineas.length
            fin = ed_fin_de_bloque(d, l)
        end
        if fin < 0
            d.plegados.remove(i)
        else
            # uno dentro de otro plegado ya está oculto
            if _pl_hasta.length == 0 or l > _pl_hasta[_pl_hasta.length - 1]
                _pl_desde.push(l + 1)
                _pl_hasta.push(fin)
            end
            i = i + 1
        end
    end
end

# ¿Está oculta la línea l?
func ed_oculta(d: Documento, l: Int) -> Bool
    if not _hay_plegados(d)
        return false
    end
    _plegado_al_dia(d)
    i = 0
    while i < _pl_desde.length
        if l >= _pl_desde[i] and l <= _pl_hasta[i]
            return true
        end
        i = i + 1
    end
    return false
end

# ¿Está plegado el bloque de la línea l?
func ed_plegada(d: Documento, l: Int) -> Bool
    if not _hay_plegados(d)
        return false
    end
    _plegado_al_dia(d)
    for k in _pl_desde
        if k == l + 1
            return true
        end
    end
    return false
end

# La primera línea que se ve desde l hacia abajo (l si se ve); d.lineas.length si ninguna
func ed_visible_desde(d: Documento, l: Int) -> Int
    if not _hay_plegados(d)
        return l
    end
    _plegado_al_dia(d)
    i = 0
    while i < _pl_desde.length
        if l >= _pl_desde[i] and l <= _pl_hasta[i]
            l = _pl_hasta[i] + 1
        end
        i = i + 1
    end
    return l
end

# La primera que se ve desde l hacia arriba (l si se ve)
func ed_visible_antes(d: Documento, l: Int) -> Int
    if not _hay_plegados(d)
        return l
    end
    _plegado_al_dia(d)
    i = _pl_desde.length - 1
    while i >= 0
        if l >= _pl_desde[i] and l <= _pl_hasta[i]
            l = _pl_desde[i] - 1
        end
        i = i - 1
    end
    return l
end

# La línea n filas (de las que se ven) más abajo de l (más arriba si n < 0), dentro del texto
func ed_filas_desde(d: Documento, l: Int, n: Int) -> Int
    if not _hay_plegados(d)
        l = l + n
    else
        while n > 0 and l < d.lineas.length - 1
            siguiente = ed_visible_desde(d, l + 1)
            if siguiente >= d.lineas.length
                n = 0
            else
                l = siguiente
                n = n - 1
            end
        end
        while n < 0 and l > 0
            l = ed_visible_antes(d, l - 1)
            n = n + 1
        end
    end
    if l > d.lineas.length - 1
        l = d.lineas.length - 1
    end
    if l < 0
        l = 0
    end
    return l
end

func ed_filas_entre(d: Documento, a: Int, b: Int) -> Int
    return _filas_entre(d, a, b)
end

# Cuántas filas hay de a hasta b (las líneas que se ven entre las dos, a incluida y b no)
func _filas_entre(d: Documento, a: Int, b: Int) -> Int
    n = b - a
    if not _hay_plegados(d)
        return n
    end
    _plegado_al_dia(d)
    i = 0
    while i < _pl_desde.length
        x = _pl_desde[i]
        y = _pl_hasta[i] + 1
        if x < a
            x = a
        end
        if y > b
            y = b
        end
        if y > x
            n = n - (y - x)
        end
        i = i + 1
    end
    return n
end

# Pliega el bloque que abre la línea l (true si se pudo)
func ed_plegar(d: Documento, l: Int) -> Bool
    if ed_fin_de_bloque(d, l) < 0
        return false
    end
    if d.plegados == nil
        d.plegados = []
    end
    if not _tiene(d.plegados, l)
        d.plegados.push(l)
        _ordenar(d.plegados)
    end
    _pl_cambios = _pl_cambios + 1
    return true
end

func ed_desplegar(d: Documento, l: Int) -> Bool
    if d.plegados == nil
        return false
    end
    i = 0
    while i < d.plegados.length
        if d.plegados[i] == l
            d.plegados.remove(i)
            _pl_cambios = _pl_cambios + 1
            return true
        end
        i = i + 1
    end
    return false
end

func ed_desplegar_todo(d: Documento) -> Bool
    if not _hay_plegados(d)
        return false
    end
    d.plegados.clear()
    _pl_cambios = _pl_cambios + 1
    return true
end

# El bloque donde está la línea l: la línea que lo abre (la misma si lo abre ella); -1 si ninguno
func ed_bloque_de(d: Documento, l: Int) -> Int
    if _clase_bloque_en(d, l) == 1
        return l
    end
    nivel = 0
    if _clase_bloque_en(d, l) == -1
        nivel = 1
    end
    k = l - 1
    while k >= 0
        c = _clase_bloque_en(d, k)
        if c == -1
            nivel = nivel + 1
        elif c == 1
            if nivel == 0
                return k
            end
            nivel = nivel - 1
        end
        k = k - 1
    end
    return -1
end

# Pliega o despliega el bloque del cursor (F4): si su línea está plegada, la despliega; si no, pliega el bloque donde
# está el cursor (que pasa a su primera línea). true si cambió algo
func ed_plegar_cursor(d: Documento) -> Bool
    if ed_plegada(d, d.cl)
        return ed_desplegar(d, d.cl)
    end
    l = ed_bloque_de(d, d.cl)
    if l < 0 or not ed_plegar(d, l)
        return false
    end
    if d.cl != l
        d.cl = l
        d.cc = _columna_valida(d, l, d.cc)
    end
    d.al = -1
    ed_seguir_cursor(d)
    return true
end

# Si la línea l está oculta, despliega lo que la tapa
func ed_destapar(d: Documento, l: Int)
    if not _hay_plegados(d)
        return
    end
    _plegado_al_dia(d)
    i = 0
    while i < _pl_desde.length
        if l >= _pl_desde[i] and l <= _pl_hasta[i]
            ed_desplegar(d, _pl_desde[i] - 1)
            _plegado_al_dia(d)
            i = 0
        else
            i = i + 1
        end
    end
end

# --- Moverse ---

func _es_letra(s: String, i: Int) -> Bool
    if i < 0 or i >= s.length
        return false
    end
    c = str_code(s, i)
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 192
end

func _mover(d: Documento, codigo: Int, teclas: Int)
    linea = d.lineas[d.cl]
    alt = (teclas & Q_ALT) != 0
    ctrl = (teclas & Q_CTRL) != 0
    if codigo == T_IZQUIERDA
        if alt
            # al principio del texto de la línea; otra vez, a la columna 0
            s = _espacios_delante(linea)
            if d.cc > s or d.cc == 0
                d.cc = s
            else
                d.cc = 0
            end
        elif ctrl
            while d.cc > 0 and not _es_letra(linea, d.cc - 1)
                d.cc = d.cc - 1
            end
            while d.cc > 0 and _es_letra(linea, d.cc - 1)
                d.cc = d.cc - 1
            end
        elif d.cc > 0
            d.cc = d.cc - 1
        elif d.cl > 0
            d.cl = ed_visible_antes(d, d.cl - 1)
            d.cc = d.lineas[d.cl].length
        end
    elif codigo == T_DERECHA
        if alt
            d.cc = linea.length
        elif ctrl
            while d.cc < linea.length and not _es_letra(linea, d.cc)
                d.cc = d.cc + 1
            end
            while d.cc < linea.length and _es_letra(linea, d.cc)
                d.cc = d.cc + 1
            end
        elif d.cc < linea.length
            d.cc = d.cc + 1
        elif d.cl < d.lineas.length - 1 and ed_visible_desde(d, d.cl + 1) < d.lineas.length
            d.cl = ed_visible_desde(d, d.cl + 1)
            d.cc = 0
        end
    elif codigo == T_ARRIBA or codigo == T_ABAJO
        paso = 1
        if alt
            paso = ed_visibles - 1
        end
        if ctrl
            paso = d.lineas.length
        end
        if _hay_plegados(d) and not ctrl
            # de fila en fila: las líneas plegadas se saltan
            if codigo == T_ARRIBA
                paso = -paso
            end
            d.cl = ed_filas_desde(d, d.cl, paso)
        elif codigo == T_ARRIBA
            d.cl = d.cl - paso
        else
            d.cl = d.cl + paso
        end
        if d.cl < 0
            d.cl = 0
            if ctrl
                d.cc = 0
            end
        end
        if d.cl > d.lineas.length - 1
            d.cl = d.lineas.length - 1
            if ctrl
                d.cc = d.lineas[d.cl].length
            end
        end
        if d.cc > d.lineas[d.cl].length
            d.cc = d.lineas[d.cl].length
        end
    end
end

# Que el cursor se vea
func ed_seguir_cursor(d: Documento)
    if _hay_plegados(d)
        # el cursor en una línea oculta: se despliega lo que la tapa
        ed_destapar(d, d.cl)
        d.primera = ed_visible_desde(d, d.primera)
        if d.primera >= d.lineas.length
            d.primera = ed_visible_antes(d, d.lineas.length - 1)
        end
        if d.cl < d.primera
            d.primera = d.cl
        end
        if _filas_entre(d, d.primera, d.cl) >= ed_visibles
            d.primera = ed_filas_desde(d, d.cl, -(ed_visibles - 1))
        end
    else
        if d.cl < d.primera
            d.primera = d.cl
        end
        if d.cl >= d.primera + ed_visibles
            d.primera = d.cl - ed_visibles + 1
        end
    end
    if d.cc < d.izquierda
        d.izquierda = d.cc
    end
    if d.cc >= d.izquierda + ed_columnas
        d.izquierda = d.cc - ed_columnas + 4
    end
    if d.izquierda < 0
        d.izquierda = 0
    end
end

# Una tecla sobre el editor (sin Amiga: esas son atajos del menú). true si cambió algo.
func ed_tecla(codigo: Int, teclas: Int, letra: String) -> Bool
    d = ed_actual()
    if d == nil
        return false
    end
    mayus = (teclas & Q_MAYUS) != 0
    if d.vista != 0 and codigo != T_IZQUIERDA and codigo != T_DERECHA and codigo != T_ARRIBA and codigo != T_ABAJO and codigo != T_ESC
        # una vista de solo lectura: solo moverse
        return false
    end
    if codigo == T_IZQUIERDA or codigo == T_DERECHA or codigo == T_ARRIBA or codigo == T_ABAJO
        if mayus and d.al < 0
            d.al = d.cl
            d.ac = d.cc
        end
        if not mayus and ed_hay_seleccion(d) and (teclas & (Q_ALT | Q_CTRL)) == 0 and (codigo == T_IZQUIERDA or codigo == T_DERECHA)
            # sin Mayúsculas, la flecha va al lado de la selección
            _orden(d)
            if codigo == T_IZQUIERDA
                d.cl = _l1
                d.cc = _c1
            else
                d.cl = _l2
                d.cc = _c2
            end
        else
            _mover(d, codigo, teclas)
        end
        if not mayus
            d.al = -1
        end
    elif codigo == T_RETURN or codigo == T_ENTER
        ed_nueva_linea(d)
    elif codigo == T_RETROCESO
        ed_retroceso(d)
    elif codigo == T_SUPRIMIR
        ed_suprimir(d)
    elif codigo == T_TAB
        if mayus
            ed_quitar_sangria(d)
        else
            ed_tabulador(d)
        end
    elif codigo == T_ESC
        d.al = -1
    elif letra != "" and str_code(letra, 0) >= 32 and str_code(letra, 0) != 127
        if not (ed_cerrar_solo and _cerrar_solo(d, letra))
            ed_escribir(d, letra)
            ed_tras_letra(d, letra)
        end
    else
        return false
    end
    ed_seguir_cursor(d)
    return true
end

# ¿Se ve la sugerencia en d? (el texto y el cursor siguen como estaban, sin nada elegido, al final de la línea)
func ed_sugerencia_vale(d: Documento) -> Bool
    if ed_sug_texto == "" or d == nil or d != ed_sug_doc or d.vista != 0
        return false
    end
    return d.version == ed_sug_version and d.cl == ed_sug_l and d.cc == ed_sug_c and not ed_hay_seleccion(d) and d.cl < d.lineas.length and d.cc == d.lineas[d.cl].length
end

# --- Ratón ---

# La línea y la columna de un punto de la zona (en _fin_l, _fin_c)
func _posicion(d: Documento, x: Int, y: Int)
    l = d.primera + (y - ALTO_PESTANAS - 2) / ed_alto_fila
    if y < ALTO_PESTANAS + 2
        l = d.primera - 1
    elif _hay_plegados(d)
        l = ed_filas_desde(d, d.primera, (y - ALTO_PESTANAS - 2) / ed_alto_fila)
    end
    if l < 0
        l = 0
    end
    if l > d.lineas.length - 1
        l = d.lineas.length - 1
    end
    c = d.izquierda + (x - ed_margen - 2 + ancho_letra / 2) / ancho_letra
    if c < 0
        c = 0
    end
    if c > d.lineas[l].length
        c = d.lineas[l].length
    end
    _fin_l = l
    _fin_c = c
end

# La línea y la columna (desde 0) de un punto del lienzo: en ed_punto_l y ed_punto_c
var ed_punto_l: Int = 0
var ed_punto_c: Int = 0
func ed_punto_en(d: Documento, x: Int, y: Int)
    _posicion(d, x, y)
    ed_punto_l = _fin_l
    ed_punto_c = _fin_c
end

func ed_clic(x: Int, y: Int, extender: Bool)
    d = ed_actual()
    if d == nil or y < ALTO_PESTANAS
        return
    end
    _posicion(d, x, y)
    if extender
        if d.al < 0
            d.al = d.cl
            d.ac = d.cc
        end
    else
        # el ancla, por si se arrastra
        d.al = _fin_l
        d.ac = _fin_c
    end
    d.cl = _fin_l
    d.cc = _fin_c
end

func ed_arrastrar(x: Int, y: Int)
    d = ed_actual()
    if d == nil
        return
    end
    _posicion(d, x, y)
    if d.al < 0
        d.al = d.cl
        d.ac = d.cc
    end
    d.cl = _fin_l
    d.cc = _fin_c
    ed_seguir_cursor(d)
end

# --- Dibujar ---

func _dibujar_pestanas(x: Int, y: Int, ancho: Int)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + ALTO_PESTANAS - 1)
    usar_panel(0)
    _pestana_x1.clear()
    _pestana_x2.clear()
    tx = x + 4
    i = 0
    for d in documentos
        nombre = d.nombre
        if d.cambiado
            nombre = nombre + " *"
        end
        w = font_text_width(nombre) + 20
        if i == activo
            gfx_pen(tema.fondo)
            gfx_rect(tx, y + 2, tx + w - 1, y + ALTO_PESTANAS - 1)
            gfx_pen(tema.acento)
            gfx_rect(tx, y + 2, tx + w - 1, y + 3)
            gfx_pen(tema.texto)
        else
            gfx_pen(tema.tenue)
        end
        gfx_text_at(tx + 10, y + (ALTO_PESTANAS - font_height()) / 2 + 2 + font_baseline(), nombre)
        _pestana_x1.push(tx - x)
        _pestana_x2.push(tx + w - 1 - x)
        tx = tx + w + 2
        i = i + 1
    end
end

# ¿Está la línea n (desde 0) dentro de un bloque asm ... end? Se mira hacia arriba hasta una línea que lo diga
# (sx_clase_linea: la cabecera asm, un end o una de Dash seguro), 300 como mucho: no hace falta leer todo el fichero
func ed_en_asm(d: Documento, n: Int) -> Bool
    k = n - 1
    tope = n - 300
    while k >= 0 and k >= tope
        c = sx_clase_linea(d.lineas[k])
        if c == SXL_ASM
            return true
        elif c != SXL_NADA
            return false
        end
        k = k - 1
    end
    return false
end

# Si la línea que sigue a esta está dentro de un bloque asm (dentro: si lo está esta)
func _asm_tras(linea: String, dentro: Bool) -> Bool
    c = sx_clase_linea(linea)
    if c == SXL_ASM
        return true
    end
    return dentro and c == SXL_NADA
end

# Una línea del texto en fy, con su número, la selección, los colores y el cursor (_fila_asm: dentro de un bloque asm)
func _dibujar_fila(d: Documento, n: Int, x: Int, fy: Int, ancho: Int, hay_sel: Bool)
    linea = d.lineas[n]
    tx = x + ed_margen + 2
    gfx_pen(tema.fondo)
    if n == d.cl and not hay_sel
        gfx_pen(tema.fondo_linea)
    end
    gfx_rect(x + ed_margen - 3, fy, x + ancho - 1, fy + ed_alto_fila - 1)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, fy, x + ed_margen - 4, fy + ed_alto_fila - 1)
    if hay_sel and n >= _l1 and n <= _l2
        desde = 0
        hasta = linea.length + 1     # el salto de línea también
        if n == _l1
            desde = _c1
        end
        if n == _l2
            hasta = _c2
        end
        desde = desde - d.izquierda
        hasta = hasta - d.izquierda
        if desde < 0
            desde = 0
        end
        if hasta > desde
            gfx_pen(tema.seleccion)
            gfx_rect(tx + desde * ancho_letra, fy, tx + hasta * ancho_letra - 1, fy + ed_alto_fila - 1)
        end
    end
    parada = ed_dbg_linea == n + 1 and ed_dbg_ruta != "" and str_lower(ed_dbg_ruta) == str_lower(d.ruta)
    if parada
        # la línea donde está parado el depurador
        gfx_pen(tema.parada)
        gfx_rect(x + ed_margen - 3, fy, x + ancho - 1, fy + ed_alto_fila - 1)
    end
    if _tiene_punto(d, n + 1)
        gfx_pen(tema.error)
        if ed_puntos_raros.length > 0 and ed_puntos_raros.has(str_lower(d.ruta) + ":#{n + 1}")
            # con condición o contador: hueco, con un punto en medio (con 4 colores se ve por la forma)
            gfx_box(x + 2, fy + 2, x + 7, fy + ed_alto_fila - 3)
            gfx_rect(x + 4, fy + ed_alto_fila / 2 - 1, x + 5, fy + ed_alto_fila / 2)
        else
            gfx_rect(x + 2, fy + 2, x + 7, fy + ed_alto_fila - 3)
        end
    end
    if d.marcadores != nil and _tiene(d.marcadores, n)
        # el marcador: una cinta con muesca abajo (sobre el punto de parada, solo su borde)
        _dibujar_marcador(x + 2, fy)
    end
    # las rayas de las extensiones (git: lo cambiado frente a HEAD), a la derecha del margen; con 4 colores se
    # distinguen por la forma: añadida, una raya llena; cambiada, una raya a trozos; quitadas, un triángulo
    if d.vista == 0 and marcas_rayas.length > 0
        _raya(raya_en(ed_marca_ruta, n + 1), x + ed_margen - 9, fy)
    end
    if parada
        # una flecha en el margen (con 4 colores el fondo de la línea no se distingue)
        gfx_pen(tema.cursor)
        medio = fy + ed_alto_fila / 2
        k = 0
        while k < 4
            gfx_line(x + 9 + k, medio - 3 + k, x + 9 + k, medio + 3 - k)
            k = k + 1
        end
    end
    num = "#{n + 1}"
    gfx_pen(tema.tenue)
    if n == d.cl or parada
        gfx_pen(tema.texto)
    end
    # un error de compilar o de comprobar (errores.dash): el número en rojo y el texto subrayado
    ecol = -1
    if err_lista.length > 0 and d.vista == 0
        ecol = err_col_en(ed_err_ruta, n + 1)
        if ecol >= 0
            gfx_pen(tema.error)
        end
    end
    base = fy + 1 + base_letra
    gfx_text_at(x + ed_margen - 4 - MARGEN_TEXTO - ed_ancho_marca - num.length * ancho_letra, base, num)
    if ed_ancho_marca > 0
        m = marca_en(ed_marca_ruta, n + 1)
        if m != ""
            gfx_pen(color_marca(m))
            gfx_text_at(ed_x_marca(x), base, m)
        end
    end
    # los trozos de color que caen en las columnas que se ven
    hasta_col = d.izquierda + ed_columnas + 1
    if linea != "" and d.vista != 0
        gfx_pen(tema.texto)
        if n < d.colores.length
            gfx_pen(ed_color_vista(d.colores[n:n + 1]))
        end
        a = d.izquierda
        b = linea.length
        if b > hasta_col
            b = hasta_col
        end
        if b > a
            gfx_text_at(tx, base, linea[a:b])
        end
    elif linea != ""
        if _fila_asm and sx_clase_linea(linea) != SXL_END
            sx_partir_asm(linea)
        else
            sx_partir(linea)
        end
        k = 0
        while k < sx_desde.length
            a = sx_desde[k]
            b = linea.length
            if k + 1 < sx_desde.length
                b = sx_desde[k + 1]
            end
            if a < d.izquierda
                a = d.izquierda
            end
            if b > hasta_col
                b = hasta_col
            end
            if b > a
                gfx_pen(tema.sintaxis[sx_tipo[k]])
                gfx_text_at(tx + (a - d.izquierda) * ancho_letra, base, linea[a:b])
            end
            k = k + 1
        end
    end
    if d.plegados != nil and ed_plegada(d, n)
        # plegada: " ... end" detrás, en una caja
        a = linea.length + 1 - d.izquierda
        if a < 0
            a = 0
        end
        px = tx + a * ancho_letra
        gfx_pen(tema.borde)
        gfx_rect(px - 2, fy + 1, px + 9 * ancho_letra + 1, fy + ed_alto_fila - 2)
        gfx_pen(tema.tenue)
        gfx_text_at(px, base, " ... end")
    end
    if n == d.cl and ed_sugerencia_vale(d)
        # la sugerencia, en gris tras el final de la línea (lo que cabe)
        cabe = hasta_col - linea.length
        if cabe > 0 and linea.length >= d.izquierda
            t = ed_sug_texto
            if t.length > cabe
                t = t[0:cabe]
            end
            gfx_pen(tema.tenue)
            gfx_text_at(tx + (linea.length - d.izquierda) * ancho_letra, base, t)
        end
    end
    if ecol >= 0
        _subrayar_error(linea, ecol, d.izquierda, hasta_col, tx, fy)
    end
    if n == ed_par_l1 or n == ed_par_l2
        _dibujar_pareja(d, n, tx, fy)
    end
    if n == d.cl
        cx = tx + (d.cc - d.izquierda) * ancho_letra
        if cx >= tx
            gfx_pen(tema.cursor)
            gfx_rect(cx - 1, fy, cx, fy + ed_alto_fila - 1)
        end
    end
end

func _dibujar_marcador(mx: Int, fy: Int)
    gfx_pen(tema.acento)
    abajo = fy + ed_alto_fila - 2
    gfx_rect(mx, fy + 1, mx, abajo)
    gfx_rect(mx + 5, fy + 1, mx + 5, abajo)
    gfx_rect(mx, fy + 1, mx + 5, fy + 2)
    gfx_line(mx, abajo, mx + 2, abajo - 2)
    gfx_line(mx + 5, abajo, mx + 3, abajo - 2)
end

# La raya en zigzag bajo lo que señala un error: el nombre (o el carácter) de su columna col (desde 1); sin columna,
# o fuera del texto, toda la línea
func _subrayar_error(linea: String, col: Int, izquierda: Int, hasta_col: Int, tx: Int, fy: Int)
    a = col - 1
    b = a
    if a >= 0 and a < linea.length
        while b < linea.length and _es_letra(linea, b)
            b = b + 1
        end
        if b == a
            b = a + 1
        end
    else
        a = _espacios_delante(linea)
        b = linea.length
        if b <= a
            b = a + 1
        end
    end
    if a < izquierda
        a = izquierda
    end
    if b > hasta_col
        b = hasta_col
    end
    if b <= a
        return
    end
    x1 = tx + (a - izquierda) * ancho_letra
    x2 = tx + (b - izquierda) * ancho_letra - 1
    y = fy + ed_alto_fila - 1
    gfx_pen(tema.error)
    k = x1
    while k < x2
        if ((k - x1) / 2) % 2 == 0
            gfx_line(k, y, k + 1, y - 1)
        else
            gfx_line(k, y - 1, k + 1, y)
        end
        k = k + 2
    end
end

# La x de la columna de las marcas de las extensiones (x: la de la zona)
func ed_x_marca(x: Int) -> Int
    return x + ed_margen - 4 - MARGEN_TEXTO - ed_ancho_marca
end

# El color de una marca, por su símbolo: + añadido, - quitado, ~ y * cambiado, ! error; las demás, texto
func color_marca(m: String) -> Int
    if m == "+"
        return tema.bien
    elif m == "-" or m == "!"
        return tema.error
    elif m == "~" or m == "*"
        return tema.acento
    end
    return tema.texto
end

func _raya(m: Int, mx: Int, fy: Int)
    if m == 0
        return
    end
    if (m & R_ANADIDA) != 0
        gfx_pen(tema.bien)
        gfx_rect(mx, fy, mx + 2, fy + ed_alto_fila - 1)
    elif (m & R_CAMBIADA) != 0
        gfx_pen(tema.acento)
        k = 0
        while k < ed_alto_fila
            gfx_rect(mx, fy + k, mx + 2, fy + k + 1)
            k = k + 3
        end
    end
    if (m & R_QUITADA) != 0
        gfx_pen(tema.error)
        gfx_rect(mx, fy, mx + 4, fy)
        gfx_rect(mx, fy + 1, mx + 2, fy + 1)
        gfx_rect(mx, fy + 2, mx, fy + 2)
    end
    if (m & R_QUITADA_FIN) != 0
        b = fy + ed_alto_fila - 1
        gfx_pen(tema.error)
        gfx_rect(mx, b, mx + 4, b)
        gfx_rect(mx, b - 1, mx + 2, b - 1)
        gfx_rect(mx, b - 2, mx, b - 2)
    end
end

# El editor de ventanas lee el documento si no es el que tiene (o si se le pide otra vez)
func ed_cargar_diseno(d: Documento, otra_vez: Bool)
    clave = d.ruta + "|" + d.nombre
    if dv_de == clave and not otra_vez
        return
    end
    if dv_de != clave
        dv_sel = 0
        dv_prop = -1
    end
    dv_de = clave
    dv_error_carga = dv_cargar(ed_texto(d))
end

# Lo cambiado en el editor de ventanas pasa al texto del documento (con deshacer)
func ed_aplicar_diseno(d: Documento)
    ed_cambiar_lineas(d, 1, d.lineas.length, dv_texto())
    d.cl = 0
    d.cc = 0
    d.primera = 0
end

# Pone o quita el punto de parada de la línea n (desde 1); true si queda puesto
func ed_alternar_punto(d: Documento, n: Int) -> Bool
    i = 0
    while i < d.puntos.length
        if d.puntos[i] == n
            d.puntos.remove(i)
            return false
        end
        i = i + 1
    end
    d.puntos.push(n)
    return true
end

func _tiene_punto(d: Documento, n: Int) -> Bool
    for p in d.puntos
        if p == n
            return true
        end
    end
    return false
end

# La línea (desde 1) de un punto y de la zona, para los clics en el margen
func ed_linea_en(d: Documento, y: Int) -> Int
    _posicion(d, 0, y)
    return _fin_l + 1
end

# La y de la fila de la línea n, desde la esquina de la zona (-1 si no se ve)
func ed_fila_y(d: Documento, n: Int) -> Int
    if _hay_plegados(d)
        if n < d.primera or ed_oculta(d, n)
            return -1
        end
        f = _filas_entre(d, d.primera, n)
        if f >= ed_visibles
            return -1
        end
        return ALTO_PESTANAS + 2 + f * ed_alto_fila
    end
    if n < d.primera or n >= d.primera + ed_visibles
        return -1
    end
    return ALTO_PESTANAS + 2 + (n - d.primera) * ed_alto_fila
end

# --- La bienvenida: sin ficheros abiertos, el logo de Dash con el cursor del Shell parpadeando ---
# El logo es de 16x16 cuadros (docs/logo/dash.svg de Dash). tic() de main.dash lo hace parpadear con
# bienvenida_parpadear().

var bienvenida_cursor: Bool = true
var _bienvenida_cambio: Int = 0
var _bienvenida_zona: [Int] = [0, 0, 0, 0]  # el cursor: x, y, ancho y alto desde la esquina del lienzo

func _cuadros(lx: Int, ly: Int, c: Int, cx: Int, cy: Int, ancho: Int, alto: Int)
    gfx_rect(lx + cx * c, ly + cy * c, lx + (cx + ancho) * c - 1, ly + (cy + alto) * c - 1)
end

func _dibujar_bienvenida(x: Int, y: Int, ancho: Int, alto: Int)
    # el lado de un cuadro: el logo ocupa unos dos quintos del lado corto
    c = alto / 40
    if ancho / 40 < c
        c = ancho / 40
    end
    if c < 2
        c = 2
    end
    lx = x + (ancho - 16 * c) / 2
    ly = y + (alto - 16 * c) / 2
    gfx_pen(pen_logo[0])
    gfx_rect(lx, ly, lx + 16 * c - 1, ly + 16 * c - 1)
    gfx_pen(pen_logo[1])
    _cuadros(lx, ly, c, 3, 4, 5, 1)
    _cuadros(lx, ly, c, 3, 5, 2, 6)
    _cuadros(lx, ly, c, 7, 5, 2, 6)
    _cuadros(lx, ly, c, 3, 11, 5, 1)
    if bienvenida_cursor
        gfx_pen(pen_logo[2])
        _cuadros(lx, ly, c, 10, 11, 3, 1)
    end
    _bienvenida_zona = [lx + 10 * c - ed_zona_x, ly + 11 * c - ed_zona_y, 3 * c, c]
end

# Enciende o apaga el cursor si ha pasado medio segundo; true si hay que redibujar su zona
func bienvenida_parpadear() -> Bool
    if ed_actual() != nil or time_ms() - _bienvenida_cambio < 400
        return false
    end
    _bienvenida_cambio = time_ms()
    bienvenida_cursor = not bienvenida_cursor
    return true
end

func bienvenida_zona() -> [Int]
    return _bienvenida_zona
end

func ed_dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    tema_preparar()
    gfx_mode(0)
    d = ed_actual()
    if d != nil and d.diseno
        if not mui_canvas_updating()
            _dibujar_pestanas(x, y, ancho)
        end
        ed_zona_x = x
        ed_zona_y = y
        ed_zona_ancho = ancho
        ed_zona_alto = alto
        ed_cargar_diseno(d, false)
        dv_dibujar(x, y + ALTO_PESTANAS, ancho, alto - ALTO_PESTANAS, ALTO_PESTANAS)
        return
    end
    if mui_canvas_updating() and ed_solo_linea >= 0 and d != nil
        fy = ed_fila_y(d, ed_solo_linea)
        if fy >= 0
            usar_codigo()
            _fila_asm = d.vista == 0 and ed_en_asm(d, ed_solo_linea)
            _dibujar_fila(d, ed_solo_linea, x, y + fy, ancho, false)
        end
        return
    end
    t0 = time_ms()
    ed_zona_x = x
    ed_zona_y = y
    ed_zona_ancho = ancho
    ed_zona_alto = alto
    _dibujar_pestanas(x, y, ancho)
    ty = y + ALTO_PESTANAS
    gfx_pen(tema.fondo)
    gfx_rect(x, ty, x + ancho - 1, y + alto - 1)
    if d == nil
        _dibujar_bienvenida(x, ty, ancho, y + alto - ty)
        return
    end
    usar_codigo()
    ed_alto_fila = alto_letra + 2
    ed_visibles = (alto - ALTO_PESTANAS - 4) / ed_alto_fila
    if ed_visibles < 1
        ed_visibles = 1
    end
    # el margen de los números, del ancho del número más largo
    cifras = "#{d.lineas.length}".length
    if cifras < 3
        cifras = 3
    end
    ed_marca_ruta = str_lower(d.ruta)
    ed_err_ruta = ed_marca_ruta
    if d.ruta == ""
        ed_err_ruta = str_lower(d.temporal)
    end
    ed_ancho_marca = 0
    if marcas_hay(ed_marca_ruta)
        ed_ancho_marca = ancho_letra
    end
    ed_margen = (cifras + 1) * ancho_letra + MARGEN_TEXTO + ed_ancho_marca
    ed_columnas = (ancho - ed_margen - 4) / ancho_letra
    if ed_columnas < 1
        ed_columnas = 1
    end
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, ty, x + ed_margen - 4, y + alto - 1)
    hay_sel = ed_hay_seleccion(d)
    if hay_sel
        _orden(d)
    end
    ed_pareja_calcular(d)
    hay_plegados = _hay_plegados(d)
    j = 0
    if hay_plegados
        _plegado_al_dia(d)
        d.primera = ed_visible_desde(d, d.primera)
        if d.primera >= d.lineas.length
            d.primera = ed_visible_antes(d, d.lineas.length - 1)
        end
    end
    fy = ty + 2
    n = d.primera
    _fila_asm = d.vista == 0 and ed_en_asm(d, n)
    while n < d.lineas.length and fy + ed_alto_fila <= y + alto
        _dibujar_fila(d, n, x, fy, ancho, hay_sel)
        if d.vista == 0
            _fila_asm = _asm_tras(d.lineas[n], _fila_asm)
        end
        fy = fy + ed_alto_fila
        n = n + 1
        if hay_plegados
            # (las de dentro de un bloque plegado no se ven: los tramos ocultos van en orden, se sigue por ellos)
            while j < _pl_desde.length and _pl_hasta[j] < n
                j = j + 1
            end
            if j < _pl_desde.length and n >= _pl_desde[j]
                n = _pl_hasta[j] + 1
                _fila_asm = false
            end
        end
    end
    ed_ms_dibujo = time_ms() - t0
    ed_dibujos = ed_dibujos + 1
    if ed_anotar_vistas and ed_vistas.length < 2000
        ed_vistas = ed_vistas + "#{d.primera} "
    end
    ed_capas_geometria(d)
    _dibujar_capas(d, x, y)
end

# --- La lista para completar y la ayuda de los argumentos ---

# Parte un texto en líneas de como mucho ancho letras (por los espacios), hasta max líneas
func _partir(t: String, ancho: Int, max: Int) -> [String]
    var r: [String] = []
    while t != "" and r.length < max
        if t.length <= ancho
            r.push(t)
            return r
        end
        corte = ancho
        while corte > ancho / 2 and str_code(t, corte) != 32
            corte = corte - 1
        end
        if str_code(t, corte) != 32
            corte = ancho
        end
        if r.length == max - 1
            r.push(t[0:ancho - 3] + "...")
            return r
        end
        r.push(t[0:corte])
        t = str_trim(t[corte:])
    end
    return r
end

func ed_texto_ayuda() -> String
    t = ay_cabeza
    i = 0
    for p in ay_params
        if i > 0
            t = t + ", "
        end
        t = t + p
        i = i + 1
    end
    return t + ay_cola
end

# Dónde van la lista y la ayuda (ed_lista_*, ed_ayuda_*), desde la esquina de la zona; alto 0 si no se ven
func ed_capas_geometria(d: Documento)
    ed_lista_alto = 0
    ed_ayuda_alto = 0
    ed_valor_alto = 0
    if d == nil or d.diseno
        return
    end
    if ed_valor_texto != "" and ed_valor_l >= 0
        fv = ed_fila_y(d, ed_valor_l)
        if fv >= 0
            cols = ed_valor_texto.length
            if cols > ed_columnas - 4
                cols = ed_columnas - 4
            end
            if cols < 4
                cols = 4
            end
            ed_valor_ancho = cols * ancho_letra + 8
            ed_valor_alto = ed_alto_fila + 4
            ed_valor_x = ed_margen + 2 + (ed_valor_c - d.izquierda) * ancho_letra - 4
            ed_valor_y = fv - ed_valor_alto - 1
            if ed_valor_y < ALTO_PESTANAS + 2
                ed_valor_y = fv + ed_alto_fila + 1
            end
            if ed_valor_x + ed_valor_ancho > ed_zona_ancho - 2
                ed_valor_x = ed_zona_ancho - 2 - ed_valor_ancho
            end
            if ed_valor_x < ed_margen
                ed_valor_x = ed_margen
            end
        end
    end
    fila = ed_fila_y(d, d.cl)
    if fila < 0
        return
    end
    tx = ed_margen + 2
    maximo = ed_columnas - 2
    if maximo < 10
        maximo = 10
    end
    if ay_visible and ay_linea == d.cl
        t = ed_texto_ayuda()
        cols = t.length
        if cols > maximo
            cols = maximo
        end
        _ayuda_lineas = []
        if ay_nota != ""
            ancho_nota = cols
            if ancho_nota < 40
                ancho_nota = 40
            end
            if ancho_nota > maximo
                ancho_nota = maximo
            end
            _ayuda_lineas = _partir(ay_nota, ancho_nota, 3)
            for l in _ayuda_lineas
                if l.length > cols
                    cols = l.length
                end
            end
        end
        ed_ayuda_ancho = cols * ancho_letra + 8
        ed_ayuda_alto = (1 + _ayuda_lineas.length) * ed_alto_fila + 4
        ed_ayuda_x = tx + (d.cc - d.izquierda - ay_cabeza.length) * ancho_letra - 4
        ed_ayuda_y = fila - ed_ayuda_alto - 1
        if ed_ayuda_y < ALTO_PESTANAS + 2
            ed_ayuda_y = fila + ed_alto_fila + 1
        end
    end
    if ac_visible and ac_linea == d.cl
        filas = ac_nombres.length
        if filas > LISTA_FILAS
            filas = LISTA_FILAS
        end
        ed_lista_filas = filas
        largo = 14
        i = 0
        while i < ac_nombres.length
            if ac_nombres[i].length > largo
                largo = ac_nombres[i].length
            end
            i = i + 1
        end
        cols = largo + 4
        f = ac_firma(ac_sel)
        if f.length + 1 > cols
            cols = f.length + 1
        end
        if cols > 48
            cols = 48
        end
        if cols > maximo
            cols = maximo
        end
        ed_lista_ancho = cols * ancho_letra + 8
        ed_lista_x = tx + (ac_col - d.izquierda - 2) * ancho_letra - 4
        # debajo de la línea si cabe; si no, donde haya más sitio (encima, si la ayuda no está ahí), con menos filas
        abajo = fila + ed_alto_fila + 1
        if ed_ayuda_alto > 0 and ed_ayuda_y > fila
            abajo = ed_ayuda_y + ed_ayuda_alto + 1
        end
        sitio_abajo = ed_zona_alto - abajo - 1
        sitio_arriba = fila - 1 - (ALTO_PESTANAS + 2)
        if ed_ayuda_alto > 0 and ed_ayuda_y < fila
            sitio_arriba = 0
        end
        arriba = false
        if (filas + 1) * ed_alto_fila + 6 > sitio_abajo and sitio_arriba > sitio_abajo
            arriba = true
            sitio_abajo = sitio_arriba
        end
        caben = (sitio_abajo - 6) / ed_alto_fila - 1
        if caben < 1
            caben = 1
        end
        if filas > caben
            filas = caben
        end
        ed_lista_filas = filas
        ed_lista_alto = (filas + 1) * ed_alto_fila + 6
        ed_lista_y = abajo
        if arriba
            ed_lista_y = fila - ed_lista_alto - 1
        end
        ac_seguir(filas)
    end
    # dentro de la zona por la derecha y la izquierda
    if ed_lista_alto > 0
        if ed_lista_x + ed_lista_ancho > ed_zona_ancho - 2
            ed_lista_x = ed_zona_ancho - 2 - ed_lista_ancho
        end
        if ed_lista_x < ed_margen
            ed_lista_x = ed_margen
        end
    end
    if ed_ayuda_alto > 0
        if ed_ayuda_x + ed_ayuda_ancho > ed_zona_ancho - 2
            ed_ayuda_x = ed_zona_ancho - 2 - ed_ayuda_ancho
        end
        if ed_ayuda_x < ed_margen
            ed_ayuda_x = ed_margen
        end
    end
end

# Las y (desde la esquina de la zona) de arriba y de abajo de lo que hay encima del texto; -1, -1 si nada
var ed_capas_y1: Int = -1
var ed_capas_y2: Int = -1

func ed_capas_rango()
    ed_capas_y1 = -1
    ed_capas_y2 = -1
    if ed_valor_alto > 0
        ed_capas_y1 = ed_valor_y
        ed_capas_y2 = ed_valor_y + ed_valor_alto
    end
    if ed_lista_alto > 0
        if ed_capas_y1 < 0 or ed_lista_y < ed_capas_y1
            ed_capas_y1 = ed_lista_y
        end
        if ed_lista_y + ed_lista_alto > ed_capas_y2
            ed_capas_y2 = ed_lista_y + ed_lista_alto
        end
    end
    if ed_ayuda_alto > 0
        if ed_capas_y1 < 0 or ed_ayuda_y < ed_capas_y1
            ed_capas_y1 = ed_ayuda_y
        end
        if ed_ayuda_y + ed_ayuda_alto > ed_capas_y2
            ed_capas_y2 = ed_ayuda_y + ed_ayuda_alto
        end
    end
end

# El color de una clase de símbolo (codigo.dash) y su letra
func ed_color_clase(c: Int) -> Int
    if c == CX_FUNC or c == CX_METODO or c == CX_BUILTIN
        return tema.sintaxis[S_LLAMADA]
    elif c == CX_STRUCT or c == CX_TIPO or c == CX_ENUM
        return tema.sintaxis[S_TIPO]
    elif c == CX_CONST or c == CX_VALOR
        return tema.sintaxis[S_CONSTANTE]
    elif c == CX_CLAVE
        return tema.sintaxis[S_CLAVE]
    end
    return tema.sintaxis[S_NUMERO]
end

func ed_letra_clase(c: Int) -> String
    var letras: [String] = ["?", "f", "S", "k", "v", "E", "c", "m", "e", "l", "p", "t", "b", "m"]
    if c < 0 or c >= letras.length
        return "?"
    end
    return letras[c]
end

# Lo que quedó pintado encima del texto en el último dibujo (las y desde la esquina de la zona; -1 si nada): lo que
# hay que volver a pintar para quitarlo
var ed_pintado_y1: Int = -1
var ed_pintado_y2: Int = -1

func _dibujar_capas(d: Documento, x: Int, y: Int)
    ed_capas_rango()
    ed_pintado_y1 = ed_capas_y1
    ed_pintado_y2 = ed_capas_y2
    if ed_valor_alto > 0
        vx = x + ed_valor_x
        vy = y + ed_valor_y
        gfx_pen(tema.fondo_panel)
        gfx_rect(vx, vy, vx + ed_valor_ancho - 1, vy + ed_valor_alto - 1)
        gfx_pen(tema.acento)
        gfx_box(vx, vy, vx + ed_valor_ancho - 1, vy + ed_valor_alto - 1)
        gfx_pen(tema.texto)
        t = ed_valor_texto
        cabe = (ed_valor_ancho - 8) / ancho_letra
        if t.length > cabe
            t = t[0:cabe - 3] + "..."
        end
        gfx_text_at(vx + 4, vy + 2 + base_letra, t)
    end
    if ed_ayuda_alto > 0
        ax = x + ed_ayuda_x
        ay = y + ed_ayuda_y
        gfx_pen(tema.fondo_panel)
        gfx_rect(ax, ay, ax + ed_ayuda_ancho - 1, ay + ed_ayuda_alto - 1)
        gfx_pen(tema.acento)
        gfx_box(ax, ay, ax + ed_ayuda_ancho - 1, ay + ed_ayuda_alto - 1)
        base = ay + 3 + base_letra
        tx = ax + 4
        limite = ax + ed_ayuda_ancho - 4
        gfx_pen(tema.texto)
        gfx_text_at(tx, base, ay_cabeza)
        tx = tx + ay_cabeza.length * ancho_letra
        i = 0
        for p in ay_params
            if i > 0
                gfx_pen(tema.tenue)
                gfx_text_at(tx, base, ", ")
                tx = tx + 2 * ancho_letra
            end
            if i == ay_arg
                gfx_pen(tema.sintaxis[S_LLAMADA])
            else
                gfx_pen(tema.texto)
            end
            if tx + p.length * ancho_letra <= limite
                gfx_text_at(tx, base, p)
            end
            tx = tx + p.length * ancho_letra
            i = i + 1
        end
        gfx_pen(tema.tenue)
        if tx + ay_cola.length * ancho_letra <= limite
            gfx_text_at(tx, base, ay_cola)
        end
        for l in _ayuda_lineas
            base = base + ed_alto_fila
            gfx_text_at(ax + 4, base, l)
        end
    end
    if ed_lista_alto > 0
        lx = x + ed_lista_x
        ly = y + ed_lista_y
        gfx_pen(tema.fondo_panel)
        gfx_rect(lx, ly, lx + ed_lista_ancho - 1, ly + ed_lista_alto - 1)
        gfx_pen(tema.acento)
        gfx_box(lx, ly, lx + ed_lista_ancho - 1, ly + ed_lista_alto - 1)
        cols = (ed_lista_ancho - 8) / ancho_letra
        fy = ly + 2
        i = ac_primera
        while i < ac_nombres.length and i < ac_primera + ed_lista_filas
            if i == ac_sel
                gfx_pen(tema.seleccion)
                gfx_rect(lx + 2, fy, lx + ed_lista_ancho - 3, fy + ed_alto_fila - 1)
            end
            c = ac_clase(i)
            gfx_pen(ed_color_clase(c))
            gfx_text_at(lx + 4, fy + 1 + base_letra, ed_letra_clase(c))
            gfx_pen(tema.texto)
            n = ac_nombres[i]
            if n.length > cols - 2
                n = n[0:cols - 2]
            end
            gfx_text_at(lx + 4 + 2 * ancho_letra, fy + 1 + base_letra, n)
            fy = fy + ed_alto_fila
            i = i + 1
        end
        # la barra, si hay más de las que caben
        if ac_nombres.length > ed_lista_filas
            alto_barra = ed_lista_filas * ed_alto_fila
            b1 = ly + 2 + alto_barra * ac_primera / ac_nombres.length
            b2 = ly + 2 + alto_barra * (ac_primera + ed_lista_filas) / ac_nombres.length
            gfx_pen(tema.tenue)
            gfx_rect(lx + ed_lista_ancho - 4, b1, lx + ed_lista_ancho - 3, b2 - 1)
        end
        # la firma de la elegida
        gfx_pen(tema.borde)
        gfx_line(lx + 2, fy + 1, lx + ed_lista_ancho - 3, fy + 1)
        f = ac_firma(ac_sel)
        if f.length > cols
            f = f[0:cols - 3] + "..."
        end
        gfx_pen(tema.tenue)
        gfx_text_at(lx + 4, fy + 3 + base_letra, f)
    end
end
