# Buscar y cambiar en todo el proyecto (paso 2.3 de docs/FORJA_LOOP.md): en los .dash y .dashui del cajón del
# proyecto y de sus cajones (hasta BP_HONDO de hondo, sin .git), con el texto del editor en los ficheros abiertos
# (guardado o no) y el del disco en los demás. Con ed_regex, t es una expresión regular.
#
#   bp_buscar(cajon, t, mayus, max)          # lo encontrado: bp_rutas, bp_lineas, bp_cols (desde 1), bp_textos
#   bp_cambios(cajon, t, nuevo, mayus)       # lo que cambiaría: por fichero, sus líneas antes y después (bp_c_*)
#   bp_aplicar(t, nuevo, mayus)              # lo cambia: en el editor (con deshacer) o en el disco

import "editor.dash"

const BP_HONDO = 4         # los cajones de dentro que se miran como mucho
const BP_MAX = 500         # lo que se enseña como mucho

var bp_rutas: [String] = []
var bp_lineas: [Int] = []
var bp_cols: [Int] = []
var bp_textos: [String] = []
var bp_ficheros: Int = 0     # en cuántos ficheros está
var bp_mirados: Int = 0      # cuántos se miraron
var bp_veces: Int = 0        # cuántas veces está (también las que pasan de max)
var bp_ms: Int = 0

# Lo que cambiaría bp_cambios: un fichero por elemento de bp_c_rutas; sus líneas (desde 1) con cambios, en
# bp_c_lineas, y el texto de antes y de después, en bp_c_antes y bp_c_despues, juntos por fichero con "\n"
var bp_c_rutas: [String] = []
var bp_c_lineas: [String] = []     # "3 7 12": las líneas de ese fichero
var bp_c_antes: [String] = []
var bp_c_despues: [String] = []
var bp_c_veces: Int = 0

func _bp_unir(cajon: String, nombre: String) -> String
    if cajon == "" or str_ends(cajon, ":") or str_ends(cajon, "/")
        return cajon + nombre
    end
    return cajon + "/" + nombre
end

func _bp_es_codigo(nombre: String) -> Bool
    n = str_lower(nombre)
    return str_ends(n, ".dash") or str_ends(n, ".dashui")
end

var _bp_todos: Bool = false

# Los ficheros de código del cajón y de sus cajones, con su ruta entera
func bp_ficheros_de(cajon: String) -> [String]
    var r: [String] = []
    _bp_todos = false
    _bp_cajon(cajon, 0, r)
    return r
end

# Todos los ficheros (menos los iconos .info), para abrir uno por su nombre
func bp_todos_de(cajon: String) -> [String]
    var r: [String] = []
    _bp_todos = true
    _bp_cajon(cajon, 0, r)
    _bp_todos = false
    return r
end

func _bp_cajon(cajon: String, hondo: Int, r: [String])
    var cajones: [String] = []
    n = dir_read(cajon)
    i = 0
    while i < n
        nombre = dir_entry_name(i)
        if dir_entry_is_dir(i)
            if nombre != ".git" and hondo < BP_HONDO
                cajones.push(nombre)
            end
        elif _bp_es_codigo(nombre) or (_bp_todos and not str_ends(str_lower(nombre), ".info"))
            r.push(_bp_unir(cajon, nombre))
        end
        i = i + 1
    end
    # (dir_read es uno solo para todos: los cajones de dentro, después)
    for c in cajones
        _bp_cajon(_bp_unir(cajon, c), hondo + 1, r)
    end
end

# El documento abierto de una ruta (-1 si no está): "*nombre" es una pestaña sin nombre (como las llama codigo.dash)
func bp_doc(ruta: String) -> Int
    if str_starts(ruta, "*")
        i = 0
        for d in documentos
            if d.ruta == "" and d.vista == 0 and d.nombre == ruta[1:]
                return i
            end
            i = i + 1
        end
        return -1
    end
    return ed_buscar_ruta(ruta)
end

# Las líneas de un fichero: las del editor si está abierto, si no las del disco (en Latin-1, como el editor)
func bp_lineas_de(ruta: String) -> [String]
    k = bp_doc(ruta)
    if k >= 0
        return documentos[k].lineas
    end
    t = file_read_text(ruta)
    if t == nil
        var nada: [String] = []
        return nada
    end
    if es_utf8(t)
        t = utf8_to_latin1(t)
    end
    return str_split(str_replace(str_replace(t, "\r\n", "\n"), "\t", "    "), "\n")
end

# Busca t en el proyecto (lo que hay, hasta max)
func bp_buscar(cajon: String, t: String, mayus: Bool, max: Int) -> Int
    t0 = time_ms()
    bp_rutas.clear()
    bp_lineas.clear()
    bp_cols.clear()
    bp_textos.clear()
    bp_ficheros = 0
    bp_mirados = 0
    bp_veces = 0
    for ruta in bp_ficheros_de(cajon)
        lineas = bp_lineas_de(ruta)
        bp_mirados = bp_mirados + 1
        esta = false
        l = 0
        while l < lineas.length
            s = lineas[l]
            p = ed_buscar_en(s, t, 0, mayus)
            while p >= 0
                if not esta
                    esta = true
                    bp_ficheros = bp_ficheros + 1
                end
                bp_veces = bp_veces + 1
                if bp_rutas.length < max
                    bp_rutas.push(ruta)
                    bp_lineas.push(l + 1)
                    bp_cols.push(p + 1)
                    bp_textos.push(s)
                end
                siguiente = p + ed_hallado
                if ed_hallado == 0
                    siguiente = p + 1
                end
                if siguiente > s.length
                    p = -1
                else
                    p = ed_buscar_en(s, t, siguiente, mayus)
                end
            end
            l = l + 1
        end
    end
    bp_ms = time_ms() - t0
    return bp_rutas.length
end

# Lo que cambiaría cambiar t por nuevo en todo el proyecto (bp_c_*); cuántas veces
func bp_cambios(cajon: String, t: String, nuevo: String, mayus: Bool) -> Int
    t0 = time_ms()
    bp_c_rutas.clear()
    bp_c_lineas.clear()
    bp_c_antes.clear()
    bp_c_despues.clear()
    bp_c_veces = 0
    bp_mirados = 0
    for ruta in bp_ficheros_de(cajon)
        lineas = bp_lineas_de(ruta)
        bp_mirados = bp_mirados + 1
        nums = ""
        antes = ""
        despues = ""
        l = 0
        while l < lineas.length
            s = lineas[l]
            nueva = ed_cambiar_en(s, t, nuevo, mayus)
            if ed_veces > 0
                bp_c_veces = bp_c_veces + ed_veces
                if nums != ""
                    nums = nums + " "
                    antes = antes + "\n"
                    despues = despues + "\n"
                end
                nums = nums + "#{l + 1}"
                antes = antes + s
                despues = despues + nueva
            end
            l = l + 1
        end
        if nums != ""
            bp_c_rutas.push(ruta)
            bp_c_lineas.push(nums)
            bp_c_antes.push(antes)
            bp_c_despues.push(despues)
        end
    end
    bp_ms = time_ms() - t0
    return bp_c_veces
end

# Una línea del disco con tabuladores (raw), que se leyó con cada tabulador como 4 espacios (exp) y se cambió (nueva):
# lo cambiado, en raw, sin tocar sus tabuladores fuera de lo cambiado. Si exp no es raw así, nueva tal cual.
func bp_con_tabs(raw: String, exp: String, nueva: String) -> String
    if str_replace(raw, "\t", "    ") != exp
        return nueva
    end
    # lo igual al principio y al final
    p = 0
    while p < exp.length and p < nueva.length and exp[p:p + 1] == nueva[p:p + 1]
        p = p + 1
    end
    q = 0
    while q < exp.length - p and q < nueva.length - p and exp[exp.length - 1 - q:exp.length - q] == nueva[nueva.length - 1 - q:nueva.length - q]
        q = q + 1
    end
    e = exp.length - q
    # de exp a raw: un tabulador ocupa 4; lo cambiado no puede empezar ni acabar a medio tabulador
    rp = -1
    re = -1
    acum = 0
    i = 0
    while i <= raw.length
        w = 1
        if i < raw.length and raw[i:i + 1] == "\t"
            w = 4
        end
        if rp < 0 and (acum == p or (acum < p and p < acum + w))
            rp = i
            p = acum
        end
        if re < 0 and (acum == e or (acum < e and e < acum + w))
            re = i
            if acum < e
                re = i + 1
                e = acum + w
            end
        end
        acum = acum + w
        i = i + 1
    end
    if rp < 0 or re < 0 or p > nueva.length - (exp.length - e)
        return nueva
    end
    return raw[0:rp] + nueva[p:nueva.length - (exp.length - e)] + raw[re:]
end

# Hace los cambios de bp_cambios: en los ficheros abiertos, en el editor (cada línea cambiada, todo en un paso de
# deshacer por fichero; quedan sin guardar); en los demás, en el disco (en UTF-8 si lo estaban). Cuántos ficheros
# cambió; los que no pudo escribir, en bp_no_escritos
var bp_no_escritos: [String] = []

# ¿Siguen las líneas de bp_c_* como estaban? (entre la lista de cambios y el sí se puede escribir o guardar)
func bp_al_dia() -> Bool
    i = 0
    while i < bp_c_rutas.length
        ls = bp_lineas_de(bp_c_rutas[i])
        nums = str_split(bp_c_lineas[i], " ")
        antes = str_split(bp_c_antes[i], "\n")
        j = 0
        while j < nums.length
            n = Int(nums[j])
            if n < 1 or n > ls.length or j >= antes.length or ls[n - 1] != antes[j]
                return false
            end
            j = j + 1
        end
        i = i + 1
    end
    return true
end

func bp_aplicar() -> Int
    bp_no_escritos.clear()
    hechos = 0
    i = 0
    while i < bp_c_rutas.length
        ruta = bp_c_rutas[i]
        nums = str_split(bp_c_lineas[i], " ")
        nuevas = str_split(bp_c_despues[i], "\n")
        k = bp_doc(ruta)
        if k >= 0
            d = documentos[k]
            # (de abajo arriba no cambia nada; cada línea es un cambio, y van todos juntos al deshacer)
            antes = d.deshacer.length
            j = nums.length - 1
            while j >= 0
                n = Int(nums[j])
                if n >= 1 and n <= d.lineas.length
                    ed_cambiar_lineas(d, n, n, nuevas[j])
                end
                j = j - 1
            end
            m = antes + 1
            while m < d.deshacer.length
                d.deshacer[m].junto = true
                m = m + 1
            end
            d.al = -1
            hechos = hechos + 1
        else
            t = file_read_text(ruta)
            if t != nil
                utf8 = es_utf8(t)
                if utf8
                    t = utf8_to_latin1(t)
                end
                crlf = str_contains(t, "\r\n")
                lineas = str_split(str_replace(t, "\r\n", "\n"), "\n")
                viejas = str_split(bp_c_antes[i], "\n")
                j = 0
                while j < nums.length
                    n = Int(nums[j])
                    if n >= 1 and n <= lineas.length
                        if str_contains(lineas[n - 1], "\t") and j < viejas.length
                            # (las líneas se leyeron con los tabuladores como 4 espacios: el cambio, en la línea con
                            # sus tabuladores; antes se quedaba con espacios)
                            lineas[n - 1] = bp_con_tabs(lineas[n - 1], viejas[j], nuevas[j])
                        else
                            lineas[n - 1] = nuevas[j]
                        end
                    end
                    j = j + 1
                end
                r = ""
                j = 0
                for l in lineas
                    if j > 0
                        r = r + "\n"
                    end
                    r = r + l
                    j = j + 1
                end
                if crlf
                    r = str_replace(r, "\n", "\r\n")
                end
                if utf8
                    r = latin1_to_utf8(r)
                end
                if file_write_text(ruta, r)
                    hechos = hechos + 1
                else
                    bp_no_escritos.push(ruta)
                end
            else
                bp_no_escritos.push(ruta)
            end
        end
        i = i + 1
    end
    return hechos
end
