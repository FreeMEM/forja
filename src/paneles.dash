# El panel del proyecto (los ficheros del cajón) y el de la salida (lo que dice dashc).

import "tema.dash"

const TITULO_ALTO = 18

var proyecto_cajon: String = ""
var proyecto_ficheros: [String] = []    # los cajones acaban en "/"; "/" solo es el de arriba
var proyecto_fila: Int = 14
var proyecto_y0: Int = 0                # la y de la primera fila, desde la esquina de la zona
var proyecto_zona_x: Int = 0
var proyecto_zona_y: Int = 0
var proyecto_desde: Int = 0             # la primera entrada que se ve (la barra y la rueda la mueven)
var proyecto_caben: Int = 1             # las que caben a la vez
# Al depurar, el panel del proyecto enseña la pila y las variables (estas líneas)
var depuracion_lineas: [String] = []
var depuracion_tipos: [Int] = []      # 0 título, 1 normal, 2 la de ahora
var salida_lineas: [String] = []
var salida_tipos: [Int] = []      # 0 normal, 1 error, 2 bien
var salida_rutas: [String] = []   # el fichero de un error ("" si no es un error con sitio)
var salida_num: [Int] = []        # su línea (desde 1) y su columna
var salida_col: [Int] = []
var salida_desde: Int = 0         # la primera línea que se ve
var salida_y0: Int = 0            # la y de la primera fila, desde la esquina de la zona
var salida_fila: Int = 10
var salida_zona_x: Int = 0
var salida_zona_y: Int = 0
var salida_atras: Int = 0         # cuántas líneas se ha subido desde el final (0: se ve lo último)
var salida_caben: Int = 1         # las líneas que caben a la vez
var salida_sel_a: Int = -1        # las líneas elegidas (arrastrando en la salida), de a a b; -1 sin elegir
var salida_sel_b: Int = -1

func ruta_unir(cajon: String, nombre: String) -> String
    if cajon == "" or str_ends(cajon, ":") or str_ends(cajon, "/")
        return cajon + nombre
    end
    return cajon + "/" + nombre
end

# El cajón de una ruta ("Work:juego/main.dash" -> "Work:juego")
func cajon_de(ruta: String) -> String
    i = ruta.length - 1
    while i >= 0
        c = ruta[i:i + 1]
        if c == "/"
            return ruta[0:i]
        end
        if c == ":"
            return ruta[0:i + 1]
        end
        i = i - 1
    end
    return ""
end

func proyecto_leer(cajon: String)
    proyecto_cajon = cajon
    proyecto_ficheros = []
    proyecto_desde = 0
    if cajon != "" and not str_ends(cajon, ":")
        proyecto_ficheros.push("/")
    end
    # los cajones primero y luego los ficheros, cada uno por orden alfabético (el disco los da en cualquier orden)
    var cajones: [String] = []
    var ficheros: [String] = []
    n = dir_read(cajon)
    i = 0
    while i < n
        nombre = dir_entry_name(i)
        if dir_entry_is_dir(i)
            if nombre != ".git"
                cajones.push(nombre + "/")
            end
        elif str_ends(str_lower(nombre), ".dash") or str_ends(str_lower(nombre), ".dashui") or sp_extension(nombre)
            ficheros.push(nombre)
        end
        i = i + 1
    end
    cajones.sort(_proyecto_antes)
    ficheros.sort(_proyecto_antes)
    for c in cajones
        proyecto_ficheros.push(c)
    end
    for f in ficheros
        proyecto_ficheros.push(f)
    end
end

func _proyecto_antes(a: String, b: String) -> Int
    return str_compare_locale(a, b, true)
end

func salida_anadir(texto: String, tipo: Int)
    for l in str_split(texto, "\n")
        if salida_atras > 0
            salida_atras = salida_atras + 1     # quien ha subido a mirar algo lo sigue viendo
        end
        salida_lineas.push(l)
        salida_tipos.push(tipo)
        salida_rutas.push("")
        salida_num.push(0)
        salida_col.push(0)
    end
end

# Una línea con un sitio (dónde se usa un nombre): un clic lleva a ruta, línea num, columna col
func salida_anadir_sitio(texto: String, ruta: String, num: Int, col: Int)
    if salida_atras > 0
        salida_atras = salida_atras + 1
    end
    salida_lineas.push(texto)
    salida_tipos.push(0)
    salida_rutas.push(ruta)
    salida_num.push(num)
    salida_col.push(col)
end

# Una línea de dashc: "fichero:línea:columna: Error: texto" (el fichero puede llevar ":", como DH0:x.dash).
# Si lo es, va como error con su sitio y devuelve true.
func salida_error_dashc(l: String) -> Bool
    p = str_find(l, ": Error: ")
    if p < 0
        return false
    end
    sitio = str_split(l[0:p], ":")
    if sitio.length < 3
        return false
    end
    if salida_atras > 0
        salida_atras = salida_atras + 1
    end
    col = Int(sitio[sitio.length - 1])
    num = Int(sitio[sitio.length - 2])
    ruta = l[0:p - sitio[sitio.length - 1].length - sitio[sitio.length - 2].length - 2]
    salida_lineas.push(l)
    salida_tipos.push(1)
    salida_rutas.push(ruta)
    salida_num.push(num)
    salida_col.push(col)
    return true
end

# Una línea de un programa que falla al ejecutarse: "Error: texto (en fichero:línea)" (el fichero, como lo dio
# dashc: entero, o desde el cajón del programa). Si lo es, va como error con su sitio y devuelve true: un clic lleva
# a la línea, como en los errores de compilar.
func salida_error_programa(l: String, cajon: String) -> Bool
    t = str_trim(l)
    if not str_starts(t, "Error: ") or not str_ends(t, ")")
        return false
    end
    p = str_find(t, " (en ")
    if p < 0
        return false
    end
    sitio = t[p + 5:t.length - 1]
    i = sitio.length - 1
    while i >= 0 and str_code(sitio, i) != 58
        i = i - 1
    end
    if i <= 0
        return false
    end
    num = Int(sitio[i + 1:])
    ruta = sitio[0:i]
    if num <= 0
        return false
    end
    if str_find(ruta, ":") < 0
        ruta = ruta_unir(cajon, ruta)
    end
    if salida_atras > 0
        salida_atras = salida_atras + 1
    end
    salida_lineas.push(t)
    salida_tipos.push(1)
    salida_rutas.push(ruta)
    salida_num.push(num)
    salida_col.push(1)
    return true
end

# La salida de un programa: cada línea, y las de un error de ejecución con su sitio. "exe failed returncode N" del
# Shell no va: Forja ya dice con qué código acabó (y en 640x256, con dos líneas de salida, tapaba el error). Da la
# línea del primer error, o -1.
func salida_anadir_programa(texto: String, cajon: String, exe: String) -> Int
    primero = -1
    for l in str_split(texto, "\n")
        if str_starts(l, exe + " failed returncode ")
            continue
        end
        if salida_error_programa(l, cajon)
            if primero < 0
                primero = salida_lineas.length - 1
            end
        else
            salida_anadir(l, 0)
        end
    end
    return primero
end

# Que se vea la línea i de la salida (subiendo lo justo, si hace falta)
func salida_mostrar(i: Int)
    if i < 0
        return
    end
    desde = salida_lineas.length - salida_caben - salida_atras
    if i < desde
        salida_atras = salida_atras_valido(salida_lineas.length - salida_caben - i)
    end
end

# La línea de la salida en la y de la zona; -1 si no hay
func salida_en(y: Int) -> Int
    if y < salida_y0
        return -1
    end
    i = salida_desde + (y - salida_y0) / salida_fila
    if i >= salida_lineas.length
        return -1
    end
    return i
end

# La primera línea que se ve si se sube "atras" líneas desde el final (sin pasarse por ningún lado)
func salida_atras_valido(atras: Int) -> Int
    maximo = salida_lineas.length - salida_caben
    if maximo < 0
        maximo = 0
    end
    if atras > maximo
        return maximo
    end
    if atras < 0
        return 0
    end
    return atras
end

# La salida, desde la línea "desde" (la barra): cuánto queda por debajo
func salida_ir_a(desde: Int)
    salida_atras = salida_atras_valido(salida_lineas.length - salida_caben - desde)
end

# El texto de las líneas elegidas, o de toda la salida si no hay nada elegido
func salida_texto(solo_elegidas: Bool) -> String
    a = 0
    b = salida_lineas.length - 1
    if solo_elegidas and salida_sel_a >= 0
        a = salida_sel_a
        b = salida_sel_b
        if b < a
            a = salida_sel_b
            b = salida_sel_a
        end
    end
    t = ""
    i = a
    while i <= b and i < salida_lineas.length
        t = t + salida_lineas[i] + "\n"
        i = i + 1
    end
    return t
end

func salida_hay_seleccion() -> Bool
    return salida_sel_a >= 0
end

# La entrada del proyecto que se ve primero, sin pasarse
func proyecto_desde_valido(desde: Int) -> Int
    maximo = proyecto_ficheros.length - proyecto_caben
    if maximo < 0
        maximo = 0
    end
    if desde > maximo
        return maximo
    end
    if desde < 0
        return 0
    end
    return desde
end

func _titulo(x: Int, y: Int, ancho: Int, texto: String)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + TITULO_ALTO - 1)
    usar_panel(2)
    gfx_pen(tema.tenue)
    gfx_text_at(x + 8, y + (TITULO_ALTO - font_height()) / 2 + font_baseline(), texto)
    font_style(0)
end

func proyecto_dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    tema_preparar()
    gfx_mode(0)
    gfx_pen(tema.fondo_panel)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    if depuracion_lineas.length > 0
        _depuracion_dibujar(x, y, ancho, alto)
        return
    end
    nombre = proyecto_cajon
    if nombre == ""
        nombre = tr(60, "Proyecto")
    end
    _titulo(x, y, ancho, str_upper(nombre))
    usar_panel(0)
    fila = font_height() + 3
    proyecto_fila = fila
    proyecto_y0 = TITULO_ALTO + 4
    proyecto_zona_x = x
    proyecto_zona_y = y
    proyecto_caben = (alto - TITULO_ALTO - 4) / fila
    if proyecto_caben < 1
        proyecto_caben = 1
    end
    proyecto_desde = proyecto_desde_valido(proyecto_desde)
    fy = y + TITULO_ALTO + 4
    k = proyecto_desde
    while k < proyecto_ficheros.length
        f = proyecto_ficheros[k]
        k = k + 1
        if fy + fila > y + alto
            break
        end
        gfx_pen(tema.texto)
        if str_ends(f, "/")
            gfx_pen(tema.acento)
        end
        nombre = f
        if f == "/"
            nombre = tr(61, "/ (arriba)")
        end
        gfx_text_at(x + 12, fy + font_baseline(), nombre)
        fy = fy + fila
    end
end

func _depuracion_dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    fy = y + 2
    i = 0
    while i < depuracion_lineas.length
        if depuracion_tipos[i] == 0
            _titulo(x, fy, ancho, depuracion_lineas[i])
            fy = fy + TITULO_ALTO + 2
        else
            usar_codigo()
            if fy + alto_letra + 2 > y + alto
                return
            end
            gfx_pen(tema.texto)
            if depuracion_tipos[i] == 2
                gfx_pen(tema.cursor)
            end
            gfx_text_at(x + 8, fy + base_letra, depuracion_lineas[i])
            fy = fy + alto_letra + 2
        end
        i = i + 1
    end
end

# La entrada del proyecto en la y de la zona; -1 si no hay
func proyecto_en(y: Int) -> Int
    if y < proyecto_y0
        return -1
    end
    i = proyecto_desde + (y - proyecto_y0) / proyecto_fila
    if i >= proyecto_ficheros.length
        return -1
    end
    return i
end

func salida_dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    tema_preparar()
    gfx_mode(0)
    gfx_pen(tema.fondo_salida)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    _titulo(x, y, ancho, tr(62, "SALIDA"))
    usar_codigo()
    fila = alto_letra + 2
    cabe = (alto - TITULO_ALTO - 4) / fila
    if cabe < 1
        cabe = 1
    end
    salida_caben = cabe
    salida_atras = salida_atras_valido(salida_atras)
    desde = salida_lineas.length - cabe - salida_atras
    if desde < 0
        desde = 0
    end
    salida_desde = desde
    salida_fila = fila
    salida_y0 = TITULO_ALTO + 3
    salida_zona_x = x
    salida_zona_y = y
    fy = y + TITULO_ALTO + 3
    sa = salida_sel_a
    sb = salida_sel_b
    if sb < sa
        sa = salida_sel_b
        sb = salida_sel_a
    end
    i = desde
    while i < salida_lineas.length and i < desde + cabe
        if sa >= 0 and i >= sa and i <= sb
            gfx_pen(tema.seleccion)
            gfx_rect(x, fy, x + ancho - 1, fy + fila - 1)
        end
        gfx_pen(tema.texto)
        if salida_tipos[i] == 1
            gfx_pen(tema.error)
        elif salida_tipos[i] == 2
            gfx_pen(tema.bien)
        end
        gfx_text_at(x + 8, fy + base_letra, salida_lineas[i])
        fy = fy + fila
        i = i + 1
    end
end
