# Git en Forja: el estado del repositorio del proyecto (rama, ficheros cambiados, marcas del panel y del margen)
# con dashgit. dashgit va siempre como un proceso aparte (run_start): es GPLv2 y Forja es MIT, así que Forja no
# importa sus módulos; solo lee lo que escribe con sus salidas para máquinas (status --porcelain -b, diff --rangos).
#
#   git_programa = "DH0:C/dashgit"         # lo pone main.dash (ENV:Forja/dashgit, DASH:dashgit...)
#   git_mirar_cajon(proyecto_cajon)        # si cambió el cajón del proyecto: busca su repositorio y pide el estado
#   git_pedir_estado()                     # al guardar, al volver a Forja, tras una orden de git
#   git_orden("add -- \"x\"", 0, "")       # una orden en segundo plano, en cola (tras ella, el estado otra vez)
#   r = git_mirar()                        # en cada tic: G_NADA, G_ESTADO (cambió el estado), G_DIFF, G_RANGOS
#   git_letra("main.dash", false)          # la marca de un fichero del cajón del proyecto: M, A, D, U, ? o ""

const G_NADA = 0
const G_ESTADO = 1      # llegó el estado (git_rama, git_cambios, las marcas)
const G_DIFF = 2        # llegó un diff pedido con git_orden(..., G_DIFF, dato): git_texto, git_dato
const G_RANGOS = 3      # llegaron los rangos de un fichero (diff --rangos): git_texto, git_dato
const G_ERROR = 4       # una orden acabó mal: git_texto (lo que escribió) y git_dato (la orden)

const G_ESPERA = 120000     # dos minutos como mucho para una orden de estas

var git_programa: String = "dashgit"
var git_raiz: String = ""          # el cajón con .git ("" si el proyecto no está en un repositorio)
var git_cajon: String = ""         # el cajón del proyecto de la última vez (para ver si cambió)
var git_rama: String = ""          # la rama ("" sin estado aún); "(suelto)" con HEAD suelto
var git_cambios: Int = 0           # los ficheros con cambios (también los que no se siguen)
var git_leido: Bool = false        # hay estado leído de este repositorio
var git_lineas: [String] = []      # las líneas de status --porcelain (sin la de la rama): "XY ruta"
var _xy: {String: String} = {}     # ruta desde la raíz (en minúsculas) -> sus dos letras
var _cajones: {String: String} = {}  # cajón desde la raíz (en minúsculas) -> la letra que se enseña

# lo que llegó con git_mirar
var git_texto: String = ""
var git_dato: String = ""

# la cola: una orden a la vez
var _run: Int = 0
var _run_tipo: Int = 0
var _run_dato: String = ""
var _run_orden: String = ""
var _cola: [String] = []
var _cola_tipo: [Int] = []
var _cola_dato: [String] = []
var _estado_pendiente: Bool = false
var git_ms_estado: Int = 0         # lo que tardó el último status (para la sonda y la bitácora)
var git_ms_rangos: Int = 0
var _inicio: Int = 0

# las marcas del margen (ver más abajo)
var _rangos: {String: String} = {}   # ruta del Amiga (en minúsculas) -> lo que dio diff --rangos
var _marcas_de: String = "?"         # de qué ruta es _marcas (la última que se pintó)
var _marcas: [Int] = []
var _forzar: {String: Int} = {}       # ficheros guardados: sus rangos se piden otra vez tras el estado
var _pedido_xy: {String: String} = {} # las letras que tenía cada uno cuando se pidieron sus rangos

func _unir(cajon: String, nombre: String) -> String
    if cajon == "" or str_ends(cajon, ":") or str_ends(cajon, "/")
        return cajon + nombre
    end
    return cajon + "/" + nombre
end

func _padre(ruta: String) -> String
    i = ruta.length - 1
    while i >= 0
        c = ruta[i:i + 1]
        if c == "/"
            return ruta[0:i]
        end
        if c == ":"
            if i == ruta.length - 1
                return ""
            end
            return ruta[0:i + 1]
        end
        i = i - 1
    end
    return ""
end

# El cajón con .git que contiene a cajon (él o uno de arriba); "" si no hay
func git_buscar_raiz(cajon: String) -> String
    c = cajon
    dos_requesters(false)
    vueltas = 0
    while c != "" and vueltas < 30
        if file_exists(_unir(c, ".git/HEAD"))
            dos_requesters(true)
            return c
        end
        c = _padre(c)
        vueltas = vueltas + 1
    end
    dos_requesters(true)
    return ""
end

# Una ruta del Amiga (o de un cajón del proyecto) a una ruta desde la raíz del repositorio, con "/"; "?" si fuera
func git_relativa(ruta: String) -> String
    if git_raiz == ""
        return "?"
    end
    if str_lower(ruta) == str_lower(git_raiz)
        return ""
    end
    pre = git_raiz
    if not str_ends(pre, ":") and not str_ends(pre, "/")
        pre = pre + "/"
    end
    if str_starts(str_lower(ruta), str_lower(pre))
        return ruta[pre.length:]
    end
    return "?"
end

# Si el cajón del proyecto cambió: busca su repositorio y, si es otro, olvida lo de antes y pide el estado
func git_mirar_cajon(cajon: String) -> Bool
    if cajon == git_cajon
        return false
    end
    git_cajon = cajon
    raiz = git_buscar_raiz(cajon)
    if raiz == git_raiz
        return false
    end
    git_raiz = raiz
    git_leido = false
    git_rama = ""
    git_cambios = 0
    git_lineas = []
    _xy = {}
    _cajones = {}
    _pedido_xy = {}
    _rangos = {}
    _marcas_de = "?"
    if raiz != ""
        git_pedir_estado()
    end
    return true
end

func git_comillas(t: String) -> String
    return "\"" + str_replace(str_replace(t, "*", "**"), "\"", "*\"") + "\""
end

func _empezar(orden: String, tipo: Int, dato: String) -> Bool
    _run = run_start(git_programa + " -C " + git_comillas(git_raiz) + " " + orden, G_ESPERA)
    if _run == 0
        return false
    end
    _run_tipo = tipo
    _run_dato = dato
    _run_orden = orden
    _inicio = time_ms()
    return true
end

# Pide el estado (status --porcelain -b) en segundo plano; si hay una orden en marcha, al acabar la cola
func git_pedir_estado()
    if git_raiz == ""
        return
    end
    if _run != 0 or _cola.length > 0
        _estado_pendiente = true
        return
    end
    _estado_pendiente = false
    _empezar("status --porcelain -b", G_ESTADO, "")
end

# Una orden de dashgit en segundo plano (en cola). tipo: G_NADA (al acabar, el estado otra vez), G_DIFF o G_RANGOS
# (git_mirar da su salida, con dato)
func git_orden(orden: String, tipo: Int, dato: String)
    if git_raiz == ""
        return
    end
    if _run != 0
        _cola.push(orden)
        _cola_tipo.push(tipo)
        _cola_dato.push(dato)
        return
    end
    _empezar(orden, tipo, dato)
end

# Si hay algo en marcha (para que el tic siga mirando)
func git_ocupado() -> Bool
    return _run != 0
end

func _siguiente()
    while _cola.length > 0
        orden = _cola[0]
        tipo = _cola_tipo[0]
        dato = _cola_dato[0]
        _cola.remove(0)
        _cola_tipo.remove(0)
        _cola_dato.remove(0)
        if _empezar(orden, tipo, dato)
            return
        end
    end
    if _estado_pendiente
        git_pedir_estado()
    end
end

# Mira si acabó lo que estaba en marcha: G_NADA si no hay nada nuevo
func git_mirar() -> Int
    if _run == 0 or not run_ready(_run)
        return G_NADA
    end
    texto = run_finish(_run)
    rc = run_rc()
    _run = 0
    tipo = _run_tipo
    git_dato = _run_dato
    git_texto = texto
    ms = time_ms() - _inicio
    if tipo == G_ESTADO
        git_ms_estado = ms
        if rc == 0
            _leer_estado(texto)
        else
            # un disco sin nombres largos, un repositorio roto...: sin marcas
            git_leido = false
            git_rama = ""
        end
        _siguiente()
        return G_ESTADO
    end
    if tipo == G_RANGOS
        git_ms_rangos = ms
    end
    if rc != 0 and tipo != G_RANGOS
        git_dato = _run_orden
        _estado_pendiente = true
        _siguiente()
        return G_ERROR
    end
    if tipo == G_NADA
        _estado_pendiente = true
    end
    _siguiente()
    return tipo
end

# La letra de unas letras de status: U (conflicto), A (nuevo en el índice), D (borrado), M (cambiado), ? (sin seguir)
func git_letra_xy(xy: String) -> String
    if xy == "??"
        return "?"
    end
    if str_contains(xy, "U") or xy == "AA" or xy == "DD"
        return "U"
    end
    if xy[:1] == "A"
        return "A"
    end
    if xy[:1] == "D" or xy[1:2] == "D"
        return "D"
    end
    return "M"
end

# La que gana para un cajón con varias dentro
func _peso(l: String) -> Int
    if l == "U"
        return 5
    elif l == "M"
        return 4
    elif l == "D"
        return 3
    elif l == "A"
        return 2
    elif l == "?"
        return 1
    end
    return 0
end

func _leer_estado(texto: String)
    git_rama = ""
    git_cambios = 0
    git_lineas = []
    _xy = {}
    _cajones = {}
    for l in str_split(texto, "\n")
        if str_starts(l, "## ")
            r = l[3:]
            p = str_find(r, "...")
            if p >= 0
                r = r[:p]
            end
            if str_starts(r, "No commits yet on ")
                r = r[18:]
            elif r == "HEAD (no branch)"
                r = "(suelto)"
            end
            git_rama = r
        elif l.length > 3 and l[2:3] == " "
            xy = l[:2]
            ruta = l[3:]
            git_lineas.push(l)
            git_cambios = git_cambios + 1
            _xy[str_lower(ruta)] = xy
            letra = git_letra_xy(xy)
            # los cajones de encima llevan la marca que más pesa de lo que tienen dentro
            c = ruta
            p = ultima_barra(c)
            while p > 0
                c = c[:p]
                clave = str_lower(c)
                if _peso(letra) > _peso(_cajones.get(clave, ""))
                    _cajones[clave] = letra
                end
                p = ultima_barra(c)
            end
        end
    end
    git_leido = true
end

func ultima_barra(s: String) -> Int
    i = s.length - 1
    while i >= 0
        if str_code(s, i) == 47
            return i
        end
        i = i - 1
    end
    return -1
end

# Las dos letras de status de un fichero (ruta del Amiga); "" si no tiene cambios
func git_xy_de(ruta: String) -> String
    r = git_relativa(ruta)
    if r == "?" or r == ""
        return ""
    end
    return _xy.get(str_lower(r), "")
end

# La marca de una entrada del panel del proyecto (nombre dentro de cajon; los cajones acaban en "/")
func git_letra(cajon: String, nombre: String) -> String
    if not git_leido or nombre == "/"
        return ""
    end
    es_cajon = str_ends(nombre, "/")
    n = nombre
    if es_cajon
        n = nombre[:nombre.length - 1]
    end
    r = git_relativa(_unir(cajon, n))
    if r == "?" or r == ""
        return ""
    end
    if es_cajon
        return _cajones.get(str_lower(r), "")
    end
    xy = _xy.get(str_lower(r), "")
    if xy == ""
        return ""
    end
    return git_letra_xy(xy)
end

# El texto de la barra: "rama" y, si hay, los ficheros cambiados
func git_barra() -> String
    if git_raiz == "" or not git_leido or git_rama == ""
        return ""
    end
    return git_rama
end

# ---- marcas del margen: diff --rangos HEAD de cada fichero abierto ----
# Cada línea (desde 0) lleva unos bits: M_ANADIDA, M_CAMBIADA, M_QUITADA (se quitaron líneas justo antes de esta) y
# M_QUITADA_FIN (se quitaron líneas tras la última). Son del fichero guardado: con cambios sin guardar no se enseñan.

const M_ANADIDA = 1
const M_CAMBIADA = 2
const M_QUITADA = 4
const M_QUITADA_FIN = 8


# Pide los rangos de un fichero si tiene cambios frente a HEAD; si no, le quita las marcas. Devuelve las líneas
# (desde 0) cuya marca cambió al quitarlas (para repintar solo esas)
func git_pedir_rangos(ruta: String) -> [Int]
    var nada: [Int] = []
    r = git_relativa(ruta)
    if r == "?" or r == "" or not git_leido
        return nada
    end
    clave = str_lower(ruta)
    xy = _xy.get(str_lower(r), "")
    forzar = _forzar.get(clave, 0) != 0
    if not forzar and _pedido_xy.get(clave, "-") == xy
        # nada cambió para él desde la última vez
        return nada
    end
    _pedido_xy[clave] = xy
    _forzar[clave] = 0
    if xy == "" or xy == "??" or git_letra_xy(xy) == "U"
        return git_rangos_poner(ruta, "")
    end
    git_orden("diff --rangos HEAD -- " + git_comillas(r), G_RANGOS, ruta)
    return nada
end


# Un fichero se guardó: el estado otra vez y, después, sus rangos
func git_guardado(ruta: String)
    if git_raiz == "" or git_relativa(ruta) == "?"
        return
    end
    _forzar[str_lower(ruta)] = 1
    git_pedir_estado()
end

func _marcas_parsear(texto: String) -> [Int]
    var m: [Int] = []
    for l in str_split(texto, "\n")
        p = str_split(str_trim(l), " ")
        if p.length == 3 and (p[0] == "A" or p[0] == "C" or p[0] == "B")
            n = str_to_int(p[1], 10) - 1
            c = str_to_int(p[2], 10)
            bit = M_ANADIDA
            hasta = n + c
            if p[0] == "C"
                bit = M_CAMBIADA
            elif p[0] == "B"
                bit = M_QUITADA
                hasta = n + 1
            end
            while m.length < hasta
                m.push(0)
            end
            k = n
            while k < hasta
                if k >= 0
                    m[k] = m[k] | bit
                end
                k = k + 1
            end
        end
    end
    return m
end

func _marcas_cargar(ruta: String)
    clave = str_lower(ruta)
    if clave == _marcas_de
        return
    end
    _marcas_de = clave
    _marcas = _marcas_parsear(_rangos.get(clave, ""))
end

# La marca de la línea n (desde 0) de un fichero de total líneas
func git_marca(ruta: String, n: Int, total: Int) -> Int
    if git_raiz == "" or ruta == ""
        return 0
    end
    _marcas_cargar(ruta)
    m = 0
    if n < _marcas.length
        m = _marcas[n]
    end
    # lo quitado tras la última línea va en la última
    if n == total - 1 and _marcas.length > total and (_marcas[total] & M_QUITADA) != 0
        m = m | M_QUITADA_FIN
    end
    return m
end

# Pone los rangos que llegaron de un fichero; las líneas (desde 0) cuya marca cambió
func git_rangos_poner(ruta: String, texto: String) -> [Int]
    clave = str_lower(ruta)
    var antes: [Int] = _marcas_parsear(_rangos.get(clave, ""))
    _rangos[clave] = texto
    _marcas_de = "?"
    var ahora: [Int] = _marcas_parsear(texto)
    var r: [Int] = []
    n = antes.length
    if ahora.length > n
        n = ahora.length
    end
    k = 0
    while k < n
        a = 0
        b = 0
        if k < antes.length
            a = antes[k]
        end
        if k < ahora.length
            b = ahora[k]
        end
        if a != b
            r.push(k)
            # lo quitado tras la última se pinta en la anterior
            if k > 0
                r.push(k - 1)
            end
        end
        k = k + 1
    end
    return r
end

# Para la sonda: las marcas de un fichero, "n:bits" de las líneas que tienen
func git_marcas_texto(ruta: String, total: Int) -> String
    t = ""
    k = 0
    while k < total
        m = git_marca(ruta, k, total)
        if m != 0
            t = t + " #{k + 1}:#{m}"
        end
        k = k + 1
    end
    return str_trim(t)
end
