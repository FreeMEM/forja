func dibujar_proyecto(x: Int, y: Int, ancho: Int, alto: Int)
    proyecto_dibujar(x, y, ancho, alto)
end

func dibujar_editor(x: Int, y: Int, ancho: Int, alto: Int)
    ed_dibujar(x, y, ancho, alto)
end

func dibujar_botones(x: Int, y: Int, ancho: Int, alto: Int)
    bb_dibujar(x, y, ancho, alto)
end

func dibujar_salida(x: Int, y: Int, ancho: Int, alto: Int)
    salida_dibujar(x, y, ancho, alto)
end

func avisar(texto: String, tipo: Int)
    salida_anadir(texto, tipo)
    if abierta
        mui_canvas_redraw(v.salida)
    end
    d = ed_actual()
    if d != nil and d.sprite != nil
        # con un sprite la salida está oculta: el aviso va a su barra de estado
        sp_mensaje = texto
        sp_mensaje_tipo = tipo
        if abierta
            mui_canvas_redraw(v.editor)
        end
    elif d != nil and d.mapa != nil
        mp_mensaje = texto
        mp_mensaje_tipo = tipo
        if abierta
            mui_canvas_redraw(v.editor)
        end
    end
end

# Con un sprite delante, la salida y la barra se ocultan: la rejilla necesita el alto (en 640x256 no hay más)
var _salida_oculta: Bool = false

func ajustar_paneles()
    d = ed_actual()
    for o in documentos
        if o.sprite != nil and o != d
            o.sprite.reproduciendo = false
        end
    end
    ocultar = d != nil and (d.sprite != nil or d.mapa != nil)
    if ocultar != _salida_oculta
        _salida_oculta = ocultar
        # el grupo de la salida entero: con la salida y su barra ocultas dentro, el grupo vacío no deja crecer la
        # ventana a lo ancho y MUI la encoge a su mínimo
        mui_set_visible(v.grupo_salida, not ocultar)
        mui_set_visible(v.balance_salida, not ocultar)
        mui_set_visible(v.barra, not ocultar)
        sp_mensaje = ""
        mp_mensaje = ""
    end
end

func nombre_de(ruta: String) -> String
    nombre = ruta
    for sep in [":", "/"]
        p = str_find(nombre, sep)
        while p >= 0
            nombre = nombre[p + 1:]
            p = str_find(nombre, sep)
        end
    end
    return nombre
end

# Abre un fichero en una pestaña nueva, o va a la suya si ya está abierto. Una imagen IFF ILBM va al editor de
# sprites.
func abrir(ruta: String) -> Bool
    i = ed_buscar_ruta(ruta)
    if i >= 0
        activo = i
        return true
    end
    l = str_lower(ruta)
    if not str_ends(l, ".dash") and not str_ends(l, ".dashui") and mp_es_mapa(ruta)
        m = mp_leer(ruta)
        if m == nil
            avisar(mp_error, 1)
            return false
        end
        ed_abrir_mapa(nombre_de(ruta), ruta, m)
        if mp_error != ""
            avisar(mp_error, 1)
            mp_error = ""
        end
        return true
    end
    if not str_ends(l, ".dash") and not str_ends(l, ".dashui") and sp_es_ilbm(ruta)
        s = sp_leer(ruta)
        if s == nil
            avisar(sp_error, 1)
            return false
        end
        ed_abrir_sprite(nombre_de(ruta), ruta, s)
        return true
    end
    texto = file_read_text(ruta)
    if texto == nil
        avisar(tr(1, "No se puede leer ") + ruta, 1)
        return false
    end
    ed_abrir_texto(nombre_de(ruta), ruta, texto)
    return true
end

func guardar_en(d: Documento, ruta: String) -> Bool
    if d.sprite != nil
        if not sp_escribir(d.sprite, ruta)
            avisar(sp_error, 1)
            return false
        end
    elif d.mapa != nil
        mp_tileset_relativo(d.mapa, mp_cajon_de(ruta))
        if not mp_escribir(d.mapa, ruta)
            avisar(mp_error, 1)
            return false
        end
    elif not file_write_text(ruta, ed_texto_disco(d))
        avisar(tr(2, "No se puede escribir ") + ruta, 1)
        return false
    end
    d.ruta = ruta
    d.nombre = nombre_de(ruta)
    d.cambiado = false
    avisar(tr(3, "Guardado: ") + ruta, 2)
    if cajon_de(ruta) == proyecto_cajon
        proyecto_leer(proyecto_cajon)
        mui_canvas_redraw(v.proyecto)
    end
    return true
end

func guardar_como(d: Documento) -> Bool
    patron = "#?.(dash|dashui)"
    if d.sprite != nil
        patron = SP_PATRON
    elif d.mapa != nil
        patron = "#?.fmap"
    end
    if not file_save_dialog(tr(458, "Guardar ") + d.nombre, patron)
        return false
    end
    return guardar_en(d, file_fullpath())
end

func guardar(d: Documento) -> Bool
    if d.ruta == ""
        return guardar_como(d)
    end
    return guardar_en(d, d.ruta)
end

func cambiados() -> Int
    n = 0
    for d in documentos
        if d.cambiado
            n = n + 1
        end
    end
    return n
end

# Las órdenes del menú Proyecto. Devuelve true si hay que salir.
func proyecto(ev: Int) -> Bool
    d = ed_actual()
    if ev == EV_NUEVO
        ed_abrir_texto("sin nombre.dash", "", NUEVO)
    elif ev == EV_NUEVO_SPRITE
        r = mui_request(v.window, tr(88, "Nuevo sprite"), tr(89, "¿Qué vas a dibujar?\n\nUn sprite de hardware: 16 píxeles de ancho, 3 colores y el transparente.\nUn BOB: del tamaño y los colores que quieras; lo pinta el blitter.") + "\n" + tr(194, "Un mapa de tiles: una rejilla de tiles de un tileset (un BOB con un fotograma por tile)."), tr(195, "_Sprite|_BOB|_Mapa|_Cancelar"))
        if r == 1
            ed_abrir_sprite("sin nombre.iff", "", sp_nuevo(true))
        elif r == 2
            ed_abrir_sprite("sin nombre.iff", "", sp_nuevo(false))
        elif r == 3
            m = mp_nuevo(64, 32, 16)
            if m == nil
                avisar(mp_error, 1)
            else
                ed_abrir_mapa("sin nombre.fmap", "", m)
                ajustar_paneles()
                elegir_tileset(ed_actual())
            end
        end
    elif ev == EV_ABRIR
        if file_open_dialog("Abrir", "#?.(dash|dashui|iff|ilbm|lbm|brush|bob|spr|fmap)")
            ruta = file_fullpath()
            if abrir(ruta) and cajon_de(ruta) != proyecto_cajon
                proyecto_leer(cajon_de(ruta))
                mui_canvas_redraw(v.proyecto)
            end
        end
    elif ev == EV_GUARDAR and d != nil
        guardar(d)
    elif ev == EV_GUARDAR_COMO and d != nil
        guardar_como(d)
    elif ev == EV_CERRAR and d != nil
        if d.cambiado
            r = mui_request(v.window, tr(63, "Cambios sin guardar"), d.nombre + tr(4, " tiene cambios sin guardar."), tr(5, "_Guardar|_Descartar|_Cancelar"))
            if r == 0 or (r == 1 and not guardar(d))
                return false
            end
        end
        ed_cerrar(activo)
    elif ev == EV_SALIR
        n = cambiados()
        if n > 0
            texto = hueco(tr(452, "Hay %1 ficheros con cambios sin guardar."), "#{n}")
            if n == 1
                texto = tr(453, "Hay un fichero con cambios sin guardar.")
            end
            r = mui_request(v.window, tr(63, "Cambios sin guardar"), texto, tr(6, "_Guardar|_Descartar|_Cancelar"))
            if r == 0
                return false
            end
            if r == 1
                for o in documentos
                    if o.cambiado and not guardar(o)
                        return false
                    end
                end
            end
        end
        return parar_al_salir()
    end
    redibujar()
    return false
end

# --- Compilar y ejecutar ---

# El compilador: ENV:Forja/dashc (lo escribe el instalador de Dash), o DASH:dash, o el dash del cajón de encima del de
# Forja (Dash/Forja/Forja: Dash/dash, sin necesitar la asignación DASH:, idea de Tolkien), o la orden dash del camino
# de órdenes
func dashc() -> String
    return programa_de_dash("Forja/dashc", "dash")
end

func dashgit() -> String
    return programa_de_dash("Forja/dashgit", "dashgit")
end

func programa_de_dash(variable: String, orden: String) -> String
    c = env_get(variable)
    if c != ""
        return c
    end
    # sin peticiones: sin la asignación DASH:, el Amiga pediría que se inserte ese volumen y Forja se quedaría
    # esperando detrás (quien llame no debe tenerlas ya quitadas: dos_requesters(true) las vuelve a poner)
    dos_requesters(false)
    c = orden
    if file_exists("DASH:" + orden)
        c = "DASH:" + orden     # el cajón que deja el instalador de Dash
    elif file_exists("PROGDIR:/" + orden)
        r = file_real_path("PROGDIR:/" + orden)   # (la ruta entera: PROGDIR: es de cada proceso)
        if r != ""
            c = r
        end
    end
    dos_requesters(true)
    return c
end

# Una orden de dashgit en el cajón del proyecto, sin esperar; lo que escriba sale en la salida al acabar
func git(orden: String)
    if tarea != NADA
        return
    end
    if proyecto_cajon == ""
        avisar(tr(225, "Abre antes un fichero del proyecto."), 1)
        return
    end
    for o in documentos
        if o.cambiado and o.ruta != ""
            guardar_en(o, o.ruta)
        end
    end
    redibujar()
    avisar("git " + orden, 0)
    tarea_run = run_start(dashgit() + " -C \"" + proyecto_cajon + "\" " + orden, ESPERA_GIT)
    if tarea_run == 0
        avisar(tr(226, "No se puede ejecutar ") + dashgit() + tr(227, ". Pon su ruta en ENV:Forja/dashgit."), 1)
        return
    end
    tarea_inicio = time_ms()
    poner_tarea(GIT)
    armar_tic(TIC_MS, EV_TIC)
end

# Un texto entre comillas para el Shell del Amiga (las comillas de dentro van como *")
func entre_comillas(t: String) -> String
    return "\"" + str_replace(str_replace(t, "*", "**"), "\"", "*\"") + "\""
end

# "main.dash" -> "main", al lado del .dash o en el cajón de las preferencias (ENV:Forja/ejecutables)
func ejecutable_de(ruta: String) -> String
    return en_cajon(cajon_ejecutables(), sin_dash(ruta))
end

func sin_dash(ruta: String) -> String
    if str_ends(str_lower(ruta), ".dash")
        return ruta[0:ruta.length - 5]
    end
    return ruta + ".exe"
end

# El fichero en ese cajón ("": donde está); "RAM:" + "Work:Juego/main" -> "RAM:main"
func en_cajon(cajon: String, ruta: String) -> String
    if cajon == ""
        return ruta
    end
    if str_ends(cajon, ":") or str_ends(cajon, "/")
        return cajon + nombre_de(ruta)
    end
    return cajon + "/" + nombre_de(ruta)
end

# Lo que se ejecuta o depura arranca en el cajón del .dash (el proceso nuevo copia el cajón actual de Forja): así
# encuentra sus ficheros con ruta relativa aunque el ejecutable esté en otro cajón (Ejecutables en:). Devuelve el
# cajón de antes, para volver a él
func al_cajon_del_programa() -> String
    antes = dir_current()
    cajon = cajon_de(tarea_dash)
    if cajon == "" or antes == "" or not dir_change(cajon)
        return ""
    end
    return antes
end

func volver_al_cajon(antes: String)
    if antes != ""
        dir_change(antes)
    end
end

func cajon_ejecutables() -> String
    return str_trim(env_get("Forja/ejecutables"))
end

# El cajón de los ejecutables existe o se crea (sin peticiones: un volumen que no está no deja Forja esperando)
func cajon_listo(cajon: String) -> Bool
    if cajon == ""
        return true
    end
    dos_requesters(false)
    listo = file_exists(cajon) or dir_create(cajon)
    dos_requesters(true)
    return listo
end

func segundos(ms: Int) -> String
    return "#{ms / 1000},#{(ms % 1000) / 100} s"
end

func poner_tarea(t: Int)
    tarea = t
    # la barra de botones (botones.dash): los que no valen ahora, en gris
    cambio = bb_poner(EV_COMPILAR, t == NADA)
    cambio = bb_poner(EV_EJECUTAR, t == NADA or t == EJECUTANDO) or cambio
    cambio = bb_poner(EV_DEPURAR, t == NADA) or cambio
    for ev in [EV_SEGUIR, EV_PASO, EV_ENTRAR, EV_SALIR_FUNCION, EV_PARAR]
        cambio = bb_poner(ev, t == DEPURANDO) or cambio
    end
    cambio = bb_ejecutando(t == EJECUTANDO) or cambio
    if cambio and abierta
        mui_canvas_redraw(v.botones)
    end
    if sonda
        var nombres: [String] = ["libre", "compilando", "ejecutando", "depurando", "git"]
        env_set("FORJA_ESTADO", nombres[t], false)
    end
end

var parar_pedido: Int = 0        # cuándo se pulsó Parar (time_ms), 0 si no
var parar_avisado: Bool = false

# Al salir con un programa en marcha: se para antes (el depurado, con dbg_end; el ejecutado, con Ctrl-C). Si no
# para en 3 s, se pregunta: Forja no puede acabar hasta que acabe él (su proceso corre con el código de Forja).
# false si no hay que salir.
func parar_al_salir() -> Bool
    if tarea == DEPURANDO
        dbg_end(3000)
        return true
    end
    if tarea != EJECUTANDO
        return true
    end
    run_break(tarea_run)
    n = 0
    while n < 60 and not run_ready(tarea_run)
        time_delay(5)
        n = n + 1
    end
    if run_ready(tarea_run)
        return true
    end
    r = mui_request(v.window, tr(455, "El programa sigue en marcha"), tr(456, "Forja se cerrará cuando acabe. Si tiene ventana, ciérrala."), tr(457, "_Salir|_No salir"))
    return r == 1
end

func compilar(y_ejecutar: Bool)
    if tarea == EJECUTANDO
        run_break(tarea_run)
        if parar_pedido == 0
            parar_pedido = time_ms()
        end
        return
    end
    if tarea != NADA
        return
    end
    d = ed_actual()
    if d != nil and (d.sprite != nil or d.mapa != nil)
        d = programa_abierto()
        if d == nil
            avisar(tr(91, "Para compilar, abre el .dash del programa."), 1)
            return
        end
    end
    if d == nil
        return
    end
    if d.ruta == "" and not guardar_como(d)
        return
    end
    # lo que haya sin guardar va al disco antes (dashc lee los ficheros)
    for o in documentos
        if o.cambiado and o.ruta != ""
            guardar_en(o, o.ruta)
        end
    end
    redibujar()
    # un módulo (sin Main) no es un programa: se compila el de su proyecto
    ruta = programa_de(d)
    nombre = nombre_de(ruta)
    tarea_exe = ejecutable_de(ruta)
    tarea_dash = ruta
    if not cajon_listo(cajon_ejecutables())
        avisar(tr(377, "No se puede crear el cajón de los ejecutables: ") + cajon_ejecutables(), 1)
        return
    end
    opciones = ""
    if depurar_despues
        opciones = " --debug"
    end
    orden = dashc() + opciones + " \"" + ruta + "\" -o \"" + tarea_exe + "\""
    avisar(tr(9, "Compilando ") + nombre + "...", 0)
    tarea_run = run_start(orden, ESPERA_DASHC)
    if tarea_run == 0
        avisar(tr(10, "No se puede ejecutar ") + dashc() + tr(11, ". Pon su ruta en ENV:Forja/dashc."), 1)
        return
    end
    ejecutar_despues = y_ejecutar
    tarea_inicio = time_ms()
    poner_tarea(COMPILANDO)
    armar_tic(TIC_MS, EV_TIC)
end

# true si el código tiene Main (es un programa, no un módulo que importa otro)
func tiene_main(lineas: [String]) -> Bool
    for l in lineas
        if str_starts(l, "Main") and (l.length == 4 or str_code(l, 4) == 32 or str_code(l, 4) == 35 or str_code(l, 4) == 9)
            return true
        end
    end
    return false
end

# Lo que se compila desde un documento: él mismo si tiene Main; si es un módulo, el programa de su proyecto (un
# .dash abierto con Main de su cajón o del de encima; si no, el main.dash de esos cajones o del proyecto). Antes se
# compilaba el módulo solo, y fallaba.
func programa_de(d: Documento) -> String
    if not str_ends(str_lower(d.ruta), ".dash") and not str_ends(str_lower(d.ruta), ".dashui")
        return d.ruta
    end
    if str_ends(str_lower(d.ruta), ".dash") and tiene_main(d.lineas)
        return d.ruta
    end
    cajon = cajon_de(d.ruta)
    var cajones: [String] = [cajon]
    if cajon_de(cajon) != "" and cajon_de(cajon) != cajon
        cajones.push(cajon_de(cajon))
    end
    if proyecto_cajon != "" and proyecto_cajon != cajon
        cajones.push(proyecto_cajon)
    end
    for c in cajones
        for o in documentos
            if o.ruta != "" and o.sprite == nil and o.mapa == nil and str_lower(cajon_de(o.ruta)) == str_lower(c) and str_ends(str_lower(o.ruta), ".dash") and tiene_main(o.lineas)
                return o.ruta
            end
        end
        m = ruta_unir(c, "main.dash")
        if file_exists(m)
            return m
        end
    end
    return d.ruta
end

# Desde una pestaña de sprite se compila el programa: main.dash si está abierto, si no el primer .dash
func programa_abierto() -> Documento
    var otro: Documento = nil
    for o in documentos
        if o.sprite == nil and o.mapa == nil and str_ends(str_lower(o.nombre), ".dash")
            if str_lower(o.nombre) == "main.dash"
                return o
            end
            if otro == nil
                otro = o
            end
        end
    end
    return otro
end

# El único temporizador de MUI: uno nuevo cancela el anterior, así que todo lo que espera pasa por tic()
# Las versiones nuevas de Dash (actualizar.dash): un paso, sus mensajes a la salida y, si hay una nueva y se pidió,
# la pregunta de si se instala
func actualizar_tic()
    act_paso()
    actualizar_mensajes()
    if act_preguntar()
        r = mui_request(v.window, tr(448, "Versión nueva de Dash"), hueco2(tr(449, "Está publicada Dash %1. ¿La bajo y la instalo en el cajón de Dash?\n\nSon %2 MB. Pone al día la orden dash, Forja, Inferencia, lib/ y los ejemplos.\nTus programas y tus preferencias no se tocan."), act_version_nueva(), act_megas()), tr(450, "_Instalar|_Cancelar"))
        act_instalar(r == 1)
        actualizar_mensajes()
    end
end

func actualizar_mensajes()
    m = act_mensaje()
    if m != ""
        avisar(m, act_tipo())
    end
end

# El temporizador para lo de actualizar, si nada más lo ha puesto
func actualizar_armar()
    if not tic_armado
        e = act_espera()
        if e >= 0
            armar_tic(e, EV_TIC)
        end
    end
end

func armar_tic(ms: Int, ev: Int)
    tic_armado = true
    mui_timer(ms, ev)
end

func tic()
    tic_armado = false
    actualizar_tic()
    indice_en_reposo()
    d = ed_actual()
    if d != nil and d.sprite != nil and sp_avanzar(d.sprite)
        z = sp_zona_vista()
        sp_solo_vista = true
        mui_canvas_update_area(v.editor, z[0], z[1], z[2], z[3])
        sp_solo_vista = false
        escribir_sonda()
    end
    if bienvenida_parpadear()
        z = bienvenida_zona()
        mui_canvas_update_area(v.editor, z[0], z[1], z[2], z[3])
    end
    if inferencia_espera > 0
        if inferencia_mandar()
            redibujar()
        else
            inferencia_espera = inferencia_espera - 1
            if inferencia_espera == 0
                avisar(tr(12, "Inferencia no aparece."), 1)
            elif tarea == NADA
                armar_tic(TIC_MS, EV_TIC)
            end
        end
    end
    if tarea == NADA
        return
    end
    if tarea == DEPURANDO
        # (la señal del depurador es lo normal; esto, por si se pierde)
        mirar_depuracion()
        if tarea == DEPURANDO
            armar_tic(TIC_MS * 3, EV_TIC)
        end
        return
    end
    if not run_ready(tarea_run)
        # Parar manda Ctrl-C (y otra vez cada segundo); un programa que espera a su ventana no lo ve hasta que le
        # llega algo: a los 4 s, se dice
        if parar_pedido > 0 and not parar_avisado and time_ms() - parar_pedido > 4000
            parar_avisado = true
            avisar(tr(454, "El programa no se para: si tiene ventana, ciérrala."), 1)
        end
        armar_tic(TIC_MS, EV_TIC)
        return
    end
    parar_pedido = 0
    parar_avisado = false
    texto = run_finish(tarea_run)
    rc = run_rc()
    tarea_run = 0
    ms = time_ms() - tarea_inicio
    if tarea == GIT
        if str_trim(texto) != ""
            salida_anadir(str_trim(texto), 0)
        end
        if rc == 0
            avisar(tr(228, "Git: hecho en ") + segundos(ms) + ".", 2)
        else
            avisar(hueco(tr(229, "Git acabó con código %1."), "#{rc}"), 1)
        end
        poner_tarea(NADA)
        # traer o cambiar de rama puede cambiar los ficheros
        proyecto_leer(proyecto_cajon)
        redibujar()
        return
    end
    if tarea == COMPILANDO
        errores = 0
        errores_ultimos = ""
        for l in str_split(str_trim(texto), "\n")
            if salida_error_dashc(l)
                errores = errores + 1
                errores_ultimos = errores_ultimos + l + "\n"
            elif l != ""
                salida_anadir(l, 0)
            end
        end
        if rc != 0
            if errores == 1
                avisar(tr(13, "No compila: un error (clic en él para ir a su línea)."), 1)
            else
                avisar(hueco(tr(67, "No compila: %1 errores (clic en uno para ir a su línea)."), "#{errores}"), 1)
            end
            poner_tarea(NADA)
            depurar_despues = false
            return
        end
        avisar(tr(14, "Compilado en ") + segundos(ms) + ": " + tarea_exe, 2)
        if depurar_despues
            depurar_despues = false
            empezar_depuracion()
            return
        end
        if not ejecutar_despues
            poner_tarea(NADA)
            return
        end
        avisar(tr(15, "Ejecutando ") + nombre_de(tarea_exe) + "...", 0)
        antes = al_cajon_del_programa()
        tarea_run = run_start("\"" + tarea_exe + "\"", 0)
        volver_al_cajon(antes)
        if tarea_run == 0
            avisar(tr(16, "No se puede ejecutar ") + tarea_exe, 1)
            poner_tarea(NADA)
            return
        end
        tarea_inicio = time_ms()
        parar_pedido = 0
        parar_avisado = false
        poner_tarea(EJECUTANDO)
        armar_tic(TIC_MS, EV_TIC)
        return
    end
    # acabó el programa (un error de ejecución, con su sitio: un clic lleva a la línea)
    error = -1
    if str_trim(texto) != ""
        error = salida_anadir_programa(str_trim(texto), cajon_de(tarea_dash), tarea_exe)
    end
    tipo = 2
    if rc != 0
        tipo = 1
    end
    avisar(hueco2(tr(68, "%1 acabó con código %2"), nombre_de(tarea_exe), "#{rc}") + tr(69, " en ") + segundos(ms) + ".", tipo)
    if error >= 0
        salida_mostrar(error)
        mui_canvas_redraw(v.salida)
    end
    poner_tarea(NADA)
end

# --- Depurar ---

func depurar()
    if tarea != NADA
        return
    end
    depurar_despues = true
    compilar(false)
    if tarea != COMPILANDO
        depurar_despues = false
    end
end

func empezar_depuracion()
    antes = al_cajon_del_programa()
    empezado = dbg_start(tarea_exe, "")
    volver_al_cajon(antes)
    if not empezado
        avisar(tr(17, "No se puede depurar: ") + dbg_error(), 1)
        poner_tarea(NADA)
        return
    end
    for d in documentos
        for p in d.puntos
            dbg_break(d.nombre, p)
        end
    end
    salida_vista = 0
    dep_olvidar()
    avisar(tr(18, "Depurando ") + nombre_de(tarea_exe) + tr(19, " (F5 seguir, F10 paso, F6 entrar, F7 salir, F9 punto de parada)."), 0)
    poner_tarea(DEPURANDO)
    parada_atendida = false
    dbg_continue()
    armar_tic(TIC_MS * 3, EV_TIC)
    mirar_depuracion()
    publicar_depuracion()
end

# Lo nuevo que escribió el programa, a la salida
func salida_programa()
    t = dbg_output()
    if t.length > salida_vista
        nuevo = t[salida_vista:]
        salida_vista = t.length
        if nuevo.length > 0 and str_ends(nuevo, "\n")
            nuevo = nuevo[0:nuevo.length - 1]
        end
        avisar(nuevo, 0)
    end
end

# El depurador avisó (o un tic): ¿ha parado o ha acabado?
var parada_atendida: Bool = false   # la parada de ahora ya está en el editor y en el panel
func mirar_depuracion()
    if tarea != DEPURANDO
        return
    end
    e = dbg_state()
    if e == 3 and not parada_atendida
        # una vez por parada: el tic de por si se pierde la señal la volvía a atender cada poco, y llevaba el cursor
        # a la línea de la parada (y el código saltaba tras un clic en el editor, lo contó David Martínez)
        parada_atendida = true
        al_parar()
    elif e == 4 or e == 0
        al_acabar()
    end
end

func al_parar()
    salida_programa()
    # la ventana del programa se queda el teclado al abrirse: Forja delante otra vez, para que F5, F10... lleguen
    if abierta and mui_window_active(v.window) == 0
        mui_window_activate(v.window)
    end
    ruta = dbg_file()
    n = dbg_line()
    # en el mismo fichero y con la línea a la vista, el código no se mueve y solo se repintan la línea del cursor de
    # antes y la de la parada (cada parada repintaba y centraba: lo contó David Martínez)
    d0 = ed_actual()
    mismo = d0 != nil and d0.ruta != "" and str_lower(d0.ruta) == str_lower(ruta) and es_codigo(d0)
    cursor_antes = -1
    if d0 != nil
        cursor_antes = d0.cl
    end
    quieto = false
    ed_dbg_ruta = ruta
    ed_dbg_linea = n
    if abrir(ruta)
        if mismo
            quieto = ed_ir_a_quieto(n, 1)
        else
            ed_ir_a(n, 1)
        end
    end
    # la pila y las variables, en el panel de la izquierda (en árbol: lo desplegado sigue desplegado)
    dep_construir()
    barra_variables_ver(true)
    mui_canvas_redraw(v.proyecto)
    if quieto
        if cursor_antes >= 0 and cursor_antes != n - 1
            redibujar_linea(cursor_antes)
        end
        redibujar_linea(n - 1)
    else
        redibujar()
    end
    publicar_depuracion()
end

func al_acabar()
    salida_programa()
    avisar(hueco2(tr(68, "%1 acabó con código %2"), nombre_de(tarea_exe), "#{dbg_rc()}") + ".", 2)
    ed_dbg_ruta = ""
    ed_dbg_linea = 0
    depuracion.clear()
    barra_variables_ver(false)
    poner_tarea(NADA)
    mui_canvas_redraw(v.proyecto)
    redibujar()
    publicar_depuracion()
end

# Seguir, paso, entrar, salir o parar
func orden_depurador(ev: Int)
    if tarea != DEPURANDO
        return
    end
    if ev == EV_PARAR
        dbg_end(3000)
        al_acabar()
        return
    end
    if dbg_state() != 3 and dbg_state() != 1
        return
    end
    # la línea de la parada deja de marcarse: se repinta solo ella (el editor entero, en cada paso, parpadeaba)
    vieja = ed_dbg_linea
    ed_dbg_linea = 0
    d = ed_actual()
    if vieja > 0 and d != nil and d.ruta != "" and str_lower(d.ruta) == str_lower(ed_dbg_ruta) and es_codigo(d)
        redibujar_linea(vieja - 1)
    end
    parada_atendida = false
    if ev == EV_SEGUIR
        dbg_continue()
    elif ev == EV_PASO
        dbg_next()
    elif ev == EV_ENTRAR
        dbg_step()
    elif ev == EV_SALIR_FUNCION
        dbg_out()
    end
    # (puede haber parado o acabado ya)
    mirar_depuracion()
    publicar_depuracion()
end

# Para las pruebas: ENV:FORJA_DEPURAR ("estado línea función") y ENV:FORJA_VARIABLES (las líneas del panel)
func publicar_depuracion()
    if not sonda
        return
    end
    # las variables antes que el estado: quien espera el estado ya las encuentra
    t = ""
    for f in depuracion
        t = t + dep_linea(f) + "|"
    end
    env_set("FORJA_VARIABLES", t, false)
    # parado (3) solo cuando Forja ya ha recogido la parada (al_parar): si no, la prueba leería la línea nueva con las
    # variables de antes
    estado = dbg_state()
    if estado == 3 and ed_dbg_linea == 0
        estado = 1
    end
    env_set("FORJA_DEPURAR", "#{estado} #{dbg_line()} " + dbg_function(), false)
end

# Un clic en un error de la salida: a su fichero y su línea
func en_salida()
    rueda = mui_canvas_wheel(v.salida)
    if rueda != 0
        salida_atras = salida_atras_valido(salida_atras + rueda * 3)
        mui_canvas_redraw(v.salida)
        return
    end
    if mui_canvas_button(v.salida) != 1
        return
    end
    salida_foco = true
    i = salida_en(mui_canvas_mouse_y(v.salida))
    # un clic elige esa línea (arrastrando, varias): Amiga-C la copia
    salida_sel_a = i
    salida_sel_b = i
    mui_canvas_redraw(v.salida)
    if i < 0 or salida_rutas[i] == ""
        return
    end
    ruta = salida_rutas[i]
    # una ruta relativa es del cajón del fichero activo
    if str_find(ruta, ":") < 0 and not str_starts(ruta, "*")
        d = ed_actual()
        if d != nil
            ruta = ruta_unir(cajon_de(d.ruta), ruta)
        end
    end
    if abrir_sitio(ruta)
        ed_ir_a(salida_num[i], salida_col[i])
        cerrar_capas()
        redibujar()
    end
end

# Arrastrando en la salida se eligen varias líneas
func arrastrar_salida()
    if salida_sel_a < 0 or mui_canvas_drag(v.salida) != 1
        return
    end
    y = mui_canvas_mouse_y(v.salida)
    i = salida_en(y)
    if i < 0 and y >= salida_y0
        i = salida_lineas.length - 1
    elif i < 0
        i = salida_desde
    end
    if i != salida_sel_b
        salida_sel_b = i
        mui_canvas_redraw(v.salida)
    end
end

# La salida al portapapeles: las líneas elegidas, o toda si no hay ninguna
func copiar_salida(solo_elegidas: Bool)
    clip_write_text(latin1_to_utf8(salida_texto(solo_elegidas)))
end

func guardar_salida()
    if not file_save_dialog(tr(222, "Guardar la salida"), "#?.txt")
        return
    end
    ruta = file_fullpath()
    if file_write_text(ruta, salida_texto(false))
        avisar(tr(3, "Guardado: ") + ruta, 2)
    else
        avisar(tr(2, "No se puede escribir ") + ruta, 1)
    end
end

# Un clic en el panel del proyecto: un fichero se abre; un cajón se enseña
func en_proyecto()
    if depuracion.length > 0
        en_depuracion()
        return
    end
    rueda = mui_canvas_wheel(v.proyecto)
    if rueda != 0
        proyecto_desde = proyecto_desde_valido(proyecto_desde - rueda * 3)
        mui_canvas_redraw(v.proyecto)
        return
    end
    if mui_canvas_button(v.proyecto) != 1
        return
    end
    i = proyecto_en(mui_canvas_mouse_y(v.proyecto))
    if i < 0
        return
    end
    f = proyecto_ficheros[i]
    if f == "/"
        proyecto_leer(cajon_de(proyecto_cajon))
    elif str_ends(f, "/")
        proyecto_leer(ruta_unir(proyecto_cajon, f[0:f.length - 1]))
    else
        if abrir(ruta_unir(proyecto_cajon, f))
            redibujar()
        end
        return
    end
    mui_canvas_redraw(v.proyecto)
end

# Al depurar, el panel enseña la pila y las variables: un clic despliega o pliega una lista o un struct (idea de
# David Martínez); la rueda y las flechas lo mueven (con Mayúsculas, la rueda va a lo ancho y las flechas de página
# en página). Un clic ahí no es en la lista de ficheros que tapan (abría el de esa fila, lo contó David Martínez).
func en_depuracion()
    rueda = mui_canvas_wheel(v.proyecto)
    mayus = (mui_canvas_qualifiers(v.proyecto) & Q_MAYUS) != 0
    tecla = mui_canvas_key(v.proyecto)
    desde = depuracion_desde
    dx = depuracion_dx
    if rueda != 0 and mayus
        dx = dx - rueda * 4
    elif rueda != 0
        desde = desde - rueda * 3
    elif tecla >= 0
        paso = 1
        lado = 4
        if mayus
            paso = depuracion_caben
            lado = depuracion_ancho_caben
        end
        if tecla == T_ARRIBA
            desde = desde - paso
        elif tecla == T_ABAJO
            desde = desde + paso
        elif tecla == T_IZQUIERDA
            dx = dx - lado
        elif tecla == T_DERECHA
            dx = dx + lado
        end
    elif mui_canvas_button(v.proyecto) == 1
        if dep_clic(dep_en(mui_canvas_mouse_y(v.proyecto)))
            mui_canvas_redraw(v.proyecto)
            publicar_depuracion()
        end
        return
    end
    desde = dep_desde_valido(desde)
    dx = dep_dx_valido(dx)
    if desde != depuracion_desde or dx != depuracion_dx
        depuracion_desde = desde
        depuracion_dx = dx
        mui_canvas_redraw(v.proyecto)
    end
end

# La barra de abajo del panel de las variables: solo al depurar
var barra_variables_vista: Bool = false
func barra_variables_ver(ver: Bool)
    if ver != barra_variables_vista
        barra_variables_vista = ver
        mui_set_visible(v.barra_variables, ver)
    end
end

# Las barras de la salida y del proyecto siguen a lo que se ve
func ajustar_barras_paneles()
    caben = salida_caben
    total = salida_lineas.length
    if total < caben
        total = caben
    end
    if total != barra_salida_total or caben != barra_salida_caben
        barra_salida_total = total
        barra_salida_caben = caben
        mui_set_range(v.barra_salida, total, caben)
        barra_salida_valor = -1
    end
    if salida_desde != barra_salida_valor
        barra_salida_valor = salida_desde
        mui_set_value(v.barra_salida, salida_desde)
    end
    caben = proyecto_caben
    total = proyecto_ficheros.length
    primera = proyecto_desde
    if depuracion.length > 0
        caben = depuracion_caben
        total = depuracion.length
        primera = depuracion_desde
    end
    if total < caben
        total = caben
    end
    if total != barra_proyecto_total or caben != barra_proyecto_caben
        barra_proyecto_total = total
        barra_proyecto_caben = caben
        mui_set_range(v.barra_proyecto, total, caben)
        barra_proyecto_valor = -1
    end
    if primera != barra_proyecto_valor
        barra_proyecto_valor = primera
        mui_set_value(v.barra_proyecto, primera)
    end
    if barra_variables_vista
        caben = depuracion_ancho_caben
        total = depuracion_ancho + 1
        if total < caben
            total = caben
        end
        if total != barra_variables_total or caben != barra_variables_caben
            barra_variables_total = total
            barra_variables_caben = caben
            mui_set_range(v.barra_variables, total, caben)
            barra_variables_valor = -1
        end
        if depuracion_dx != barra_variables_valor
            barra_variables_valor = depuracion_dx
            mui_set_value(v.barra_variables, depuracion_dx)
        end
    end
end

# La barra sigue al editor
func ajustar_barra()
    d = ed_actual()
    if d == nil
        return
    end
    if d.lineas.length != barra_total or ed_visibles != barra_visibles
        barra_total = d.lineas.length
        barra_visibles = ed_visibles
        mui_set_range(v.barra, barra_total, barra_visibles)
        barra_valor = -1
    end
    if d.primera != barra_valor
        barra_valor = d.primera
        mui_set_value(v.barra, d.primera)
    end
end

func redibujar()
    ajustar_paneles()
    mui_canvas_redraw(v.editor)
    ajustar_barra()
    escribir_sonda()
end

# --- Los símbolos del código (codigo.dash): completar, ayuda de argumentos, ir a la definición ---

# El nombre de un documento para codigo.dash: su ruta, o "*nombre" si aún no se ha guardado
func clave_de(d: Documento) -> String
    if d.ruta != ""
        return d.ruta
    end
    return "*" + d.nombre
end

func es_codigo(d: Documento) -> Bool
    return d != nil and d.sprite == nil and d.mapa == nil and not d.diseno
end

# Los símbolos al día: los de los ficheros abiertos (con lo que tienen sin guardar) y lo que importa el activo
func indice_al_dia()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    cx_empezar()
    for o in documentos
        if o.sprite == nil and o.mapa == nil
            cx_fichero(clave_de(o), o.lineas, o.version)
        end
    end
    # (sin requesters: buscar lo importado en DASH: no debe pedir que se inserte ese volumen si no existe)
    cajon = cajon_de(dashc())
    dos_requesters(false)
    cx_preparar(clave_de(d), cajon)
    dos_requesters(true)
    bi_preparar()
    indice_de = clave_de(d)
    indice_version = d.version
end

# Antes de completar: los del fichero activo (aunque sean de unas letras antes); con al_dia, de ahora mismo
func indice_si_hace_falta(al_dia: Bool)
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    if indice_de != clave_de(d) or (al_dia and indice_version != d.version)
        indice_al_dia()
    end
end

# Desde tic(): tras un rato sin escribir, los símbolos del fichero activo se vuelven a leer
func indice_en_reposo()
    d = ed_actual()
    if not completar_activo or not es_codigo(d) or (indice_de == clave_de(d) and indice_version == d.version)
        return
    end
    if time_ms() - ultimo_cambio < REPOSO_MS
        if not tic_armado
            armar_tic(REPOSO_MS, EV_TIC)
        end
        return
    end
    if indice_de != clave_de(d)
        indice_al_dia()
        return
    end
    # el mismo fichero: se lee a trozos de LINEAS_TIC líneas, un trozo por tic, para que el editor siga respondiendo
    if cx_leer_paso(clave_de(d), d.lineas, d.version, LINEAS_TIC)
        cajon = cajon_de(dashc())
        dos_requesters(false)
        cx_preparar(clave_de(d), cajon)
        dos_requesters(true)
        indice_version = d.version
    elif not tic_armado
        armar_tic(20, EV_TIC)
    end
end

func cerrar_capas()
    ac_cerrar()
    ay_cerrar()
    cx_locales_olvidar()
end

# Redibuja tras una tecla: solo la línea del cursor (solo_linea) si no hay ni hubo nada encima del texto (la lista o
# la ayuda, antes en y1 a y2); si lo hay, todo (un dibujo entero cuesta poco más que las filas que tapan)
func redibujar_tras_tecla(solo_linea: Bool, y1: Int, y2: Int)
    d = ed_actual()
    ed_capas_geometria(d)
    ed_capas_rango()
    if solo_linea and d != nil and y1 < 0 and ed_capas_y1 < 0
        redibujar_linea(d.cl)
    else
        redibujar()
    end
end

# Antes de que una tecla llegue al editor: la lista para completar se queda con las flechas, Tab, Return y Esc;
# Ctrl + Espacio la saca. true si la tecla era para ella (y ya se ha redibujado).
func completar_tecla(d: Documento, codigo: Int, teclas: Int) -> Bool
    y1 = ed_pintado_y1
    y2 = ed_pintado_y2
    sin_teclas = (teclas & (Q_MAYUS | Q_ALT | Q_CTRL)) == 0
    if codigo == T_ESPACIO and (teclas & Q_CTRL) != 0
        completar_ahora()
        return true
    end
    if ac_visible and ac_linea == d.cl
        if (codigo == T_ARRIBA or codigo == T_ABAJO) and sin_teclas
            if codigo == T_ARRIBA
                ac_mover(-1, ed_lista_filas)
            else
                ac_mover(1, ed_lista_filas)
            end
            redibujar_tras_tecla(true, y1, y2)
            return true
        end
        if (codigo == T_TAB or codigo == T_RETURN or codigo == T_ENTER) and sin_teclas
            palabra = ac_elegida()
            ac_cerrar()
            if palabra != "" and palabra != ac_prefijo
                ed_completar(d, ac_col, palabra)
                ultimo_cambio = time_ms()
                if ay_visible
                    ay_calcular(d.lineas, d.cl, d.cc, d.version)
                end
                redibujar_tras_tecla(true, y1, y2)
                return true
            end
            # ya está escrita entera: la tecla hace lo de siempre
            return false
        end
        if codigo == T_ESC
            ac_cerrar()
            redibujar_tras_tecla(true, y1, y2)
            return true
        end
    end
    if ay_visible and codigo == T_ESC
        ay_cerrar()
        redibujar_tras_tecla(true, y1, y2)
        return true
    end
    return false
end

# Help o F1: la ayuda del nombre del cursor (idea de Javier R. Santurde "Tolkien"); Esc o mover el cursor la cierra
func ayuda_del_cursor(d: Documento)
    y1 = ed_pintado_y1
    y2 = ed_pintado_y2
    indice_si_hace_falta(true)
    ac_cerrar()
    if ay_palabra(d.lineas, d.cl, d.cc, d.version)
        redibujar_tras_tecla(true, y1, y2)
    else
        avisar(tr(379, "No hay ayuda para lo que hay en el cursor."), 1)
    end
end

# Ctrl + Espacio (o el menú): la lista para completar, aunque haya menos letras
func completar_ahora()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    y1 = ed_pintado_y1
    y2 = ed_pintado_y2
    indice_si_hace_falta(true)
    ac_calcular(d.lineas, d.cl, d.cc, d.version, true)
    redibujar_tras_tecla(true, y1, y2)
end

func _letra_de_nombre(letra: String) -> Bool
    if letra == ""
        return false
    end
    c = str_code(letra, 0)
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 192
end

# Tras una tecla que cambió el editor: la lista se filtra (o sale, o se cierra) y la ayuda sigue al cursor
var ms_completar: Int = 0         # lo que tardó la última lista (para la sonda)

func completar_despues(d: Documento, codigo: Int, letra: String)
    t0 = time_ms()
    if _letra_de_nombre(letra) or letra == "." or letra == "@" or (codigo == T_RETROCESO and ac_visible)
        indice_si_hace_falta(false)
        ac_calcular(d.lineas, d.cl, d.cc, d.version, false)
    else
        ac_cerrar()
    end
    ms_completar = time_ms() - t0
    if letra == "(" or letra == ","
        indice_si_hace_falta(false)
        ay_calcular(d.lineas, d.cl, d.cc, d.version)
    elif ay_visible
        if d.cl != ay_linea
            ay_cerrar()
        else
            ay_calcular(d.lineas, d.cl, d.cc, d.version)
        end
    end
end

# Abre (o va a) el fichero de un sitio: una ruta o "*nombre" (uno sin guardar); false si no puede
func abrir_sitio(ruta: String) -> Bool
    if str_starts(ruta, "*")
        i = 0
        for o in documentos
            if o.ruta == "" and "*" + o.nombre == ruta
                activo = i
                return true
            end
            i = i + 1
        end
        return false
    end
    if not abrir(ruta)
        return false
    end
    d = ed_actual()
    if d != nil and d.diseno
        # a una línea de un .dashui: como texto
        d.diseno = false
    end
    return true
end

func ir_a_sitio(ruta: String, linea: Int, col: Int)
    if abrir_sitio(ruta)
        ed_ir_a(linea, col)
    end
    cerrar_capas()
    redibujar()
end

# Amiga-J o Ctrl + clic: a donde se define el nombre del cursor
func ir_definicion()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    indice_si_hace_falta(true)
    r = cx_definicion(d.lineas, clave_de(d), d.cl, d.cc, d.version)
    if r == 0
        if cx_def_nombre == ""
            avisar(tr(230, "No hay un nombre en el cursor."), 1)
        else
            avisar(hueco(tr(231, "No sé dónde se define %1."), cx_def_nombre), 1)
        end
        return
    end
    if r == 2
        avisar(hueco(tr(232, "%1 es de Dash: "), cx_def_nombre) + cx_def_info, 0)
        return
    end
    historial_rutas.push(clave_de(d))
    historial_lineas.push(d.cl + 1)
    historial_cols.push(d.cc + 1)
    if historial_rutas.length > 50
        historial_rutas.remove(0)
        historial_lineas.remove(0)
        historial_cols.remove(0)
    end
    ir_a_sitio(cx_def_ruta, cx_def_linea, cx_def_col)
end

# Amiga-U: a donde se estaba antes de ir a la definición
func volver()
    if historial_rutas.length == 0
        avisar(tr(233, "No hay a dónde volver."), 1)
        return
    end
    r = historial_rutas.pop()
    l = historial_lineas.pop()
    c = historial_cols.pop()
    ir_a_sitio(r, l, c)
end

# Amiga-H: dónde se usa el nombre del cursor (en el fichero, lo que importa y los .dash del proyecto), en la salida
func referencias()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    indice_si_hace_falta(true)
    var otros: [String] = []
    for f in proyecto_ficheros
        if str_ends(str_lower(f), ".dash")
            otros.push(ruta_unir(proyecto_cajon, f))
        end
    end
    dos_requesters(false)
    hay = cx_referencias(d.lineas, clave_de(d), d.cl, d.cc, d.version, otros)
    dos_requesters(true)
    if not hay
        avisar(tr(230, "No hay un nombre en el cursor."), 1)
        return
    end
    n = cx_ref_lineas.length
    salida_anadir(hueco2(tr(234, "Dónde se usa %1: %2 sitios (clic en uno para ir)."), cx_def_nombre, "#{n}"), 2)
    i = 0
    while i < n
        r = cx_ref_rutas[i]
        nombre = nombre_de(r)
        if str_starts(r, "*")
            nombre = r[1:]
        end
        salida_anadir_sitio(nombre + ":#{cx_ref_lineas[i]}: " + cx_ref_textos[i], r, cx_ref_lineas[i], cx_ref_cols[i])
        i = i + 1
    end
    salida_atras = 0
    mui_canvas_redraw(v.salida)
end

func redibujar_linea(n: Int)
    d = ed_actual()
    if d == nil
        redibujar()
        return
    end
    fy = ed_fila_y(d, n)
    if fy < 0
        redibujar()
        return
    end
    ed_solo_linea = n
    mui_canvas_update_area(v.editor, 0, fy, ed_zona_ancho, ed_alto_fila)
    ed_solo_linea = -1
    escribir_sonda()
end

# Escribe un fichero de la sonda; si la prueba lo tiene abierto en ese momento, AmigaDOS no deja escribirlo:
# se reintenta unas veces (si no, la prueba leería lo de antes)
func sonda_fichero(ruta: String, texto: String)
    n = 0
    while not file_write_text(ruta, texto) and n < 20
        time_delay(1)
        n = n + 1
    end
end

func escribir_sonda()
    if sonda
        d = ed_actual()
        if d == nil
            sonda_fichero("RAM:forja-sonda.txt", "0 0 \n")
            return
        end
        if d.sprite != nil
            sonda_fichero("RAM:forja-sonda.txt", "0 0 " + d.nombre + "\n" + sp_sonda(d.sprite))
        elif d.mapa != nil
            sonda_fichero("RAM:forja-sonda.txt", "0 0 " + d.nombre + "\n" + mp_sonda(d.mapa))
        else
            sonda_fichero("RAM:forja-sonda.txt", "#{d.cl} #{d.cc} " + d.nombre + "\n" + ed_texto(d))
            env_set("FORJA_DIBUJOS", "#{ed_dibujos}", false)
            if ed_vistas != sonda_vistas
                sonda_vistas = ed_vistas
                sonda_fichero("RAM:forja-vistas.txt", ed_vistas)
            end
        end
        env_set("FORJA_DIBUJO", "#{ed_ms_dibujo}", false)
        env_set("FORJA_DISENO", "#{dv_sel} #{dv_prop} #{dv_editando} " + dv_mensaje, false)
        c = ""
        if ac_visible
            c = "#{ac_sel}"
            i = 0
            while i < ac_nombres.length and i < 12
                c = c + " " + ac_nombres[i]
                i = i + 1
            end
        end
        env_set("FORJA_VISTA", "#{d.primera} #{ed_alto_fila} #{ed_margen} #{ms_completar} #{ed_visibles}", false)
        if c != sonda_completar
            sonda_completar = c
            env_set("FORJA_COMPLETAR", c, false)
        end
        a = ""
        if ay_visible
            a = "#{ay_arg} " + ed_texto_ayuda()
        end
        if a != sonda_ayuda
            sonda_ayuda = a
            env_set("FORJA_AYUDA", a, false)
        end
    end
end

# Las órdenes del menú Edición (también con Amiga sobre el editor)
func edicion(ev: Int)
    cerrar_capas()
    if ev == EV_COPIAR and salida_foco and salida_hay_seleccion()
        copiar_salida(true)
        return
    end
    d = ed_actual()
    if d == nil
        return
    end
    if d.mapa != nil
        if ev == EV_DESHACER and mp_deshacer(d.mapa)
            d.cambiado = true
        elif ev == EV_REHACER and mp_rehacer(d.mapa)
            d.cambiado = true
        end
        redibujar()
        return
    end
    if d.sprite != nil
        if ev == EV_COPIAR or ev == EV_CORTAR
            sp_copiar_fotograma(d.sprite)
            if ev == EV_CORTAR
                sp_vaciar_fotograma(d.sprite)
                d.cambiado = true
            end
        elif ev == EV_PEGAR
            if (sp_pegar_fotograma(d.sprite) & SP_CAMBIO) != 0
                d.cambiado = true
            end
        elif ev == EV_DESHACER and sp_deshacer(d.sprite)
            d.cambiado = true
        elif ev == EV_REHACER and sp_rehacer(d.sprite)
            d.cambiado = true
        elif ev == EV_DISENO or ev == EV_VISTA
            avisar(tr(20, "El editor de ventanas es para ficheros .dashui."), 1)
        end
        redibujar()
        return
    end
    if ev == EV_CORTAR or ev == EV_COPIAR
        s = ed_seleccion(d)
        if s != ""
            clip_write_text(latin1_to_utf8(s))
            if ev == EV_CORTAR
                ed_borrar_seleccion(d)
            end
        end
    elif ev == EV_PEGAR
        t = str_replace(utf8_to_latin1(clip_read_text()), "\r\n", "\n")
        if t != ""
            ed_escribir(d, str_replace(t, "\t", "    "))
        end
    elif ev == EV_DESHACER
        ed_deshacer(d)
    elif ev == EV_REHACER
        ed_rehacer(d)
    elif ev == EV_TODO
        ed_seleccionar_todo(d)
    elif ev == EV_DISENO
        if str_ends(str_lower(d.nombre), ".dashui")
            d.diseno = not d.diseno
            if d.diseno
                ed_cargar_diseno(d, true)
            end
        else
            avisar(tr(20, "El editor de ventanas es para ficheros .dashui."), 1)
        end
    elif ev == EV_VISTA
        if not d.diseno
            avisar(tr(21, "La vista previa es del editor de ventanas (Amiga-D en un .dashui)."), 1)
        elif dv_error_carga == ""
            e = dv_vista_previa(EV_VISTA_CERRADA, false)
            if e != ""
                avisar(tr(22, "Vista previa: ") + e, 1)
            end
        end
    end
    if d.diseno and (ev == EV_DESHACER or ev == EV_REHACER or ev == EV_PEGAR or ev == EV_CORTAR)
        ed_cargar_diseno(d, true)
        rehacer_vista()
    end
    ed_seguir_cursor(d)
    redibujar()
end

# Pone o quita un punto de parada; si se está depurando, también en el programa
func alternar_punto(d: Documento, n: Int)
    puesto = ed_alternar_punto(d, n)
    if tarea == DEPURANDO
        if puesto
            if not dbg_break(d.nombre, n)
                avisar(hueco(tr(70, "La línea %1 no tiene código: el punto no para ahí."), "#{n}"), 1)
            end
        else
            dbg_unbreak(d.nombre, n)
        end
    end
    redibujar()
end

# Lo que pide el editor de mapas tras un clic, una tecla o un arrastre (SP_CAMBIO, SP_TODO, SP_CELDAS, SP_CODIGO y
# MP_TILESET)
func mp_resultado(d: Documento, r: Int)
    if (r & SP_CAMBIO) != 0
        d.cambiado = true
    end
    if (r & MP_TILESET) != 0
        elegir_tileset(d)
        return
    end
    if (r & MP_SPRITE) != 0
        if file_open_dialog(tr(221, "Sprite del objeto"), SP_PATRON) and mp_objeto_sprite(d.mapa, file_fullpath(), mp_cajon_de(d.ruta))
            d.cambiado = true
        end
        redibujar()
        return
    end
    if (r & SP_CODIGO) != 0
        if d.ruta == ""
            avisar(tr(196, "Guarda el mapa primero: el código lleva el nombre de su fichero."), 1)
            return
        end
        if clip_write_text(latin1_to_utf8(mp_codigo(d.mapa, d.nombre)))
            avisar(tr(135, "El código para cargarlo está en el portapapeles (Amiga-V en el .dash)."), 2)
        else
            avisar(tr(136, "No se puede escribir en el portapapeles."), 1)
        end
        return
    end
    if (r & SP_TODO) != 0
        redibujar()
    elif (r & SP_CELDAS) != 0
        for i in mp_tocados
            z = mp_zona_celda(d.mapa, i)
            mp_celda_sola = i
            mui_canvas_update_area(v.editor, z[0], z[1], z[2], z[3])
        end
        mp_celda_sola = -1
        escribir_sonda()
    end
end

# El tileset del mapa, con la petición de ficheros. Un mapa nuevo y sin tocar toma el lado de sus tiles; si no, el
# tileset tiene que tener tiles del lado del mapa
func elegir_tileset(d: Documento)
    m = d.mapa
    if not file_open_dialog(tr(197, "Tileset del mapa"), SP_PATRON)
        return
    end
    ruta = file_fullpath()
    s = sp_leer(ruta)
    if s == nil
        avisar(sp_error, 1)
        return
    end
    ts = tilemap_tile_size(m.id)
    if s.ancho != ts
        if (s.ancho == 8 or s.ancho == 16 or s.ancho == 32) and d.ruta == "" and m.deshacer.length == 0
            tilemap_create(m.id, tilemap_width(m.id), tilemap_height(m.id), s.ancho, 1)
            tilemap_layer_set(m.id, 0, tr(152, "fondo"), 0, true)
        else
            avisar(hueco2(tr(198, "Los fotogramas de %1 miden %2: los tiles del mapa son de otro tamaño (8, 16 o 32)."), nombre_de(ruta), "#{s.ancho}"), 1)
            return
        end
    end
    tilemap_set_tileset(m.id, ruta)
    if d.ruta != ""
        mp_tileset_relativo(m, mp_cajon_de(d.ruta))
    end
    if mp_leer_tileset(m, mp_cajon_de(d.ruta))
        d.cambiado = true
        avisar(hueco(tr(199, "Tileset: %1"), tilemap_tileset(m.id)), 2)
    else
        avisar(mp_error, 1)
    end
    redibujar()
end

# Lo que pide el editor de sprites tras un clic o un arrastre (SP_CAMBIO, SP_TODO, SP_CELDAS)
func sp_resultado(d: Documento, r: Int)
    if (r & SP_CAMBIO) != 0
        d.cambiado = true
    end
    if (r & SP_CODIGO) != 0
        if d.ruta == ""
            avisar(tr(134, "Guarda el sprite primero: el código lleva el nombre de su fichero."), 1)
            return
        end
        if clip_write_text(latin1_to_utf8(sp_codigo(d.sprite, d.nombre)))
            avisar(tr(135, "El código para cargarlo está en el portapapeles (Amiga-V en el .dash)."), 2)
        else
            avisar(tr(136, "No se puede escribir en el portapapeles."), 1)
        end
        return
    end
    if (r & SP_TODO) != 0
        redibujar()
    elif (r & SP_CELDAS) != 0
        for i in sp_tocados
            z = sp_zona_celda(d.sprite, i)
            sp_celda_sola = i
            mui_canvas_update_area(v.editor, z[0], z[1], z[2], z[3])
        end
        sp_celda_sola = -1
        escribir_sonda()
    elif (r & SP_REJILLA) != 0
        z = sp_zona_rejilla(d.sprite)
        sp_solo_rejilla = true
        mui_canvas_update_area(v.editor, z[0], z[1], z[2], z[3])
        sp_solo_rejilla = false
    end
end

# Si la vista previa está abierta, se rehace con lo cambiado
func rehacer_vista()
    if dv_vista != 0 and dv_error_carga == ""
        e = dv_vista_previa(EV_VISTA_CERRADA, true)
        if e != ""
            avisar(tr(23, "Vista previa: ") + e, 1)
        end
    end
end

# F5 (depurar o seguir), F10 (paso), F6 (entrar) y F7 (salir): su evento, o 0. Valen con el puntero sobre el
# editor, el proyecto o la salida.
func tecla_depurador(codigo: Int) -> Int
    if codigo == T_F5
        if tarea == DEPURANDO
            return EV_SEGUIR
        end
        return EV_DEPURAR
    elif codigo == T_F10
        return EV_PASO
    elif codigo == T_F6
        return EV_ENTRAR
    elif codigo == T_F7
        return EV_SALIR_FUNCION
    end
    return 0
end

# Amiga + letra sobre el editor: el evento de su opción del menú (0 si no es ninguna)
func atajo(letra: String) -> Int
    var letras: [String] = ["x", "c", "v", "z", "r", "a", "q", "n", "o", "s", "w", "k", "e", "i", "d", "p", "f", "l", "g", "b", "j", "u", "h"]
    var eventos: [Int] = [EV_CORTAR, EV_COPIAR, EV_PEGAR, EV_DESHACER, EV_REHACER, EV_TODO, EV_SALIR, EV_NUEVO, EV_ABRIR, EV_GUARDAR, EV_CERRAR, EV_COMPILAR, EV_EJECUTAR, EV_INFERENCIA, EV_DISENO, EV_VISTA, EV_BUSCAR, EV_IRA, EV_DEPURAR, EV_NUEVO_SPRITE, EV_DEFINICION, EV_VOLVER, EV_REFERENCIAS]
    l = str_lower(letra)
    i = 0
    while i < letras.length
        if letras[i] == l
            return eventos[i]
        end
        i = i + 1
    end
    return 0
end

# Lo que pasa sobre el editor: un clic, la rueda o una tecla. Devuelve otro evento si es un atajo.
func en_editor() -> Int
    # un clic o una tecla en el editor (no un atajo con Amiga) le devuelven el foco
    if mui_canvas_button(v.editor) != 0 or (mui_canvas_key(v.editor) >= 0 and (mui_canvas_qualifiers(v.editor) & Q_AMIGA) == 0)
        salida_foco = false
    end
    d = ed_actual()
    if d == nil
        return 0
    end
    rueda = mui_canvas_wheel(v.editor)
    teclas = mui_canvas_qualifiers(v.editor)
    if rueda != 0 or mui_canvas_button(v.editor) != 0
        # la lista para completar y la ayuda se cierran (lo que sigue lo redibuja todo)
        cerrar_capas()
    end
    if rueda != 0 and d.sprite != nil
        sp_resultado(d, sp_ir_fotograma(d.sprite, -rueda))
    elif rueda != 0 and d.mapa != nil
        mp_resultado(d, mp_rueda(d.mapa, rueda, teclas))
    elif rueda != 0
        d.primera = d.primera - rueda * 3
        maximo = d.lineas.length - ed_visibles
        if d.primera > maximo
            d.primera = maximo
        end
        if d.primera < 0
            d.primera = 0
        end
        redibujar()
    elif mui_canvas_button(v.editor) == 1 and ed_pestana_en(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor)) >= 0
        activo = ed_pestana_en(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
        redibujar()
    elif d.mapa != nil
        if mui_canvas_button(v.editor) == 1
            mp_resultado(d, mp_clic(d.mapa, mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), teclas))
        elif mui_canvas_key(v.editor) >= 0 and (teclas & Q_AMIGA) != 0
            return atajo(mui_canvas_char(v.editor))
        elif mui_canvas_key(v.editor) >= 0
            mp_resultado(d, mp_tecla(d.mapa, mui_canvas_key(v.editor), teclas, mui_canvas_char(v.editor)))
        end
        return 0
    elif d.sprite != nil
        if mui_canvas_button(v.editor) == 1
            sp_resultado(d, sp_clic(d.sprite, mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), teclas))
        elif mui_canvas_key(v.editor) >= 0 and (teclas & Q_AMIGA) != 0
            return atajo(mui_canvas_char(v.editor))
        elif mui_canvas_key(v.editor) >= 0
            sp_resultado(d, sp_tecla(d.sprite, mui_canvas_key(v.editor), teclas, mui_canvas_char(v.editor)))
        end
        return 0
    elif mui_canvas_button(v.editor) == 1 and d.diseno
        dv_clic(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
        redibujar()
    elif mui_canvas_button(v.editor) == 1 and mui_canvas_mouse_x(v.editor) < ed_margen - 4 and mui_canvas_mouse_y(v.editor) >= ALTO_PESTANAS
        # un clic en el margen de los números: punto de parada
        alternar_punto(d, ed_linea_en(d, mui_canvas_mouse_y(v.editor)))
    elif mui_canvas_button(v.editor) == 1 and (teclas & Q_CTRL) != 0
        # Ctrl + clic: a la definición de lo que hay ahí
        ed_clic(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), false)
        d.al = -1
        redibujar()
        ir_definicion()
    elif mui_canvas_button(v.editor) == 1
        ed_clic(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), (teclas & Q_MAYUS) != 0)
        redibujar()
    else
        codigo = mui_canvas_key(v.editor)
        if codigo < 0
            return 0
        end
        letra = mui_canvas_char(v.editor)
        if (teclas & Q_AMIGA) != 0
            return atajo(letra)
        end
        if codigo == T_F9
            alternar_punto(d, d.cl + 1)
            return 0
        end
        if (codigo == T_HELP or codigo == T_F1) and es_codigo(d)
            ayuda_del_cursor(d)
            return 0
        end
        otro = tecla_depurador(codigo)
        if otro != 0
            return otro
        end
        if d.diseno
            if dv_tecla(codigo, teclas, letra)
                ed_aplicar_diseno(d)
                rehacer_vista()
            end
            redibujar()
            return 0
        end
        if completar_activo and completar_tecla(d, codigo, teclas)
            return 0
        end
        # escribir dentro de una línea solo redibuja esa línea (y la lista o la ayuda, si están)
        antes_lineas = d.lineas.length
        antes_cl = d.cl
        antes_primera = d.primera
        antes_izquierda = d.izquierda
        antes_cambiado = d.cambiado
        antes_sel = ed_hay_seleccion(d)
        antes_version = d.version
        y1 = ed_pintado_y1
        y2 = ed_pintado_y2
        if ed_tecla(codigo, teclas, letra)
            if d.version != antes_version
                # las variables locales siguen valiendo mientras se escribe en la misma línea
                if d.cl != linea_escrita or d.lineas.length != lineas_antes
                    cx_locales_olvidar()
                end
                linea_escrita = d.cl
                lineas_antes = d.lineas.length
                ultimo_cambio = time_ms()
                if completar_activo and not tic_armado
                    armar_tic(REPOSO_MS, EV_TIC)
                end
            end
            if completar_activo
                completar_despues(d, codigo, letra)
            end
            solo = d.lineas.length == antes_lineas and d.cl == antes_cl and d.primera == antes_primera and d.izquierda == antes_izquierda and antes_cambiado and not antes_sel and not ed_hay_seleccion(d)
            redibujar_tras_tecla(solo, y1, y2)
        end
    end
    return 0
end

func publicar_sonda()
    e = "#{ed_zona_x} #{ed_zona_y} #{ed_zona_ancho} #{ed_zona_alto}"
    if e != sonda_editor
        sonda_editor = e
        env_set("FORJA_EDITOR", e, false)
    end
    p = "#{proyecto_zona_x} #{proyecto_zona_y + proyecto_y0} #{proyecto_fila}"
    if p != sonda_proyecto
        sonda_proyecto = p
        env_set("FORJA_PROYECTO", p, false)
    end
    lista = proyecto_cajon
    for f in proyecto_ficheros
        lista = lista + "|" + f
    end
    if depuracion.length > 0
        lista = "(depurando)"
    end
    if lista != sonda_lista
        sonda_lista = lista
        env_set("FORJA_FICHEROS", lista, false)
    end
    # el árbol de las variables: la zona (x, y, ancho, alto), la primera fila, lo desplazado, el alto de fila, lo
    # ancho, lo que cabe y la y de cada fila que se ve
    a = "#{depuracion_zona_x} #{depuracion_zona_y} #{depuracion_zona_ancho} #{depuracion_zona_alto} #{depuracion_desde} #{depuracion_dx} #{depuracion_fila} #{depuracion_ancho} #{depuracion_ancho_caben}"
    for ay in depuracion_ys
        a = a + " #{ay}"
    end
    if a != sonda_arbol
        sonda_arbol = a
        env_set("FORJA_ARBOL", a, false)
    end
    b = bb_sonda()
    if b != sonda_botones
        sonda_botones = b
        env_set("FORJA_BOTONES", b, false)
    end
    s = "#{salida_zona_x} #{salida_zona_y + salida_y0} #{salida_fila} #{salida_desde} #{salida_lineas.length}"
    if s != sonda_salida
        sonda_salida = s
        env_set("FORJA_SALIDA", s, false)
        texto = ""
        for l in salida_lineas
            texto = texto + l + "\n"
        end
        sonda_fichero("RAM:forja-salida.txt", texto)
    end
    d = ed_actual()
    if d != nil and d.sprite != nil
        g = sp_geometria() + "|" + sp_geometria_panel() + "|" + sp_botones()
        if g != sonda_sprite
            sonda_sprite = g
            env_set("FORJA_SPRITE", sp_geometria(), false)
            env_set("FORJA_SPRITE_PANEL", sp_geometria_panel(), false)
            env_set("FORJA_SPRITE_BOTONES", sp_botones(), false)
        end
    end
    if d != nil and d.mapa != nil
        g = mp_geometria(d.mapa) + "|" + mp_botones()
        if g != sonda_sprite
            sonda_sprite = g
            env_set("FORJA_MAPA", mp_geometria(d.mapa), false)
            env_set("FORJA_MAPA_BOTONES", mp_botones(), false)
        end
    end
    t = ed_pestanas_ventana()
    if t != sonda_pestanas
        sonda_pestanas = t
        env_set("FORJA_PESTANAS", t, false)
    end
end

# --- Buscar y cambiar, ir a la línea ---

# Busca lo de la ventana de buscar; false (y un aviso) si no está
func buscar(adelante: Bool) -> Bool
    d = ed_actual()
    t = mui_get_text(vb.texto)
    if d == nil or t == ""
        return false
    end
    if not ed_buscar(d, t, mui_get_value(vb.mayus) != 0, adelante)
        avisar(tr(24, "No está \"") + t + "\".", 1)
        return false
    end
    redibujar()
    return true
end

# Cambia lo elegido (si es lo buscado) y busca el siguiente
func cambiar_uno()
    d = ed_actual()
    t = mui_get_text(vb.texto)
    if d == nil or t == ""
        return
    end
    if ed_hay_seleccion(d) and ed_elegido_es(d, t, mui_get_value(vb.mayus) != 0)
        ed_escribir(d, mui_get_text(vb.cambio))
    end
    buscar(true)
    redibujar()
end

func cambiar_todo(t: String, nuevo: String, mayus: Bool) -> Int
    d = ed_actual()
    if d == nil
        return 0
    end
    n = ed_cambiar_todo(d, t, nuevo, mayus)
    avisar(hueco(tr(71, "Cambiado %1 veces."), "#{n}"), 2)
    redibujar()
    return n
end

func ir_a(n: Int)
    if n > 0
        ed_ir_a(n, 1)
        redibujar()
    end
end

# --- Preferencias, y lo que se abre al empezar ---

func preferencias_abrir()
    mui_set_text(vp.dashc, dashc())
    mui_set_text(vp.inferencia, env_get("Forja/inferencia"))
    mui_set_text(vp.ejecutables, cajon_ejecutables())
    mui_set_value(vp.recordar, recordar_sesion())
    mui_set_value(vp.pantalla, env_get("Forja/pantalla") == "si")
    mui_set_value(vp.completar, completar_activo)
    mui_set_value(vp.buscar, env_get("Forja/buscar_dash") != "no")
    mui_window_open(vp.window)
end

func recordar_sesion() -> Bool
    return env_get("Forja/recordar") != "no"
end

func preferencias_aplicar(guardar: Bool)
    env_set("Forja/dashc", str_trim(mui_get_text(vp.dashc)), guardar)
    env_set("Forja/inferencia", str_trim(mui_get_text(vp.inferencia)), guardar)
    env_set("Forja/ejecutables", str_trim(mui_get_text(vp.ejecutables)), guardar)
    if mui_get_value(vp.recordar) != 0
        env_set("Forja/recordar", "si", guardar)
    else
        env_set("Forja/recordar", "no", guardar)
    end
    if mui_get_value(vp.pantalla) != 0
        env_set("Forja/pantalla", "si", guardar)
    else
        env_set("Forja/pantalla", "no", guardar)
    end
    completar_activo = mui_get_value(vp.completar) != 0
    if completar_activo
        env_set("Forja/completar", "si", guardar)
    else
        env_set("Forja/completar", "no", guardar)
        cerrar_capas()
        redibujar()
    end
    if mui_get_value(vp.buscar) != 0
        env_set("Forja/buscar_dash", "si", guardar)
    else
        env_set("Forja/buscar_dash", "no", guardar)
    end
    mui_window_close(vp.window)
end

# Al salir: el cajón del proyecto y los ficheros abiertos, para la próxima vez (ENVARC:Forja/sesion, con "|")
func sesion_guardar()
    t = proyecto_cajon
    for d in documentos
        if d.ruta != ""
            t = t + "|" + d.ruta
        end
    end
    env_set("Forja/sesion", t, true)
end

# Al empezar sin fichero: lo de la última vez; false si no había nada
func sesion_abrir() -> Bool
    if not recordar_sesion()
        return false
    end
    partes = str_split(env_get("Forja/sesion"), "|")
    # un fichero de un disco que ya no está (DF0:, otro Work:): sin el requester de "Inserta el volumen", que dejaba
    # Forja esperando al arrancar; se salta
    dos_requesters(false)
    abiertos = 0
    i = 1
    while i < partes.length
        if file_exists(partes[i]) and abrir(partes[i])
            abiertos = abiertos + 1
        end
        i = i + 1
    end
    if partes[0] != "" and file_exists(partes[0])
        proyecto_leer(partes[0])
    elif abiertos > 0
        proyecto_leer(cajon_de(ed_actual().ruta))
    end
    dos_requesters(true)
    return abiertos > 0
end

# --- Inferencia ---

const PUERTO_INFERENCIA = "INFERENCIA.1"

func inferencia_ruta() -> String
    r = env_get("Forja/inferencia")
    if r == ""
        r = "Inferencia"
    end
    return r
end

# Manda a Inferencia el fichero activo (o las líneas elegidas) y la enseña; si no está abierta, la arranca y
# lo manda cuando aparezca su puerto (tic)
func boton_inferencia()
    d = ed_actual()
    if d == nil
        return
    end
    if d.sprite != nil or d.mapa != nil
        avisar(tr(92, "Inferencia lee texto: un sprite no se le puede mandar."), 1)
        return
    end
    ed_lineas_seleccion(d)
    que = d.nombre
    texto = ed_texto(d)
    if ed_hay_seleccion(d)
        que = d.nombre + ", líneas #{ed_sel_desde} a #{ed_sel_hasta}"
        texto = ed_seleccion(d)
    end
    ruta = d.ruta
    if ruta == ""
        ruta = d.nombre
    end
    # "ADJUNTAR título" y el texto en las líneas siguientes: Inferencia no tiene que leerlo de Forja
    inferencia_pendiente = "ADJUNTAR " + que + " (" + ruta + ")\n" + texto
    if not inferencia_mandar()
        if inferencia_espera > 0
            return
        end
        if run_start("Run >NIL: \"" + inferencia_ruta() + "\"", 5000) == 0
            avisar(tr(25, "No se puede arrancar ") + inferencia_ruta() + tr(26, ". Pon su ruta en ENV:Forja/inferencia."), 1)
            return
        end
        avisar(tr(27, "Arrancando Inferencia..."), 0)
        inferencia_espera = 150
        armar_tic(TIC_MS, EV_TIC)
    end
end

# true si Inferencia lo recibió
func inferencia_mandar() -> Bool
    rexx_send(PUERTO_INFERENCIA, inferencia_pendiente)
    if rexx_rc() == -1
        return false
    end
    if rexx_rc() != 0
        avisar(hueco(tr(72, "Inferencia no lo aceptó (RC %1)."), "#{rexx_rc()}"), 1)
    else
        rexx_send(PUERTO_INFERENCIA, "MOSTRAR")
        avisar(tr(28, "Mandado a Inferencia."), 2)
    end
    inferencia_pendiente = ""
    inferencia_espera = 0
    return true
end

# --- El puerto ARexx FORJA.1 ---

# Las palabras de una orden: un argumento entre comillas puede llevar espacios. resto_desde dice desde qué
# argumento (desde 0) se quiere el resto de la línea tal cual, en _resto.
var _resto: String = ""

func _partes(linea: String, resto_desde: Int) -> [String]
    var ps: [String] = []
    _resto = ""
    i = 0
    n = linea.length
    while i < n
        while i < n and linea[i:i + 1] == " "
            i = i + 1
        end
        if i >= n
            break
        end
        if ps.length == resto_desde
            _resto = linea[i:]
            if _resto.length >= 2 and str_starts(_resto, "\"") and str_ends(_resto, "\"")
                _resto = _resto[1:_resto.length - 1]
            end
            return ps
        end
        if linea[i:i + 1] == "\""
            j = str_find_from(linea, "\"", i + 1)
            if j < 0
                j = n
            end
            ps.push(linea[i + 1:j])
            i = j + 1
        else
            j = str_find_from(linea, " ", i)
            if j < 0
                j = n
            end
            ps.push(linea[i:j])
            i = j
        end
    end
    return ps
end

# El documento de esa ruta, abriéndolo si hace falta (nil si no se puede leer)
func _documento(ruta: String) -> Documento
    if not abrir(ruta)
        return nil
    end
    return ed_actual()
end

func orden_rexx(linea: String) -> String
    p = _partes(linea, 99)
    if p.length == 0
        mui_rexx_fail(10)
        return ""
    end
    orden = str_upper(p[0])
    if orden == "ABRIR" and p.length >= 2
        if _documento(p[1]) == nil
            mui_rexx_fail(10)
            return ""
        end
        if p.length >= 3
            ed_ir_a(Int(p[2]), 1)
        end
        redibujar()
        return ""
    elif orden == "ABIERTO" and p.length >= 2
        if ed_buscar_ruta(p[1]) >= 0
            return "1"
        end
        return "0"
    elif orden == "TEXTO" and p.length >= 2
        i = ed_buscar_ruta(p[1])
        if i < 0
            mui_rexx_fail(10)
            return ""
        end
        return ed_texto(documentos[i])
    elif orden == "SELECCION"
        d = ed_actual()
        if d == nil
            mui_rexx_fail(10)
            return ""
        end
        ed_lineas_seleccion(d)
        return d.ruta + "\n#{ed_sel_desde}\n#{ed_sel_hasta}\n" + ed_seleccion(d)
    elif orden == "CAMBIAR"
        p = _partes(linea, 4)
        if p.length < 4
            mui_rexx_fail(10)
            return ""
        end
        d = _documento(p[1])
        if d == nil or not ed_cambiar_lineas(d, Int(p[2]), Int(p[3]), _resto)
            mui_rexx_fail(10)
            return ""
        end
        redibujar()
        return ""
    elif orden == "GUARDAR"
        d = ed_actual()
        if p.length >= 2
            i = ed_buscar_ruta(p[1])
            d = nil
            if i >= 0
                d = documentos[i]
            end
        end
        if d == nil or d.ruta == "" or not guardar_en(d, d.ruta)
            mui_rexx_fail(10)
            return ""
        end
        redibujar()
        return ""
    elif orden == "COMPILAR" or orden == "EJECUTAR"
        if tarea != NADA
            mui_rexx_fail(5)
            return ""
        end
        errores_ultimos = ""
        compilar(orden == "EJECUTAR")
        return ""
    elif orden == "BUSCAR" and p.length >= 2
        # BUSCAR texto: lo elige en el fichero activo y da su línea
        d = ed_actual()
        if d == nil or not ed_buscar(d, p[1], false, true)
            mui_rexx_fail(5)
            return ""
        end
        redibujar()
        return "#{d.cl + 1}"
    elif orden == "CAMBIARTODO" and p.length >= 3
        d = ed_actual()
        if d == nil
            mui_rexx_fail(10)
            return ""
        end
        n = ed_cambiar_todo(d, p[1], p[2], true)
        redibujar()
        return "#{n}"
    elif orden == "IRA" and p.length >= 2
        ed_ir_a(Int(p[1]), 1)
        redibujar()
        return ""
    elif orden == "ESTADO"
        var nombres: [String] = ["libre", "compilando", "ejecutando", "depurando", "git"]
        return nombres[tarea]
    elif orden == "ERRORES"
        return errores_ultimos
    elif orden == "GIT"
        # GIT orden de dashgit (status, add -A, commit -a -m "...", pull, push...): sin esperar; ESTADO da "git"
        # mientras sigue, y SALIDA lo que escribió
        if tarea != NADA
            mui_rexx_fail(5)
            return ""
        end
        resto = str_trim(linea[3:])
        if resto == ""
            mui_rexx_fail(10)
            return ""
        end
        git(resto)
        return ""
    elif orden == "SALIDA"
        return salida_texto(false)
    elif orden == "ACTUALIZAR"
        # lo mismo que el menú: busca una versión nueva de Dash y, si la hay, pregunta si se instala
        act_pedir()
        actualizar_mensajes()
        return ""
    end
    mui_rexx_fail(10)
    return ""
end

# Lo que pide un evento de la ventana (lo que no es salir ni del menú Proyecto). Va aparte de Main para que Main
# no pase de 32 KB: dashc 2.4 estropea un salto corto que tiene que crecer (ver el informe de la rama autocompletar).
func atender(ev: Int)
    if ev == EV_PROYECTO
        en_proyecto()
    elif ev == EV_ACTUALIZAR
        act_pedir()
        actualizar_mensajes()
    elif ev == EV_BUSCAR
        mui_window_open(vb.window)
        mui_set_active(vb.window, vb.texto)
    elif ev == EV_SIGUIENTE or ev == EV_ANTERIOR
        buscar(ev == EV_SIGUIENTE)
    elif ev == EV_CAMBIAR
        cambiar_uno()
    elif ev == EV_TODO_CAMBIAR
        cambiar_todo(mui_get_text(vb.texto), mui_get_text(vb.cambio), mui_get_value(vb.mayus) != 0)
    elif ev == EV_BUSCAR_CERRAR
        mui_window_close(vb.window)
    elif ev == EV_IRA
        mui_set_text(vi.linea, "")
        mui_window_open(vi.window)
        mui_set_active(vi.window, vi.linea)
    elif ev == EV_IR
        ir_a(Int(str_trim(mui_get_text(vi.linea))))
        mui_window_close(vi.window)
    elif ev == EV_IRA_CERRAR
        mui_window_close(vi.window)
    elif ev == EV_GIT_ESTADO
        git("status")
    elif ev == EV_GIT_DIFERENCIAS
        git("diff")
    elif ev == EV_GIT_HISTORIAL
        git("log --oneline -n 30")
    elif ev == EV_GIT_ANADIR
        git("add -A")
    elif ev == EV_GIT_CONFIRMAR
        mui_set_text(vg.mensaje, "")
        mui_window_open(vg.window)
        mui_set_active(vg.window, vg.mensaje)
    elif ev == EV_GIT_MENSAJE
        m = str_trim(mui_get_text(vg.mensaje))
        if m != ""
            mui_window_close(vg.window)
            git("commit -a -m " + entre_comillas(m))
        end
    elif ev == EV_GIT_CERRAR
        mui_window_close(vg.window)
    elif ev == EV_GIT_TRAER
        git("pull")
    elif ev == EV_DEFINICION
        ir_definicion()
    elif ev == EV_VOLVER
        volver()
    elif ev == EV_REFERENCIAS
        referencias()
    elif ev == EV_COMPLETAR
        completar_ahora()
    elif ev == EV_GIT_SUBIR
        git("push")
    elif ev == EV_PREFERENCIAS
        preferencias_abrir()
    elif ev == EV_PREF_GUARDAR or ev == EV_PREF_USAR
        preferencias_aplicar(ev == EV_PREF_GUARDAR)
    elif ev == EV_PREF_CANCELAR
        mui_window_close(vp.window)
    elif ev == EV_SALIDA
        en_salida()
    elif ev == EV_ARRASTRE_SALIDA
        arrastrar_salida()
    elif ev == EV_COPIAR_SALIDA
        copiar_salida(salida_hay_seleccion())
    elif ev == EV_GUARDAR_SALIDA
        guardar_salida()
    elif ev == EV_BARRA_SALIDA
        desde = mui_get_value(v.barra_salida)
        if desde != salida_desde
            salida_ir_a(desde)
            barra_salida_valor = desde
            mui_canvas_redraw(v.salida)
        end
    elif ev == EV_BARRA_PROYECTO and depuracion.length > 0
        desde = mui_get_value(v.barra_proyecto)
        if desde != depuracion_desde
            depuracion_desde = dep_desde_valido(desde)
            barra_proyecto_valor = desde
            mui_canvas_redraw(v.proyecto)
        end
    elif ev == EV_BARRA_PROYECTO
        desde = mui_get_value(v.barra_proyecto)
        if desde != proyecto_desde
            proyecto_desde = proyecto_desde_valido(desde)
            barra_proyecto_valor = desde
            mui_canvas_redraw(v.proyecto)
        end
    elif ev == EV_BARRA_VARIABLES
        dx = mui_get_value(v.barra_variables)
        if dx != depuracion_dx
            depuracion_dx = dep_dx_valido(dx)
            barra_variables_valor = dx
            mui_canvas_redraw(v.proyecto)
        end
    elif ev == EV_ELEGIR_DASHC
        if file_open_dialog(tr(223, "El compilador de Dash"), "#?")
            mui_set_text(vp.dashc, file_fullpath())
        end
    elif ev == EV_ELEGIR_INFERENCIA
        if file_open_dialog(tr(224, "Inferencia"), "#?")
            mui_set_text(vp.inferencia, file_fullpath())
        end
    elif ev == EV_ELEGIR_EJECUTABLES
        # el cajón donde está el diálogo al aceptar (el nombre de fichero no cuenta)
        if file_open_dialog(tr(378, "El cajón de los ejecutables"), "#?")
            mui_set_text(vp.ejecutables, file_get_path())
        end
    elif ev == EV_INFERENCIA
        boton_inferencia()
    elif ev == EV_DEPURAR
        depurar()
    elif ev >= EV_SEGUIR and ev <= EV_PARAR
        orden_depurador(ev)
    elif ev == EV_COMPILAR
        compilar(false)
    elif ev == EV_EJECUTAR
        compilar(true)
    elif ev == EV_TIC
        tic()
    elif ev == EV_VISTA_CERRADA
        dv_cerrar_vista()
    elif ev >= EV_CORTAR and ev <= EV_VISTA
        edicion(ev)
    elif ev == EV_ARRASTRE and ed_actual() != nil and ed_actual().mapa != nil
        mp_resultado(ed_actual(), mp_arrastrar(ed_actual().mapa, mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), mui_canvas_drag(v.editor) == 2))
    elif ev == EV_ARRASTRE and ed_actual() != nil and ed_actual().sprite != nil
        sp_resultado(ed_actual(), sp_arrastrar(ed_actual().sprite, mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), mui_canvas_drag(v.editor) == 2))
    elif ev == EV_ARRASTRE
        if mui_canvas_drag(v.editor) == 1
            ed_arrastrar(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
            redibujar()
        end
    elif ev == EV_BARRA
        d = ed_actual()
        if d != nil and mui_get_value(v.barra) != d.primera
            d.primera = mui_get_value(v.barra)
            barra_valor = d.primera
            mui_canvas_redraw(v.editor)
        end
    end
end

Main
    app = mui_app_begin("Forja", "FORJA")
    if app == 0
        Print "Forja necesita MUI y un 68020 o mejor."
    else
        v = Principal_create()
        vb = Buscar_create()
        vi = IrA_create()
        vp = PrefForja_create()
        vg = GitMensaje_create()
        # en su propia pantalla (preferencia): un clon público del Workbench, que pasa a ser la pública por defecto
        # para que los programas que ejecuta salgan en ella
        if env_get("Forja/pantalla") == "si" and screen_clone_wb(PANTALLA)
            screen_make_default()
            for w in [v.window, vb.window, vi.window, vp.window, vg.window]
                mui_window_screen(w, PANTALLA)
            end
        end
        mui_canvas_on_draw(v.proyecto, dibujar_proyecto)
        mui_canvas_on_draw(v.editor, dibujar_editor)
        mui_canvas_on_draw(v.salida, dibujar_salida)
        bb_crear()
        mui_canvas_on_draw(v.botones, dibujar_botones)
        mui_canvas_on_input(v.botones, EV_BOTONES)
        mui_canvas_on_move(v.botones, EV_BOTONES_MOVER)
        mui_canvas_buffered(v.editor, true)
        mui_canvas_on_input(v.editor, EV_EDITOR)
        mui_canvas_on_drag(v.editor, EV_ARRASTRE)
        mui_canvas_on_input(v.proyecto, EV_PROYECTO)
        mui_canvas_on_input(v.salida, EV_SALIDA)
        mui_canvas_on_drag(v.salida, EV_ARRASTRE_SALIDA)
        mui_canvas_take_tab(v.editor, true)
        # las teclas, al editor aunque el puntero no esté encima (F5, F10... al depurar: lo contó David Martínez)
        mui_canvas_take_keys(v.editor, true)
        # lo que aún no hace nada, apagado
        mui_app_rexx(app, orden_rexx)
        poner_tarea(NADA)
        sonda = env_get("FORJA_SONDA") != ""
        ed_anotar_vistas = sonda
        completar_activo = env_get("Forja/completar") != "no"
        act_iniciar(env_get("Forja/buscar_dash") != "no" and env_get("FORJA_SONDA") == "")

        ruta = env_get("FORJA_PRUEBA")
        if ruta == "" and arg_count() > 0
            ruta = arg(0)
        end
        if ruta != "" and abrir(ruta)
            proyecto_leer(cajon_de(ruta))
        elif not sesion_abrir()
            proyecto_leer(cajon_de(ruta))     # sin fichero: la bienvenida, con el logo de Dash
        end
        salida_anadir(tr(29, "Forja ") + VERSION + ".", 0)
        salida_anadir(tr(31, "Listo."), 2)

        ajustar_paneles()
        mui_set_visible(v.barra_variables, false)     # la de abajo del panel de las variables, solo al depurar
        mui_window_open(v.window)
        abierta = true
        mui_canvas_set_pointer(v.editor, 1)
        ajustar_barra()
        if ed_actual() == nil
            armar_tic(500, EV_TIC)
        elif completar_activo
            # los símbolos del código, en cuanto la ventana esté quieta
            armar_tic(REPOSO_MS, EV_TIC)
        end
        actualizar_armar()
        if sonda
            publicar_sonda()
            escribir_sonda()
            env_set("FORJA_ESTADO", "libre", false)
        end
        while true
            ev = mui_wait_event_signals(dbg_signal())
            if sonda
                sonda_eventos = sonda_eventos + "#{ev}@#{(time_ms() / 100) % 10000}"
                if ev == EV_EDITOR
                    sonda_eventos = sonda_eventos + ":#{mui_canvas_key(v.editor)}/#{mui_canvas_button(v.editor)}q#{mui_canvas_qualifiers(v.editor)}"
                elif ev == EV_ARRASTRE
                    sonda_eventos = sonda_eventos + "d#{mui_canvas_drag(v.editor)}"
                end
                sonda_eventos = sonda_eventos + " "
                sonda_fichero("RAM:forja-eventos.txt", sonda_eventos)
            end
            if ev == 0
                mirar_depuracion()
            end
            if ev == EV_EDITOR
                otro = en_editor()
                if otro != 0
                    ev = otro
                end
            elif ev == EV_BOTONES_MOVER
                if bb_mover(mui_canvas_pointer_x(v.botones), mui_canvas_pointer_inside(v.botones))
                    mui_canvas_redraw(v.botones)
                end
            elif ev == EV_BOTONES
                if mui_canvas_button(v.botones) == 1
                    ev = bb_clic(mui_canvas_mouse_x(v.botones))
                elif mui_canvas_key(v.botones) >= 0
                    ev = tecla_depurador(mui_canvas_key(v.botones))
                end
            elif ev == EV_PROYECTO and mui_canvas_key(v.proyecto) >= 0 and tecla_depurador(mui_canvas_key(v.proyecto)) != 0
                ev = tecla_depurador(mui_canvas_key(v.proyecto))
            elif ev == EV_SALIDA and mui_canvas_key(v.salida) >= 0 and tecla_depurador(mui_canvas_key(v.salida)) != 0
                ev = tecla_depurador(mui_canvas_key(v.salida))
            end
            if ev == -1
                ev = EV_SALIR
            end
            if ev == EV_SALIR or (ev >= EV_NUEVO and ev <= EV_CERRAR) or ev == EV_NUEVO_SPRITE
                if proyecto(ev)
                    sesion_guardar()
                    break
                end
            end
            atender(ev)
            ajustar_barra()
            ajustar_barras_paneles()
            if ed_actual() == nil and not tic_armado
                armar_tic(500, EV_TIC)
            end
            # la vista animada del sprite: el tic la avanza (un fotograma por tic, o menos si va lenta)
            if ed_actual() != nil and ed_actual().sprite != nil and ed_actual().sprite.reproduciendo and not tic_armado
                armar_tic(sp_intervalo(ed_actual().sprite), EV_TIC)
            end
            actualizar_armar()
            if sonda
                publicar_sonda()
                # para las pruebas: abre las preferencias (la simulación del menú no llega a ellas)
                if env_get("FORJA_PREFERENCIAS") != ""
                    env_set("FORJA_PREFERENCIAS", "", false)
                    preferencias_abrir()
                end
            end
        end
        mui_app_end()
        screen_close()
    end
end
