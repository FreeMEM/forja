# Forja: el entorno de desarrollo de Dash en el Amiga.
#
# La ventana (ventana.dashui): botones arriba; el proyecto a la izquierda; el editor con sus pestañas; la salida
# abajo. Los paneles se dibujan en lienzos con el tema oscuro (tema.dash).
#
#   Forja [fichero]      # sin fichero, uno nuevo
#
# El teclado va al editor cuando el puntero está encima. Flechas; con Mayúsculas seleccionan; Alt: principio y
# final de línea, página arriba y abajo; Ctrl: de palabra en palabra, principio y final del texto. Los atajos con
# Amiga son los del menú, también sobre el editor.
#
# Cerrar una pestaña o salir con cambios sin guardar avisa en la salida y pide la misma orden otra vez.
#
# Para las pruebas: ENV:FORJA_PRUEBA con un fichero lo abre al empezar. Con ENV:FORJA_SONDA, para un programa que
# hace de usuario (tests/teclas.dash, tests/ficheros.dash): ENV:FORJA_EDITOR dice dónde está el editor ("x y
# ancho alto" desde la esquina de la ventana), ENV:FORJA_PROYECTO dónde empiezan las filas del proyecto ("x y
# alto de fila"), ENV:FORJA_PESTANAS los centros de las pestañas ("x,y x,y...") y RAM:forja-sonda.txt lleva,
# tras cada cambio, "línea columna nombre" y el texto.

import "tema.dash"
import "editor.dash"
import "paneles.dash"
import "ventana.dashui"

const VERSION = "0.1"

const EV_COMPILAR = 10
const EV_EJECUTAR = 11
const EV_INFERENCIA = 19
const EV_BARRA = 3
const EV_EDITOR = 4
const EV_ARRASTRE = 5
const EV_PROYECTO = 6
const EV_NUEVO = 30
const EV_ABRIR = 31
const EV_GUARDAR = 32
const EV_GUARDAR_COMO = 33
const EV_CERRAR = 34
const EV_CORTAR = 40
const EV_COPIAR = 41
const EV_PEGAR = 42
const EV_DESHACER = 43
const EV_REHACER = 44
const EV_TODO = 45
const EV_SALIR = 99

const NUEVO = "# Un programa de Dash\n\nMain\n    Print \"Hola, Amiga\"\nend\n"

var v: Principal = nil
var sonda: Bool = false
var sonda_editor: String = ""
var barra_total: Int = -1
var barra_visibles: Int = -1
var barra_valor: Int = -1
var sonda_proyecto: String = ""
var sonda_pestanas: String = ""
# Cerrar o salir con cambios sin guardar pide la misma orden otra vez seguida
var pendiente: Int = 0
var abierta: Bool = false

func dibujar_proyecto(x: Int, y: Int, ancho: Int, alto: Int)
    proyecto_dibujar(x, y, ancho, alto)
end

func dibujar_editor(x: Int, y: Int, ancho: Int, alto: Int)
    ed_dibujar(x, y, ancho, alto)
end

func dibujar_salida(x: Int, y: Int, ancho: Int, alto: Int)
    salida_dibujar(x, y, ancho, alto)
end

func avisar(texto: String, tipo: Int)
    salida_anadir(texto, tipo)
    if abierta
        mui_canvas_redraw(v.salida)
    end
end

func nombre_de(ruta: String) -> String
    nombre = ruta
    for sep in [":", "/"]
        p = str_find(nombre, sep)
        while p >= 0
            nombre = nombre[p + 1:]
            p = str_find(nombre, sep)
        end
    end
    return nombre
end

# Abre un fichero en una pestaña nueva, o va a la suya si ya está abierto
func abrir(ruta: String) -> Bool
    i = ed_buscar_ruta(ruta)
    if i >= 0
        activo = i
        return true
    end
    texto = file_read_text(ruta)
    if texto == nil
        avisar("No se puede leer " + ruta, 1)
        return false
    end
    ed_abrir_texto(nombre_de(ruta), ruta, texto)
    return true
end

func guardar_en(d: Documento, ruta: String) -> Bool
    if not file_write_text(ruta, ed_texto_disco(d))
        avisar("No se puede escribir " + ruta, 1)
        return false
    end
    d.ruta = ruta
    d.nombre = nombre_de(ruta)
    d.cambiado = false
    avisar("Guardado: " + ruta, 2)
    if cajon_de(ruta) == proyecto_cajon
        proyecto_leer(proyecto_cajon)
        mui_canvas_redraw(v.proyecto)
    end
    return true
end

func guardar_como(d: Documento) -> Bool
    if not file_save_dialog("Guardar " + d.nombre, "#?.(dash|dashui)")
        return false
    end
    return guardar_en(d, file_fullpath())
end

func guardar(d: Documento) -> Bool
    if d.ruta == ""
        return guardar_como(d)
    end
    return guardar_en(d, d.ruta)
end

func cambiados() -> Int
    n = 0
    for d in documentos
        if d.cambiado
            n = n + 1
        end
    end
    return n
end

# Las órdenes del menú Proyecto. Devuelve true si hay que salir.
func proyecto(ev: Int) -> Bool
    d = ed_actual()
    repetida = pendiente == ev
    pendiente = 0
    if ev == EV_NUEVO
        ed_abrir_texto("sin nombre.dash", "", NUEVO)
    elif ev == EV_ABRIR
        if file_open_dialog("Abrir", "#?.(dash|dashui)")
            ruta = file_fullpath()
            if abrir(ruta) and cajon_de(ruta) != proyecto_cajon
                proyecto_leer(cajon_de(ruta))
                mui_canvas_redraw(v.proyecto)
            end
        end
    elif ev == EV_GUARDAR and d != nil
        guardar(d)
    elif ev == EV_GUARDAR_COMO and d != nil
        guardar_como(d)
    elif ev == EV_CERRAR and d != nil
        if d.cambiado and not repetida
            avisar(d.nombre + " tiene cambios sin guardar. Amiga-W otra vez la cierra sin guardarlos.", 1)
            pendiente = ev
            return false
        end
        ed_cerrar(activo)
        if documentos.length == 0
            ed_abrir_texto("sin nombre.dash", "", NUEVO)
        end
    elif ev == EV_SALIR
        n = cambiados()
        if n > 0 and not repetida
            avisar("Hay #{n} ficheros con cambios sin guardar. Amiga-Q otra vez sale sin guardarlos.", 1)
            pendiente = ev
            return false
        end
        return true
    end
    redibujar()
    return false
end

# Un clic en el panel del proyecto: un fichero se abre; un cajón se enseña
func en_proyecto()
    if mui_canvas_button(v.proyecto) != 1
        return
    end
    i = proyecto_en(mui_canvas_mouse_y(v.proyecto))
    if i < 0
        return
    end
    f = proyecto_ficheros[i]
    if f == "/"
        proyecto_leer(cajon_de(proyecto_cajon))
    elif str_ends(f, "/")
        proyecto_leer(ruta_unir(proyecto_cajon, f[0:f.length - 1]))
    else
        if abrir(ruta_unir(proyecto_cajon, f))
            redibujar()
        end
        return
    end
    mui_canvas_redraw(v.proyecto)
end

# La barra sigue al editor
func ajustar_barra()
    d = ed_actual()
    if d == nil
        return
    end
    if d.lineas.length != barra_total or ed_visibles != barra_visibles
        barra_total = d.lineas.length
        barra_visibles = ed_visibles
        mui_set_range(v.barra, barra_total, barra_visibles)
        barra_valor = -1
    end
    if d.primera != barra_valor
        barra_valor = d.primera
        mui_set_value(v.barra, d.primera)
    end
end

func redibujar()
    mui_canvas_redraw(v.editor)
    ajustar_barra()
    escribir_sonda()
end

func redibujar_linea(n: Int)
    d = ed_actual()
    fy = ed_fila_y(d, n)
    if fy < 0
        redibujar()
        return
    end
    ed_solo_linea = n
    mui_canvas_update_area(v.editor, 0, fy, ed_zona_ancho, ed_alto_fila)
    ed_solo_linea = -1
    escribir_sonda()
end

func escribir_sonda()
    if sonda
        d = ed_actual()
        file_write_text("RAM:forja-sonda.txt", "#{d.cl} #{d.cc} " + d.nombre + "\n" + ed_texto(d))
        env_set("FORJA_DIBUJO", "#{ed_ms_dibujo}", false)
    end
end

# Las órdenes del menú Edición (también con Amiga sobre el editor)
func edicion(ev: Int)
    d = ed_actual()
    if d == nil
        return
    end
    if ev == EV_CORTAR or ev == EV_COPIAR
        s = ed_seleccion(d)
        if s != ""
            clip_write_text(latin1_to_utf8(s))
            if ev == EV_CORTAR
                ed_borrar_seleccion(d)
            end
        end
    elif ev == EV_PEGAR
        t = str_replace(utf8_to_latin1(clip_read_text()), "\r\n", "\n")
        if t != ""
            ed_escribir(d, str_replace(t, "\t", "    "))
        end
    elif ev == EV_DESHACER
        ed_deshacer(d)
    elif ev == EV_REHACER
        ed_rehacer(d)
    elif ev == EV_TODO
        ed_seleccionar_todo(d)
    end
    ed_seguir_cursor(d)
    redibujar()
end

# Amiga + letra sobre el editor: el evento de su opción del menú (0 si no es ninguna)
func atajo(letra: String) -> Int
    var letras: [String] = ["x", "c", "v", "z", "r", "a", "q", "n", "o", "s", "w"]
    var eventos: [Int] = [EV_CORTAR, EV_COPIAR, EV_PEGAR, EV_DESHACER, EV_REHACER, EV_TODO, EV_SALIR, EV_NUEVO, EV_ABRIR, EV_GUARDAR, EV_CERRAR]
    l = str_lower(letra)
    i = 0
    while i < letras.length
        if letras[i] == l
            return eventos[i]
        end
        i = i + 1
    end
    return 0
end

# Lo que pasa sobre el editor: un clic, la rueda o una tecla. Devuelve otro evento si es un atajo.
func en_editor() -> Int
    d = ed_actual()
    if d == nil
        return 0
    end
    rueda = mui_canvas_wheel(v.editor)
    teclas = mui_canvas_qualifiers(v.editor)
    if rueda != 0
        d.primera = d.primera - rueda * 3
        maximo = d.lineas.length - ed_visibles
        if d.primera > maximo
            d.primera = maximo
        end
        if d.primera < 0
            d.primera = 0
        end
        redibujar()
    elif mui_canvas_button(v.editor) == 1 and ed_pestana_en(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor)) >= 0
        activo = ed_pestana_en(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
        redibujar()
    elif mui_canvas_button(v.editor) == 1
        ed_clic(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), (teclas & Q_MAYUS) != 0)
        redibujar()
    else
        codigo = mui_canvas_key(v.editor)
        if codigo < 0
            return 0
        end
        letra = mui_canvas_char(v.editor)
        if (teclas & Q_AMIGA) != 0
            return atajo(letra)
        end
        # escribir dentro de una línea solo redibuja esa línea
        antes_lineas = d.lineas.length
        antes_cl = d.cl
        antes_primera = d.primera
        antes_izquierda = d.izquierda
        antes_cambiado = d.cambiado
        antes_sel = ed_hay_seleccion(d)
        if ed_tecla(codigo, teclas, letra)
            if d.lineas.length == antes_lineas and d.cl == antes_cl and d.primera == antes_primera and d.izquierda == antes_izquierda and antes_cambiado and not antes_sel and not ed_hay_seleccion(d)
                redibujar_linea(d.cl)
            else
                redibujar()
            end
        end
    end
    return 0
end

func publicar_sonda()
    e = "#{ed_zona_x} #{ed_zona_y} #{ed_zona_ancho} #{ed_zona_alto}"
    if e != sonda_editor
        sonda_editor = e
        env_set("FORJA_EDITOR", e, false)
    end
    p = "#{proyecto_zona_x} #{proyecto_zona_y + proyecto_y0} #{proyecto_fila}"
    if p != sonda_proyecto
        sonda_proyecto = p
        env_set("FORJA_PROYECTO", p, false)
    end
    t = ed_pestanas_ventana()
    if t != sonda_pestanas
        sonda_pestanas = t
        env_set("FORJA_PESTANAS", t, false)
    end
end

Main
    if mui_app_begin("Forja", "FORJA") == 0
        Print "Forja necesita MUI y un 68020 o mejor."
    else
        v = Principal_create()
        mui_canvas_on_draw(v.proyecto, dibujar_proyecto)
        mui_canvas_on_draw(v.editor, dibujar_editor)
        mui_canvas_on_draw(v.salida, dibujar_salida)
        mui_canvas_buffered(v.editor, true)
        mui_canvas_on_input(v.editor, EV_EDITOR)
        mui_canvas_on_drag(v.editor, EV_ARRASTRE)
        mui_canvas_on_input(v.proyecto, EV_PROYECTO)
        mui_canvas_take_tab(v.editor, true)
        # lo que aún no hace nada, apagado
        for b in [v.compilar, v.ejecutar, v.depurar, v.inferencia]
            mui_set_enabled(b, false)
        end
        sonda = env_get("FORJA_SONDA") != ""

        ruta = env_get("FORJA_PRUEBA")
        if ruta == "" and arg_count() > 0
            ruta = arg(0)
        end
        if ruta == "" or not abrir(ruta)
            ed_abrir_texto("sin nombre.dash", "", NUEVO)
        end
        proyecto_leer(cajon_de(ruta))
        salida_anadir("Forja " + VERSION + ", con Dash 2.0.", 0)
        salida_anadir("Listo.", 2)

        mui_window_open(v.window)
        abierta = true
        mui_canvas_set_pointer(v.editor, 1)
        ajustar_barra()
        if sonda
            publicar_sonda()
        end
        while true
            ev = mui_wait_event()
            if ev == EV_EDITOR
                otro = en_editor()
                if otro != 0
                    ev = otro
                end
            end
            if ev == -1
                ev = EV_SALIR
            end
            if ev == EV_SALIR or (ev >= EV_NUEVO and ev <= EV_CERRAR)
                if proyecto(ev)
                    break
                end
            elif ev != EV_EDITOR
                pendiente = 0
            end
            if ev == EV_PROYECTO
                en_proyecto()
            elif ev >= EV_CORTAR and ev <= EV_TODO
                edicion(ev)
            elif ev == EV_ARRASTRE
                if mui_canvas_drag(v.editor) == 1
                    ed_arrastrar(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
                    redibujar()
                end
            elif ev == EV_BARRA
                d = ed_actual()
                if d != nil and mui_get_value(v.barra) != d.primera
                    d.primera = mui_get_value(v.barra)
                    barra_valor = d.primera
                    mui_canvas_redraw(v.editor)
                end
            end
            ajustar_barra()
            if sonda
                publicar_sonda()
            end
        end
        mui_app_end()
    end
end
