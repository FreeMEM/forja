func dibujar_proyecto(x: Int, y: Int, ancho: Int, alto: Int)
    proyecto_dibujar(x, y, ancho, alto)
end

func dibujar_editor(x: Int, y: Int, ancho: Int, alto: Int)
    ed_dibujar(x, y, ancho, alto)
    # la lista rápida (esquema, abrir por nombre), encima de todo
    lr_dibujar(x, y, ancho, alto)
end

func dibujar_botones(x: Int, y: Int, ancho: Int, alto: Int)
    bb_dibujar(x, y, ancho, alto)
end

func dibujar_salida(x: Int, y: Int, ancho: Int, alto: Int)
    salida_dibujar(x, y, ancho, alto)
end

func avisar(texto: String, tipo: Int)
    salida_anadir(texto, tipo)
    if abierta
        mui_canvas_redraw(v.salida)
    end
end

func nombre_de(ruta: String) -> String
    nombre = ruta
    for sep in [":", "/"]
        p = str_find(nombre, sep)
        while p >= 0
            nombre = nombre[p + 1:]
            p = str_find(nombre, sep)
        end
    end
    return nombre
end

# Abre un fichero en una pestaña nueva, o va a la suya si ya está abierto. Uno de los tipos de una extensión (una
# imagen IFF, un mapa) se lo pasa a ella (EDITAR).
func abrir(ruta: String) -> Bool
    abrir_delegado = false
    if str_ends(str_lower(ruta), ".forja")
        # un proyecto: el panel y su fichero principal
        return proyecto_abrir(ruta, true)
    end
    i = ed_buscar_ruta(ruta)
    if i >= 0
        activo = i
        return true
    end
    # un tipo de fichero de una extensión: lo abre ella (EDITAR)
    e = ext_para_fichero(ruta)
    if e >= 0
        ext_editar(e, ruta)
        abrir_delegado = true
        return false
    end
    if not abrir_nuevo(ruta)
        return false
    end
    ext_suceso("ABIERTO", ruta)
    return true
end

# ¿Empieza por FORM, como un IFF (una imagen ILBM, un mapa FMAP)?
func es_iff(ruta: String) -> Bool
    fh = file_open(ruta, 1005)
    if fh == 0
        return false
    end
    ok = file_read_byte(fh) == 70 and file_read_byte(fh) == 79 and file_read_byte(fh) == 82 and file_read_byte(fh) == 77
    file_close(fh)
    return ok
end

func abrir_nuevo(ruta: String) -> Bool
    l = str_lower(ruta)
    if not str_ends(l, ".dash") and not str_ends(l, ".dashui") and es_iff(ruta)
        # una imagen, un mapa...: los abren las extensiones (Sprites, Mapas) por el final de su nombre
        avisar(hueco(tr(640, "%1 es un fichero IFF: lo abre una extensión (como Sprites o Mapas), y no hay ninguna activa para él."), nombre_de(ruta)), 1)
        return false
    end
    texto = file_read_text(ruta)
    if texto == nil
        avisar(tr(1, "No se puede leer ") + ruta, 1)
        return false
    end
    ed_abrir_texto(nombre_de(ruta), ruta, texto)
    # sus puntos de parada (los del proyecto, con su condición)
    d = ed_actual()
    d.puntos = pr_lineas_de(ruta)
    return true
end

func guardar_en(d: Documento, ruta: String) -> Bool
    if not file_write_text(ruta, ed_texto_disco(d))
        avisar(tr(2, "No se puede escribir ") + ruta, 1)
        return false
    end
    # los puntos de parada que se movieron al escribir, al .forja (con el fichero ya como dicen)
    puntos_seguir()
    if str_lower(d.ruta) != str_lower(ruta)
        # Guardar como: los puntos (con su condición) pasan a la ruta nueva, también en el .forja
        pr_puntos_mover(d.ruta, ruta, d.puntos)
        puntos_raros_al_dia()
        puntos_por_guardar = true
        if proy != nil and d.ruta != "" and pr_dentro(proy, d.ruta)
            # (salen del proyecto: el .forja sin ellos aunque la ruta nueva sea de fuera)
            proyecto_guardar()
        end
    end
    d.ruta = ruta
    d.nombre = nombre_de(ruta)
    d.cambiado = false
    pr_puntos_guardados(ruta)
    if puntos_por_guardar and proyecto_de(ruta) != nil
        puntos_por_guardar = false
        proyecto_guardar()
    end
    avisar(tr(3, "Guardado: ") + ruta, 2)
    ext_suceso("GUARDADO", ruta)
    # sus errores, con dash --check en segundo plano (paso 3.5)
    comprobar_pedir(d, false)
    if cajon_de(ruta) == proyecto_cajon
        proyecto_leer(proyecto_cajon)
        mui_canvas_redraw(v.proyecto)
    end
    return true
end

func guardar_como(d: Documento) -> Bool
    if not file_save_dialog(tr(458, "Guardar ") + d.nombre, "#?.(dash|dashui)")
        return false
    end
    return guardar_en(d, file_fullpath())
end

func guardar(d: Documento) -> Bool
    if d.ruta == ""
        return guardar_como(d)
    end
    return guardar_en(d, d.ruta)
end

func cambiados() -> Int
    n = 0
    for d in documentos
        if d.cambiado
            n = n + 1
        end
    end
    return n
end

# Amiga-B: un fichero nuevo de los que hacen las extensiones (nuevo = en su manifiesto: un sprite, un BOB, un
# mapa...). La petición enseña la descripción de cada uno y un botón por cada uno; NUEVO orden a la que lo hace.
func nuevo_de_extension()
    ns = ext_nuevos()
    if ns.length == 0
        avisar(tr(642, "Ninguna extensión activa hace ficheros nuevos (como Sprites o Mapas)."), 1)
        return
    end
    texto = tr(645, "¿Qué vas a hacer?") + "\n"
    botones = ""
    for n in ns
        p = str_split(n, "|")
        texto = texto + "\n" + str_replace(p[1], "_", "") + ": " + p[3]
        botones = botones + p[1] + "|"
    end
    r = mui_request(v.window, tr(644, "Nuevo"), texto, botones + tr(643, "_Cancelar"))
    if r >= 1 and r <= ns.length
        p = str_split(ns[r - 1], "|")
        ext_nuevo(Int(p[0]), p[2])
    end
end

# Las órdenes del menú Proyecto. Devuelve true si hay que salir.
func proyecto(ev: Int) -> Bool
    d = ed_actual()
    if ev == EV_NUEVO
        ed_abrir_texto("sin nombre.dash", "", NUEVO)
    elif ev == EV_NUEVO_EXT
        nuevo_de_extension()
    elif ev == EV_ABRIR
        if file_open_dialog(tr(303, "Abrir..."), "#?.(" + ext_patron_tipos("dash|dashui|forja") + ")")
            ruta = file_fullpath()
            if abrir(ruta) and cajon_de(ruta) != proyecto_cajon
                proyecto_leer(cajon_de(ruta))
                mui_canvas_redraw(v.proyecto)
            end
        end
    elif (ev == EV_GUARDAR or ev == EV_GUARDAR_COMO) and d != nil and d.vista != 0
        avisar(tr(464, "Esta pestaña es de solo lectura."), 1)
    elif ev == EV_GUARDAR and d != nil
        guardar(d)
    elif ev == EV_GUARDAR_COMO and d != nil
        guardar_como(d)
    elif ev == EV_CERRAR and d != nil
        if d.cambiado
            r = mui_request(v.window, tr(63, "Cambios sin guardar"), d.nombre + tr(4, " tiene cambios sin guardar."), tr(5, "_Guardar|_Descartar|_Cancelar"))
            if r == 0 or (r == 1 and not guardar(d))
                return false
            end
            if r == 2
                puntos_descartar(d)
            end
        end
        cerrada = d.ruta
        if cerrada == ""
            cerrada = d.nombre
        end
        ed_cerrar(activo)
        ext_suceso("CERRADO", cerrada)
    elif ev == EV_SALIR
        n = cambiados() + ext_sin_guardar().length
        if n > 0
            texto = hueco(tr(452, "Hay %1 ficheros con cambios sin guardar."), "#{n}")
            if n == 1
                texto = tr(453, "Hay un fichero con cambios sin guardar.")
            end
            r = mui_request(v.window, tr(63, "Cambios sin guardar"), texto, tr(6, "_Guardar|_Descartar|_Cancelar"))
            if r == 0
                return false
            end
            if r == 2
                for o in documentos
                    if o.cambiado
                        puntos_descartar(o)
                    end
                end
            end
            if r == 1
                for o in documentos
                    if o.cambiado and not guardar(o)
                        return false
                    end
                end
                # los de las extensiones (un sprite, un mapa): GUARDAR a cada una, y se espera a que digan que ya
                if not ext_guardar_todo()
                    avisar(tr(641, "Una extensión no ha guardado sus ficheros: Forja sigue abierta."), 1)
                    return false
                end
            end
        end
        return parar_al_salir()
    end
    redibujar()
    return false
end

# --- Compilar y ejecutar ---

# El compilador: ENV:Forja/dashc (lo escribe el instalador de Dash), o DASH:dash, o el dash del cajón de encima del de
# Forja (Dash/Forja/Forja: Dash/dash, sin necesitar la asignación DASH:, idea de Tolkien), o la orden dash del camino
# de órdenes
func dashc() -> String
    return programa_de_dash("Forja/dashc", "dash")
end

func programa_de_dash(variable: String, orden: String) -> String
    c = env_get(variable)
    if c != ""
        return c
    end
    # sin peticiones: sin la asignación DASH:, el Amiga pediría que se inserte ese volumen y Forja se quedaría
    # esperando detrás (quien llame no debe tenerlas ya quitadas: dos_requesters(true) las vuelve a poner)
    dos_requesters(false)
    c = orden
    if file_exists("DASH:" + orden)
        c = "DASH:" + orden     # el cajón que deja el instalador de Dash
    elif file_exists("PROGDIR:/" + orden)
        r = file_real_path("PROGDIR:/" + orden)   # (la ruta entera: PROGDIR: es de cada proceso)
        if r != ""
            c = r
        end
    end
    dos_requesters(true)
    return c
end

# Un texto entre comillas para el Shell del Amiga (las comillas de dentro van como *")
func entre_comillas(t: String) -> String
    return "\"" + str_replace(str_replace(t, "*", "**"), "\"", "*\"") + "\""
end

# "main.dash" -> "main", al lado del .dash o en el cajón de las preferencias (ENV:Forja/ejecutables)
func ejecutable_de(ruta: String) -> String
    return en_cajon(cajon_ejecutables(), sin_dash(ruta))
end

func sin_dash(ruta: String) -> String
    if str_ends(str_lower(ruta), ".dash")
        return ruta[0:ruta.length - 5]
    end
    return ruta + ".exe"
end

# El fichero en ese cajón ("": donde está); "RAM:" + "Work:Juego/main" -> "RAM:main"
func en_cajon(cajon: String, ruta: String) -> String
    if cajon == ""
        return ruta
    end
    if str_ends(cajon, ":") or str_ends(cajon, "/")
        return cajon + nombre_de(ruta)
    end
    return cajon + "/" + nombre_de(ruta)
end

# Lo que se ejecuta o depura arranca en el cajón del .dash (el proceso nuevo copia el cajón actual de Forja): así
# encuentra sus ficheros con ruta relativa aunque el ejecutable esté en otro cajón (Ejecutables en:). Devuelve el
# cajón de antes, para volver a él
func al_cajon_del_programa() -> String
    antes = dir_current()
    cajon = cajon_de(tarea_dash)
    if cajon == "" or antes == "" or not dir_change(cajon)
        return ""
    end
    return antes
end

func volver_al_cajon(antes: String)
    if antes != ""
        dir_change(antes)
    end
end

func cajon_ejecutables() -> String
    return str_trim(env_get("Forja/ejecutables"))
end

# El cajón de los ejecutables existe o se crea (sin peticiones: un volumen que no está no deja Forja esperando)
func cajon_listo(cajon: String) -> Bool
    if cajon == ""
        return true
    end
    dos_requesters(false)
    listo = file_exists(cajon) or dir_create(cajon)
    dos_requesters(true)
    return listo
end

func segundos(ms: Int) -> String
    return "#{ms / 1000},#{(ms % 1000) / 100} s"
end

func poner_tarea(t: Int)
    tarea = t
    # la barra de botones (botones.dash): los que no valen ahora, en gris
    cambio = bb_poner(EV_COMPILAR, t == NADA)
    cambio = bb_poner(EV_EJECUTAR, t == NADA or t == EJECUTANDO) or cambio
    cambio = bb_poner(EV_DEPURAR, t == NADA) or cambio
    for ev in [EV_SEGUIR, EV_PASO, EV_ENTRAR, EV_SALIR_FUNCION, EV_PARAR]
        cambio = bb_poner(ev, t == DEPURANDO) or cambio
    end
    cambio = bb_ejecutando(t == EJECUTANDO) or cambio
    if cambio and abierta
        mui_canvas_redraw(v.botones)
    end
    if sonda
        var nombres: [String] = ["libre", "compilando", "ejecutando", "depurando"]
        env_set("FORJA_ESTADO", nombres[t], false)
    end
end

var parar_pedido: Int = 0        # cuándo se pulsó Parar (time_ms), 0 si no
var parar_avisado: Bool = false

# Al salir con un programa en marcha: se para antes (el depurado, con dbg_end; el ejecutado, con Ctrl-C). Si no
# para en 3 s, se pregunta: Forja no puede acabar hasta que acabe él (su proceso corre con el código de Forja).
# false si no hay que salir.
func parar_al_salir() -> Bool
    if tarea == DEPURANDO
        dbg_end(3000)
        return true
    end
    if tarea != EJECUTANDO
        return true
    end
    run_break(tarea_run)
    n = 0
    while n < 60 and not run_ready(tarea_run)
        time_delay(5)
        n = n + 1
    end
    if run_ready(tarea_run)
        return true
    end
    r = mui_request(v.window, tr(455, "El programa sigue en marcha"), tr(456, "Forja se cerrará cuando acabe. Si tiene ventana, ciérrala."), tr(457, "_Salir|_No salir"))
    return r == 1
end

func compilar(y_ejecutar: Bool)
    if tarea == EJECUTANDO
        run_break(tarea_run)
        if parar_pedido == 0
            parar_pedido = time_ms()
        end
        return
    end
    if tarea != NADA
        return
    end
    d = ed_actual()
    desde = compilar_desde
    compilar_desde = ""
    ruta = ""
    if desde != ""
        # COMPILAR fichero (de una extensión: un sprite, un mapa): el programa de su cajón, abierto o no
        ruta = programa_de_ruta(desde)
        if ruta == ""
            avisar(tr(91, "Para compilar, abre el .dash del programa."), 1)
            return
        end
        d = nil
        k = ed_buscar_ruta(ruta)
        if k >= 0
            d = documentos[k]
        end
    elif d == nil
        return
    elif d.ruta == "" and d.temporal == "" and not guardar_como(d)
        return
    end
    # lo que haya sin guardar va al disco antes (dashc lee los ficheros)
    for o in documentos
        if o.cambiado and o.ruta != ""
            guardar_en(o, o.ruta)
        end
    end
    # una comprobación en marcha (dash --check, paso 3.5) es de los ficheros de antes: si acabara tras compilar, su
    # resultado quitaría los errores de compilar (o pondría otros ya viejos), y "Sin errores." movería la salida. Se
    # para; lo que se acaba de guardar se comprueba después de compilar.
    if cmp_en_marcha()
        cmp_parar()
    end
    redibujar()
    # un módulo (sin Main) no es un programa: se compila el de su proyecto
    if desde == ""
        ruta = programa_de(d)
    end
    # con un .forja (paso 3.1): su fichero principal, su ejecutable y sus opciones
    tarea_proy = nil
    if desde != ""
        tarea_proy = proyecto_de(desde)
    elif d.ruta != ""
        tarea_proy = proyecto_de(d.ruta)
    end
    if tarea_proy != nil and file_exists(pr_principal(tarea_proy))
        ruta = pr_principal(tarea_proy)
    else
        tarea_proy = nil
    end
    nombre = nombre_de(ruta)
    tarea_exe = ejecutable_de(ruta)
    if tarea_proy != nil
        tarea_exe = pr_ejecutable(tarea_proy, cajon_ejecutables())
    end
    if desde == "" and d.ruta == ""
        # un ejemplo de la ayuda (Probar), sin nombre: desde T:, y su ejecutable ahí
        if not file_write_text(d.temporal, ed_texto_disco(d))
            avisar(tr(2, "No se puede escribir ") + d.temporal, 1)
            return
        end
        ruta = d.temporal
        nombre = d.nombre
        tarea_exe = sin_dash(ruta)
    end
    tarea_dash = ruta
    if (desde != "" or d.ruta != "") and not cajon_listo(cajon_ejecutables())
        avisar(tr(377, "No se puede crear el cajón de los ejecutables: ") + cajon_ejecutables(), 1)
        return
    end
    opciones = pr_opciones(tarea_proy, perfil_pedido, memcheck_pedido)
    tarea_perfil = str_contains(opciones, "--profile")
    tarea_memcheck = str_contains(opciones, "--memcheck")
    perfil_pedido = false
    memcheck_pedido = false
    if depurar_despues
        opciones = opciones + " --debug"
    end
    orden = dashc() + opciones + " \"" + ruta + "\" -o \"" + tarea_exe + "\""
    avisar(tr(9, "Compilando ") + nombre + "...", 0)
    tarea_run = run_start(orden, ESPERA_DASHC)
    if tarea_run == 0
        avisar(tr(10, "No se puede ejecutar ") + dashc() + tr(11, ". Pon su ruta en ENV:Forja/dashc."), 1)
        return
    end
    ejecutar_despues = y_ejecutar
    tarea_inicio = time_ms()
    poner_tarea(COMPILANDO)
    armar_tic(TIC_MS, EV_TIC)
end

# true si el código tiene Main (es un programa, no un módulo que importa otro)
func tiene_main(lineas: [String]) -> Bool
    for l in lineas
        if str_starts(l, "Main") and (l.length == 4 or str_code(l, 4) == 32 or str_code(l, 4) == 35 or str_code(l, 4) == 9)
            return true
        end
    end
    return false
end

# Lo que se compila desde un documento: él mismo si tiene Main; si es un módulo, el programa de su proyecto (un
# .dash abierto con Main de su cajón o del de encima; si no, el main.dash de esos cajones o del proyecto). Antes se
# compilaba el módulo solo, y fallaba.
func programa_de(d: Documento) -> String
    if not str_ends(str_lower(d.ruta), ".dash") and not str_ends(str_lower(d.ruta), ".dashui")
        return d.ruta
    end
    if str_ends(str_lower(d.ruta), ".dash") and tiene_main(d.lineas)
        return d.ruta
    end
    r = programa_de_ruta(d.ruta)
    if r == ""
        return d.ruta
    end
    return r
end

# El programa de un fichero que no lo es (un módulo, un sprite, un mapa): un .dash abierto con Main de su cajón o del
# de encima; si no, el main.dash de esos cajones o del proyecto; si no, el primer .dash abierto con Main. "" si nada.
func programa_de_ruta(ruta: String) -> String
    cajon = cajon_de(ruta)
    var cajones: [String] = [cajon]
    if cajon_de(cajon) != "" and cajon_de(cajon) != cajon
        cajones.push(cajon_de(cajon))
    end
    if proyecto_cajon != "" and proyecto_cajon != cajon
        cajones.push(proyecto_cajon)
    end
    for c in cajones
        for o in documentos
            if o.ruta != "" and str_lower(cajon_de(o.ruta)) == str_lower(c) and str_ends(str_lower(o.ruta), ".dash") and tiene_main(o.lineas)
                return o.ruta
            end
        end
        m = ruta_unir(c, "main.dash")
        if file_exists(m)
            return m
        end
    end
    for o in documentos
        if o.ruta != "" and str_ends(str_lower(o.ruta), ".dash") and tiene_main(o.lineas)
            return o.ruta
        end
    end
    return ""
end

# El único temporizador de MUI: uno nuevo cancela el anterior, así que todo lo que espera pasa por tic()
# Las versiones nuevas de Dash (actualizar.dash): un paso, sus mensajes a la salida y, si hay una nueva y se pidió,
# la pregunta de si se instala
func actualizar_tic()
    act_paso()
    actualizar_mensajes()
    if act_preguntar()
        r = mui_request(v.window, tr(448, "Versión nueva de Dash"), hueco2(tr(449, "Está publicada Dash %1. ¿La bajo y la instalo en el cajón de Dash?\n\nSon %2 MB. Pone al día la orden dash, Forja, Inferencia, lib/ y los ejemplos.\nTus programas y tus preferencias no se tocan."), act_version_nueva(), act_megas()), tr(450, "_Instalar|_Cancelar"))
        if r == 1
            # (la ayuda abierta no dejaría cambiar DASH:Ayuda)
            ayf_cerrar_ventana()
        end
        act_instalar(r == 1)
        actualizar_mensajes()
    end
end

func actualizar_mensajes()
    m = act_mensaje()
    if m != ""
        avisar(m, act_tipo())
    end
end

# El temporizador para lo de actualizar, si nada más lo ha puesto
func actualizar_armar()
    if not tic_armado
        e = act_espera()
        if e >= 0
            armar_tic(e, EV_TIC)
        end
    end
end

func armar_tic(ms: Int, ev: Int)
    tic_armado = true
    mui_timer(ms, ev)
end

var ayuda_campo_luego: Bool = false

func tic()
    tic_armado = false
    if ayuda_campo_luego
        ayuda_campo_luego = false
        mui_set_active(va.window, va.buscar)
    end
    comprobar_tic()
    ext_reposo()
    actualizar_tic()
    indice_en_reposo()
    if bienvenida_parpadear()
        z = bienvenida_zona()
        mui_canvas_update_area(v.editor, z[0], z[1], z[2], z[3])
    end
    if tarea == NADA
        return
    end
    if tarea == DEPURANDO
        # (la señal del depurador es lo normal; esto, por si se pierde)
        mirar_depuracion()
        if tarea == DEPURANDO
            armar_tic(TIC_MS * 3, EV_TIC)
        end
        return
    end
    if not run_ready(tarea_run)
        # Parar manda Ctrl-C (y otra vez cada segundo); un programa que espera a su ventana no lo ve hasta que le
        # llega algo: a los 4 s, se dice
        if parar_pedido > 0 and not parar_avisado and time_ms() - parar_pedido > 4000
            parar_avisado = true
            avisar(tr(454, "El programa no se para: si tiene ventana, ciérrala."), 1)
        end
        armar_tic(TIC_MS, EV_TIC)
        return
    end
    parar_pedido = 0
    parar_avisado = false
    texto = run_finish(tarea_run)
    rc = run_rc()
    tarea_run = 0
    ms = time_ms() - tarea_inicio
    if tarea == COMPILANDO
        errores = 0
        errores_ultimos = ""
        for l in str_split(str_trim(texto), "\n")
            if salida_error_dashc(l)
                errores = errores + 1
                errores_ultimos = errores_ultimos + l + "\n"
            elif l != ""
                salida_anadir(l, 0)
            end
        end
        if rc != 0 and errores == 0
            ext_suceso("COMPILADO", "1")
        else
            ext_suceso("COMPILADO", "#{errores}")
        end
        # y marcados en el código (errores.dash), como los de comprobar
        err_de_salida(texto, cajon_de(tarea_dash), "", "")
        errores_cambiados(false)
        if rc != 0 and errores == 0 and str_contains(texto, "uso: dash") and tarea_proy != nil and tarea_proy.gcc
            avisar(tr(1003, "Esta orden dash no compila por C (--gcc): quítalo en Propiedades del proyecto."), 1)
        end
        if rc != 0
            tarea_perfil = false
            tarea_memcheck = false
            if errores == 1
                avisar(tr(13, "No compila: un error (clic en él para ir a su línea)."), 1)
            else
                avisar(hueco(tr(67, "No compila: %1 errores (clic en uno para ir a su línea)."), "#{errores}"), 1)
            end
            poner_tarea(NADA)
            depurar_despues = false
            return
        end
        avisar(tr(14, "Compilado en ") + segundos(ms) + ": " + tarea_exe, 2)
        icono_del_programa()
        if depurar_despues
            depurar_despues = false
            empezar_depuracion()
            return
        end
        if not ejecutar_despues
            poner_tarea(NADA)
            return
        end
        avisar(tr(15, "Ejecutando ") + nombre_de(tarea_exe) + "...", 0)
        antes = al_cajon_del_programa()
        argumentos = ""
        if tarea_proy != nil and tarea_proy.argumentos != ""
            argumentos = " " + tarea_proy.argumentos
        end
        perfil_filas.clear()
        perfil_muestras = 0
        perfil_programa = tarea_dash
        memcheck_avisos = 0
        memcheck_primero = -1
        tarea_run = run_start("\"" + tarea_exe + "\"" + argumentos, 0)
        volver_al_cajon(antes)
        if tarea_run == 0
            avisar(tr(16, "No se puede ejecutar ") + tarea_exe, 1)
            poner_tarea(NADA)
            return
        end
        tarea_inicio = time_ms()
        parar_pedido = 0
        parar_avisado = false
        poner_tarea(EJECUTANDO)
        armar_tic(TIC_MS, EV_TIC)
        return
    end
    # acabó el programa (un error de ejecución, con su sitio: un clic lleva a la línea)
    error = -1
    if str_trim(texto) != ""
        error = salida_al_acabar(str_trim(texto), cajon_de(tarea_dash), tarea_exe)
    end
    tipo = 2
    if rc != 0
        tipo = 1
    end
    avisar(hueco2(tr(68, "%1 acabó con código %2"), nombre_de(tarea_exe), "#{rc}") + tr(69, " en ") + segundos(ms) + ".", tipo)
    if error >= 0
        salida_mostrar(error)
        mui_canvas_redraw(v.salida)
    end
    poner_tarea(NADA)
    tras_perfil_y_memcheck()
end

# El icono del programa del proyecto (icono = en el .forja), junto al ejecutable
func icono_del_programa()
    p = tarea_proy
    if p == nil or p.icono == ""
        return
    end
    origen = pr_ruta(p, p.icono)
    destino = tarea_exe + ".info"
    dos_requesters(false)
    if str_lower(origen) != str_lower(destino) and file_exists(origen) and not file_copy(origen, destino)
        avisar(tr(2, "No se puede escribir ") + destino, 1)
    end
    dos_requesters(true)
end

# --- Depurar ---

func depurar()
    if tarea != NADA
        return
    end
    depurar_despues = true
    compilar(false)
    if tarea != COMPILANDO
        depurar_despues = false
    end
end

func empezar_depuracion()
    antes = al_cajon_del_programa()
    argumentos = ""
    if tarea_proy != nil
        argumentos = tarea_proy.argumentos_depurar
        if argumentos == ""
            argumentos = tarea_proy.argumentos
        end
    end
    empezado = dbg_start(tarea_exe, argumentos)
    volver_al_cajon(antes)
    if not empezado
        avisar(tr(17, "No se puede depurar: ") + dbg_error(), 1)
        poner_tarea(NADA)
        return
    end
    # los puntos: los de los ficheros sin guardar, y los del proyecto (también de los que no están abiertos)
    for d in documentos
        if d.ruta == ""
            for p in d.puntos
                dbg_break(d.nombre, p)
            end
        end
    end
    for q in pr_puntos
        dbg_break(nombre_de(q.fichero), q.linea)
    end
    pr_puntos_empezar()
    if hasta_ruta != ""
        hasta_puesto = pr_punto(hasta_ruta, hasta_linea) == nil
        if hasta_puesto and not dbg_break(nombre_de(hasta_ruta), hasta_linea)
            avisar(hueco(tr(70, "La línea %1 no tiene código: el punto no para ahí."), "#{hasta_linea}"), 1)
            hasta_ruta = ""
        end
    end
    orden_seguir = true
    salida_vista = 0
    dep_olvidar()
    avisar(tr(18, "Depurando ") + nombre_de(tarea_exe) + tr(19, " (F5 seguir, F10 paso, F6 entrar, F7 salir, F9 punto de parada)."), 0)
    poner_tarea(DEPURANDO)
    parada_atendida = false
    dbg_continue()
    armar_tic(TIC_MS * 3, EV_TIC)
    mirar_depuracion()
    publicar_depuracion()
end

# Lo nuevo que escribió el programa, a la salida
func salida_programa()
    t = dbg_output()
    if t.length > salida_vista
        nuevo = t[salida_vista:]
        salida_vista = t.length
        if nuevo.length > 0 and str_ends(nuevo, "\n")
            nuevo = nuevo[0:nuevo.length - 1]
        end
        avisar(nuevo, 0)
    end
end

# El depurador avisó (o un tic): ¿ha parado o ha acabado?
var parada_atendida: Bool = false   # la parada de ahora ya está en el editor y en el panel
func mirar_depuracion()
    if tarea != DEPURANDO
        return
    end
    e = dbg_state()
    if e == 3 and not parada_atendida
        # una vez por parada: el tic de por si se pierde la señal la volvía a atender cada poco, y llevaba el cursor
        # a la línea de la parada (y el código saltaba tras un clic en el editor, lo contó David Martínez)
        parada_atendida = true
        al_parar()
    elif e == 4 or e == 0
        al_acabar()
    end
end

func al_parar()
    salida_programa()
    # un punto con condición o contador que no se cumple: sigue, sin enseñar nada
    if punto_sigue(dbg_file(), dbg_line())
        parada_atendida = false
        return
    end
    hasta_quitar()
    # la ventana del programa se queda el teclado al abrirse: Forja delante otra vez, para que F5, F10... lleguen
    if abierta and mui_window_active(v.window) == 0
        mui_window_activate(v.window)
    end
    ruta = dbg_file()
    n = dbg_line()
    # en el mismo fichero y con la línea a la vista, el código no se mueve y solo se repintan la línea del cursor de
    # antes y la de la parada (cada parada repintaba y centraba: lo contó David Martínez)
    d0 = ed_actual()
    mismo = d0 != nil and d0.ruta != "" and str_lower(d0.ruta) == str_lower(ruta) and es_codigo(d0)
    cursor_antes = -1
    if d0 != nil
        cursor_antes = d0.cl
    end
    quieto = false
    ed_dbg_ruta = ruta
    ed_dbg_linea = n
    if abrir(ruta)
        if mismo
            quieto = ed_ir_a_quieto(n, 1)
        else
            ed_ir_a(n, 1)
        end
    end
    # la pila y las variables, en el panel de la izquierda (en árbol: lo desplegado sigue desplegado)
    dep_construir()
    barra_variables_ver(true)
    mui_canvas_redraw(v.proyecto)
    if quieto
        if cursor_antes >= 0 and cursor_antes != n - 1
            redibujar_linea(cursor_antes)
        end
        redibujar_linea(n - 1)
    else
        redibujar()
    end
    publicar_depuracion()
end

func al_acabar()
    salida_programa()
    avisar(hueco2(tr(68, "%1 acabó con código %2"), nombre_de(tarea_exe), "#{dbg_rc()}") + ".", 2)
    ed_dbg_ruta = ""
    ed_dbg_linea = 0
    hasta_ruta = ""
    valor_quitar()
    depuracion.clear()
    barra_variables_ver(false)
    poner_tarea(NADA)
    mui_canvas_redraw(v.proyecto)
    redibujar()
    publicar_depuracion()
end

# Seguir, paso, entrar, salir o parar
func orden_depurador(ev: Int)
    if tarea != DEPURANDO
        return
    end
    if ev == EV_PARAR
        dbg_end(3000)
        al_acabar()
        return
    end
    if dbg_state() != 3 and dbg_state() != 1
        return
    end
    # la línea de la parada deja de marcarse: se repinta solo ella (el editor entero, en cada paso, parpadeaba)
    vieja = ed_dbg_linea
    ed_dbg_linea = 0
    d = ed_actual()
    if vieja > 0 and d != nil and d.ruta != "" and str_lower(d.ruta) == str_lower(ed_dbg_ruta) and es_codigo(d)
        redibujar_linea(vieja - 1)
    end
    parada_atendida = false
    orden_seguir = ev == EV_SEGUIR
    valor_quitar()
    if ev == EV_SEGUIR
        dbg_continue()
    elif ev == EV_PASO
        dbg_next()
    elif ev == EV_ENTRAR
        dbg_step()
    elif ev == EV_SALIR_FUNCION
        dbg_out()
    end
    # (puede haber parado o acabado ya)
    mirar_depuracion()
    publicar_depuracion()
end

# Para las pruebas: ENV:FORJA_DEPURAR ("estado línea función") y ENV:FORJA_VARIABLES (las líneas del panel)
func publicar_depuracion()
    if not sonda
        return
    end
    # las variables antes que el estado: quien espera el estado ya las encuentra
    t = ""
    for f in depuracion
        t = t + dep_linea(f) + "|"
    end
    env_set("FORJA_VARIABLES", t, false)
    # parado (3) solo cuando Forja ya ha recogido la parada (al_parar): si no, la prueba leería la línea nueva con las
    # variables de antes
    estado = dbg_state()
    if estado == 3 and ed_dbg_linea == 0
        estado = 1
    end
    env_set("FORJA_DEPURAR", "#{estado} #{dbg_line()} " + dbg_function(), false)
end

# Un clic en un error de la salida: a su fichero y su línea
func en_salida()
    rueda = mui_canvas_wheel(v.salida)
    if rueda != 0
        salida_atras = salida_atras_valido(salida_atras + rueda * 3)
        mui_canvas_redraw(v.salida)
        return
    end
    if mui_canvas_button(v.salida) != 1
        return
    end
    salida_foco = true
    i = salida_en(mui_canvas_mouse_y(v.salida))
    # un clic elige esa línea (arrastrando, varias): Amiga-C la copia
    salida_sel_a = i
    salida_sel_b = i
    mui_canvas_redraw(v.salida)
    if i < 0 or salida_rutas[i] == ""
        return
    end
    ruta = salida_rutas[i]
    # una ruta relativa es del cajón del fichero activo
    if str_find(ruta, ":") < 0 and not str_starts(ruta, "*")
        d = ed_actual()
        if d != nil
            ruta = ruta_unir(cajon_de(d.ruta), ruta)
        end
    end
    if abrir_sitio(ruta)
        ed_ir_a(salida_num[i], salida_col[i])
        cerrar_capas()
        redibujar()
    end
end

# Arrastrando en la salida se eligen varias líneas
func arrastrar_salida()
    if salida_sel_a < 0 or mui_canvas_drag(v.salida) != 1
        return
    end
    y = mui_canvas_mouse_y(v.salida)
    i = salida_en(y)
    if i < 0 and y >= salida_y0
        i = salida_lineas.length - 1
    elif i < 0
        i = salida_desde
    end
    if i != salida_sel_b
        salida_sel_b = i
        mui_canvas_redraw(v.salida)
    end
end

# La salida al portapapeles: las líneas elegidas, o toda si no hay ninguna
func copiar_salida(solo_elegidas: Bool)
    clip_write_text(latin1_to_utf8(salida_texto(solo_elegidas)))
end

func guardar_salida()
    if not file_save_dialog(tr(222, "Guardar la salida"), "#?.txt")
        return
    end
    ruta = file_fullpath()
    if file_write_text(ruta, salida_texto(false))
        avisar(tr(3, "Guardado: ") + ruta, 2)
    else
        avisar(tr(2, "No se puede escribir ") + ruta, 1)
    end
end

# Un clic en el panel del proyecto: un fichero se abre; un cajón se enseña
func en_proyecto()
    if depuracion.length > 0
        en_depuracion()
        return
    end
    rueda = mui_canvas_wheel(v.proyecto)
    if rueda != 0
        proyecto_desde = proyecto_desde_valido(proyecto_desde - rueda * 3)
        mui_canvas_redraw(v.proyecto)
        return
    end
    if mui_canvas_button(v.proyecto) != 1
        return
    end
    i = proyecto_en(mui_canvas_mouse_y(v.proyecto))
    if i < 0
        return
    end
    f = proyecto_ficheros[i]
    if f == "/"
        proyecto_leer(cajon_de(proyecto_cajon))
    elif str_ends(f, "/")
        proyecto_leer(ruta_unir(proyecto_cajon, f[0:f.length - 1]))
    else
        if abrir(ruta_unir(proyecto_cajon, f))
            redibujar()
        end
        return
    end
    mui_canvas_redraw(v.proyecto)
end

func es_flecha(k: Int) -> Bool
    return k == T_ARRIBA or k == T_ABAJO or k == T_IZQUIERDA or k == T_DERECHA
end

# Al depurar, el panel enseña la pila y las variables: un clic despliega o pliega una lista o un struct (idea de
# David Martínez); la rueda y las flechas lo mueven (con Mayúsculas, la rueda va a lo ancho y las flechas de página
# en página). Un clic ahí no es en la lista de ficheros que tapan (abría el de esa fila, lo contó David Martínez).
func en_depuracion()
    rueda = mui_canvas_wheel(v.proyecto)
    mayus = (mui_canvas_qualifiers(v.proyecto) & Q_MAYUS) != 0
    tecla = mui_canvas_key(v.proyecto)
    desde = depuracion_desde
    dx = depuracion_dx
    if rueda != 0 and mayus
        dx = dx - rueda * 4
    elif rueda != 0
        desde = desde - rueda * 3
    elif tecla >= 0
        paso = 1
        lado = 4
        if mayus
            paso = depuracion_caben
            lado = depuracion_ancho_caben
        end
        if tecla == T_ARRIBA
            desde = desde - paso
        elif tecla == T_ABAJO
            desde = desde + paso
        elif tecla == T_IZQUIERDA
            dx = dx - lado
        elif tecla == T_DERECHA
            dx = dx + lado
        end
    elif mui_canvas_button(v.proyecto) == 1
        if dep_clic(dep_en(mui_canvas_mouse_y(v.proyecto)))
            mui_canvas_redraw(v.proyecto)
            publicar_depuracion()
        end
        return
    end
    desde = dep_desde_valido(desde)
    dx = dep_dx_valido(dx)
    if desde != depuracion_desde or dx != depuracion_dx
        depuracion_desde = desde
        depuracion_dx = dx
        mui_canvas_redraw(v.proyecto)
    end
end

# La barra de abajo del panel de las variables: solo al depurar
var barra_variables_vista: Bool = false
func barra_variables_ver(ver: Bool)
    if ver != barra_variables_vista
        barra_variables_vista = ver
        mui_set_visible(v.barra_variables, ver)
    end
end

# Las barras de la salida y del proyecto siguen a lo que se ve
func ajustar_barras_paneles()
    caben = salida_caben
    total = salida_lineas.length
    if total < caben
        total = caben
    end
    if total != barra_salida_total or caben != barra_salida_caben
        barra_salida_total = total
        barra_salida_caben = caben
        mui_set_range(v.barra_salida, total, caben)
        barra_salida_valor = -1
    end
    if salida_desde != barra_salida_valor
        barra_salida_valor = salida_desde
        mui_set_value(v.barra_salida, salida_desde)
    end
    caben = proyecto_caben
    total = proyecto_ficheros.length
    primera = proyecto_desde
    if depuracion.length > 0
        caben = depuracion_caben
        total = depuracion.length
        primera = depuracion_desde
    end
    if total < caben
        total = caben
    end
    if total != barra_proyecto_total or caben != barra_proyecto_caben
        barra_proyecto_total = total
        barra_proyecto_caben = caben
        mui_set_range(v.barra_proyecto, total, caben)
        barra_proyecto_valor = -1
    end
    if primera != barra_proyecto_valor
        barra_proyecto_valor = primera
        mui_set_value(v.barra_proyecto, primera)
    end
    if barra_variables_vista
        caben = depuracion_ancho_caben
        total = depuracion_ancho + 1
        if total < caben
            total = caben
        end
        if total != barra_variables_total or caben != barra_variables_caben
            barra_variables_total = total
            barra_variables_caben = caben
            mui_set_range(v.barra_variables, total, caben)
            barra_variables_valor = -1
        end
        if depuracion_dx != barra_variables_valor
            barra_variables_valor = depuracion_dx
            mui_set_value(v.barra_variables, depuracion_dx)
        end
    end
end

# La barra sigue al editor
func ajustar_barra()
    d = ed_actual()
    if d == nil
        return
    end
    # (en filas de las que se ven: lo plegado no cuenta)
    total = ed_filas_entre(d, 0, d.lineas.length)
    if total != barra_total or ed_visibles != barra_visibles
        barra_total = total
        barra_visibles = ed_visibles
        mui_set_range(v.barra, barra_total, barra_visibles)
        barra_valor = -1
    end
    fila = ed_filas_entre(d, 0, d.primera)
    if fila != barra_valor
        barra_valor = fila
        mui_set_value(v.barra, fila)
    end
end

func redibujar()
    mui_canvas_redraw(v.editor)
    ajustar_barra()
    escribir_sonda()
end

# --- Los símbolos del código (codigo.dash): completar, ayuda de argumentos, ir a la definición ---

# El nombre de un documento para codigo.dash: su ruta, o "*nombre" si aún no se ha guardado
func clave_de(d: Documento) -> String
    if d.ruta != ""
        return d.ruta
    end
    return "*" + d.nombre
end

func es_codigo(d: Documento) -> Bool
    return d != nil and not d.diseno and d.vista == 0
end

# Los símbolos al día: los de los ficheros abiertos (con lo que tienen sin guardar) y lo que importa el activo
func indice_al_dia()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    cx_empezar()
    for o in documentos
        cx_fichero(clave_de(o), o.lineas, o.version)
    end
    # (sin requesters: buscar lo importado en DASH: no debe pedir que se inserte ese volumen si no existe)
    cajon = cajon_de(dashc())
    dos_requesters(false)
    cx_preparar(clave_de(d), cajon)
    dos_requesters(true)
    bi_preparar()
    indice_de = clave_de(d)
    indice_version = d.version
end

# Antes de completar: los del fichero activo (aunque sean de unas letras antes); con al_dia, de ahora mismo
func indice_si_hace_falta(al_dia: Bool)
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    if indice_de != clave_de(d) or (al_dia and indice_version != d.version)
        indice_al_dia()
    end
end

# Desde tic(): tras un rato sin escribir, los símbolos del fichero activo se vuelven a leer
func indice_en_reposo()
    d = ed_actual()
    if not completar_activo or not es_codigo(d) or (indice_de == clave_de(d) and indice_version == d.version)
        return
    end
    if time_ms() - ultimo_cambio < REPOSO_MS
        if not tic_armado
            armar_tic(REPOSO_MS, EV_TIC)
        end
        return
    end
    if indice_de != clave_de(d)
        indice_al_dia()
        return
    end
    # el mismo fichero: se lee a trozos de LINEAS_TIC líneas, un trozo por tic, para que el editor siga respondiendo
    if cx_leer_paso(clave_de(d), d.lineas, d.version, LINEAS_TIC)
        cajon = cajon_de(dashc())
        dos_requesters(false)
        cx_preparar(clave_de(d), cajon)
        dos_requesters(true)
        indice_version = d.version
    elif not tic_armado
        armar_tic(20, EV_TIC)
    end
end

func cerrar_capas()
    ac_cerrar()
    ay_cerrar()
    cx_locales_olvidar()
end

# Redibuja tras una tecla: solo la línea del cursor (solo_linea) si no hay ni hubo nada encima del texto (la lista o
# la ayuda, antes en y1 a y2); si lo hay, todo (un dibujo entero cuesta poco más que las filas que tapan)
func redibujar_tras_tecla(solo_linea: Bool, y1: Int, y2: Int)
    d = ed_actual()
    ed_capas_geometria(d)
    ed_capas_rango()
    if solo_linea and d != nil and y1 < 0 and ed_capas_y1 < 0
        redibujar_linea(d.cl)
    else
        redibujar()
    end
end

# Como redibujar_tras_tecla, con la pareja (el paréntesis o el end que casa con el del cursor): si cambió, también
# sus líneas. otra: el cursor pasó de la línea antes_cl a otra sin nada más (solo esas dos)
func redibujar_tras_tecla_pareja(solo: Bool, otra: Bool, antes_cl: Int, y1: Int, y2: Int)
    d = ed_actual()
    cambio = d != nil and ed_pareja_calcular(d)
    ed_capas_geometria(d)
    ed_capas_rango()
    if d == nil or y1 >= 0 or ed_capas_y1 >= 0 or not (solo or otra)
        redibujar()
        return
    end
    var ls: [Int] = [d.cl]
    if otra
        ls.push(antes_cl)
    end
    if cambio
        for l in [ed_par_antes_l1, ed_par_antes_l2, ed_par_l1, ed_par_l2]
            ls.push(l)
        end
    end
    redibujar_lineas(ls)
end

# Repinta esas líneas (las que se ven, cada una una vez)
func redibujar_lineas(ls: [Int])
    d = ed_actual()
    t0 = time_ms()
    var hechas: [Int] = []
    for l in ls
        repetida = false
        for h in hechas
            if h == l
                repetida = true
            end
        end
        if l >= 0 and ed_fila_y(d, l) >= 0 and not repetida
            hechas.push(l)
            ed_solo_linea = l
            mui_canvas_update_area(v.editor, 0, ed_fila_y(d, l), ed_zona_ancho, ed_alto_fila)
        end
    end
    ed_solo_linea = -1
    ms_lineas = time_ms() - t0
    n_lineas = hechas.length
    escribir_sonda()
end

# Tras cambiar el texto con una orden (no con una tecla): lo mismo que al escribir
func tras_escribir(d: Documento)
    cx_locales_olvidar()
    linea_escrita = d.cl
    lineas_antes = d.lineas.length
    ultimo_cambio = time_ms()
    if completar_activo and not tic_armado
        armar_tic(REPOSO_MS, EV_TIC)
    end
    ext_tras_escribir(d)
    comprobar_pedir(d, true)
end

# Una orden del editor (TC_* de teclas.dash), con su tecla o desde el menú Editor
func orden_editor(o: Int)
    if o == TC_ABRIR_FICHERO
        abrir_por_nombre()
        return
    elif o == TC_BUSCAR_PROYECTO or o == TC_CAMBIAR_PROYECTO
        ventana_buscar_proyecto(o == TC_CAMBIAR_PROYECTO)
        return
    elif o == TC_ABRIR_SIMBOLO
        nombres_del_proyecto()
        return
    end
    d = ed_actual()
    if d == nil or d.diseno
        return
    end
    cerrar_capas()
    version = d.version
    texto = d.vista == 0
    if o == TC_COMENTAR and texto
        ed_comentar(d)
    elif o == TC_DUPLICAR and texto
        ed_duplicar(d)
    elif o == TC_SUBIR and texto
        ed_mover_lineas(d, true)
    elif o == TC_BAJAR and texto
        ed_mover_lineas(d, false)
    elif o == TC_BORRAR_LINEA and texto
        ed_borrar_lineas(d)
    elif o == TC_PAREJA
        if not ed_ir_pareja(d)
            avisar(tr(801, "Aquí no hay nada que haga pareja (un paréntesis, o la primera palabra de un bloque)."), 1)
        end
    else
        orden_editor_mas(d, o)
    end
    if d.version != version
        tras_escribir(d)
    end
    ed_pareja_calcular(d)
    redibujar()
end

# --- Las teclas y el menú del editor (fase 2) ---

func si_no(b: Bool) -> String
    if b
        return "si"
    end
    return "no"
end

# Las teclas de las órdenes del editor: ENV:Forja/teclas (o ENVARC:, si ENV: no la tiene); lo que no se entiende se
# dice en la salida
func teclas_leer()
    t = file_read_text("ENV:Forja/teclas")
    if t == nil
        t = file_read_text("ENVARC:Forja/teclas")
    end
    if t != nil
        malas = tc_leer(t)
        if malas != ""
            salida_anadir(tr(802, "No entiendo estas líneas de las teclas (ENVARC:Forja/teclas):"), 1)
            for l in str_split(str_trim(malas), "\n")
                salida_anadir("  " + l, 1)
            end
        end
    end
end

# Las opciones del menú Editor, para cambiar su etiqueta si cambian las teclas: su objeto, su texto y su orden
var _ed_items: [Int] = []
var _ed_items_texto: [String] = []
var _ed_items_orden: [Int] = []

func _etiqueta_editor(texto: String, o: Int) -> String
    k = tc_texto(o)
    if k != ""
        return texto + "  (" + k + ")"
    end
    return texto
end

func _opcion_editor(texto: String, o: Int)
    _ed_items.push(mui_menu_item(_etiqueta_editor(texto, o), "", EV_ED + o))
    _ed_items_texto.push(texto)
    _ed_items_orden.push(o)
end

# ENV:Forja/teclas o ENVARC:Forja/teclas cambiaron (Forja los vigila): las teclas otra vez, y las etiquetas del menú
# Editor con ellas, sin cerrar Forja
var _teclas_vigia: [Int] = []
func teclas_vigilar()
    dos_requesters(false)
    # (el cajón tiene que estar para vigilar un fichero que aún no está)
    dir_create("ENV:Forja")
    dir_create("ENVARC:Forja")
    for f in ["ENV:Forja/teclas", "ENVARC:Forja/teclas"]
        n = file_notify(f)
        if n > 0
            _teclas_vigia.push(n)
        end
    end
    dos_requesters(true)
end

func teclas_mirar()
    cambio = false
    for n in _teclas_vigia
        if file_changed(n)
            cambio = true
        end
    end
    if not cambio
        return
    end
    tc_por_defecto()
    teclas_leer()
    t = ""
    i = 0
    while i < _ed_items.length
        e = _etiqueta_editor(_ed_items_texto[i], _ed_items_orden[i])
        mui_set_text(_ed_items[i], e)
        t = t + e + "|"
        i = i + 1
    end
    if sonda
        env_set("FORJA_MENU_EDITOR", t, false)
    end
    salida_anadir(tr(1006, "Teclas del editor leídas otra vez (ENVARC:Forja/teclas)."), 2)
end

# El menú Editor: las órdenes del editor con su tecla (la de ENVARC:Forja/teclas, si se cambió)
func menu_editor()
    mui_menu_add(v.window, tr(800, "Editor"))
    _opcion_editor(tr(803, "Comentar o descomentar"), TC_COMENTAR)
    _opcion_editor(tr(804, "Duplicar las líneas"), TC_DUPLICAR)
    _opcion_editor(tr(805, "Subir las líneas"), TC_SUBIR)
    _opcion_editor(tr(806, "Bajar las líneas"), TC_BAJAR)
    _opcion_editor(tr(807, "Borrar las líneas"), TC_BORRAR_LINEA)
    _opcion_editor(tr(808, "Ir a la pareja"), TC_PAREJA)
    mui_menu_separator()
    _opcion_editor(tr(809, "Poner o quitar marcador"), TC_MARCADOR)
    _opcion_editor(tr(810, "Siguiente marcador"), TC_MARCADOR_SIGUIENTE)
    _opcion_editor(tr(811, "Marcador anterior"), TC_MARCADOR_ANTERIOR)
    mui_menu_separator()
    _opcion_editor(tr(812, "Esquema del fichero..."), TC_ESQUEMA)
    _opcion_editor(tr(813, "Abrir un fichero por su nombre..."), TC_ABRIR_FICHERO)
    _opcion_editor(tr(814, "Ir a un nombre del proyecto..."), TC_ABRIR_SIMBOLO)
    _opcion_editor(tr(815, "Buscar en el proyecto..."), TC_BUSCAR_PROYECTO)
    _opcion_editor(tr(816, "Cambiar en el proyecto..."), TC_CAMBIAR_PROYECTO)
    _opcion_editor(tr(817, "Renombrar..."), TC_RENOMBRAR)
    mui_menu_separator()
    _opcion_editor(tr(818, "Plegar o desplegar el bloque"), TC_PLEGAR)
    _opcion_editor(tr(819, "Desplegar todo"), TC_DESPLEGAR_TODO)
    mui_menu_separator()
    menu_cerrar = mui_menu_check(tr(820, "Cerrar solos paréntesis y comillas"), "", EV_ED_CERRAR, ed_cerrar_solo)
    menu_end = mui_menu_check(tr(821, "Poner el end al abrir un bloque"), "", EV_ED_END, ed_auto_end)
    mui_menu_end()
end

# Las órdenes de los pasos 2.4 a 2.7 (esquema, marcadores, renombrar, plegar)
func orden_editor_mas(d: Documento, o: Int)
    if o == TC_ESQUEMA
        esquema(d)
    elif o == TC_MARCADOR
        ed_marcador(d)
    elif o == TC_MARCADOR_SIGUIENTE or o == TC_MARCADOR_ANTERIOR
        if not ed_ir_marcador(d, o == TC_MARCADOR_SIGUIENTE)
            avisar(hueco2(tr(857, "No hay marcadores en %1 (%2 pone o quita uno)."), d.nombre, tc_texto(TC_MARCADOR)), 1)
        end
    elif o == TC_RENOMBRAR and d.vista == 0
        renombrar_preguntar(d)
    elif o == TC_PLEGAR
        if not ed_plegar_cursor(d)
            avisar(tr(864, "El cursor no está en un bloque (func, if, while, struct...)."), 1)
        end
    elif o == TC_DESPLEGAR_TODO
        ed_desplegar_todo(d)
    else
        avisar(tr(822, "Esa orden aún no está hecha."), 1)
    end
end

# Ctrl Mayús F (o H): la ventana de buscar, con lo elegido o el nombre del cursor, y busca en el proyecto (o deja el
# cursor en "Cambiar por")
func ventana_buscar_proyecto(cambiar: Bool)
    d = ed_actual()
    t = ""
    if d != nil
        t = ed_seleccion(d)
        if t == "" or str_contains(t, "\n")
            t = palabra_del_cursor(d)
        end
    end
    if t != ""
        mui_set_text(vb.texto, t)
    end
    mui_window_open(vb.window)
    if cambiar
        mui_set_active(vb.window, vb.cambio)
    else
        mui_set_active(vb.window, vb.texto)
        if t != ""
            buscar_proyecto()
        end
    end
end

# --- La lista rápida (paso 2.4) ---

# El esquema del fichero: sus funciones, structs (con sus campos), enums, constantes y variables, en su orden; queda
# elegido lo que hay donde está el cursor
func esquema(d: Documento)
    if not es_codigo(d) and not str_ends(str_lower(d.nombre), ".dashui")
        return
    end
    t0 = time_ms()
    sims = cx_simbolos_de(clave_de(d), d.lineas, d.version)
    lr_abrir(LR_ESQUEMA, hueco(tr(852, "Esquema de %1"), d.nombre))
    aqui = -1
    for s in sims
        if s.clase != CX_LOCAL
            t = s.nombre
            if s.dueno != ""
                t = "  " + t
            end
            lr_anadir(t, s.clase, "", s.linea, s.col, "#{s.linea}")
            if s.linea <= d.cl + 1 and s.dueno == ""
                aqui = lr_textos.length - 1
            end
        end
    end
    lr_filtrar()
    if aqui >= 0
        lr_elegir(aqui)
    end
    lr_ms = time_ms() - t0
    redibujar()
end

# Abrir un fichero del proyecto por su nombre (Ctrl P)
func abrir_por_nombre()
    cajon = cajon_proyecto()
    if cajon == ""
        avisar(tr(853, "No hay proyecto: abre antes un fichero."), 1)
        return
    end
    t0 = time_ms()
    dos_requesters(false)
    rutas = bp_todos_de(cajon)
    dos_requesters(true)
    lr_abrir(LR_FICHEROS, tr(854, "Abrir"))
    for r in rutas
        rel = _nombre_en_proyecto(r, cajon)
        nombre = nombre_de(r)
        det = ""
        if rel.length > nombre.length
            det = rel[0:rel.length - nombre.length - 1]
        end
        lr_anadir(nombre, LR_FICHERO, r, 0, 0, det)
    end
    lr_filtrar()
    lr_ms = time_ms() - t0
    redibujar()
end

# Ir a un nombre de todo el proyecto (Ctrl T): lo de arriba de cada fichero de código y los métodos
func nombres_del_proyecto()
    cajon = cajon_proyecto()
    if cajon == ""
        avisar(tr(853, "No hay proyecto: abre antes un fichero."), 1)
        return
    end
    t0 = time_ms()
    dos_requesters(false)
    rutas = bp_ficheros_de(cajon)
    lr_abrir(LR_NOMBRES, tr(855, "Ir a"))
    for r in rutas
        k = ed_buscar_ruta(r)
        var sims: [Simbolo] = []
        if k >= 0
            sims = cx_simbolos_de(r, documentos[k].lineas, documentos[k].version)
        else
            sims = cx_simbolos_de(r, nil, 0)
        end
        rel = _nombre_en_proyecto(r, cajon)
        for s in sims
            if s.dueno == "" or s.clase == CX_METODO
                t = s.nombre
                if s.clase == CX_METODO
                    t = s.dueno + "." + s.nombre
                end
                lr_anadir(t, s.clase, r, s.linea, s.col, rel + ":#{s.linea}")
            end
        end
    end
    dos_requesters(true)
    lr_filtrar()
    lr_ms = time_ms() - t0
    redibujar()
end

# --- Renombrar (paso 2.6) ---

var renombrar_viejo: String = ""

# F2: dónde se usa el nombre del cursor, y pregunta el nuevo (en la lista rápida, sin lista)
func renombrar_preguntar(d: Documento)
    if not es_codigo(d)
        return
    end
    indice_si_hace_falta(true)
    cajon = cajon_proyecto()
    var otros: [String] = []
    if cajon != ""
        dos_requesters(false)
        otros = bp_ficheros_de(cajon)
        dos_requesters(true)
    end
    dos_requesters(false)
    hay = cx_referencias(d.lineas, clave_de(d), d.cl, d.cc, d.version, otros)
    dos_requesters(true)
    if not hay or cx_ref_lineas.length == 0
        avisar(tr(230, "No hay un nombre en el cursor."), 1)
        return
    end
    renombrar_viejo = cx_def_nombre
    pregunta = PG_RENOMBRAR
    lr_abrir(LR_PREGUNTA, hueco(tr(858, "Renombrar %1 a"), renombrar_viejo))
    lr_filtro = renombrar_viejo
    lr_ayuda = hueco(tr(859, "%1 sitios; antes de cambiar nada, la lista de cambios."), "#{cx_ref_lineas.length}")
    redibujar()
end

func es_nombre(t: String) -> Bool
    return regex_match("[A-Za-z_][A-Za-z0-9_]*", t, false)
end

# Con el nombre nuevo: los cambios de cx_ref_* en bp_c_*, la lista y la pregunta (aplicar_cambios)
func renombrar(nuevo: String)
    viejo = renombrar_viejo
    if nuevo == "" or nuevo == viejo
        return
    end
    if not es_nombre(nuevo) or bi_buscar(nuevo) >= 0 and bi_clase(bi_buscar(nuevo)) != 2
        avisar(hueco(tr(860, "\"%1\" no vale como nombre."), nuevo), 1)
        return
    end
    if cx_global(nuevo) != nil
        avisar(hueco(tr(861, "Ya hay un %1 en el proyecto: no renombro, se mezclarían."), nuevo), 1)
        return
    end
    # por fichero y línea, en el orden de cx_ref_* (por fichero, de arriba abajo)
    bp_c_rutas.clear()
    bp_c_lineas.clear()
    bp_c_antes.clear()
    bp_c_despues.clear()
    bp_c_veces = 0
    i = 0
    n = cx_ref_lineas.length
    while i < n
        ruta = cx_ref_rutas[i]
        # (un fichero sin nombre, "*nombre", es su pestaña: bp_lineas_de y bp_aplicar la encuentran)
        if str_starts(ruta, "*") and bp_doc(ruta) < 0
            i = i + 1
        else
            lineas = bp_lineas_de(ruta)
            nums = ""
            antes = ""
            despues = ""
            while i < n and cx_ref_rutas[i] == ruta
                num = cx_ref_lineas[i]
                # las columnas de esa línea (de derecha a izquierda, para que no se muevan)
                var cols: [Int] = []
                while i < n and cx_ref_rutas[i] == ruta and cx_ref_lineas[i] == num
                    cols.push(cx_ref_cols[i])
                    i = i + 1
                end
                if num >= 1 and num <= lineas.length
                    s = lineas[num - 1]
                    t = s
                    k = cols.length - 1
                    while k >= 0
                        c = cols[k] - 1
                        if c >= 0 and c + viejo.length <= t.length and t[c:c + viejo.length] == viejo
                            t = t[0:c] + nuevo + t[c + viejo.length:]
                            bp_c_veces = bp_c_veces + 1
                        end
                        k = k - 1
                    end
                    if t != s
                        if nums != ""
                            nums = nums + " "
                            antes = antes + "\n"
                            despues = despues + "\n"
                        end
                        nums = nums + "#{num}"
                        antes = antes + s
                        despues = despues + t
                    end
                end
            end
            if nums != ""
                bp_c_rutas.push(ruta)
                bp_c_lineas.push(nums)
                bp_c_antes.push(antes)
                bp_c_despues.push(despues)
            end
        end
    end
    if bp_c_veces == 0
        return
    end
    if aplicar_cambios(hueco2(tr(862, "Renombrar %1 a %2"), viejo, nuevo), cajon_proyecto())
        avisar(hueco2(tr(863, "Renombrado %1 en %2 sitios."), viejo + " -> " + nuevo, "#{bp_c_veces}"), 2)
    end
end

# Lo que pasa sobre el editor con la lista rápida abierta: es suya
func en_lista_rapida() -> Int
    teclas = mui_canvas_qualifiers(lienzo_teclas)
    if mui_canvas_button(lienzo_teclas) == 1
        x = mui_canvas_mouse_x(lienzo_teclas)
        y = mui_canvas_mouse_y(lienzo_teclas)
        if lr_dentro(x, y)
            if lr_clic(x, y)
                ir_lista_rapida()
            end
            return 0
        end
        lr_cerrar()
        redibujar()
        return 0
    end
    rueda = mui_canvas_wheel(lienzo_teclas)
    if rueda != 0
        lr_primera = lr_primera - rueda * 3
        if lr_primera > lr_vistos.length - LR_FILAS
            lr_primera = lr_vistos.length - LR_FILAS
        end
        if lr_primera < 0
            lr_primera = 0
        end
        redibujar()
        return 0
    end
    codigo = mui_canvas_key(lienzo_teclas)
    if codigo < 0
        return 0
    end
    letra = mui_canvas_char(lienzo_teclas)
    if (teclas & Q_AMIGA) != 0
        lr_cerrar()
        redibujar()
        return atajo(letra)
    end
    o = tc_orden(codigo, teclas, letra)
    if o != 0
        # otra vez su tecla la cierra; la de otra lista, la cambia
        tipo = lr_tipo
        lr_cerrar()
        redibujar()
        if (o == TC_ESQUEMA and tipo == LR_ESQUEMA) or (o == TC_ABRIR_FICHERO and tipo == LR_FICHEROS) or (o == TC_ABRIR_SIMBOLO and tipo == LR_NOMBRES)
            return 0
        end
        return EV_ED + o
    end
    r = lr_tecla(codigo, teclas, letra)
    if r == LR_ELEGIDA
        ir_lista_rapida()
        return 0
    end
    redibujar()
    return 0
end

func ir_lista_rapida()
    if lr_tipo == LR_PREGUNTA
        nuevo = str_trim(lr_filtro)
        lr_cerrar()
        redibujar()
        if pregunta == PG_RENOMBRAR
            renombrar(nuevo)
        else
            responder(nuevo)
        end
        pregunta = PG_RENOMBRAR
        return
    end
    k = lr_la_elegida()
    if k < 0
        return
    end
    ruta = lr_rutas[k]
    linea = lr_lineas[k]
    col = lr_cols[k]
    tipo = lr_tipo
    lr_cerrar()
    if tipo == LR_ESQUEMA
        ed_ir_a(linea, col)
        cerrar_capas()
        redibujar()
    elif tipo == LR_FICHEROS
        abrir_sitio(ruta)
        redibujar()
    else
        ir_a_sitio(ruta, linea, col)
    end
end

# Antes de que una tecla llegue al editor: la lista para completar se queda con las flechas, Tab, Return y Esc;
# Ctrl + Espacio la saca. true si la tecla era para ella (y ya se ha redibujado).
func completar_tecla(d: Documento, codigo: Int, teclas: Int) -> Bool
    y1 = ed_pintado_y1
    y2 = ed_pintado_y2
    sin_teclas = (teclas & (Q_MAYUS | Q_ALT | Q_CTRL)) == 0
    if codigo == T_ESPACIO and (teclas & Q_CTRL) != 0
        completar_ahora()
        return true
    end
    if ac_visible and ac_linea == d.cl
        if (codigo == T_ARRIBA or codigo == T_ABAJO) and sin_teclas
            if codigo == T_ARRIBA
                ac_mover(-1, ed_lista_filas)
            else
                ac_mover(1, ed_lista_filas)
            end
            redibujar_tras_tecla(true, y1, y2)
            return true
        end
        if (codigo == T_TAB or codigo == T_RETURN or codigo == T_ENTER) and sin_teclas
            palabra = ac_elegida()
            ac_cerrar()
            if palabra != "" and palabra != ac_prefijo
                ed_completar(d, ac_col, palabra)
                ultimo_cambio = time_ms()
                if ay_visible
                    ay_calcular(d.lineas, d.cl, d.cc, d.version)
                end
                redibujar_tras_tecla(true, y1, y2)
                return true
            end
            # ya está escrita entera: la tecla hace lo de siempre
            return false
        end
        if codigo == T_ESC
            ac_cerrar()
            redibujar_tras_tecla(true, y1, y2)
            return true
        end
    end
    if ay_visible and codigo == T_ESC
        ay_cerrar()
        redibujar_tras_tecla(true, y1, y2)
        return true
    end
    return false
end

# Help o F1 (idea de Javier R. Santurde "Tolkien"): la ficha de la ayuda de Dash del nombre del cursor, entera, en la
# ventana de la ayuda (paso 3.4); sin nombre, la ayuda por donde se dejó; un nombre que la ayuda no tiene, buscado en
# ella. Lo del proyecto (y todo, sin la ayuda de Dash) saca la ayuda de sus argumentos sobre el texto, como antes: Esc o
# mover el cursor la cierra.
func ayuda_del_cursor(d: Documento)
    y1 = ed_pintado_y1
    y2 = ed_pintado_y2
    indice_si_hace_falta(true)
    ac_cerrar()
    nombre = palabra_del_cursor(d)
    if nombre == "" or not cx_es_del_proyecto(d.lineas, d.cl, d.version, nombre)
        id = ayf_nombre(nombre)
        if id >= 0 or (nombre == "" and ayf_abrir())
            ay_cerrar()
            redibujar_tras_tecla(true, y1, y2)
            ayf_mostrar(id)
            return
        end
    end
    if ay_palabra(d.lineas, d.cl, d.cc, d.version)
        redibujar_tras_tecla(true, y1, y2)
    elif nombre != "" and ayf_abrir()
        # (no tiene ficha: lo que sale en la ayuda)
        mui_set_text(va.buscar, nombre)
        ayf_mostrar(-1)
        ayf_evento(EV_AY_CAMPO)
    else
        avisar(tr(379, "No hay ayuda para lo que hay en el cursor."), 1)
    end
end

# El nombre (letras, cifras y _) en el cursor o justo antes; "" si no hay
func palabra_del_cursor(d: Documento) -> String
    if d.cl < 0 or d.cl >= d.lineas.length
        return ""
    end
    s = d.lineas[d.cl]
    c = d.cc
    if c >= s.length or ayf_palabra(s, c) == ""
        c = c - 1
    end
    return ayf_palabra(s, c)
end

# --- La ventana de la ayuda (ayuda.dash) ---

func dibujar_ayuda(x: Int, y: Int, ancho: Int, alto: Int)
    ayf_dibujar(x, y, ancho, alto)
end

func ayuda_evento(ev: Int)
    if ev == EV_AYUDA or ev == EV_AYUDA_BUSCAR
        if not ayf_mostrar(-1)
            avisar(ayf_aviso(), 1)
            return
        end
        if ev == EV_AYUDA_BUSCAR
            mui_set_text(va.buscar, "")
            mui_set_active(va.window, va.buscar)
            # (con MUI 3.8, al activarse la ventana pierde el campo: se le vuelve a dar entonces)
            ayuda_al_campo = true
        end
        return
    end
    if ev == EV_AY_ACTIVADA
        if ayuda_al_campo
            ayuda_al_campo = false
            mui_set_active(va.window, va.buscar)
            # (con MUI 3.8 tampoco se queda: algo de MUI se lo quita justo después; otra vez un momento más tarde, en el
            # tic, que no hace nada antes de tiempo)
            ayuda_campo_luego = true
            tic_armado = false
            armar_tic(150, EV_TIC)
        end
        return
    end
    if ayf_evento(ev) == EV_AY_PROBAR
        probar_ejemplo()
    end
end

# "Probar" en una ficha con un programa entero: en una pestaña nueva sin nombre, y se ejecuta (se compila desde T:)
func probar_ejemplo()
    if ayf_ejemplo == "" or tarea != NADA
        if tarea != NADA
            avisar(tr(727, "Espera a que acabe lo que está en marcha."), 1)
        end
        return
    end
    nombre = "ejemplo_" + ayf_ejemplo_de + ".dash"
    ed_abrir_texto(nombre, "", ayf_ejemplo)
    d = ed_actual()
    t = "T:"
    dos_requesters(false)
    if not file_exists("T:")
        t = "RAM:"
    end
    dos_requesters(true)
    d.temporal = t + "forja_" + nombre
    cerrar_capas()
    redibujar()
    mui_window_activate(v.window)
    compilar(true)
end

# --- Los errores en el código (errores.dash): dash --check al guardar y tras una pausa al escribir ---

# La clave de un documento para sus errores: su ruta, o la de T: de un ejemplo sin nombre
func clave_errores(d: Documento) -> String
    if d.ruta != ""
        return str_lower(d.ruta)
    end
    return str_lower(d.temporal)
end

# El documento abierto de una ruta (o de la de T: de un ejemplo); nil si no está abierto
func doc_de(ruta: String) -> Documento
    r = str_lower(ruta)
    for o in documentos
        if (o.ruta != "" and str_lower(o.ruta) == r) or (o.temporal != "" and str_lower(o.temporal) == r)
            return o
        end
    end
    return nil
end

# Al guardar d (o tras la pausa al escribir): que se compruebe en cuanto se pueda
func comprobar_pedir(d: Documento, tras_pausa: Bool)
    if d == nil or not es_codigo(d) or not str_ends(str_lower(d.nombre), ".dash")
        return
    end
    if tras_pausa and (not comprobar_activo or d.ruta == "" or not tiene_main(d.lineas))
        # (un módulo sin guardar no se puede comprobar: dash lee del disco lo que importa el programa)
        return
    end
    if comprobar_pedido == 1 and not tras_pausa and comprobar_doc != d
        # dos ficheros guardados a la vez (compilar los guarda todos): el programa del último basta
        comprobar_doc = d
        return
    end
    if comprobar_pedido != 1
        comprobar_pedido = 2
        if not tras_pausa
            comprobar_pedido = 1
        end
    end
    comprobar_doc = d
    if not tic_armado
        armar_tic(TIC_MS, EV_TIC)
    end
end

# Desde tic(): empieza la comprobación pedida (si no hay nada en marcha), o mira si acabó la que corre
func comprobar_tic()
    if cmp_en_marcha()
        if cmp_mirar()
            if cmp_sin_check
                avisar(tr(733, "Esta orden dash no sabe comprobar (--check): actualiza Dash para ver los errores al guardar."), 1)
                comprobar_pedido = 0
                return
            end
            errores_cambiados(true)
        elif not tic_armado
            armar_tic(150, EV_TIC)
        end
        return
    end
    if comprobar_pedido == 0 or tarea != NADA or cmp_sin_check
        return
    end
    d = comprobar_doc
    if d == nil or indice_doc(d) < 0
        comprobar_pedido = 0
        return
    end
    if comprobar_pedido == 2
        if d.version == comprobar_version and comprobar_de == d
            comprobar_pedido = 0
            return
        end
        espera = COMPROBAR_MS - (time_ms() - ultimo_cambio)
        if espera > 0
            if not tic_armado
                armar_tic(espera + 20, EV_TIC)
            end
            return
        end
    end
    pedido = comprobar_pedido
    comprobar_pedido = 0
    orden = ""
    cajon = ""
    temporal = ""
    real = ""
    if pedido == 2 or d.ruta == ""
        # el texto del editor, sin guardar, a T: (lo que importa se encuentra desde su cajón)
        temporal = "T:forja_comprobar.dash"
        dos_requesters(false)
        if not file_exists("T:")
            temporal = "RAM:forja_comprobar.dash"
        end
        dos_requesters(true)
        if not file_write_text(temporal, ed_texto_disco(d))
            return
        end
        real = d.ruta
        if real == ""
            real = d.temporal
        else
            cajon = cajon_de(d.ruta)
        end
        orden = dashc() + " --check " + entre_comillas(temporal)
    else
        ruta = programa_de(d)
        cajon = cajon_de(ruta)
        orden = dashc() + " --check " + entre_comillas(ruta)
    end
    comprobar_version = d.version
    comprobar_de = d
    if cmp_empezar(orden, cajon, temporal, real) and not tic_armado
        armar_tic(150, EV_TIC)
    end
end

# El sitio de d en las pestañas; -1 si no está
func indice_doc(d: Documento) -> Int
    i = 0
    for o in documentos
        if o == d
            return i
        end
        i = i + 1
    end
    return -1
end

func _texto_errores() -> String
    t = err_sin_sitio
    for e in err_lista
        t = t + "\n" + e.entera
    end
    return t
end

# Los errores marcados cambiaron (al compilar o al comprobar): el editor, la barra y la salida (con decir, los que no
# se dijeron ya: al compilar, ya van a la salida)
func errores_cambiados(decir: Bool)
    if not abierta
        return
    end
    t = _texto_errores()
    if not decir
        errores_ultimos_marcados = t
    elif t != errores_ultimos_marcados
        errores_ultimos_marcados = t
        if err_lista.length > 0
            for e in err_lista
                salida_error_dashc(e.entera)
            end
            salida_mostrar(salida_lineas.length - 1)
        elif err_sin_sitio != ""
            salida_anadir("dash: Error: " + err_sin_sitio, 1)
        elif cmp_veces > 0
            salida_anadir(tr(728, "Sin errores."), 2)
        end
        mui_canvas_redraw(v.salida)
    end
    barra_error_al_dia()
    mui_canvas_redraw(v.editor)
end

# La barra (a la derecha del título de la salida): el error de la línea del cursor, o cuántos hay
func barra_error_al_dia()
    t = ""
    d = ed_actual()
    if err_lista.length > 0 and d != nil
        i = err_en(clave_errores(d), d.cl + 1)
        if i >= 0
            t = hueco(tr(729, "Línea %1: "), "#{err_lista[i].linea}") + err_lista[i].texto
        elif err_lista.length == 1
            t = tr(730, "1 error (F8)")
        else
            t = hueco(tr(731, "%1 errores (F8)"), "#{err_lista.length}")
        end
    elif err_sin_sitio != ""
        t = err_sin_sitio
    end
    if t != err_barra
        err_barra = t
        barra_poner("*errores", t)
        if abierta
            mui_canvas_redraw(v.salida)
        end
    end
end

# F8 y Mayúsculas+F8: al siguiente error (o al anterior), también en otro fichero
func ir_a_error(adelante: Bool)
    d = ed_actual()
    r = ""
    n = 0
    if d != nil
        r = clave_errores(d)
        n = d.cl + 1
    end
    i = err_siguiente(r, n, adelante)
    if i < 0
        avisar(tr(732, "No hay errores marcados."), 0)
        return
    end
    e = err_lista[i]
    o = doc_de(e.ruta)
    if o != nil
        activo = indice_doc(o)
    elif not abrir_sitio(e.ruta)
        return
    end
    col = e.col
    if col < 1
        col = 1
    end
    ed_ir_a(e.linea, col)
    cerrar_capas()
    redibujar()
    barra_error_al_dia()
end

# Ctrl + Espacio (o el menú): la lista para completar, aunque haya menos letras
func completar_ahora()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    y1 = ed_pintado_y1
    y2 = ed_pintado_y2
    indice_si_hace_falta(true)
    ac_calcular(d.lineas, d.cl, d.cc, d.version, true)
    redibujar_tras_tecla(true, y1, y2)
end

func _letra_de_nombre(letra: String) -> Bool
    if letra == ""
        return false
    end
    c = str_code(letra, 0)
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 192
end

# Tras una tecla que cambió el editor: la lista se filtra (o sale, o se cierra) y la ayuda sigue al cursor
var ms_completar: Int = 0         # lo que tardó la última lista (para la sonda)

func completar_despues(d: Documento, codigo: Int, letra: String)
    t0 = time_ms()
    if _letra_de_nombre(letra) or letra == "." or letra == "@" or (codigo == T_RETROCESO and ac_visible)
        indice_si_hace_falta(false)
        ac_calcular(d.lineas, d.cl, d.cc, d.version, false)
    else
        ac_cerrar()
    end
    ms_completar = time_ms() - t0
    if letra == "(" or letra == ","
        indice_si_hace_falta(false)
        ay_calcular(d.lineas, d.cl, d.cc, d.version)
    elif ay_visible
        if d.cl != ay_linea
            ay_cerrar()
        else
            ay_calcular(d.lineas, d.cl, d.cc, d.version)
        end
    end
end

# Abre (o va a) el fichero de un sitio: una ruta o "*nombre" (uno sin guardar); false si no puede
func abrir_sitio(ruta: String) -> Bool
    # un ejemplo de la ayuda sin nombre: su pestaña, no el fichero de T:
    o = doc_de(ruta)
    if o != nil and o.ruta == ""
        activo = indice_doc(o)
        return true
    end
    if str_starts(ruta, "*")
        i = 0
        for o in documentos
            if o.ruta == "" and "*" + o.nombre == ruta
                activo = i
                return true
            end
            i = i + 1
        end
        return false
    end
    if not abrir(ruta)
        return false
    end
    d = ed_actual()
    if d != nil and d.diseno
        # a una línea de un .dashui: como texto
        d.diseno = false
    end
    return true
end

func ir_a_sitio(ruta: String, linea: Int, col: Int)
    if abrir_sitio(ruta)
        ed_ir_a(linea, col)
    end
    cerrar_capas()
    redibujar()
end

# Amiga-J o Ctrl + clic: a donde se define el nombre del cursor
func ir_definicion()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    indice_si_hace_falta(true)
    r = cx_definicion(d.lineas, clave_de(d), d.cl, d.cc, d.version)
    if r == 0
        if cx_def_nombre == ""
            avisar(tr(230, "No hay un nombre en el cursor."), 1)
        else
            avisar(hueco(tr(231, "No sé dónde se define %1."), cx_def_nombre), 1)
        end
        return
    end
    if r == 2
        avisar(hueco(tr(232, "%1 es de Dash: "), cx_def_nombre) + cx_def_info, 0)
        return
    end
    historial_rutas.push(clave_de(d))
    historial_lineas.push(d.cl + 1)
    historial_cols.push(d.cc + 1)
    if historial_rutas.length > 50
        historial_rutas.remove(0)
        historial_lineas.remove(0)
        historial_cols.remove(0)
    end
    ir_a_sitio(cx_def_ruta, cx_def_linea, cx_def_col)
end

# Amiga-U: a donde se estaba antes de ir a la definición
func volver()
    if historial_rutas.length == 0
        avisar(tr(233, "No hay a dónde volver."), 1)
        return
    end
    r = historial_rutas.pop()
    l = historial_lineas.pop()
    c = historial_cols.pop()
    ir_a_sitio(r, l, c)
end

# Amiga-H: dónde se usa el nombre del cursor (en el fichero, lo que importa y los .dash del proyecto), en la salida
func referencias()
    d = ed_actual()
    if not es_codigo(d)
        return
    end
    indice_si_hace_falta(true)
    var otros: [String] = []
    for f in proyecto_ficheros
        if str_ends(str_lower(f), ".dash")
            otros.push(ruta_unir(proyecto_cajon, f))
        end
    end
    dos_requesters(false)
    hay = cx_referencias(d.lineas, clave_de(d), d.cl, d.cc, d.version, otros)
    dos_requesters(true)
    if not hay
        avisar(tr(230, "No hay un nombre en el cursor."), 1)
        return
    end
    n = cx_ref_lineas.length
    salida_anadir(hueco2(tr(234, "Dónde se usa %1: %2 sitios (clic en uno para ir)."), cx_def_nombre, "#{n}"), 2)
    i = 0
    while i < n
        r = cx_ref_rutas[i]
        nombre = nombre_de(r)
        if str_starts(r, "*")
            nombre = r[1:]
        end
        salida_anadir_sitio(nombre + ":#{cx_ref_lineas[i]}: " + cx_ref_textos[i], r, cx_ref_lineas[i], cx_ref_cols[i])
        i = i + 1
    end
    salida_atras = 0
    mui_canvas_redraw(v.salida)
end

func redibujar_linea(n: Int)
    d = ed_actual()
    if d == nil
        redibujar()
        return
    end
    fy = ed_fila_y(d, n)
    if fy < 0
        redibujar()
        return
    end
    t0 = time_ms()
    ed_solo_linea = n
    mui_canvas_update_area(v.editor, 0, fy, ed_zona_ancho, ed_alto_fila)
    ed_solo_linea = -1
    ms_lineas = time_ms() - t0
    n_lineas = 1
    escribir_sonda()
end

# Escribe un fichero de la sonda; si la prueba lo tiene abierto en ese momento, AmigaDOS no deja escribirlo:
# se reintenta unas veces (si no, la prueba leería lo de antes)
func sonda_fichero(ruta: String, texto: String)
    n = 0
    while not file_write_text(ruta, texto) and n < 20
        time_delay(1)
        n = n + 1
    end
end

func escribir_sonda()
    if sonda
        d = ed_actual()
        if d == nil
            sonda_fichero("RAM:forja-sonda.txt", "0 0 \n")
            return
        end
        sonda_fichero("RAM:forja-sonda.txt", "#{d.cl} #{d.cc} " + d.nombre + "\n" + ed_texto(d))
        env_set("FORJA_MARCAS", _lista_texto(d.marcadores) + "|" + _lista_texto(d.plegados), false)
        env_set("FORJA_PILAS", "#{d.deshacer.length} #{d.rehacer.length}", false)
        env_set("FORJA_DIBUJOS", "#{ed_dibujos}", false)
        if ed_vistas != sonda_vistas
            sonda_vistas = ed_vistas
            sonda_fichero("RAM:forja-vistas.txt", ed_vistas)
        end
        env_set("FORJA_DIBUJO", "#{ed_ms_dibujo}", false)
        env_set("FORJA_DISENO", "#{dv_sel} #{dv_prop} #{dv_editando} " + dv_mensaje, false)
        c = ""
        if ac_visible
            c = "#{ac_sel}"
            i = 0
            while i < ac_nombres.length and i < 12
                c = c + " " + ac_nombres[i]
                i = i + 1
            end
        end
        env_set("FORJA_VISTA", "#{d.primera} #{ed_alto_fila} #{ed_margen} #{ms_completar} #{ed_visibles}", false)
        ra = "0"
        if lr_visible
            el = ""
            if lr_la_elegida() >= 0
                el = str_trim(lr_textos[lr_la_elegida()])
            end
            ra = "#{lr_tipo} #{lr_vistos.length} #{lr_textos.length} #{lr_ms} " + el
        end
        if ra != sonda_rapida
            sonda_rapida = ra
            env_set("FORJA_RAPIDA", ra, false)
        end
        pa = "#{ed_par_l1} #{ed_par_c1} #{ed_par_l2} #{ed_par_c2} #{n_lineas} #{ms_lineas}"
        if pa != sonda_pareja
            sonda_pareja = pa
            env_set("FORJA_PAREJA", pa, false)
        end
        if c != sonda_completar
            sonda_completar = c
            env_set("FORJA_COMPLETAR", c, false)
        end
        a = ""
        if ay_visible
            a = "#{ay_arg} " + ed_texto_ayuda()
        end
        if a != sonda_ayuda
            sonda_ayuda = a
            env_set("FORJA_AYUDA", a, false)
        end
    end
end

# Las órdenes del menú Edición (también con Amiga sobre el editor)
func edicion(ev: Int)
    cerrar_capas()
    if ev == EV_COPIAR and salida_foco and salida_hay_seleccion()
        copiar_salida(true)
        return
    end
    d = ed_actual()
    if d == nil
        return
    end
    if d.vista != 0 and ev != EV_COPIAR and ev != EV_TODO
        return
    end
    if ev == EV_CORTAR or ev == EV_COPIAR
        s = ed_seleccion(d)
        if s != ""
            clip_write_text(latin1_to_utf8(s))
            if ev == EV_CORTAR
                ed_borrar_seleccion(d)
            end
        end
    elif ev == EV_PEGAR
        t = str_replace(utf8_to_latin1(clip_read_text()), "\r\n", "\n")
        if t != ""
            ed_escribir(d, str_replace(t, "\t", "    "))
        end
    elif ev == EV_DESHACER or ev == EV_REHACER
        # (sin nada que deshacer, nada que dibujar: Amiga-Z pulsada varias veces de más repintaba todo cada vez, y en
        # un fichero grande se quedaban en cola)
        hecho = false
        if ev == EV_DESHACER
            hecho = ed_deshacer(d)
        else
            hecho = ed_rehacer(d)
        end
        if not hecho and not d.diseno
            return
        end
    elif ev == EV_TODO
        ed_seleccionar_todo(d)
    elif ev == EV_DISENO
        if str_ends(str_lower(d.nombre), ".dashui")
            d.diseno = not d.diseno
            if d.diseno
                ed_cargar_diseno(d, true)
            end
        else
            avisar(tr(20, "El editor de ventanas es para ficheros .dashui."), 1)
        end
    elif ev == EV_VISTA
        if not d.diseno
            avisar(tr(21, "La vista previa es del editor de ventanas (Amiga-D en un .dashui)."), 1)
        elif dv_error_carga == ""
            e = dv_vista_previa(EV_VISTA_CERRADA, false)
            if e != ""
                avisar(tr(22, "Vista previa: ") + e, 1)
            end
        end
    end
    if d.diseno and (ev == EV_DESHACER or ev == EV_REHACER or ev == EV_PEGAR or ev == EV_CORTAR)
        ed_cargar_diseno(d, true)
        rehacer_vista()
    end
    ed_seguir_cursor(d)
    redibujar()
end

# Pone o quita un punto de parada; si se está depurando, también en el programa
func alternar_punto(d: Documento, n: Int)
    puntos_seguir()
    puesto = ed_alternar_punto(d, n)
    # con el proyecto: se guarda en el .forja (también su condición, si la tiene)
    if d.ruta != ""
        pr_punto_poner(d.ruta, n, puesto)
        if not d.cambiado
            pr_puntos_guardados(d.ruta)
        end
        puntos_raros_al_dia()
        if proyecto_de(d.ruta) != nil
            proyecto_guardar()
        end
    end
    if tarea == DEPURANDO
        if puesto
            if not dbg_break(d.nombre, n)
                avisar(hueco(tr(70, "La línea %1 no tiene código: el punto no para ahí."), "#{n}"), 1)
            end
        else
            dbg_unbreak(d.nombre, n)
        end
    end
    redibujar()
end

# Si la vista previa está abierta, se rehace con lo cambiado
func rehacer_vista()
    if dv_vista != 0 and dv_error_carga == ""
        e = dv_vista_previa(EV_VISTA_CERRADA, true)
        if e != ""
            avisar(tr(23, "Vista previa: ") + e, 1)
        end
    end
end

# F5 (depurar o seguir), F10 (paso), F6 (entrar) y F7 (salir): su evento, o 0. Valen con el puntero sobre el
# editor, el proyecto o la salida.
func tecla_depurador(codigo: Int) -> Int
    if codigo == T_F5
        if tarea == DEPURANDO
            return EV_SEGUIR
        end
        return EV_DEPURAR
    elif codigo == T_F10
        return EV_PASO
    elif codigo == T_F6
        return EV_ENTRAR
    elif codigo == T_F7
        return EV_SALIR_FUNCION
    end
    return 0
end

# Amiga + letra sobre el editor: el evento de su opción del menú (0 si no es ninguna)
func atajo(letra: String) -> Int
    var letras: [String] = ["x", "c", "v", "z", "r", "a", "q", "n", "o", "s", "w", "k", "e", "d", "p", "f", "l", "g", "b", "j", "u", "h"]
    var eventos: [Int] = [EV_CORTAR, EV_COPIAR, EV_PEGAR, EV_DESHACER, EV_REHACER, EV_TODO, EV_SALIR, EV_NUEVO, EV_ABRIR, EV_GUARDAR, EV_CERRAR, EV_COMPILAR, EV_EJECUTAR, EV_DISENO, EV_VISTA, EV_BUSCAR, EV_IRA, EV_DEPURAR, EV_NUEVO_EXT, EV_DEFINICION, EV_VOLVER, EV_REFERENCIAS]
    l = str_lower(letra)
    i = 0
    while i < letras.length
        if letras[i] == l
            return eventos[i]
        end
        i = i + 1
    end
    return 0
end

# Lo que pasa sobre el editor: un clic, la rueda o una tecla. Devuelve otro evento si es un atajo.
func en_editor() -> Int
    # un clic o una tecla en el editor (no un atajo con Amiga) le devuelven el foco
    if mui_canvas_button(lienzo_teclas) != 0 or (mui_canvas_key(lienzo_teclas) >= 0 and (mui_canvas_qualifiers(lienzo_teclas) & Q_AMIGA) == 0)
        salida_foco = false
    end
    if lr_visible
        return en_lista_rapida()
    end
    d = ed_actual()
    if d == nil
        codigo = mui_canvas_key(lienzo_teclas)
        if codigo >= 0
            # sin ficheros, abrir uno del proyecto por su nombre también vale
            o = tc_orden(codigo, mui_canvas_qualifiers(lienzo_teclas), mui_canvas_char(lienzo_teclas))
            if o == TC_ABRIR_FICHERO or o == TC_BUSCAR_PROYECTO
                return EV_ED + o
            end
        end
        return 0
    end
    rueda = mui_canvas_wheel(lienzo_teclas)
    teclas = mui_canvas_qualifiers(lienzo_teclas)
    if rueda != 0 or mui_canvas_button(lienzo_teclas) != 0
        # la lista para completar y la ayuda se cierran (lo que sigue lo redibuja todo)
        cerrar_capas()
    end
    if rueda != 0
        d.primera = ed_filas_desde(d, d.primera, -rueda * 3)
        maximo = d.lineas.length - ed_visibles
        if d.primera > maximo
            d.primera = maximo
        end
        if d.primera < 0
            d.primera = 0
        end
        redibujar()
    elif mui_canvas_button(lienzo_teclas) == 1 and ed_pestana_en(mui_canvas_mouse_x(lienzo_teclas), mui_canvas_mouse_y(lienzo_teclas)) >= 0
        activo = ed_pestana_en(mui_canvas_mouse_x(lienzo_teclas), mui_canvas_mouse_y(lienzo_teclas))
        redibujar()
    elif mui_canvas_button(lienzo_teclas) == 1 and d.diseno
        dv_clic(mui_canvas_mouse_x(lienzo_teclas), mui_canvas_mouse_y(lienzo_teclas))
        redibujar()
    elif mui_canvas_button(lienzo_teclas) == 1 and ed_ancho_marca > 0 and mui_canvas_mouse_x(lienzo_teclas) >= ed_x_marca(0) - 2 and mui_canvas_mouse_x(lienzo_teclas) < ed_margen - 4 and mui_canvas_mouse_y(lienzo_teclas) >= ALTO_PESTANAS and ext_clic_marca(d, ed_linea_en(d, mui_canvas_mouse_y(lienzo_teclas)))
        # un clic en la marca de una extensión: MARCA a la suya
        return 0
    elif mui_canvas_button(lienzo_teclas) == 1 and mui_canvas_mouse_x(lienzo_teclas) < ed_margen - 4 and mui_canvas_mouse_y(lienzo_teclas) >= ALTO_PESTANAS
        # un clic en el margen de los números: punto de parada
        alternar_punto(d, ed_linea_en(d, mui_canvas_mouse_y(lienzo_teclas)))
    elif mui_canvas_button(lienzo_teclas) == 1 and (teclas & Q_CTRL) != 0
        # Ctrl + clic: a la definición de lo que hay ahí
        ed_clic(mui_canvas_mouse_x(lienzo_teclas), mui_canvas_mouse_y(lienzo_teclas), false)
        d.al = -1
        redibujar()
        ir_definicion()
    elif mui_canvas_button(lienzo_teclas) == 1
        ed_clic(mui_canvas_mouse_x(lienzo_teclas), mui_canvas_mouse_y(lienzo_teclas), (teclas & Q_MAYUS) != 0)
        if d.vista != 0 and d.vista_ext == "*perfil"
            perfil_elegir(d)
            return 0
        end
        # un clic en el " ... end" de un bloque plegado lo despliega
        if ed_plegada(d, d.cl) and d.cc == d.lineas[d.cl].length and mui_canvas_mouse_x(lienzo_teclas) > ed_margen + (d.cc - d.izquierda) * ancho_letra + ancho_letra
            ed_desplegar(d, d.cl)
        end
        redibujar()
    else
        codigo = mui_canvas_key(lienzo_teclas)
        if codigo < 0
            return 0
        end
        letra = mui_canvas_char(lienzo_teclas)
        # las órdenes del editor (teclas.dash, menú Editor)
        o = tc_orden(codigo, teclas, letra)
        if o != 0 and not d.diseno
            return EV_ED + o
        end
        # las teclas de las extensiones (las de Forja van antes)
        r = ext_tecla(codigo, teclas)
        if r >= 0 and ((teclas & Q_AMIGA) == 0 or atajo(letra) == 0)
            ext_menu(r)
            return 0
        end
        if (teclas & Q_AMIGA) != 0
            return atajo(letra)
        end
        if codigo == T_F9
            alternar_punto(d, d.cl + 1)
            return 0
        end
        if codigo == T_F10 and (teclas & Q_CTRL) != 0
            return EV_HASTA_AQUI
        end
        if d.vista != 0 and d.vista_ext == "*perfil" and (codigo == T_RETURN or codigo == T_ENTER)
            perfil_elegir(d)
            return 0
        end
        if codigo == T_F8
            if (teclas & Q_MAYUS) != 0
                return EV_ERROR_ANTERIOR
            end
            return EV_ERROR_SIGUIENTE
        end
        if (codigo == T_HELP or codigo == T_F1) and es_codigo(d)
            ayuda_del_cursor(d)
            return 0
        end
        otro = tecla_depurador(codigo)
        if otro != 0
            return otro
        end
        if d.vista != 0 and ext_tecla_vista(d, codigo, letra)
            return 0
        end
        if d.diseno
            if dv_tecla(codigo, teclas, letra)
                ed_aplicar_diseno(d)
                rehacer_vista()
            end
            redibujar()
            return 0
        end
        if completar_activo and completar_tecla(d, codigo, teclas)
            return 0
        end
        if sugerencia_tecla(d, codigo, teclas)
            return 0
        end
        # escribir dentro de una línea solo redibuja esa línea (y la lista o la ayuda, si están)
        antes_lineas = d.lineas.length
        antes_cl = d.cl
        antes_primera = d.primera
        antes_izquierda = d.izquierda
        antes_cambiado = d.cambiado
        antes_sel = ed_hay_seleccion(d)
        antes_version = d.version
        y1 = ed_pintado_y1
        y2 = ed_pintado_y2
        if ed_tecla(codigo, teclas, letra)
            if d.version != antes_version
                # las variables locales siguen valiendo mientras se escribe en la misma línea
                if d.cl != linea_escrita or d.lineas.length != lineas_antes
                    cx_locales_olvidar()
                end
                linea_escrita = d.cl
                lineas_antes = d.lineas.length
                ultimo_cambio = time_ms()
                if completar_activo and not tic_armado
                    armar_tic(REPOSO_MS, EV_TIC)
                end
                ext_tras_escribir(d)
                comprobar_pedir(d, true)
            end
            if completar_activo
                completar_despues(d, codigo, letra)
            end
            solo = d.lineas.length == antes_lineas and d.cl == antes_cl and d.primera == antes_primera and d.izquierda == antes_izquierda and antes_cambiado and not antes_sel and not ed_hay_seleccion(d)
            # el cursor pasó a otra línea sin mover la vista ni cambiar el texto: solo las dos líneas
            otra = d.version == antes_version and d.cl != antes_cl and d.primera == antes_primera and d.izquierda == antes_izquierda and not antes_sel and not ed_hay_seleccion(d)
            redibujar_tras_tecla_pareja(solo, otra, antes_cl, y1, y2)
        end
    end
    return 0
end

func publicar_sonda()
    e = "#{ed_zona_x} #{ed_zona_y} #{ed_zona_ancho} #{ed_zona_alto}"
    if e != sonda_editor
        sonda_editor = e
        env_set("FORJA_EDITOR", e, false)
    end
    p = "#{proyecto_zona_x} #{proyecto_zona_y + proyecto_y0} #{proyecto_fila}"
    if p != sonda_proyecto
        sonda_proyecto = p
        env_set("FORJA_PROYECTO", p, false)
    end
    lista = proyecto_cajon
    for f in proyecto_ficheros
        lista = lista + "|" + f
    end
    if depuracion.length > 0
        lista = "(depurando)"
    end
    if lista != sonda_lista
        sonda_lista = lista
        env_set("FORJA_FICHEROS", lista, false)
    end
    # el árbol de las variables: la zona (x, y, ancho, alto), la primera fila, lo desplazado, el alto de fila, lo
    # ancho, lo que cabe y la y de cada fila que se ve
    a = "#{depuracion_zona_x} #{depuracion_zona_y} #{depuracion_zona_ancho} #{depuracion_zona_alto} #{depuracion_desde} #{depuracion_dx} #{depuracion_fila} #{depuracion_ancho} #{depuracion_ancho_caben}"
    for ay in depuracion_ys
        a = a + " #{ay}"
    end
    if a != sonda_arbol
        sonda_arbol = a
        env_set("FORJA_ARBOL", a, false)
    end
    b = bb_sonda()
    if b != sonda_botones
        sonda_botones = b
        env_set("FORJA_BOTONES", b, false)
    end
    s = "#{salida_zona_x} #{salida_zona_y + salida_y0} #{salida_fila} #{salida_desde} #{salida_lineas.length}"
    if s != sonda_salida
        sonda_salida = s
        env_set("FORJA_SALIDA", s, false)
        texto = ""
        for l in salida_lineas
            texto = texto + l + "\n"
        end
        sonda_fichero("RAM:forja-salida.txt", texto)
    end
    d = ed_actual()
    t = ed_pestanas_ventana()
    if t != sonda_pestanas
        sonda_pestanas = t
        env_set("FORJA_PESTANAS", t, false)
    end
    # los errores marcados: "veces ms_última en_marcha|ruta:línea:col texto|..." (errores.dash)
    en_marcha = 0
    if cmp_en_marcha()
        en_marcha = 1
    end
    e = "#{cmp_veces} #{cmp_ms} #{en_marcha}" + err_resumen() + "~" + err_barra
    if e != sonda_errores
        sonda_errores = e
        env_set("FORJA_ERRORES", e, false)
    end
    # la ventana de la ayuda: lo que se ve (ayf_sonda) y, en RAM:forja-ayuda.txt, la ficha como se pinta y la lista
    a = ayf_sonda()
    if not ayf_abierta
        a = "cerrada"
    end
    if a != sonda_ayudav
        sonda_ayudav = a
        env_set("FORJA_AYUDAV", a, false)
        sonda_fichero("RAM:forja-ayuda.txt", ayf_sonda_texto())
    end
end

# --- Buscar y cambiar, ir a la línea ---

# Busca lo de la ventana de buscar; false (y un aviso) si no está
# La casilla "Expresión regular" de la ventana de buscar pasa a ed_regex; false (y lo dice) si el patrón está mal
func con_regex(t: String) -> Bool
    ed_regex = mui_get_value(vb.regex) != 0
    malo = ed_patron_malo(t)
    if malo != ""
        avisar(hueco(tr(833, "La expresión regular está mal: %1"), malo), 1)
        ed_regex = false
        return false
    end
    return true
end

func buscar(adelante: Bool) -> Bool
    d = ed_actual()
    t = mui_get_text(vb.texto)
    if d == nil or t == "" or not con_regex(t)
        return false
    end
    hallado = ed_buscar(d, t, mui_get_value(vb.mayus) != 0, adelante)
    ed_regex = false
    if not hallado
        avisar(tr(24, "No está \"") + t + "\".", 1)
        return false
    end
    redibujar()
    return true
end

# Cambia lo elegido (si es lo buscado) y busca el siguiente
func cambiar_uno()
    d = ed_actual()
    t = mui_get_text(vb.texto)
    if d == nil or t == ""
        return
    end
    if not con_regex(t)
        return
    end
    if ed_hay_seleccion(d) and ed_elegido_es(d, t, mui_get_value(vb.mayus) != 0)
        ed_escribir(d, ed_texto_cambio(mui_get_text(vb.cambio)))
    end
    ed_regex = false
    buscar(true)
    redibujar()
end

func cambiar_todo(t: String, nuevo: String, mayus: Bool) -> Int
    d = ed_actual()
    if d == nil
        return 0
    end
    if not con_regex(t)
        return 0
    end
    n = ed_cambiar_todo(d, t, nuevo, mayus)
    ed_regex = false
    avisar(hueco(tr(71, "Cambiado %1 veces."), "#{n}"), 2)
    redibujar()
    return n
end

# --- Buscar y cambiar en el proyecto (paso 2.3) ---

func cajon_proyecto() -> String
    if proyecto_cajon != ""
        return proyecto_cajon
    end
    d = ed_actual()
    if d != nil and d.ruta != ""
        return cajon_de(d.ruta)
    end
    return ""
end

# Lo de la ventana de buscar, en todo el proyecto: a la salida, con clic a cada sitio
func buscar_proyecto()
    t = mui_get_text(vb.texto)
    cajon = cajon_proyecto()
    if t == "" or cajon == "" or not con_regex(t)
        return
    end
    dos_requesters(false)
    n = bp_buscar(cajon, t, mui_get_value(vb.mayus) != 0, BP_MAX)
    dos_requesters(true)
    ed_regex = false
    if bp_veces == 0
        avisar(hueco2(tr(834, "\"%1\" no está en el proyecto (%2 ficheros)."), t, "#{bp_mirados}"), 1)
        return
    end
    salida_anadir(tr(835, "Buscar \"") + t + "\": " + hueco2(tr(836, "%1 veces en %2 ficheros (clic en una para ir)."), "#{bp_veces}", "#{bp_ficheros}"), 2)
    i = 0
    while i < n
        salida_anadir_sitio(_nombre_en_proyecto(bp_rutas[i], cajon) + ":#{bp_lineas[i]}: " + str_trim(bp_textos[i]), bp_rutas[i], bp_lineas[i], bp_cols[i])
        i = i + 1
    end
    if bp_veces > n
        salida_anadir(hueco(tr(837, "... y %1 más."), "#{bp_veces - n}"), 1)
    end
    salida_atras = 0
    mui_canvas_redraw(v.salida)
end

# La ruta desde el cajón del proyecto ("lib/red.dash")
func _nombre_en_proyecto(ruta: String, cajon: String) -> String
    if cajon != "" and str_starts(str_lower(ruta), str_lower(cajon))
        r = ruta[cajon.length:]
        if str_starts(r, "/")
            r = r[1:]
        end
        return r
    end
    return nombre_de(ruta)
end

# Cambiar en todo el proyecto: primero la lista de cambios (una pestaña de solo lectura: cada línea antes, en rojo, y
# después, en verde), y luego se pregunta
func cambiar_proyecto()
    t = mui_get_text(vb.texto)
    nuevo = mui_get_text(vb.cambio)
    cajon = cajon_proyecto()
    if t == "" or cajon == "" or not con_regex(t)
        return
    end
    dos_requesters(false)
    n = bp_cambios(cajon, t, nuevo, mui_get_value(vb.mayus) != 0)
    dos_requesters(true)
    ed_regex = false
    if n == 0
        avisar(hueco2(tr(834, "\"%1\" no está en el proyecto (%2 ficheros)."), t, "#{bp_mirados}"), 1)
        return
    end
    titulo = hueco2(tr(838, "Cambiar \"%1\" por \"%2\""), t, nuevo)
    if aplicar_cambios(titulo, cajon)
        avisar(hueco2(tr(839, "Cambiado %1 veces en %2 ficheros."), "#{n}", "#{bp_c_rutas.length}"), 2)
    end
end

# Enseña los cambios de bp_c_* en una pestaña, pregunta y los hace (true si se hicieron). Lo usan cambiar en el
# proyecto y renombrar
func aplicar_cambios(titulo: String, cajon: String) -> Bool
    var lineas: [String] = [titulo + "  (" + hueco2(tr(840, "%1 veces en %2 ficheros"), "#{bp_c_veces}", "#{bp_c_rutas.length}") + ")", ""]
    colores = "@ "
    i = 0
    while i < bp_c_rutas.length
        lineas.push(_nombre_en_proyecto(bp_c_rutas[i], cajon))
        colores = colores + "@"
        nums = str_split(bp_c_lineas[i], " ")
        antes = str_split(bp_c_antes[i], "\n")
        despues = str_split(bp_c_despues[i], "\n")
        j = 0
        while j < nums.length
            num = nums[j]
            while num.length < 5
                num = " " + num
            end
            lineas.push("- " + num + ": " + antes[j])
            lineas.push("+ " + num + ": " + despues[j])
            colores = colores + "-+"
            j = j + 1
        end
        lineas.push("")
        colores = colores + " "
        i = i + 1
    end
    activo_antes = activo
    ed_abrir_vista("", tr(841, "Cambios"), lineas, colores)
    redibujar()
    r = mui_request(v.window, tr(842, "Cambiar en el proyecto"), hueco2(tr(843, "¿Hago estos %1 cambios en %2 ficheros?\n\nLos ficheros abiertos cambian en el editor (sin guardar; se pueden deshacer).\nLos demás se guardan en el disco."), "#{bp_c_veces}", "#{bp_c_rutas.length}"), tr(844, "_Cambiar|C_ancelar"))
    # la pestaña de los cambios se cierra; se vuelve a la de antes
    k = activo
    if k >= 0 and documentos[k].vista != 0 and documentos[k].vista_ext == ""
        ed_cerrar(k)
    end
    if activo_antes >= 0 and activo_antes < documentos.length
        activo = activo_antes
    end
    if r != 1
        redibujar()
        return false
    end
    hechos = bp_aplicar()
    for ruta in bp_c_rutas
        k = ed_buscar_ruta(ruta)
        if k >= 0
            tras_escribir(documentos[k])
        end
    end
    for ruta in bp_no_escritos
        avisar(hueco(tr(845, "No he podido escribir %1."), ruta), 1)
    end
    redibujar()
    return hechos > 0
end

func ir_a(n: Int)
    if n > 0
        ed_ir_a(n, 1)
        redibujar()
    end
end

# --- Preferencias, y lo que se abre al empezar ---

func preferencias_abrir()
    mui_set_text(vp.dashc, dashc())
    mui_set_text(vp.ejecutables, cajon_ejecutables())
    mui_set_value(vp.recordar, recordar_sesion())
    mui_set_value(vp.pantalla, env_get("Forja/pantalla") == "si")
    mui_set_value(vp.completar, completar_activo)
    mui_set_value(vp.comprobar, comprobar_activo)
    mui_set_value(vp.buscar, env_get("Forja/buscar_dash") != "no")
    mui_window_open(vp.window)
end

func recordar_sesion() -> Bool
    return env_get("Forja/recordar") != "no"
end

func preferencias_aplicar(guardar: Bool)
    env_set("Forja/dashc", str_trim(mui_get_text(vp.dashc)), guardar)
    env_set("Forja/ejecutables", str_trim(mui_get_text(vp.ejecutables)), guardar)
    if mui_get_value(vp.recordar) != 0
        env_set("Forja/recordar", "si", guardar)
    else
        env_set("Forja/recordar", "no", guardar)
    end
    if mui_get_value(vp.pantalla) != 0
        env_set("Forja/pantalla", "si", guardar)
    else
        env_set("Forja/pantalla", "no", guardar)
    end
    completar_activo = mui_get_value(vp.completar) != 0
    if completar_activo
        env_set("Forja/completar", "si", guardar)
    else
        env_set("Forja/completar", "no", guardar)
        cerrar_capas()
        redibujar()
    end
    comprobar_activo = mui_get_value(vp.comprobar) != 0
    if comprobar_activo
        env_set("Forja/comprobar", "si", guardar)
    else
        env_set("Forja/comprobar", "no", guardar)
    end
    if mui_get_value(vp.buscar) != 0
        env_set("Forja/buscar_dash", "si", guardar)
    else
        env_set("Forja/buscar_dash", "no", guardar)
    end
    mui_window_close(vp.window)
end

# Al salir: el cajón del proyecto y los ficheros abiertos, para la próxima vez (ENVARC:Forja/sesion, con "|"), también
# los de las extensiones (un sprite, un mapa: EDITANDO), que se abren otra vez con ellas. Y en ENVARC:Forja/sesion_estado
# lo de cada fichero de Forja: la ruta, la primera línea que se ve, el cursor, los marcadores y lo plegado, separados
# por tabuladores (las listas, con comas), y cada fichero tras el carácter 30 (env_get lee una sola línea); lo primero,
# "activo" y el fichero de delante.
func sesion_guardar()
    t = proyecto_cajon
    estado = "activo\t"
    d = ed_actual()
    if d != nil
        estado = estado + d.ruta
    end
    for d in documentos
        if d.ruta != "" and d.vista == 0
            t = t + "|" + d.ruta
            estado = estado + str_char(30) + d.ruta + "\t#{d.primera}\t#{d.cl}\t#{d.cc}\t" + _lista_texto(d.marcadores) + "\t" + _lista_texto(d.plegados)
        end
    end
    for r in ext_abiertos()
        t = t + "|" + r
    end
    env_set("Forja/sesion", t, true)
    env_set("Forja/sesion_estado", estado, true)
end

func _lista_texto(ls: [Int]) -> String
    t = ""
    if ls != nil
        for n in ls
            if t != ""
                t = t + ","
            end
            t = t + "#{n}"
        end
    end
    return t
end

func _lista_de(t: String) -> [Int]
    var r: [Int] = []
    if t != ""
        for p in str_split(t, ",")
            r.push(Int(p))
        end
    end
    return r
end

# Al empezar sin fichero: lo de la última vez; false si no había nada
func sesion_abrir() -> Bool
    if not recordar_sesion()
        return false
    end
    partes = str_split(env_get("Forja/sesion"), "|")
    # un fichero de un disco que ya no está (DF0:, otro Work:): sin el requester de "Inserta el volumen", que dejaba
    # Forja esperando al arrancar; se salta
    dos_requesters(false)
    abiertos = 0
    i = 1
    while i < partes.length
        if file_exists(partes[i]) and abrir(partes[i])
            abiertos = abiertos + 1
        end
        i = i + 1
    end
    if partes[0] != "" and file_exists(partes[0])
        proyecto_leer(partes[0])
    elif abiertos > 0
        proyecto_leer(cajon_de(ed_actual().ruta))
    end
    dos_requesters(true)
    sesion_estado()
    return abiertos > 0
end

# Lo de cada fichero de la sesión (ENVARC:Forja/sesion_estado): dónde estaba, sus marcadores y lo plegado. Si el
# fichero cambió por fuera y una línea ya no está, esa se salta.
func sesion_estado()
    activo_antes = ""
    for l in str_split(env_get("Forja/sesion_estado"), str_char(30))
        c = str_split(l, "\t")
        if c.length == 2 and c[0] == "activo"
            activo_antes = c[1]
        elif c.length >= 6
            i = ed_buscar_ruta(c[0])
            if i >= 0
                d = documentos[i]
                n = d.lineas.length
                var ms: [Int] = []
                for m in _lista_de(c[4])
                    if m >= 0 and m < n
                        ms.push(m)
                    end
                end
                d.marcadores = ms
                for pl in _lista_de(c[5])
                    if pl >= 0 and pl < n
                        ed_plegar(d, pl)
                    end
                end
                cl = Int(c[2])
                if cl >= 0 and cl < n
                    d.cl = cl
                    d.cc = Int(c[3])
                    if d.cc > d.lineas[cl].length
                        d.cc = d.lineas[cl].length
                    end
                    if d.cc < 0
                        d.cc = 0
                    end
                    d.primera = Int(c[1])
                    if d.primera < 0 or d.primera > cl
                        d.primera = cl
                    end
                    ed_destapar(d, cl)
                end
            end
        end
    end
    if activo_antes != ""
        i = ed_buscar_ruta(activo_antes)
        if i >= 0
            activo = i
        end
    end
end

var compilar_desde: String = ""    # COMPILAR fichero (una extensión): compilar el programa de ese fichero
var abrir_delegado: Bool = false   # el último abrir() lo mandó a una extensión (EDITAR)
# Las opciones sueltas del menú Extensiones (las ranuras 0 a 11): se ponen en marcha con mui_menu_extend, solo las
# que hay (antes, 12 opciones vacías y apagadas fijas en ventana.dashui); su objeto (0: ninguna) y de qué está hecho
var ext_items: [Int] = []
var ext_items_firma: String = ""
# Los menús propios de las extensiones (submenu = título), en la barra de menús tras Extensiones: su objeto (0 si no
# hay) y de qué está hecho (título y opciones), para no rehacerlo si no cambió (con MUI 3.8 rehacerlo cierra y abre la
# ventana)
var ext_menus: [Int] = [0, 0, 0]
var ext_menus_firma: [String] = ["", "", ""]
var ext_elegida: Int = -1          # la elegida en el gestor

# Su cajón: ENV:Forja/extensiones, o Extensiones junto a Forja (la ruta entera: PROGDIR: es de cada proceso)
func ext_cajon_de_forja() -> String
    c = env_get("Forja/extensiones")
    if c != ""
        return c
    end
    dos_requesters(false)
    dir_create("PROGDIR:Extensiones")
    c = file_real_path("PROGDIR:Extensiones")
    dos_requesters(true)
    if c == ""
        c = "PROGDIR:Extensiones"
    end
    return c
end

# Tras cada evento y cada orden ARexx: ACTIVO si cambió el fichero activo, los avisos, los mensajes, el menú y lo
# que hay que redibujar
func ext_tras_evento()
    if extensiones.length == 0
        return
    end
    d = ed_actual()
    clave = ""
    if d != nil
        clave = d.ruta
        if clave == ""
            clave = d.nombre
        end
    end
    if clave != ext_activo_antes
        ext_activo_antes = clave
        ext_suceso("ACTIVO", clave)
    end
    if proyecto_cajon != ext_proyecto_antes
        ext_proyecto_antes = proyecto_cajon
        ext_suceso("PROYECTO", proyecto_cajon)
    end
    ext_avisar()
    while ext_mensajes.length > 0
        avisar(ext_mensajes[0], ext_mensajes_tipo[0])
        ext_mensajes.remove(0)
        ext_mensajes_tipo.remove(0)
    end
    if ext_ranuras_cambiadas
        ext_ranuras_cambiadas = false
        ext_menus_al_dia()
    end
    if ext_dibujar and abierta
        ext_dibujar = false
        mui_canvas_redraw(v.editor)
        mui_canvas_redraw(v.proyecto)
        mui_canvas_redraw(v.salida)
    end
end

# Los menús propios de las extensiones: los que cambiaron se quitan y se vuelven a hacer (mui_menu_add); y las
# opciones sueltas del menú Extensiones (mui_menu_extend)
func ext_menus_al_dia()
    firma = ""
    r = 0
    while r < EXT_RANURAS and r < ext_ranura_ext.length
        if ext_ranura_ext[r] >= 0
            firma = firma + "|#{r}:" + ext_ranura_titulo[r]
        end
        r = r + 1
    end
    if firma != ext_items_firma
        ext_items_firma = firma
        for o in ext_items
            mui_menu_remove(o)
        end
        ext_items.clear()
        if firma != ""
            # (tras la raya de ventana.dashui: mui_menu_separator no da un objeto que se pueda quitar luego)
            mui_menu_extend(v.menu_extensiones)
            r = 0
            while r < EXT_RANURAS and r < ext_ranura_ext.length
                if ext_ranura_ext[r] >= 0
                    ext_items.push(mui_menu_item(ext_ranura_titulo[r], "", EV_EXT_MENU + r))
                end
                r = r + 1
            end
            mui_menu_end()
        end
    end
    if sonda
        env_set("FORJA_MENU_EXT", firma, false)
    end
    s = 0
    while s < EXT_SUBMENUS
        firma = ""
        if ext_sub_ext[s] >= 0
            firma = ext_sub_titulo[s]
            k = 0
            while k < EXT_SUB_OPCIONES
                r = EXT_RANURAS + s * EXT_SUB_OPCIONES + k
                if ext_ranura_ext[r] >= 0
                    firma = firma + "|#{r}:" + ext_ranura_titulo[r]
                end
                k = k + 1
            end
        end
        if firma != ext_menus_firma[s]
            ext_menus_firma[s] = firma
            if ext_menus[s] != 0
                mui_menu_remove(ext_menus[s])
                ext_menus[s] = 0
            end
            if firma != ""
                ext_menus[s] = mui_menu_add(v.window, ext_sub_titulo[s])
                k = 0
                while k < EXT_SUB_OPCIONES
                    r = EXT_RANURAS + s * EXT_SUB_OPCIONES + k
                    if ext_ranura_ext[r] >= 0
                        mui_menu_item(ext_ranura_titulo[r], "", EV_EXT_MENU + r)
                    end
                    k = k + 1
                end
                mui_menu_end()
            end
        end
        s = s + 1
    end
end

# Se escribió en d: CAMBIADO a las que lo piden cuando lleven su pausa sin escribir
func ext_tras_escribir(d: Documento)
    if not ext_alguna_pide("cambiado")
        return
    end
    r = d.ruta
    if r == ""
        r = d.nombre
    end
    ext_escrito(r)
    if not tic_armado
        armar_tic(300, EV_TIC)
    end
end

func ext_reposo()
    falta = ext_cambiados()
    if falta >= 0 and not tic_armado
        armar_tic(falta + 20, EV_TIC)
    end
end

# Que las marcas y las rayas de las extensiones sigan a su texto al escribir: se mira el documento activo antes y
# después de cada evento y de cada orden ARexx; si cambió su número de líneas, se mueven las de después
var _sm_doc: Documento = nil
var _sm_lineas: Int = 0
var _sm_cl: Int = 0
var _sm_version: Int = 0

func seguir_antes()
    _sm_doc = ed_actual()
    if _sm_doc != nil
        _sm_lineas = _sm_doc.lineas.length
        _sm_cl = _sm_doc.cl
        _sm_version = _sm_doc.version
    end
end

func seguir_despues()
    puntos_seguir()
    d = _sm_doc
    _sm_doc = nil
    if d != nil and d.version != _sm_version
        # se escribió (también deshacer, pegar, ARexx...): sus errores, tras la pausa
        ultimo_cambio = time_ms()
        comprobar_pedir(d, true)
    end
    if d == nil or (d.ruta == "" and d.temporal == "") or (marcas_margen.length == 0 and marcas_rayas.length == 0 and err_lista.length == 0)
        return
    end
    delta = d.lineas.length - _sm_lineas
    if delta == 0
        if err_lista.length > 0 and d.cl != _sm_cl
            barra_error_al_dia()
        end
        return
    end
    desde = _sm_cl
    if d.cl < desde
        desde = d.cl
    end
    quitadas = 1
    puestas = 1 + delta
    if delta < 0
        quitadas = 1 - delta
        puestas = 1
    end
    movidas = err_mover(clave_errores(d), desde + 1, quitadas, puestas)
    movidas = marcas_mover(str_lower(d.ruta), desde + 1, quitadas, puestas) or movidas
    if movidas and abierta and d == ed_actual()
        mui_canvas_redraw(v.editor)
    end
    if err_lista.length > 0
        barra_error_al_dia()
    end
end

# Un clic en la zona de la extensión id en la barra de botones: ZONA, a ella
func ext_zona(id: String)
    i = ext_buscar(id)
    if i >= 0 and extensiones[i].estado != EXT_PARADA
        ext_suceso_a(i, "ZONA")
    end
end

# Una tecla en la vista de una extensión: TECLA tecla línea nombre, a ella (las flechas y Esc se quedan en Forja).
# true si era suya.
func ext_tecla_vista(d: Documento, codigo: Int, letra: String) -> Bool
    if codigo == T_IZQUIERDA or codigo == T_DERECHA or codigo == T_ARRIBA or codigo == T_ABAJO or codigo == T_ESC
        return false
    end
    i = ext_buscar(d.vista_ext)
    t = letra
    if codigo == T_RETURN or codigo == T_ENTER
        t = "return"
    elif codigo == T_TAB
        t = "tab"
    elif codigo == T_RETROCESO or codigo == T_SUPRIMIR
        t = "borrar"
    elif t == " "
        t = "espacio"
    end
    if i < 0 or t == "" or extensiones[i].estado == EXT_PARADA
        return true
    end
    ext_suceso_a(i, "TECLA " + t + " #{d.cl + 1} " + d.nombre)
    return true
end

# Al salir: hasta 2 s atendiendo ARexx para que las que están en marcha recojan su SALIR. Una orden que llegara a un
# puerto que ya no atiende nadie dejaría a la extensión esperando para siempre.
# Forja se cierra y se eligió Guardar: GUARDAR a las extensiones con ficheros sin guardar, y se espera (atendiendo
# ARexx) a que digan con SINGUARDAR que ya no les queda ninguno, 20 s como mucho (pueden preguntar dónde guardar uno
# nuevo). false si alguna no lo hizo.
func ext_guardar_todo() -> Bool
    if ext_sin_guardar().length == 0
        return true
    end
    ext_pedir_guardar()
    t0 = time_ms()
    while time_ms() - t0 < 20000
        if ext_sin_guardar().length == 0
            return true
        end
        mui_timer(200, EV_TIC)
        mui_wait_event()
    end
    return ext_sin_guardar().length == 0
end

func ext_esperar_salida()
    t0 = time_ms()
    while time_ms() - t0 < 2000
        quedan = false
        for e in extensiones
            if e.estado != EXT_PARADA and e.cola.length > 0
                quedan = true
            end
        end
        if not quedan
            return
        end
        mui_timer(100, EV_TIC)
        mui_wait_event()
    end
end

# Un clic en la marca de la línea n: MARCA ruta línea a la extensión de la marca (si pide "marca"); false si no hay
func ext_clic_marca(d: Documento, n: Int) -> Bool
    if marca_en(str_lower(d.ruta), n) == ""
        return false
    end
    i = ext_buscar(marca_ext)
    if i < 0 or not ext_pide(extensiones[i], "marca") or extensiones[i].estado == EXT_PARADA
        return false
    end
    ext_suceso_a(i, "MARCA " + d.ruta + " #{n}")
    return true
end

# --- El gestor de extensiones ---

func gestor(ev: Int)
    if ev == EV_EXT_GESTOR
        gestor_lista()
        mui_window_open(vx.window)
    elif ev == EV_EXT_LISTA
        ext_elegida = mui_get_value(vx.lista)
        gestor_info()
    elif ev == EV_EXT_ACTIVAR or ev == EV_EXT_DOBLE
        if ext_elegida >= 0 and ext_elegida < extensiones.length
            ext_activar(ext_elegida, not extensiones[ext_elegida].activa)
            gestor_lista()
        end
    elif ev == EV_EXT_INSTALAR
        gestor_instalar()
    elif ev == EV_EXT_CERRAR
        mui_window_close(vx.window)
    end
end

func gestor_lista()
    mui_list_quiet(vx.lista, true)
    mui_list_clear(vx.lista)
    for e in extensiones
        mui_list_add(vx.lista, ext_linea(e))
    end
    mui_list_quiet(vx.lista, false)
    if ext_elegida >= extensiones.length
        ext_elegida = extensiones.length - 1
    end
    if ext_elegida < 0 and extensiones.length > 0
        ext_elegida = 0
    end
    mui_set_value(vx.lista, ext_elegida)
    gestor_info()
end

func gestor_info()
    if ext_elegida < 0 or ext_elegida >= extensiones.length
        mui_set_text(vx.info, hueco(tr(626, "No hay extensiones. Se instalan con Instalar, o en %1."), ext_cajon))
        mui_set_enabled(vx.activar, false)
        return
    end
    e = extensiones[ext_elegida]
    mui_set_text(vx.info, ext_info(e))
    mui_set_enabled(vx.activar, true)
    if e.activa
        mui_set_text(vx.activar, tr(627, "Desactivar"))
    else
        mui_set_text(vx.activar, tr(628, "Activar"))
    end
end

# Instalar desde un cajón (se elige su manifiesto.txt) o un .lha: enseña qué es y pregunta antes de copiar
func gestor_instalar()
    # (para las pruebas, con la sonda: ENV:FORJA_INSTALAR en vez de la petición de ASL, que no se puede manejar sola)
    ruta = ""
    if sonda and env_get("FORJA_INSTALAR") != ""
        ruta = env_get("FORJA_INSTALAR")
        env_set("FORJA_INSTALAR", "", false)
    elif file_open_dialog(tr(629, "Instalar una extensión: su manifiesto.txt o un .lha"), "(manifiesto.txt|#?.lha)")
        ruta = file_fullpath()
    end
    if ruta == ""
        return
    end
    dir = cajon_de(ruta)
    if str_ends(str_lower(ruta), ".lha")
        dir = ext_sacar_lha(ruta)
        if dir == ""
            avisar(ext_error_instalar, 1)
            return
        end
    end
    e = ext_leer_manifiesto(cajon_de(dir), nombre_de_cajon(dir))
    if e == nil
        avisar(tr(615, "No tiene manifiesto.txt."), 1)
        ext_limpiar_lha()
        return
    end
    texto = e.nombre + " " + e.version
    if e.autor != ""
        texto = texto + tr(630, ", de ") + e.autor
    end
    texto = texto + "\n\n" + e.descripcion + "\n\n" + tr(631, "Una extensión es un programa: puede hacer cualquier cosa en tu Amiga.\nInstálala solo si te fías de quien la hizo.")
    r = mui_request(vx.window, tr(632, "Instalar una extensión"), texto, tr(633, "Instalar y _activar|_Instalar|_Cancelar"))
    if r == 0
        ext_limpiar_lha()
        return
    end
    i = ext_instalar_cajon(dir)
    ext_limpiar_lha()
    if i < 0
        avisar(ext_error_instalar, 1)
        return
    end
    if r == 1
        ext_activar(i, true)
    else
        ext_ranuras()
        ext_guardar_apagadas()
    end
    avisar(hueco(tr(634, "Instalada la extensión %1."), extensiones[i].nombre), 2)
    ext_elegida = i
    gestor_lista()
end

# --- El puerto ARexx FORJA.1 ---

# Las palabras de una orden: un argumento entre comillas puede llevar espacios. resto_desde dice desde qué
# argumento (desde 0) se quiere el resto de la línea tal cual, en _resto.
var _resto: String = ""

func _partes(linea: String, resto_desde: Int) -> [String]
    var ps: [String] = []
    _resto = ""
    i = 0
    n = linea.length
    while i < n
        while i < n and linea[i:i + 1] == " "
            i = i + 1
        end
        if i >= n
            break
        end
        if ps.length == resto_desde
            _resto = linea[i:]
            if _resto.length >= 2 and str_starts(_resto, "\"") and str_ends(_resto, "\"")
                _resto = _resto[1:_resto.length - 1]
            end
            return ps
        end
        if linea[i:i + 1] == "\""
            j = str_find_from(linea, "\"", i + 1)
            if j < 0
                j = n
            end
            ps.push(linea[i + 1:j])
            i = j + 1
        else
            j = str_find_from(linea, " ", i)
            if j < 0
                j = n
            end
            ps.push(linea[i:j])
            i = j
        end
    end
    return ps
end

# El documento de esa ruta, abriéndolo si hace falta (nil si no se puede leer)
func _documento(ruta: String) -> Documento
    if not abrir(ruta)
        return nil
    end
    return ed_actual()
end

# El RC de la orden (o del lote): el mayor de los que pidió _rexx_falla
var _rexx_rc: Int = 0

func _rexx_falla(rc: Int)
    if rc > _rexx_rc
        _rexx_rc = rc
    end
end

# Cada orden que llega a FORJA.1. LOTE y, en las líneas siguientes, una orden de una línea por cada una: sus
# respuestas, separadas por el carácter 30 (RS), con RC 0 (con otro RC, ARexx no deja dar respuesta: la de una orden
# que falla va vacía). Tras la orden: los avisos a las extensiones.
func orden_rexx(linea: String) -> String
    _rexx_rc = 0
    r = ""
    seguir_antes()
    if str_starts(str_upper(linea), "LOTE\n")
        ls = str_split(linea, "\n")
        hechas = 0
        i = 1
        while i < ls.length
            if ls[i] != ""
                if hechas > 0
                    r = r + str_char(30)
                end
                r = r + orden_una(ls[i])
                hechas = hechas + 1
            end
            i = i + 1
        end
        _rexx_rc = 0
    else
        r = orden_una(linea)
    end
    seguir_despues()
    ext_tras_evento()
    if sonda
        publicar_sonda()
    end
    if _rexx_rc != 0
        mui_rexx_fail(_rexx_rc)
    end
    return r
end

# El documento de texto de una orden: el del fichero p[i] si lo trae (abierto), o el activo; nil si no lo hay o no es
# de texto
func _doc_texto(p: [String], i: Int) -> Documento
    var d: Documento = nil
    if p.length > i and p[i] != ""
        k = ed_buscar_ruta(p[i])
        if k >= 0
            d = documentos[k]
        end
    else
        d = ed_actual()
    end
    if d == nil
        return nil
    end
    return d
end

# El texto tras la orden (lo que sigue al primer espacio), tal cual: con sus espacios delante y sus saltos de línea
func _tras_orden(linea: String) -> String
    p = str_find(linea, " ")
    if p < 0
        return ""
    end
    return linea[p + 1:]
end

# Las órdenes para las extensiones (docs/EXTENSIONES.md)
func orden_extension(orden: String, p: [String], linea: String) -> String
    if orden == "HOLA" and p.length >= 2
        r = ext_hola(p[1])
        if r == ""
            _rexx_falla(10)
            return ""
        end
        return r + " " + VERSION
    elif orden == "SUCESOS" and p.length >= 2
        return ext_sucesos(p[1])
    elif orden == "ADIOS" and p.length >= 2
        ext_adios(p[1])
        return ""
    elif orden == "GUARDADO" and p.length >= 3
        # GUARDADO extensión fichero: guardó uno suyo (un sprite, un mapa). Lo dice la salida, llega a las demás
        # (GUARDADO) y, si es del cajón del proyecto, el panel se lee otra vez
        avisar(tr(3, "Guardado: ") + p[2], 2)
        ext_suceso("GUARDADO", p[2])
        if str_lower(cajon_de(p[2])) == str_lower(proyecto_cajon)
            proyecto_leer(proyecto_cajon)
            if abierta
                mui_canvas_redraw(v.proyecto)
            end
        end
        return ""
    elif orden == "SINGUARDAR" and p.length >= 2
        # SINGUARDAR extensión, y en cada línea siguiente un fichero suyo con cambios sin guardar (ninguna: ninguno)
        ls = str_split(linea, "\n")
        cab = _partes(ls[0], 99)
        ls.remove(0)
        if cab.length < 2 or not ext_poner_sin_guardar(cab[1], ls)
            _rexx_falla(10)
        end
        return ""
    elif orden == "EDITANDO" and p.length >= 2
        # EDITANDO extensión, y en cada línea siguiente la ruta entera de un fichero suyo abierto: van en la sesión
        ls = str_split(linea, "\n")
        cab = _partes(ls[0], 99)
        ls.remove(0)
        if cab.length < 2 or not ext_poner_abiertos(cab[1], ls)
            _rexx_falla(10)
        end
        return ""
    elif orden == "SALIR"
        # una extensión pide que Forja se cierre (Amiga-Q en su ventana): como Amiga-Q aquí, en cuanto acabe esta
        # orden (el bucle de eventos lo recibe por el reloj)
        if abierta
            mui_window_activate(v.window)
            mui_timer(1, EV_SALIR_EXT)
        end
        return ""
    elif orden == "DELANTE"
        # la ventana de Forja delante y activa (desde la ventana de una extensión)
        if abierta
            mui_window_activate(v.window)
        end
        return ""
    elif orden == "ACTIVO"
        d = ed_actual()
        if d == nil
            _rexx_falla(5)
            return ""
        end
        tipo = "texto"
        if d.vista != 0
            tipo = "vista"
        elif d.diseno
            tipo = "dashui"
        end
        cambiado = "0"
        if d.cambiado
            cambiado = "1"
        end
        return d.ruta + "\n" + d.nombre + "\n" + cambiado + "\n" + tipo + "\n#{d.lineas.length}"
    elif orden == "CAMBIADOS"
        # los ficheros abiertos con cambios sin guardar (los que tienen ruta), uno por línea
        t = ""
        for d in documentos
            if d.cambiado and d.ruta != "" and d.vista == 0
                t = t + d.ruta + "\n"
            end
        end
        return t
    elif orden == "ABIERTOS"
        t = ""
        for d in documentos
            if d.ruta != ""
                t = t + d.ruta + "\n"
            else
                t = t + d.nombre + "\n"
            end
        end
        return t
    elif orden == "PROYECTO"
        t = proyecto_cajon + "\n"
        for f in proyecto_ficheros
            if f != "/"
                t = t + f + "\n"
            end
        end
        return t
    elif (orden == "LINEAS" and p.length >= 3) or (orden == "LINEA" and p.length >= 2)
        # LINEAS desde hasta [fichero], LINEA n [fichero]: desde 1, las dos incluidas (lo que no está, fuera)
        k = 3
        a = Int(p[1])
        b = a
        if orden == "LINEAS"
            b = Int(p[2])
        else
            k = 2
        end
        d = _doc_texto(p, k)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        if a < 1
            a = 1
        end
        if b > d.lineas.length
            b = d.lineas.length
        end
        t = ""
        n = a
        while n <= b
            t = t + d.lineas[n - 1]
            if n < b
                t = t + "\n"
            end
            n = n + 1
        end
        return t
    elif orden == "CURSOR"
        d = _doc_texto(p, 99)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        if p.length >= 3
            ed_poner_cursor(d, Int(p[1]), Int(p[2]))
            redibujar()
            return ""
        end
        return "#{d.cl + 1} #{d.cc + 1}"
    elif orden == "ELEGIDO"
        d = _doc_texto(p, 99)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        return ed_elegido(d) + "\n" + ed_seleccion(d)
    elif orden == "ELEGIR" and p.length >= 5
        d = _doc_texto(p, 99)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        ed_elegir(d, Int(p[1]), Int(p[2]), Int(p[3]), Int(p[4]))
        redibujar()
        return ""
    elif orden == "INSERTAR" or orden == "ESCRIBIR"
        # INSERTAR texto: en el cursor (en lugar de lo elegido); ESCRIBIR texto: el fichero entero. Con deshacer.
        d = _doc_texto(p, 99)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        t = _tras_orden(linea)
        if orden == "INSERTAR"
            ed_escribir(d, t)
            ed_seguir_cursor(d)
        else
            ed_cambiar_lineas(d, 1, d.lineas.length, t)
        end
        ultimo_cambio = time_ms()
        ext_tras_escribir(d)
        redibujar()
        return ""
    elif orden == "AVISO" and p.length >= 2
        # AVISO tipo texto: una línea en la salida (0 normal, 1 error, 2 bien)
        q = _partes(linea, 2)
        avisar(_resto, Int(p[1]))
        return ""
    elif orden == "BARRA" and p.length == 1
        return barra_texto()
    elif orden == "BARRA" and p.length >= 2
        # BARRA extensión texto: su texto en la barra ("": lo quita)
        q = _partes(linea, 2)
        barra_poner(p[1], _resto)
        if abierta
            mui_canvas_redraw(v.salida)
        end
        return ""
    elif orden == "MARCAS" or orden == "MARCASPROYECTO"
        return orden_marcas(orden, linea)
    elif orden == "RAYAS" and p.length == 2
        # RAYAS fichero: las rayas que tiene, "línea:bits" (1 añadida, 2 cambiada, 4 quitadas encima, 8 debajo)
        return rayas_texto(str_lower(p[1]))
    elif orden == "RAYAS"
        return orden_rayas(linea)
    elif orden == "ZONA" and p.length == 1
        # ZONA: las de todas, una por línea: "extensión|texto|detalle"
        t = ""
        for z in bb_zonas
            t = t + z.ext + "|" + z.texto + "|" + z.detalle + "\n"
        end
        return t
    elif orden == "ZONA"
        # ZONA extensión icono|texto|detalle|corto: su zona en la barra de botones (sin nada más: la quita)
        q = _partes(linea, 2)
        partes = str_split(_resto, "|")
        while partes.length < 4
            partes.push("")
        end
        if bb_zona_poner(p[1], partes[0], partes[1], partes[2], partes[3]) and abierta
            mui_canvas_redraw(v.botones)
        end
        return ""
    elif orden == "VISTA" and p.length >= 3 and str_find(linea, "\n") < 0
        # VISTA extensión "nombre" sin líneas: cierra esa pestaña suya (RC 5 si no la hay)
        cab = _partes(linea, 99)
        i = 0
        while i < documentos.length
            d = documentos[i]
            if d.vista != 0 and d.vista_ext == cab[1] and d.nombre == cab[2]
                ed_cerrar(i)
                redibujar()
                return ""
            end
            i = i + 1
        end
        _rexx_falla(5)
        return ""
    elif orden == "VISTA" and p.length >= 3
        # VISTA extensión "nombre", y en cada línea siguiente el color (un carácter) y el texto: una pestaña de solo
        # lectura, delante (si ya tiene una con ese nombre, la vuelve a llenar)
        ls = str_split(linea, "\n")
        var textos: [String] = []
        colores = ""
        i = 1
        while i < ls.length
            l = ls[i]
            if l == ""
                colores = colores + " "
                textos.push("")
            else
                colores = colores + l[0:1]
                textos.push(str_replace(l[1:], "\t", "    "))
            end
            i = i + 1
        end
        cab = _partes(ls[0], 99)
        ed_abrir_vista(p[1], cab[2], textos, colores)
        redibujar()
        return ""
    elif orden == "SUGERENCIA"
        return orden_sugerencia(linea)
    elif orden == "TEXTODISCO"
        # el texto como se guardaría (en UTF-8 si el fichero lo estaba)
        d = _doc_texto(p, 1)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        return ed_texto_disco(d)
    elif orden == "VERSION"
        # cuántos cambios lleva el texto (sube con cada uno)
        d = _doc_texto(p, 1)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        return "#{d.version}"
    elif orden == "MENU" and p.length >= 3
        # MENU extensión título|tecla|orden: una opción más en el menú Extensiones (su número; RC 5 si no caben)
        i = ext_buscar(p[1])
        if i < 0
            _rexx_falla(10)
            return ""
        end
        q = _partes(linea, 2)
        r = ext_ranura_nueva(i, _resto)
        if r < 0
            _rexx_falla(5)
            return ""
        end
        return "#{r}"
    end
    _rexx_falla(10)
    return ""
end

# SUGERENCIA: la que se ve, "línea columna texto" ("" si ninguna). SUGERENCIA extensión línea columna versión, y el
# texto en la línea siguiente: un texto en gris tras el cursor del fichero activo, que Tab mete (con deshacer); solo si
# el cursor está en esa línea y columna, al final de la línea, y el texto en esa versión (si no, RC 5). Se va al
# escribir, al mover el cursor o con Esc. SUGERENCIA extensión, sin más: quita la suya.
func orden_sugerencia(linea: String) -> String
    ls = str_split(linea, "\n")
    cab = _partes(ls[0], 99)
    d = ed_actual()
    if cab.length == 1
        if d != nil and ed_sugerencia_vale(d)
            return "#{ed_sug_l + 1} #{ed_sug_c + 1} " + ed_sug_texto
        end
        return ""
    end
    if cab.length < 5
        if ed_sug_ext == cab[1] and ed_sug_texto != ""
            ed_sug_texto = ""
            redibujar()
        end
        return ""
    end
    t = ""
    if ls.length > 1
        t = str_replace(ls[1], "\t", "    ")
    end
    if d == nil or d.vista != 0 or d.diseno or t == ""
        _rexx_falla(5)
        return ""
    end
    l = Int(cab[2]) - 1
    c = Int(cab[3]) - 1
    if "#{d.version}" != cab[4] or d.cl != l or d.cc != c or ed_hay_seleccion(d) or d.cc != d.lineas[d.cl].length
        _rexx_falla(5)
        return ""
    end
    ed_sug_texto = t
    ed_sug_ext = cab[1]
    ed_sug_doc = d
    ed_sug_version = d.version
    ed_sug_l = l
    ed_sug_c = c
    redibujar()
    return ""
end

# Tab mete la sugerencia que se ve (true); Esc la quita
func sugerencia_tecla(d: Documento, codigo: Int, teclas: Int) -> Bool
    if not ed_sugerencia_vale(d)
        return false
    end
    if codigo == T_TAB and (teclas & (Q_MAYUS | Q_ALT | Q_CTRL)) == 0
        t = ed_sug_texto
        ed_sug_texto = ""
        ed_escribir(d, t)
        ed_seguir_cursor(d)
        ultimo_cambio = time_ms()
        ext_tras_escribir(d)
        redibujar()
        return true
    end
    if codigo == T_ESC
        ed_sug_texto = ""
        redibujar()
    end
    return false
end

# RAYAS extensión fichero [versión], y en cada línea siguiente "línea símbolos" (+ añadida, ~ cambiada, - quitadas
# encima, _ quitadas debajo): sus rayas en ese fichero (sin líneas, las quita). Con versión, solo si el texto sigue en
# esa (VERSION): si no, RC 5 y no cambia nada (la extensión las pedirá otra vez).
func orden_rayas(linea: String) -> String
    lineas = str_split(linea, "\n")
    cab = _partes(lineas[0], 99)
    if cab.length < 3
        _rexx_falla(10)
        return ""
    end
    k = ed_buscar_ruta(cab[2])
    if cab.length >= 4 and k >= 0 and "#{documentos[k].version}" != cab[3]
        _rexx_falla(5)
        return ""
    end
    var ns: [Int] = []
    var ss: [String] = []
    i = 1
    while i < lineas.length
        l = lineas[i]
        i = i + 1
        e = str_find(l, " ")
        if l == "" or e < 0
            continue
        end
        ns.push(Int(l[0:e]))
        ss.push(str_trim(l[e + 1:]))
    end
    rayas_poner(cab[1], cab[2], ns, ss)
    d = ed_actual()
    if d != nil and str_lower(d.ruta) == str_lower(cab[2]) and abierta
        mui_canvas_redraw(v.editor)
    end
    return ""
end

# MARCAS extensión fichero, y en cada línea siguiente "línea símbolo": sus marcas en el margen de ese fichero (todas:
# sin líneas, las quita). MARCASPROYECTO extensión, y "letras ruta" en cada línea: sus letras en el panel del proyecto.
func orden_marcas(orden: String, linea: String) -> String
    lineas = str_split(linea, "\n")
    cab = _partes(lineas[0], 99)
    if cab.length < 2 or (orden == "MARCAS" and cab.length < 3)
        _rexx_falla(10)
        return ""
    end
    var ns: [Int] = []
    var ss: [String] = []
    var rutas: [String] = []
    i = 1
    while i < lineas.length
        l = lineas[i]
        i = i + 1
        e = str_find(l, " ")
        if l == "" or e < 0
            continue
        end
        if orden == "MARCAS"
            ns.push(Int(l[0:e]))
            ss.push(str_trim(l[e + 1:]))
        else
            ss.push(l[0:e])
            rutas.push(l[e + 1:])
        end
    end
    if orden == "MARCAS"
        marcas_poner(cab[1], cab[2], ns, ss)
        d = ed_actual()
        if d != nil and str_lower(d.ruta) == str_lower(cab[2]) and abierta
            mui_canvas_redraw(v.editor)
        end
    else
        marcas_proyecto_poner(cab[1], rutas, ss)
        if abierta
            mui_canvas_redraw(v.proyecto)
        end
    end
    return ""
end

func orden_una(linea: String) -> String
    p = _partes(linea, 99)
    if p.length == 0
        _rexx_falla(10)
        return ""
    end
    orden = str_upper(p[0])
    if orden == "ABRIR" and p.length >= 2
        if _documento(p[1]) == nil
            if abrir_delegado
                return ""      # lo abre una extensión
            end
            _rexx_falla(10)
            return ""
        end
        if p.length >= 3
            ed_ir_a(Int(p[2]), 1)
        end
        redibujar()
        return ""
    elif orden == "ABIERTO" and p.length >= 2
        if ed_buscar_ruta(p[1]) >= 0
            return "1"
        end
        return "0"
    elif orden == "TEXTO"
        # (sin fichero: el activo)
        d = _doc_texto(p, 1)
        if d == nil
            _rexx_falla(10)
            return ""
        end
        return ed_texto(d)
    elif orden == "SELECCION"
        d = ed_actual()
        if d == nil
            _rexx_falla(10)
            return ""
        end
        ed_lineas_seleccion(d)
        return d.ruta + "\n#{ed_sel_desde}\n#{ed_sel_hasta}\n" + ed_seleccion(d)
    elif orden == "CAMBIAR"
        p = _partes(linea, 4)
        if p.length < 4
            _rexx_falla(10)
            return ""
        end
        d = _documento(p[1])
        antes = 0
        if d != nil
            antes = d.lineas.length
        end
        if d == nil or not ed_cambiar_lineas(d, Int(p[2]), Int(p[3]), _resto)
            _rexx_falla(10)
            return ""
        end
        # las marcas de después siguen a su texto
        quitadas = Int(p[3]) - Int(p[2]) + 1
        marcas_mover(str_lower(d.ruta), Int(p[2]), quitadas, quitadas + d.lineas.length - antes)
        err_mover(clave_errores(d), Int(p[2]), quitadas, quitadas + d.lineas.length - antes)
        _sm_doc = nil
        ultimo_cambio = time_ms()
        ext_tras_escribir(d)
        comprobar_pedir(d, true)
        redibujar()
        return ""
    elif orden == "GUARDAR"
        d = ed_actual()
        if p.length >= 2
            i = ed_buscar_ruta(p[1])
            d = nil
            if i >= 0
                d = documentos[i]
            end
        end
        if d == nil or d.ruta == "" or not guardar_en(d, d.ruta)
            _rexx_falla(10)
            return ""
        end
        redibujar()
        return ""
    elif orden == "COMPILAR" or orden == "EJECUTAR"
        if tarea != NADA
            _rexx_falla(5)
            return ""
        end
        # COMPILAR fichero: el programa de ese fichero (de una extensión: un sprite, un mapa), abierto o no
        if p.length >= 2 and p[1] != ""
            if programa_de_ruta(p[1]) == ""
                _rexx_falla(10)
                return ""
            end
            compilar_desde = p[1]
        end
        errores_ultimos = ""
        compilar(orden == "EJECUTAR")
        return ""
    elif orden == "BUSCAR" and p.length >= 2
        # BUSCAR texto: lo elige en el fichero activo y da su línea
        d = ed_actual()
        if d == nil or not ed_buscar(d, p[1], false, true)
            _rexx_falla(5)
            return ""
        end
        redibujar()
        return "#{d.cl + 1}"
    elif orden == "CAMBIARTODO" and p.length >= 3
        d = ed_actual()
        if d == nil
            _rexx_falla(10)
            return ""
        end
        n = ed_cambiar_todo(d, p[1], p[2], true)
        redibujar()
        return "#{n}"
    elif orden == "IRA" and p.length >= 2
        ed_ir_a(Int(p[1]), 1)
        redibujar()
        return ""
    elif orden == "ESTADO"
        var nombres: [String] = ["libre", "compilando", "ejecutando", "depurando"]
        return nombres[tarea]
    elif orden == "ERRORES"
        # los de la última compilación; si no hay, los marcados por la comprobación al guardar o al escribir
        if errores_ultimos == ""
            t = ""
            for e in err_lista
                t = t + e.ruta + ":#{e.linea}:#{e.col}: Error: " + e.texto + "\n"
            end
            return t
        end
        return errores_ultimos
    elif orden == "SALIDA"
        return salida_texto(false)
    elif orden == "NUEVOPROYECTO" and p.length >= 4
        # NUEVOPROYECTO tipo cajón nombre: lo crea con su plantilla y lo abre; da la ruta del .forja
        r = crear_proyecto(p[1], p[2], p[3])
        if r == ""
            avisar(tr(970, "No se puede crear el proyecto: ") + pr_error, 1)
            _rexx_falla(10)
            return ""
        end
        proyecto_abrir(r, true)
        return r
    elif orden == "PROPIEDAD" and p.length >= 2
        # PROPIEDAD clave [valor]: una del .forja (la da; con valor, la cambia y lo guarda)
        con_valor = p.length >= 3
        p = _partes(linea, 2)
        if proy == nil
            _rexx_falla(10)
            return ""
        end
        if con_valor
            if not propiedad_poner(str_lower(p[1]), _resto)
                _rexx_falla(10)
                return ""
            end
            proyecto_guardar()
            if str_lower(p[1]) == "version" or str_lower(p[1]) == "nombre"
                poner_version(proy)
            end
        end
        return propiedad(str_lower(p[1]))
    elif orden == "ACTUALIZAR"
        # lo mismo que el menú: busca una versión nueva de Dash y, si la hay, pregunta si se instala
        act_pedir()
        actualizar_mensajes()
        return ""
    end
    return orden_extension(orden, p, linea)
end

# --- El proyecto: el fichero .forja (paso 3.1), Nuevo proyecto con plantillas (3.2) ---

var proy: Proyecto = nil
var vigilar_sueltas: [String] = []     # lo vigilado sin proyecto

const PG_RENOMBRAR = 0                 # lo que pregunta la lista rápida (LR_PREGUNTA)
const PG_CONDICION = 1
const PG_CONTADOR = 2
const PG_VIGILAR = 3
const PG_MEMORIA = 4
var pregunta: Int = PG_RENOMBRAR
var pregunta_ruta: String = ""
var pregunta_linea: Int = 0

# Abre un .forja: es el proyecto (sus puntos de parada, lo vigilado), el panel enseña su cajón y, si se pide, se abre
# su fichero principal
func proyecto_abrir(ruta: String, con_principal: Bool) -> Bool
    p = pr_leer(ruta)
    if p == nil
        avisar(hueco2(tr(953, "No se puede abrir el proyecto %1: %2"), ruta, pr_error), 1)
        return false
    end
    proy = p
    dep_vigilar = p.vigilar
    proyecto_puntos_al_dia()
    if str_lower(proyecto_cajon) != str_lower(p.cajon)
        proyecto_leer(p.cajon)
    end
    if abierta
        mui_canvas_redraw(v.proyecto)
    end
    avisar(hueco2(tr(954, "Proyecto %1 (%2)."), p.nombre, tipo_texto(p.tipo)), 2)
    if con_principal
        principal = pr_principal(p)
        dos_requesters(false)
        hay = file_exists(principal)
        dos_requesters(true)
        if hay
            abrir(principal)
        end
    end
    if abierta
        redibujar()
    end
    return true
end

# El panel enseña un cajón con un .forja de otro proyecto (o no había): ese pasa a ser el proyecto
func proyecto_al_dia()
    if proyecto_forja != "" and (proy == nil or str_lower(proy.cajon) != str_lower(proyecto_cajon))
        proyecto_abrir(proyecto_forja, false)
    end
end

func tipo_texto(t: String) -> String
    tipos = str_split(PR_TIPOS, "|")
    nombres = str_split(tr(933, "Orden del Shell|Commodity|Aplicación MUI|Juego|Demo|3D con MiniGL|Otro"), "|")
    i = 0
    while i < tipos.length and i < nombres.length
        if tipos[i] == t
            return nombres[i]
        end
        i = i + 1
    end
    return t
end

func _indice_en(lista: String, t: String) -> Int
    i = 0
    for e in str_split(lista, "|")
        if e == t
            return i
        end
        i = i + 1
    end
    return 0
end

# Los puntos de parada siguen a su texto al escribir: el editor mueve los del documento (ed_puntos_movidos) y aquí
# se mueven los del proyecto, con su condición y su contador. Al .forja van al guardar el fichero (puntos_por_guardar).
# Depurando, el depurador sigue con los de antes: el programa en marcha es el texto de antes.
var puntos_por_guardar: Bool = false
func puntos_seguir()
    movidos = false
    for d in documentos
        if d.puntos_antes != nil and ed_puntos_movidos(d)
            if d.ruta != "" and _puntos_mover(d.ruta)
                movidos = true
            end
        end
    end
    if movidos
        puntos_por_guardar = true
        puntos_raros_al_dia()
    end
end

# Cerrar sin guardar: sus puntos vuelven a donde estaban en el fichero del disco (y así al .forja)
func puntos_descartar(d: Documento)
    puntos_seguir()
    if d.ruta == ""
        return
    end
    pr_puntos_descartar(d.ruta)
    d.puntos = pr_lineas_de(d.ruta)
    d.puntos_antes = nil
    puntos_raros_al_dia()
    if proyecto_de(d.ruta) != nil
        proyecto_guardar()
    end
end

func _puntos_mover(ruta: String) -> Bool
    cambio = false
    i = 0
    while i < pr_puntos.length
        q = pr_puntos[i]
        if str_lower(q.fichero) == str_lower(ruta)
            k = 0
            while k < ed_movidos_antes.length and ed_movidos_antes[k] != q.linea
                k = k + 1
            end
            if k == ed_movidos_antes.length
                # su línea se borró y ya había otro punto donde iba a parar
                pr_puntos.remove(i)
                cambio = true
                continue
            end
            if q.linea != ed_movidos_ahora[k]
                q.linea = ed_movidos_ahora[k]
                cambio = true
            end
        end
        i = i + 1
    end
    return cambio
end

# Los puntos de parada de los ficheros abiertos, los del proyecto (al abrirlo)
func proyecto_puntos_al_dia()
    puntos_seguir()
    for d in documentos
        if d.ruta != "" and proy != nil and pr_dentro(proy, d.ruta)
            d.puntos = pr_lineas_de(d.ruta)
        end
    end
    puntos_raros_al_dia()
end

func puntos_raros_al_dia()
    var r: [String] = []
    for q in pr_puntos
        if q.condicion != "" or q.contador != ""
            r.push(str_lower(q.fichero) + ":#{q.linea}")
        end
    end
    ed_puntos_raros = r
end

# Lo de los puntos y lo vigilado, al .forja (si el proyecto lo tiene)
func proyecto_guardar()
    if proy != nil and not pr_escribir(proy)
        avisar(tr(2, "No se puede escribir ") + proy.ruta, 1)
    end
end

# El proyecto de lo que se compila: el de Forja si el fichero es suyo
func proyecto_de(ruta: String) -> Proyecto
    if proy != nil and ruta != "" and pr_dentro(proy, ruta)
        return proy
    end
    return nil
end

# --- Nuevo proyecto (las plantillas) ---

func nuevo_proyecto_abrir()
    cajon = env_get("Forja/proyectos")
    if cajon == ""
        if proy != nil
            cajon = cajon_de(proy.cajon)
        elif proyecto_cajon != ""
            cajon = proyecto_cajon
        else
            cajon = "RAM:"
        end
    end
    mui_set_text(vn.nombre, "")
    mui_set_text(vn.cajon, cajon)
    nuevo_proyecto_descripcion()
    if not mui_window_open(vn.window)
        avisar(hueco(tr(1005, "No se puede abrir la ventana %1."), tr(920, "Nuevo proyecto (Forja)")), 1)
    end
    mui_set_active(vn.window, vn.nombre)
end

func nuevo_proyecto_descripcion()
    var textos: [String] = [tr(960, "Lee sus argumentos y acaba con un código."), tr(961, "En Exchange, con una tecla rápida."), tr(962, "Una ventana del editor de ventanas, con menú."), tr(963, "Su pantalla, un sprite y un nivel."), tr(964, "Su pantalla, cada imagen y un bloque asm."), tr(965, "Un cubo con MiniGL: pide FPU y MiniGL.")]
    k = mui_get_value(vn.tipo)
    if k >= 0 and k < textos.length
        mui_set_text(vn.descripcion, textos[k])
    end
end

func _nombre_valido(n: String) -> Bool
    return n.length <= 24 and regex_match("[A-Za-z][A-Za-z0-9_-]*", n, false)
end

# Crea el proyecto: el cajón, los ficheros de la plantilla (con su nombre), el .forja y su icono. La ruta del .forja,
# o "" (y por qué en pr_error)
func crear_proyecto(tipo: String, cajon: String, nombre: String) -> String
    pr_error = ""
    if pl_ficheros(tipo) == ""
        pr_error = tr(966, "no hay esa plantilla")
        return ""
    end
    if not _nombre_valido(nombre)
        pr_error = tr(967, "el nombre lleva letras, cifras, - y _, empieza por una letra y tiene 24 como mucho")
        return ""
    end
    dir = ruta_unir(cajon, nombre)
    dos_requesters(false)
    existe = file_exists(dir)
    creado = not existe and dir_create(dir)
    dos_requesters(true)
    if existe
        pr_error = hueco(tr(968, "ya existe %1"), dir)
        return ""
    end
    if not creado
        pr_error = hueco(tr(969, "no se puede crear el cajón %1"), dir)
        return ""
    end
    for f in str_split(pl_ficheros(tipo), "|")
        if not file_write_text(ruta_unir(dir, f), str_replace(pl_texto(tipo, f), "%NOMBRE%", nombre))
            pr_error = tr(2, "No se puede escribir ") + f
            return ""
        end
    end
    p = pr_nuevo(ruta_unir(dir, nombre + ".forja"))
    p.tipo = tipo
    p.version = "0.1"
    if tipo == "mui"
        p.cpu = "68020"
    elif tipo == "3d"
        p.cpu = "68020"
        p.fpu = true
    end
    # (sus puntos de parada, ninguno: no los de otro proyecto de ese cajón)
    if not pr_escribir(p)
        pr_error = tr(2, "No se puede escribir ") + p.ruta
        return ""
    end
    escribir_icono_proyecto(p.ruta)
    return p.ruta
end

# El icono del .forja: uno de proyecto con Forja como herramienta (un doble clic lo abre en Forja)
func escribir_icono_proyecto(forja: String) -> Bool
    hex = pl_icono_hex()
    herramienta = file_real_path("PROGDIR:Forja")
    if herramienta == ""
        herramienta = "Forja"
    end
    fh = file_open(forja + ".info", 1006)
    if fh == 0
        return false
    end
    n = hex.length / 2
    i = 0
    while i < n
        b = str_to_int(hex[i * 2:i * 2 + 2], 16)
        if i == 53
            b = 1       # do_DefaultTool (offset 50, un long): hay herramienta
        end
        file_write_byte(fh, b)
        i = i + 1
    end
    largo = herramienta.length + 1
    for b in [(largo >> 24) & 255, (largo >> 16) & 255, (largo >> 8) & 255, largo & 255]
        file_write_byte(fh, b)
    end
    k = 0
    while k < herramienta.length
        file_write_byte(fh, str_code(herramienta, k))
        k = k + 1
    end
    file_write_byte(fh, 0)
    file_close(fh)
    return true
end

func nuevo_proyecto_crear()
    tipos = str_split(PR_TIPOS, "|")
    k = mui_get_value(vn.tipo)
    tipo = tipos[k]
    nombre = str_trim(mui_get_text(vn.nombre))
    cajon = str_trim(mui_get_text(vn.cajon))
    ruta = crear_proyecto(tipo, cajon, nombre)
    if ruta == ""
        mui_request(vn.window, tr(920, "Nuevo proyecto (Forja)"), tr(970, "No se puede crear el proyecto: ") + pr_error, tr(971, "_Vale"))
        return
    end
    mui_window_close(vn.window)
    env_set("Forja/proyectos", cajon, true)
    proyecto_abrir(ruta, true)
    if tipo == "3d"
        avisar(tr(972, "Este proyecto pide una FPU y minigl.library (MiniGL): compila con --fpu."), 1)
    elif tipo == "mui"
        avisar(tr(973, "La ventana está en ventana.dashui: ábrelo para cambiarla con el editor de ventanas."), 0)
    end
end

# --- Propiedades del proyecto ---

func propiedades_abrir()
    if proy == nil
        # sin .forja: se hace uno para el cajón del programa de ahora (con lo que Forja ya sabe)
        d = ed_actual()
        cajon = proyecto_cajon
        principal = ""
        if d != nil and d.ruta != ""
            principal = programa_de(d)
            cajon = cajon_de(principal)
        end
        if cajon == "" or str_ends(cajon, ":")
            avisar(tr(974, "Para hacer un proyecto, abre antes un fichero de su cajón (o Nuevo proyecto...)."), 1)
            return
        end
        r = mui_request(v.window, tr(930, "Propiedades del proyecto (Forja)"), hueco(tr(975, "Este cajón no tiene proyecto. ¿Hago %1?"), nombre_de(cajon) + ".forja"), tr(976, "_Hacerlo|_Cancelar"))
        if r != 1
            return
        end
        p = pr_nuevo(ruta_unir(cajon, nombre_de(cajon) + ".forja"))
        if principal != ""
            p.principal = pr_relativa(p, principal)
        end
        if not pr_escribir(p)
            avisar(tr(2, "No se puede escribir ") + p.ruta, 1)
            return
        end
        escribir_icono_proyecto(p.ruta)
        proyecto_abrir(p.ruta, false)
        proyecto_leer(proyecto_cajon)
        mui_canvas_redraw(v.proyecto)
    end
    p = proy
    mui_set_text(vq.nombre, p.nombre)
    mui_set_value(vq.tipo, _indice_en(PR_TIPOS, p.tipo))
    mui_set_text(vq.principal, p.principal)
    mui_set_text(vq.ejecutable, p.ejecutable)
    mui_set_text(vq.version, p.version)
    mui_set_text(vq.icono, p.icono)
    mui_set_value(vq.cpu, _indice_en(PR_CPUS, p.cpu))
    mui_set_value(vq.fpu, p.fpu)
    mui_set_text(vq.pila, "#{p.pila}")
    mui_set_value(vq.memcheck, p.memcheck)
    mui_set_value(vq.perfil, p.perfil)
    mui_set_value(vq.gcc, p.gcc)
    mui_set_text(vq.opciones, p.opciones)
    mui_set_text(vq.argumentos, p.argumentos)
    mui_set_text(vq.argumentos_depurar, p.argumentos_depurar)
    if not mui_window_open(vq.window)
        avisar(hueco(tr(1005, "No se puede abrir la ventana %1."), tr(930, "Propiedades del proyecto (Forja)")), 1)
    end
end

func propiedades_guardar()
    p = proy
    if p == nil
        mui_window_close(vq.window)
        return
    end
    version_antes = p.version
    nombre_antes = p.nombre
    p.nombre = str_trim(mui_get_text(vq.nombre))
    p.tipo = str_split(PR_TIPOS, "|")[mui_get_value(vq.tipo)]
    p.principal = str_trim(mui_get_text(vq.principal))
    p.ejecutable = str_trim(mui_get_text(vq.ejecutable))
    p.version = str_trim(mui_get_text(vq.version))
    p.icono = str_trim(mui_get_text(vq.icono))
    p.cpu = str_split(PR_CPUS, "|")[mui_get_value(vq.cpu)]
    p.fpu = mui_get_value(vq.fpu) != 0
    p.pila = Int(str_trim(mui_get_text(vq.pila)))
    p.memcheck = mui_get_value(vq.memcheck) != 0
    p.perfil = mui_get_value(vq.perfil) != 0
    p.gcc = mui_get_value(vq.gcc) != 0
    p.opciones = str_trim(mui_get_text(vq.opciones))
    p.argumentos = str_trim(mui_get_text(vq.argumentos))
    p.argumentos_depurar = str_trim(mui_get_text(vq.argumentos_depurar))
    mui_window_close(vq.window)
    if not pr_escribir(p)
        avisar(tr(2, "No se puede escribir ") + p.ruta, 1)
        return
    end
    avisar(tr(3, "Guardado: ") + p.ruta, 2)
    if p.version != version_antes or p.nombre != nombre_antes
        poner_version(p)
    end
end

# La línea @version del programa, con el nombre y la versión del proyecto (en el editor si está abierto, con
# deshacer; si no, en el disco)
func poner_version(p: Proyecto)
    nueva = pr_linea_version(p)
    principal = pr_principal(p)
    if nueva == "" or not file_exists(principal)
        return
    end
    k = ed_buscar_ruta(principal)
    if k >= 0
        d = documentos[k]
        i = 0
        while i < d.lineas.length
            if str_starts(d.lineas[i], "@version ")
                if d.lineas[i] != nueva
                    ed_cambiar_lineas(d, i + 1, i + 1, nueva)
                    redibujar()
                end
                return
            end
            i = i + 1
        end
        return
    end
    t = file_read_text(principal)
    if t == nil
        return
    end
    ls = str_split(t, "\n")
    i = 0
    while i < ls.length
        if str_starts(ls[i], "@version ")
            ls[i] = nueva
            file_write_text(principal, str_join(ls, "\n"))
            return
        end
        i = i + 1
    end
end

# --- El depurador: condiciones, contador, vigilar, valor bajo el ratón, hasta aquí, registros y memoria (4.1) ---

var hasta_ruta: String = ""        # Ejecutar hasta aquí: un punto de un momento (se quita al parar)
var hasta_linea: Int = 0
var hasta_puesto: Bool = false     # se puso con dbg_break (no había uno de verdad ahí)
var orden_seguir: Bool = false     # la última orden fue seguir (o empezar): una parada en un punto mira su condición

# Pregunta en la lista rápida (como renombrar): la condición, el contador, lo vigilado, la memoria
func preguntar(que: Int, titulo: String, inicial: String, ayuda: String)
    pregunta = que
    lr_abrir(LR_PREGUNTA, titulo)
    lr_filtro = inicial
    lr_ayuda = ayuda
    redibujar()
end

# El punto de parada de la línea del cursor (lo pone si no hay); nil si el fichero no tiene ruta
func punto_del_cursor() -> PuntoProy
    d = ed_actual()
    if d == nil or not es_codigo(d) or d.ruta == ""
        avisar(tr(977, "Los puntos con condición van en un fichero guardado."), 1)
        return nil
    end
    n = d.cl + 1
    q = pr_punto(d.ruta, n)
    if q == nil
        alternar_punto(d, n)
        q = pr_punto(d.ruta, n)
    end
    return q
end

func condicion_preguntar()
    q = punto_del_cursor()
    if q == nil
        return
    end
    pregunta_ruta = q.fichero
    pregunta_linea = q.linea
    preguntar(PG_CONDICION, hueco(tr(978, "Condición del punto de la línea %1"), "#{q.linea}"), q.condicion, tr(979, "Para solo si se cumple: i > 3 and nombre == \"x\". Vacía: siempre."))
end

func contador_preguntar()
    q = punto_del_cursor()
    if q == nil
        return
    end
    pregunta_ruta = q.fichero
    pregunta_linea = q.linea
    preguntar(PG_CONTADOR, hueco(tr(980, "Contador del punto de la línea %1"), "#{q.linea}"), q.contador, tr(981, "Para desde la vez n: 3; o = 3, > 3, % 2 (cada dos). Vacío: siempre."))
end

func vigilar_preguntar()
    inicial = ""
    d = ed_actual()
    if d != nil and es_codigo(d)
        if ed_hay_seleccion(d)
            inicial = str_trim(ed_seleccion(d))
        else
            inicial = palabra_del_cursor(d)
        end
    end
    preguntar(PG_VIGILAR, tr(982, "Vigilar"), inicial, tr(983, "Una expresión de Dash (naves.length, p.x + 1). Si ya se vigila, se quita."))
end

func memoria_preguntar()
    inicial = dep_memoria
    if inicial == ""
        inicial = "a7"
    end
    preguntar(PG_MEMORIA, tr(984, "Ver la memoria en"), inicial, tr(985, "Una dirección o una expresión: $C01000, a0, buffer + 16. Vacío: no se ve."))
end

# Return en la pregunta (la lista rápida)
func responder(t: String)
    if pregunta == PG_CONDICION or pregunta == PG_CONTADOR
        q = pr_punto(pregunta_ruta, pregunta_linea)
        if q == nil
            return
        end
        if pregunta == PG_CONDICION
            malo = ex_comprobar(t)
            if malo != ""
                avisar(hueco2(tr(986, "La condición no vale (%1): %2"), t, malo), 1)
                return
            end
            q.condicion = t
        else
            if not ex_contador_valido(t)
                avisar(hueco(tr(987, "El contador no vale: %1 (3, = 3, > 3, % 2)"), t), 1)
                return
            end
            q.contador = t
        end
        puntos_raros_al_dia()
        proyecto_guardar()
        texto = pr_punto_texto(q)
        if texto == ""
            avisar(hueco(tr(988, "El punto de la línea %1 para siempre."), "#{q.linea}"), 0)
        else
            avisar(hueco2(tr(989, "El punto de la línea %1 para si: %2"), "#{q.linea}", texto), 0)
        end
        redibujar()
    elif pregunta == PG_VIGILAR
        if t == ""
            return
        end
        malo = ex_comprobar(t)
        if malo != ""
            avisar(hueco2(tr(990, "No se puede vigilar %1: %2"), t, malo), 1)
            return
        end
        i = 0
        quitada = false
        while i < dep_vigilar.length
            if dep_vigilar[i] == t
                dep_vigilar.remove(i)
                quitada = true
            else
                i = i + 1
            end
        end
        if not quitada
            dep_vigilar.push(t)
        end
        proyecto_guardar()
        panel_depuracion_al_dia()
    elif pregunta == PG_MEMORIA
        dep_memoria = t
        panel_depuracion_al_dia()
    end
end

# Lo vigilado, los registros o la memoria cambiaron: el panel otra vez (si está parado)
func panel_depuracion_al_dia()
    if tarea == DEPURANDO and dbg_state() == 3
        dep_construir()
        mui_canvas_redraw(v.proyecto)
        publicar_depuracion()
    elif dep_vigilar.length > 0 or dep_registros or dep_memoria != ""
        avisar(tr(991, "Se verá al parar el programa en el depurador."), 0)
    end
end

func registros_ver()
    dep_registros = not dep_registros
    panel_depuracion_al_dia()
end

func quitar_puntos()
    for d in documentos
        if tarea == DEPURANDO
            for n in d.puntos
                dbg_unbreak(d.nombre, n)
            end
        end
        d.puntos.clear()
        d.puntos_antes = nil
    end
    if tarea == DEPURANDO
        for q in pr_puntos
            dbg_unbreak(nombre_de(q.fichero), q.linea)
        end
    end
    pr_puntos.clear()
    puntos_raros_al_dia()
    proyecto_guardar()
    redibujar()
end

# Ejecutar hasta aquí (Ctrl F10): depurando, sigue hasta la línea del cursor; si no, empieza a depurar y para ahí
func hasta_aqui()
    d = ed_actual()
    if d == nil or not es_codigo(d)
        return
    end
    n = d.cl + 1
    if tarea == DEPURANDO and (dbg_state() == 3 or dbg_state() == 1)
        hasta_ruta = d.ruta
        hasta_linea = n
        hasta_puesto = false
        if not _con_punto(d, n)
            if not dbg_break(d.nombre, n)
                avisar(hueco(tr(70, "La línea %1 no tiene código: el punto no para ahí."), "#{n}"), 1)
                hasta_ruta = ""
                return
            end
            hasta_puesto = true
        end
        orden_depurador(EV_SEGUIR)
    elif tarea == NADA
        hasta_ruta = d.ruta
        if d.ruta == ""
            hasta_ruta = d.nombre
        end
        hasta_linea = n
        hasta_puesto = false
        depurar()
        if tarea != COMPILANDO
            hasta_ruta = ""
        end
    end
end

func _con_punto(d: Documento, n: Int) -> Bool
    for p in d.puntos
        if p == n
            return true
        end
    end
    return false
end

# Al parar: el punto de hasta aquí se quita
func hasta_quitar()
    if hasta_ruta != ""
        if hasta_puesto
            dbg_unbreak(nombre_de(hasta_ruta), hasta_linea)
        end
        hasta_ruta = ""
        hasta_puesto = false
    end
end

# Paró en un punto (tras seguir): ¿lo deja seguir por su condición o su contador? true si sigue (ya se ha mandado)
func punto_sigue(ruta: String, n: Int) -> Bool
    if not orden_seguir
        return false
    end
    if hasta_ruta != "" and hasta_linea == n and str_lower(nombre_de(hasta_ruta)) == str_lower(nombre_de(ruta))
        return false
    end
    q = pr_punto(ruta, n)
    if q == nil
        # (dbg_file puede dar la ruta por otro camino: por el nombre)
        for o in pr_puntos
            if o.linea == n and str_lower(nombre_de(o.fichero)) == str_lower(nombre_de(ruta))
                q = o
            end
        end
    end
    if q == nil or (q.condicion == "" and q.contador == "")
        return false
    end
    if q.condicion != ""
        ex_marco = 0
        c = ex_evaluar(q.condicion)
        if ex_error != ""
            avisar(hueco2(tr(992, "La condición del punto de la línea %1 no se puede ver: %2"), "#{n}", ex_error), 1)
            return false
        end
        if not ex_cierto(c)
            dbg_continue()
            return true
        end
    end
    q.veces = q.veces + 1
    if not ex_contador(q.contador, q.veces)
        dbg_continue()
        return true
    end
    return false
end

# --- El valor bajo el ratón (al depurar, parado) ---

var valor_visto: String = ""

func valor_quitar()
    if ed_valor_texto != ""
        ed_valor_texto = ""
        ed_valor_l = -1
        valor_visto = ""
        redibujar()
    end
end

func _letra_nombre(c: Int) -> Bool
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95
end

# Lo que vale la expresión bajo el puntero: la palabra y lo que la lleva delante (p.hijos[i].x)
func valor_bajo_raton()
    if tarea != DEPURANDO or dbg_state() != 3 or lr_visible
        valor_quitar()
        return
    end
    d = ed_actual()
    x = mui_canvas_pointer_x(v.editor)
    y = mui_canvas_pointer_y(v.editor)
    if d == nil or not es_codigo(d) or not mui_canvas_pointer_inside(v.editor) or y < ALTO_PESTANAS + 2 or x < ed_margen
        valor_quitar()
        return
    end
    ed_punto_en(d, x, y)
    l = ed_punto_l
    s = d.lineas[l]
    c = d.izquierda + (x - ed_margen - 2) / ancho_letra
    if c < 0 or c >= s.length or not _letra_nombre(str_code(s, c))
        valor_quitar()
        return
    end
    # fuera de un texto y de un comentario
    comillas = false
    k = 0
    while k < c
        if str_code(s, k) == 34
            comillas = not comillas
        elif str_code(s, k) == 35 and not comillas
            valor_quitar()
            return
        end
        k = k + 1
    end
    if comillas
        valor_quitar()
        return
    end
    a = c
    while a > 0 and _letra_nombre(str_code(s, a - 1))
        a = a - 1
    end
    b = c
    while b < s.length and _letra_nombre(str_code(s, b))
        b = b + 1
    end
    palabra = s[a:b]
    if _ex_numero(palabra) or es_palabra_dash(palabra) or (b < s.length and str_code(s, b) == 40)
        valor_quitar()
        return
    end
    # lo de delante: .campo y [índice]
    while a > 1 and str_code(s, a - 1) == 46
        e = a - 2
        if str_code(s, e) == 93
            nivel = 0
            while e >= 0
                if str_code(s, e) == 93
                    nivel = nivel + 1
                elif str_code(s, e) == 91
                    nivel = nivel - 1
                    if nivel == 0
                        break
                    end
                end
                e = e - 1
            end
            e = e - 1
        end
        if e < 0 or not _letra_nombre(str_code(s, e))
            break
        end
        while e > 0 and _letra_nombre(str_code(s, e - 1))
            e = e - 1
        end
        a = e
    end
    expr = s[a:b]
    if expr == valor_visto
        return
    end
    ex_marco = 0
    val = ex_evaluar(expr)
    if ex_error != ""
        valor_quitar()
        return
    end
    valor_visto = expr
    ed_valor_texto = expr + " = " + ex_texto(val)
    ed_valor_l = l
    ed_valor_c = a
    redibujar()
    if sonda
        env_set("FORJA_VALOR", ed_valor_texto, false)
    end
end

func _ex_numero(t: String) -> Bool
    return t != "" and str_code(t, 0) >= 48 and str_code(t, 0) <= 57
end

func es_palabra_dash(t: String) -> Bool
    return str_contains(" if elif else end while for in func return and or not true false nil var const struct import Main break continue step enum asm ", " " + t + " ")
end

# --- Ejecutar con perfil y con memcheck (4.2) ---

var perfil_pedido: Bool = false     # lo que se compila ahora lleva --profile (Ejecutar con perfil)
var memcheck_pedido: Bool = false
var tarea_perfil: Bool = false      # lo que corre ahora se compiló con --profile (o lo pide su proyecto)
var tarea_memcheck: Bool = false
var tarea_proy: Proyecto = nil      # el proyecto de lo que se compila y se ejecuta

struct FilaPerfil
    propio: Int         # en décimas de tanto por ciento
    total: Int
    llamadas: Int
    nombre: String
end

var perfil_filas: [FilaPerfil] = []
var perfil_muestras: Int = 0
var perfil_orden: Int = 0           # 0 propio, 1 total, 2 llamadas, 3 nombre
var perfil_programa: String = ""    # el .dash del programa (para ir a sus funciones)

func ejecutar_con(perfil: Bool, memcheck: Bool)
    if tarea != NADA
        return
    end
    perfil_pedido = perfil
    memcheck_pedido = memcheck
    compilar(true)
    if tarea != COMPILANDO
        perfil_pedido = false
        memcheck_pedido = false
    end
end

# "12.5%" -> 125
func _decimas(t: String) -> Int
    t = str_replace(t, "%", "")
    p = str_find(t, ".")
    if p < 0
        return Int(t) * 10
    end
    return Int(t[0:p]) * 10 + Int(t[p + 1:p + 2])
end

# Una línea "perfil: ..." del programa: true si lo era (y la apunta)
func perfil_linea(l: String) -> Bool
    if str_starts(l, "perfil-pc:")
        return true
    end
    if not str_starts(l, "perfil:")
        return false
    end
    var trozos: [String] = []
    for t in str_split(str_trim(l[7:]), " ")
        if t != ""
            trozos.push(t)
        end
    end
    if trozos.length >= 2 and trozos[1] == "muestras"
        perfil_muestras = Int(trozos[0])
    elif trozos.length >= 4 and str_ends(trozos[0], "%")
        perfil_filas.push(FilaPerfil(_decimas(trozos[0]), _decimas(trozos[1]), Int(trozos[2]), trozos[3]))
    end
    return true
end

func _por_ciento(d: Int) -> String
    t = "#{d / 10}.#{d % 10}%"
    while t.length < 7
        t = " " + t
    end
    return t
end

func _a_la_derecha(t: String, n: Int) -> String
    while t.length < n
        t = " " + t
    end
    return t
end

func _perfil_antes(a: FilaPerfil, b: FilaPerfil) -> Int
    if perfil_orden == 1
        return b.total - a.total
    elif perfil_orden == 2
        return b.llamadas - a.llamadas
    elif perfil_orden == 3
        return str_compare_locale(a.nombre, b.nombre, true)
    end
    if a.propio != b.propio
        return b.propio - a.propio
    end
    return b.total - a.total
end

# La pestaña Perfil: una fila por función, ordenada por la columna elegida (un clic en su título)
func perfil_ver()
    perfil_filas.sort(_perfil_antes)
    var ls: [String] = []
    ls.push(hueco2(tr(993, "Perfil de %1: %2 muestras (50 por segundo). Un clic en un título ordena; en una función, va a ella."), nombre_de(perfil_programa), "#{perfil_muestras}"))
    var titulos: [String] = [tr(994, "Propio"), tr(995, "Total"), tr(996, "Llamadas"), tr(997, "Función")]
    k = 0
    while k < 4
        if k == perfil_orden
            titulos[k] = titulos[k] + "*"
        end
        k = k + 1
    end
    ls.push(_a_la_derecha(titulos[0], 8) + _a_la_derecha(titulos[1], 9) + _a_la_derecha(titulos[2], 11) + "  " + titulos[3])
    colores = "#@"
    for f in perfil_filas
        ls.push(" " + _por_ciento(f.propio) + "  " + _por_ciento(f.total) + _a_la_derecha("#{f.llamadas}", 11) + "  " + f.nombre)
        colores = colores + " "
    end
    if perfil_filas.length == 0
        ls.push(tr(998, "(Sin funciones: el programa acabó antes de la primera muestra, o no se compiló con --profile.)"))
        colores = colores + "#"
    end
    ed_abrir_vista("*perfil", tr(999, "Perfil"), ls, colores)
    d = ed_actual()
    if d != nil and perfil_filas.length > 0
        d.cl = 2
    end
    redibujar()
    if sonda
        t = ""
        for f in perfil_filas
            t = t + f.nombre + ":#{f.llamadas} "
        end
        env_set("FORJA_PERFIL", "#{perfil_orden} " + t, false)
    end
end

# Un clic o Return en la pestaña Perfil: en la línea de los títulos, ordena por esa columna; en una fila, a su función
func perfil_elegir(d: Documento)
    if d.cl == 1
        c = d.cc
        nuevo = 3
        if c < 9
            nuevo = 0
        elif c < 18
            nuevo = 1
        elif c < 30
            nuevo = 2
        end
        perfil_orden = nuevo
        perfil_ver()
        return
    end
    i = d.cl - 2
    if i < 0 or i >= perfil_filas.length
        return
    end
    ir_a_funcion(perfil_filas[i].nombre)
end

# A donde se define una función del programa ("Main", "mover", "Nave.mover"): en los ficheros de su cajón
func ir_a_funcion(nombre: String)
    cajon = cajon_de(perfil_programa)
    if cajon == ""
        cajon = cajon_proyecto()
    end
    dueno = ""
    n = nombre
    p = str_find(nombre, ".")
    if p > 0
        dueno = nombre[0:p]
        n = nombre[p + 1:]
    end
    dos_requesters(false)
    rutas = bp_ficheros_de(cajon)
    dos_requesters(true)
    if nombre == "Main" and perfil_programa != ""
        ruta = perfil_programa
        k = ed_buscar_ruta(ruta)
        var ls: [String] = []
        if k >= 0
            ls = documentos[k].lineas
        else
            t = file_read_text(ruta)
            if t != nil
                ls = str_split(t, "\n")
            end
        end
        i = 0
        while i < ls.length
            if str_starts(ls[i], "Main")
                ir_a_sitio(ruta, i + 1, 1)
                return
            end
            i = i + 1
        end
    end
    dos_requesters(false)
    for r in rutas
        k = ed_buscar_ruta(r)
        var sims: [Simbolo] = []
        if k >= 0
            sims = cx_simbolos_de(r, documentos[k].lineas, documentos[k].version)
        else
            sims = cx_simbolos_de(r, nil, 0)
        end
        for s in sims
            if s.nombre == n and (s.clase == CX_FUNC or s.clase == CX_METODO) and (dueno == "" or s.dueno == dueno)
                dos_requesters(true)
                ir_a_sitio(r, s.linea, s.col)
                return
            end
        end
    end
    dos_requesters(true)
    avisar(hueco(tr(1000, "No encuentro la función %1 en el proyecto."), nombre), 1)
end

# Una línea "memcheck: ..." del programa: a la salida, con su sitio si lo dice ("(en main.dash:12)"); true si lo era
func memcheck_linea(l: String, cajon: String) -> Bool
    if not str_starts(l, "memcheck:")
        return false
    end
    tipo = 0
    if str_contains(l, "ERROR")
        tipo = 1
    elif str_contains(l, "vivos 0 objetos y 0 strings") and str_contains(l, "errores 0")
        tipo = 2
    elif str_contains(l, "vivos")
        tipo = 1
    end
    p = str_find(l, "(en ")
    if p > 0 and str_ends(l, ")")
        sitio = l[p + 4:l.length - 1]
        q = sitio.length - 1
        while q > 0 and str_code(sitio, q) != 58
            q = q - 1
        end
        if q > 0 and regex_match("[0-9]+", sitio[q + 1:], false)
            ruta = sitio[0:q]
            if not str_contains(ruta, ":")
                ruta = ruta_unir(cajon, ruta)
            end
            if memcheck_primero < 0
                memcheck_primero = salida_lineas.length
            end
            salida_anadir_sitio(l, ruta, Int(sitio[q + 1:]), 1)
            memcheck_avisos = memcheck_avisos + 1
            return true
        end
    end
    salida_anadir(l, tipo)
    # (el resumen cuenta si queda algo vivo; los errores ya se contaron)
    if tipo == 1 and not (str_contains(l, "vivos") and str_contains(l, "vivos 0 objetos y 0 strings"))
        memcheck_avisos = memcheck_avisos + 1
    end
    return true
end

var memcheck_avisos: Int = 0
var memcheck_primero: Int = -1     # la línea de la salida del primer aviso con sitio (se pone a la vista al acabar)

# Lo que escribió el programa al acabar: las líneas del perfil y de memcheck aparte; lo demás, como siempre. Da la
# primera línea de un error de ejecución en la salida (-1 si no hay), como salida_anadir_programa
func salida_al_acabar(texto: String, cajon: String, exe: String) -> Int
    if not tarea_perfil and not tarea_memcheck
        return salida_anadir_programa(texto, cajon, exe)
    end
    error = -1
    resto = ""
    for l in str_split(texto, "\n")
        especial = (tarea_perfil and perfil_linea(l))
        if not especial and tarea_memcheck and str_starts(l, "memcheck:")
            if resto != ""
                e = salida_anadir_programa(str_trim(resto), cajon, exe)
                if error < 0
                    error = e
                end
                resto = ""
            end
            memcheck_linea(l, cajon)
            especial = true
        end
        if not especial
            resto = resto + l + "\n"
        end
    end
    if str_trim(resto) != ""
        e = salida_anadir_programa(str_trim(resto), cajon, exe)
        if error < 0
            error = e
        end
    end
    return error
end

# Tras acabar el programa: la tabla del perfil y lo que dijo memcheck
func tras_perfil_y_memcheck()
    if tarea_perfil
        perfil_ver()
    end
    if tarea_memcheck
        if memcheck_avisos == 0
            avisar(tr(1001, "memcheck: nada que decir."), 2)
        elif memcheck_avisos == 1
            avisar(tr(1004, "memcheck: un aviso (un clic en él lleva a su línea)."), 1)
        else
            avisar(hueco(tr(1002, "memcheck: %1 avisos (clic en uno para ir a su línea)."), "#{memcheck_avisos}"), 1)
        end
        # el primer aviso con sitio, a la vista (como un error), para hacer clic en él
        if memcheck_primero >= 0
            salida_mostrar(memcheck_primero)
            mui_canvas_redraw(v.salida)
        end
    end
    tarea_perfil = false
    tarea_memcheck = false
end

# PROPIEDAD por ARexx: una propiedad del .forja como texto
func propiedad(k: String) -> String
    p = proy
    if k == "nombre"
        return p.nombre
    elif k == "tipo"
        return p.tipo
    elif k == "principal"
        return p.principal
    elif k == "ejecutable"
        return p.ejecutable
    elif k == "cpu"
        return p.cpu
    elif k == "fpu"
        return si_no(p.fpu)
    elif k == "pila"
        return "#{p.pila}"
    elif k == "memcheck"
        return si_no(p.memcheck)
    elif k == "perfil"
        return si_no(p.perfil)
    elif k == "gcc"
        return si_no(p.gcc)
    elif k == "opciones"
        return p.opciones
    elif k == "argumentos"
        return p.argumentos
    elif k == "argumentos_depurar"
        return p.argumentos_depurar
    elif k == "version"
        return p.version
    elif k == "icono"
        return p.icono
    elif k == "ruta"
        return p.ruta
    elif k == "vigilar"
        return str_join(p.vigilar, "|")
    elif k == "puntos"
        t = ""
        for q in pr_puntos
            if pr_dentro(p, q.fichero)
                t = t + pr_relativa(p, q.fichero) + ":#{q.linea}"
                if q.condicion != "" or q.contador != ""
                    t = t + " [" + pr_punto_texto(q) + "]"
                end
                t = t + "|"
            end
        end
        return t
    end
    return ""
end

func propiedad_poner(k: String, valor: String) -> Bool
    p = proy
    si = valor == "si" or valor == "1" or valor == "true"
    if k == "nombre"
        p.nombre = valor
    elif k == "tipo"
        p.tipo = valor
    elif k == "principal"
        p.principal = valor
    elif k == "ejecutable"
        p.ejecutable = valor
    elif k == "cpu"
        p.cpu = valor
    elif k == "fpu"
        p.fpu = si
    elif k == "pila"
        p.pila = Int(valor)
    elif k == "memcheck"
        p.memcheck = si
    elif k == "perfil"
        p.perfil = si
    elif k == "gcc"
        p.gcc = si
    elif k == "opciones"
        p.opciones = valor
    elif k == "argumentos"
        p.argumentos = valor
    elif k == "argumentos_depurar"
        p.argumentos_depurar = valor
    elif k == "version"
        p.version = valor
    elif k == "icono"
        p.icono = valor
    else
        return false
    end
    return true
end

# Los eventos del proyecto, el perfil y el depurador (pasos 3.1, 3.2, 4.1 y 4.2)
func atender_proyecto(ev: Int)
    if ev == EV_EDITOR_MOVER
        valor_bajo_raton()
    elif ev == EV_NUEVO_PROYECTO
        nuevo_proyecto_abrir()
    elif ev == EV_NP_TIPO
        nuevo_proyecto_descripcion()
    elif ev == EV_NP_CREAR
        nuevo_proyecto_crear()
    elif ev == EV_NP_CANCELAR
        mui_window_close(vn.window)
    elif ev == EV_NP_ELEGIR
        if file_open_dialog(tr(924, "En el cajón:"), "#?")
            mui_set_text(vn.cajon, file_get_path())
        end
    elif ev == EV_ABRIR_PROYECTO
        if file_open_dialog(tr(901, "Abrir proyecto..."), "#?.forja")
            proyecto_abrir(file_fullpath(), true)
        end
    elif ev == EV_PROPIEDADES
        propiedades_abrir()
    elif ev == EV_PP_GUARDAR
        propiedades_guardar()
    elif ev == EV_PP_CANCELAR
        mui_window_close(vq.window)
    elif ev == EV_PP_PRINCIPAL and proy != nil
        if file_open_dialog(tr(934, "Fichero principal:"), "#?.dash")
            mui_set_text(vq.principal, pr_relativa(proy, file_fullpath()))
        end
    elif ev == EV_PP_ICONO and proy != nil
        if file_open_dialog(tr(937, "Icono del programa:"), "#?.info")
            mui_set_text(vq.icono, pr_relativa(proy, file_fullpath()))
        end
    elif ev == EV_PERFIL
        ejecutar_con(true, false)
    elif ev == EV_MEMCHECK
        ejecutar_con(false, true)
    elif ev == EV_HASTA_AQUI
        hasta_aqui()
    elif ev == EV_CONDICION
        condicion_preguntar()
    elif ev == EV_CONTADOR
        contador_preguntar()
    elif ev == EV_VIGILAR
        vigilar_preguntar()
    elif ev == EV_REGISTROS
        registros_ver()
    elif ev == EV_MEMORIA
        memoria_preguntar()
    elif ev == EV_QUITAR_PUNTOS
        quitar_puntos()
    end
end

# Lo que pide un evento de la ventana (lo que no es salir ni del menú Proyecto). Va aparte de Main para que Main
# no pase de 32 KB: dashc 2.4 estropea un salto corto que tiene que crecer (ver el informe de la rama autocompletar).
func atender(ev: Int)
    if ev >= EV_NUEVO_PROYECTO and ev <= EV_EDITOR_MOVER
        atender_proyecto(ev)
    elif ev >= EV_EXT_MENU and ev < EV_EXT_MENU + EXT_TOTAL
        ext_menu(ev - EV_EXT_MENU)
    elif ev > EV_ED and ev < EV_ED + TC_TOTAL
        orden_editor(ev - EV_ED)
    elif ev == EV_ED_CERRAR
        ed_cerrar_solo = mui_get_value(menu_cerrar) != 0
        env_set("Forja/cerrar_solo", si_no(ed_cerrar_solo), true)
    elif ev == EV_ED_END
        ed_auto_end = mui_get_value(menu_end) != 0
        env_set("Forja/auto_end", si_no(ed_auto_end), true)
    elif ev >= EV_AYUDA and ev <= EV_AY_ACTIVADA
        ayuda_evento(ev)
    elif ev == EV_ERROR_SIGUIENTE or ev == EV_ERROR_ANTERIOR
        ir_a_error(ev == EV_ERROR_SIGUIENTE)
    elif ev >= EV_EXT_GESTOR and ev <= EV_EXT_CERRAR
        gestor(ev)
    elif ev == EV_PROYECTO
        en_proyecto()
    elif ev == EV_ZONA
        ext_zona(bb_zona_clic)
    elif ev == EV_ACTIVADA
        # se volvió a Forja: quizá cambió algo fuera (ficheros nuevos): el panel del proyecto otra vez; y VUELTA a las
        # extensiones que lo piden (git mira el estado)
        if depuracion.length == 0 and proyecto_cajon != ""
            desde = proyecto_desde
            proyecto_leer(proyecto_cajon)
            proyecto_desde = proyecto_desde_valido(desde)
            mui_canvas_redraw(v.proyecto)
        end
        ext_suceso("VUELTA", "")
    elif ev == EV_ACTUALIZAR
        act_pedir()
        actualizar_mensajes()
    elif ev == EV_BUSCAR
        mui_window_open(vb.window)
        mui_set_active(vb.window, vb.texto)
    elif ev == EV_SIGUIENTE or ev == EV_ANTERIOR
        buscar(ev == EV_SIGUIENTE)
    elif ev == EV_CAMBIAR
        cambiar_uno()
    elif ev == EV_TODO_CAMBIAR
        cambiar_todo(mui_get_text(vb.texto), mui_get_text(vb.cambio), mui_get_value(vb.mayus) != 0)
    elif ev == EV_BUSCAR_PROYECTO
        buscar_proyecto()
    elif ev == EV_CAMBIAR_PROYECTO
        cambiar_proyecto()
    elif ev == EV_BUSCAR_CERRAR
        mui_window_close(vb.window)
    elif ev == EV_IRA
        mui_set_text(vi.linea, "")
        mui_window_open(vi.window)
        mui_set_active(vi.window, vi.linea)
    elif ev == EV_IR
        ir_a(Int(str_trim(mui_get_text(vi.linea))))
        mui_window_close(vi.window)
    elif ev == EV_IRA_CERRAR
        mui_window_close(vi.window)
    elif ev == EV_DEFINICION
        ir_definicion()
    elif ev == EV_VOLVER
        volver()
    elif ev == EV_REFERENCIAS
        referencias()
    elif ev == EV_COMPLETAR
        completar_ahora()
    elif ev == EV_PREFERENCIAS
        preferencias_abrir()
    elif ev == EV_PREF_GUARDAR or ev == EV_PREF_USAR
        preferencias_aplicar(ev == EV_PREF_GUARDAR)
    elif ev == EV_PREF_CANCELAR
        mui_window_close(vp.window)
    elif ev == EV_SALIDA
        en_salida()
    elif ev == EV_ARRASTRE_SALIDA
        arrastrar_salida()
    elif ev == EV_COPIAR_SALIDA
        copiar_salida(salida_hay_seleccion())
    elif ev == EV_GUARDAR_SALIDA
        guardar_salida()
    elif ev == EV_BARRA_SALIDA
        desde = mui_get_value(v.barra_salida)
        if desde != salida_desde
            salida_ir_a(desde)
            barra_salida_valor = desde
            mui_canvas_redraw(v.salida)
        end
    elif ev == EV_BARRA_PROYECTO and depuracion.length > 0
        desde = mui_get_value(v.barra_proyecto)
        if desde != depuracion_desde
            depuracion_desde = dep_desde_valido(desde)
            barra_proyecto_valor = desde
            mui_canvas_redraw(v.proyecto)
        end
    elif ev == EV_BARRA_PROYECTO
        desde = mui_get_value(v.barra_proyecto)
        if desde != proyecto_desde
            proyecto_desde = proyecto_desde_valido(desde)
            barra_proyecto_valor = desde
            mui_canvas_redraw(v.proyecto)
        end
    elif ev == EV_BARRA_VARIABLES
        dx = mui_get_value(v.barra_variables)
        if dx != depuracion_dx
            depuracion_dx = dep_dx_valido(dx)
            barra_variables_valor = dx
            mui_canvas_redraw(v.proyecto)
        end
    elif ev == EV_ELEGIR_DASHC
        if file_open_dialog(tr(223, "El compilador de Dash"), "#?")
            mui_set_text(vp.dashc, file_fullpath())
        end
    elif ev == EV_ELEGIR_EJECUTABLES
        # el cajón donde está el diálogo al aceptar (el nombre de fichero no cuenta)
        if file_open_dialog(tr(378, "El cajón de los ejecutables"), "#?")
            mui_set_text(vp.ejecutables, file_get_path())
        end
    elif ev == EV_DEPURAR
        depurar()
    elif ev >= EV_SEGUIR and ev <= EV_PARAR
        orden_depurador(ev)
    elif ev == EV_COMPILAR
        compilar(false)
    elif ev == EV_EJECUTAR
        compilar(true)
    elif ev == EV_TIC
        tic()
    elif ev == EV_VISTA_CERRADA
        dv_cerrar_vista()
    elif ev >= EV_CORTAR and ev <= EV_VISTA
        edicion(ev)
    elif ev == EV_ARRASTRE
        if mui_canvas_drag(v.editor) == 1
            ed_arrastrar(mui_canvas_mouse_x(lienzo_teclas), mui_canvas_mouse_y(lienzo_teclas))
            redibujar()
        end
    elif ev == EV_BARRA
        d = ed_actual()
        if d != nil and mui_get_value(v.barra) != barra_valor
            # (la barra va en filas de las que se ven: con algo plegado, no es la línea)
            barra_valor = mui_get_value(v.barra)
            d.primera = ed_filas_desde(d, 0, barra_valor)
            mui_canvas_redraw(v.editor)
        end
    end
end

Main
    app = mui_app_begin("Forja", "FORJA")
    if app == 0
        Print "Forja necesita MUI y un 68020 o mejor."
    else
        v = Principal_create()
        vb = Buscar_create()
        vi = IrA_create()
        vp = PrefForja_create()
        vx = GestorExt_create()
        va = VentanaAyuda_create()
        vn = NuevoProyecto_create()
        vq = PropProyecto_create()
        dep_vigilar = vigilar_sueltas
        ayf_ventana(va.window, va.lista, va.texto, va.barra, va.buscar, va.atras, va.adelante, va.probar)
        # en su propia pantalla (preferencia): un clon público del Workbench, que pasa a ser la pública por defecto
        # para que los programas que ejecuta salgan en ella
        if env_get("Forja/pantalla") == "si" and screen_clone_wb(PANTALLA)
            screen_make_default()
            for w in [v.window, vb.window, vi.window, vp.window, vx.window, va.window, vn.window, vq.window]
                mui_window_screen(w, PANTALLA)
            end
        end
        lienzo_teclas = v.editor
        mui_canvas_on_draw(v.proyecto, dibujar_proyecto)
        mui_canvas_on_draw(v.editor, dibujar_editor)
        mui_canvas_on_draw(v.salida, dibujar_salida)
        bb_crear()
        mui_canvas_on_draw(v.botones, dibujar_botones)
        mui_canvas_on_input(v.botones, EV_BOTONES)
        mui_canvas_on_move(v.botones, EV_BOTONES_MOVER)
        mui_canvas_buffered(v.editor, true)
        mui_canvas_on_input(v.editor, EV_EDITOR)
        mui_canvas_on_drag(v.editor, EV_ARRASTRE)
        # el valor bajo el ratón, al depurar
        mui_canvas_on_move(v.editor, EV_EDITOR_MOVER)
        mui_canvas_on_input(v.proyecto, EV_PROYECTO)
        # VUELTA a las extensiones: la ventana de Forja vuelve a ser la activa
        mui_on_activate(v.window, EV_ACTIVADA)
        mui_canvas_on_input(v.salida, EV_SALIDA)
        mui_canvas_on_draw(va.texto, dibujar_ayuda)
        mui_canvas_on_input(va.texto, EV_AY_TEXTO)
        mui_on_activate(va.window, EV_AY_ACTIVADA)
        mui_canvas_on_drag(v.salida, EV_ARRASTRE_SALIDA)
        mui_canvas_take_tab(v.editor, true)
        # las teclas, al editor aunque el puntero no esté encima (F5, F10... al depurar: lo contó David Martínez)
        mui_canvas_take_keys(v.editor, true)
        # lo que aún no hace nada, apagado
        mui_app_rexx(app, orden_rexx)
        poner_tarea(NADA)
        sonda = env_get("FORJA_SONDA") != ""
        ed_anotar_vistas = sonda
        completar_activo = env_get("Forja/completar") != "no"
        comprobar_activo = env_get("Forja/comprobar") != "no"
        # la ayuda de Dash también junto al compilador (su cajón Ayuda)
        ayf_cajon_extra = cajon_de(dashc())
        act_iniciar(env_get("Forja/buscar_dash") != "no" and env_get("FORJA_SONDA") == "")

        # las extensiones: sus opciones del menú, sus tipos de fichero y las que arrancan con Forja
        ext_leer_todas(ext_cajon_de_forja())
        # sus menús propios, antes de abrir la ventana (con MUI 3.8, después habría que cerrarla y abrirla)
        ext_menus_al_dia()
        # las teclas del editor (ENVARC:Forja/teclas) y su menú, con las teclas que tengan
        ed_cerrar_solo = env_get("Forja/cerrar_solo") != "no"
        ed_auto_end = env_get("Forja/auto_end") != "no"
        teclas_leer()
        menu_editor()
        teclas_vigilar()
        ruta = env_get("FORJA_PRUEBA")
        if ruta == "" and arg_count() > 0
            ruta = arg(0)
        end
        if ruta != "" and abrir(ruta)
            proyecto_leer(cajon_de(ruta))
        elif not sesion_abrir()
            proyecto_leer(cajon_de(ruta))     # sin fichero: la bienvenida, con el logo de Dash
        end
        proyecto_al_dia()
        salida_anadir(tr(29, "Forja ") + VERSION + ".", 0)
        salida_anadir(tr(31, "Listo."), 2)

        mui_set_visible(v.barra_variables, false)     # la de abajo del panel de las variables, solo al depurar
        mui_window_open(v.window)
        abierta = true
        # los colores y la fuente (ENVARC:Forja/tema): lo que no se entiende, a la salida
        tema_preparar()
        if tema_malas != ""
            salida_anadir(tr(871, "No entiendo estas líneas del tema (ENVARC:Forja/tema):"), 1)
            for l in str_split(str_trim(tema_malas), "\n")
                salida_anadir("  " + l, 1)
            end
        end
        mui_canvas_set_pointer(v.editor, 1)
        ajustar_barra()
        if ed_actual() == nil
            armar_tic(500, EV_TIC)
        elif completar_activo
            # los símbolos del código, en cuanto la ventana esté quieta
            armar_tic(REPOSO_MS, EV_TIC)
        end
        actualizar_armar()
        ext_tras_evento()
        if sonda
            publicar_sonda()
            escribir_sonda()
            env_set("FORJA_ESTADO", "libre", false)
        end
        while true
            ev = mui_wait_event_signals(dbg_signal() | file_notify_signal())
            if sonda
                sonda_eventos = sonda_eventos + "#{ev}@#{(time_ms() / 100) % 10000}"
                if ev == EV_EDITOR
                    sonda_eventos = sonda_eventos + ":#{mui_canvas_key(lienzo_teclas)}/#{mui_canvas_button(lienzo_teclas)}q#{mui_canvas_qualifiers(lienzo_teclas)}"
                elif ev == EV_ARRASTRE
                    sonda_eventos = sonda_eventos + "d#{mui_canvas_drag(v.editor)}"
                end
                sonda_eventos = sonda_eventos + " "
                sonda_fichero("RAM:forja-eventos.txt", sonda_eventos)
            end
            if ev == 0
                mirar_depuracion()
                teclas_mirar()
            end
            # el puntero sobre el editor solo importa parado en el depurador (el valor bajo el ratón): sin nada más
            if ev == EV_EDITOR_MOVER and ed_valor_texto == "" and (tarea != DEPURANDO or dbg_state() != 3)
                continue
            end
            seguir_antes()
            if ev == EV_EDITOR
                otro = en_editor()
                if otro != 0
                    ev = otro
                end
            elif ev == EV_BOTONES_MOVER
                if bb_mover(mui_canvas_pointer_x(v.botones), mui_canvas_pointer_inside(v.botones))
                    mui_canvas_redraw(v.botones)
                end
            elif ev == EV_BOTONES
                if mui_canvas_button(v.botones) == 1
                    ev = bb_clic(mui_canvas_mouse_x(v.botones))
                elif mui_canvas_key(v.botones) >= 0
                    ev = tecla_depurador(mui_canvas_key(v.botones))
                    if ev == 0 and ed_actual() != nil and mui_canvas_wheel(v.botones) == 0
                        # las demás, al editor
                        lienzo_teclas = v.botones
                        ev = en_editor()
                        lienzo_teclas = v.editor
                        if ev == 0
                            ev = EV_NADA
                        end
                    end
                end
            elif ev == EV_PROYECTO and mui_canvas_key(v.proyecto) >= 0 and tecla_depurador(mui_canvas_key(v.proyecto)) != 0
                ev = tecla_depurador(mui_canvas_key(v.proyecto))
            elif ev == EV_SALIDA and mui_canvas_key(v.salida) >= 0 and tecla_depurador(mui_canvas_key(v.salida)) != 0
                ev = tecla_depurador(mui_canvas_key(v.salida))
            elif ev == EV_PROYECTO and depuracion.length > 0 and es_flecha(mui_canvas_key(v.proyecto))
                # depurando, las flechas sobre el panel mueven la pila y las variables (como antes de que el teclado
                # fuera al editor con el puntero en el panel; idea de David Martínez): se queda en EV_PROYECTO
                ev = EV_PROYECTO
            elif (ev == EV_PROYECTO or ev == EV_SALIDA) and ed_actual() != nil
                # una tecla con el puntero sobre el proyecto o la salida: es del editor (el teclado va al editor
                # aunque el puntero no esté encima)
                lienzo = v.salida
                if ev == EV_PROYECTO
                    lienzo = v.proyecto
                end
                if mui_canvas_key(lienzo) >= 0 and mui_canvas_button(lienzo) == 0 and mui_canvas_wheel(lienzo) == 0
                    lienzo_teclas = lienzo
                    otro = en_editor()
                    lienzo_teclas = v.editor
                    ev = otro
                    if otro == 0
                        ev = EV_NADA
                    end
                end
            end
            if ev == -1
                ev = EV_SALIR
            end
            if ev == EV_SALIR_EXT
                tic_armado = false
                armar_tic(REPOSO_MS, EV_TIC)
                ev = EV_SALIR
            end
            if ev == EV_SALIR or (ev >= EV_NUEVO and ev <= EV_CERRAR) or ev == EV_NUEVO_EXT
                if proyecto(ev)
                    sesion_guardar()
                    break
                end
            end
            atender(ev)
            proyecto_al_dia()
            seguir_despues()
            ext_tras_evento()
            ajustar_barra()
            ajustar_barras_paneles()
            if ed_actual() == nil and not tic_armado
                armar_tic(500, EV_TIC)
            end
            actualizar_armar()
            if sonda
                publicar_sonda()
                # para las pruebas: abre las preferencias (la simulación del menú no llega a ellas)
                if env_get("FORJA_PREFERENCIAS") != ""
                    env_set("FORJA_PREFERENCIAS", "", false)
                    preferencias_abrir()
                end
                # lo mismo con cualquier opción del menú, por su evento (los menús de MUI no se dejan elegir con
                # input_menu): el menú Extensiones en tests/extensiones.dash
                if env_get("FORJA_EVENTO") != ""
                    e = Int(env_get("FORJA_EVENTO"))
                    env_set("FORJA_EVENTO", "", false)
                    atender(e)
                    ext_tras_evento()
                end
            end
        end
        cmp_parar()
        ayf_cerrar_ventana()
        ext_salir()
        ext_esperar_salida()
        mui_app_end()
        screen_close()
    end
end
