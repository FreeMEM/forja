# Forja: el entorno de desarrollo de Dash en el Amiga.
#
# La ventana (ventana.dashui): botones arriba; el proyecto a la izquierda; el editor con sus pestañas; la salida
# abajo. Los paneles se dibujan en lienzos con el tema oscuro (tema.dash).
#
#   Forja [fichero]      # sin fichero, uno nuevo
#
# El teclado va al editor cuando el puntero está encima. Flechas; con Mayúsculas seleccionan; Alt: principio y
# final de línea, página arriba y abajo; Ctrl: de palabra en palabra, principio y final del texto. Los atajos con
# Amiga son los del menú, también sobre el editor.
#
# Compilar (Amiga-K) llama a dashc sin parar la ventana (ENV:Forja/dashc, o "dashc" del camino de órdenes); sus
# errores van a la salida y un clic en uno lleva a su línea. Ejecutar (Amiga-E) compila y ejecuta; mientras el
# programa corre, el botón es Parar (Ctrl-C).
#
# Inferencia (Amiga-I o el botón) le manda el fichero activo, o las líneas elegidas, con ADJUNTAR, y la enseña;
# si no está abierta, la arranca (ENV:Forja/inferencia, o "Inferencia" del camino de órdenes).
#
# Puerto ARexx FORJA.1: ABRIR fichero [línea]; ABIERTO fichero (1 o 0); TEXTO fichero (lo que hay en el editor,
# guardado o no); SELECCION (fichero, desde, hasta y el texto, en líneas); CAMBIAR fichero desde hasta texto
# (con deshacer; hasta = desde - 1 mete líneas); GUARDAR [fichero]; COMPILAR y EJECUTAR (sin esperar);
# ESTADO (libre, compilando, ejecutando); ERRORES (los de la última compilación).
#
# Cerrar una pestaña o salir con cambios sin guardar pregunta: Guardar, Descartar o Cancelar.
#
# Para las pruebas: ENV:FORJA_PRUEBA con un fichero lo abre al empezar. Con ENV:FORJA_SONDA, para un programa que
# hace de usuario (tests/teclas.dash, tests/ficheros.dash): ENV:FORJA_EDITOR dice dónde está el editor ("x y
# ancho alto" desde la esquina de la ventana), ENV:FORJA_PROYECTO dónde empiezan las filas del proyecto ("x y
# alto de fila"), ENV:FORJA_SALIDA lo de la salida ("x y alto_de_fila primera_vista total"; el texto en
# RAM:forja-salida.txt), ENV:FORJA_ESTADO si compila o ejecuta, ENV:FORJA_PESTANAS los centros de las pestañas ("x,y x,y...") y RAM:forja-sonda.txt lleva,
# tras cada cambio, "línea columna nombre" y el texto; ENV:FORJA_DISENO, lo del editor de ventanas ("fila propiedad
# editando mensaje").

import "tema.dash"
import "editor.dash"
import "paneles.dash"
import "ventana.dashui"

const VERSION = "0.1"

const EV_COMPILAR = 10
const EV_EJECUTAR = 11
const EV_DEPURAR = 12
const EV_SEGUIR = 13
const EV_PASO = 14
const EV_ENTRAR = 15
const EV_SALIR_FUNCION = 16
const EV_PARAR = 17
const EV_INFERENCIA = 19
const EV_BARRA = 3
const EV_EDITOR = 4
const EV_ARRASTRE = 5
const EV_PROYECTO = 6
const EV_TIC = 7
const EV_SALIDA = 8
const TIC_MS = 100
const ESPERA_DASHC = 300000    # cinco minutos como mucho para compilar

const NADA = 0
const COMPILANDO = 1
const EJECUTANDO = 2
const DEPURANDO = 3
# Teclas de función sobre el editor
const T_F5 = 0x54
const T_F6 = 0x55
const T_F7 = 0x56
const T_F9 = 0x58
const T_F10 = 0x59
const EV_NUEVO = 30
const EV_ABRIR = 31
const EV_GUARDAR = 32
const EV_GUARDAR_COMO = 33
const EV_CERRAR = 34
const EV_CORTAR = 40
const EV_COPIAR = 41
const EV_PEGAR = 42
const EV_DESHACER = 43
const EV_REHACER = 44
const EV_TODO = 45
const EV_DISENO = 46
const EV_VISTA = 47
const EV_VISTA_CERRADA = 60
const EV_SALIR = 99

const TITULO_CAMBIOS = "Cambios sin guardar"
const NUEVO = "# Un programa de Dash\n\nMain\n    Print \"Hola, Amiga\"\nend\n"

var v: Principal = nil
var app: Int = 0
var errores_ultimos: String = ""    # las líneas de error de la última compilación (para ARexx)
var inferencia_espera: Int = 0      # tics esperando a que arranque Inferencia
var inferencia_pendiente: String = ""
var sonda: Bool = false
var sonda_editor: String = ""
var barra_total: Int = -1
var barra_visibles: Int = -1
var barra_valor: Int = -1
var sonda_proyecto: String = ""
var sonda_pestanas: String = ""
var sonda_salida: String = ""
var abierta: Bool = false
var tarea: Int = NADA
var tarea_run: Int = 0
var tarea_inicio: Int = 0
var tarea_exe: String = ""
var ejecutar_despues: Bool = false
var depurar_despues: Bool = false
var salida_vista: Int = 0          # lo que ya se enseñó de dbg_output()

func dibujar_proyecto(x: Int, y: Int, ancho: Int, alto: Int)
    proyecto_dibujar(x, y, ancho, alto)
end

func dibujar_editor(x: Int, y: Int, ancho: Int, alto: Int)
    ed_dibujar(x, y, ancho, alto)
end

func dibujar_salida(x: Int, y: Int, ancho: Int, alto: Int)
    salida_dibujar(x, y, ancho, alto)
end

func avisar(texto: String, tipo: Int)
    salida_anadir(texto, tipo)
    if abierta
        mui_canvas_redraw(v.salida)
    end
end

func nombre_de(ruta: String) -> String
    nombre = ruta
    for sep in [":", "/"]
        p = str_find(nombre, sep)
        while p >= 0
            nombre = nombre[p + 1:]
            p = str_find(nombre, sep)
        end
    end
    return nombre
end

# Abre un fichero en una pestaña nueva, o va a la suya si ya está abierto
func abrir(ruta: String) -> Bool
    i = ed_buscar_ruta(ruta)
    if i >= 0
        activo = i
        return true
    end
    texto = file_read_text(ruta)
    if texto == nil
        avisar("No se puede leer " + ruta, 1)
        return false
    end
    ed_abrir_texto(nombre_de(ruta), ruta, texto)
    return true
end

func guardar_en(d: Documento, ruta: String) -> Bool
    if not file_write_text(ruta, ed_texto_disco(d))
        avisar("No se puede escribir " + ruta, 1)
        return false
    end
    d.ruta = ruta
    d.nombre = nombre_de(ruta)
    d.cambiado = false
    avisar("Guardado: " + ruta, 2)
    if cajon_de(ruta) == proyecto_cajon
        proyecto_leer(proyecto_cajon)
        mui_canvas_redraw(v.proyecto)
    end
    return true
end

func guardar_como(d: Documento) -> Bool
    if not file_save_dialog("Guardar " + d.nombre, "#?.(dash|dashui)")
        return false
    end
    return guardar_en(d, file_fullpath())
end

func guardar(d: Documento) -> Bool
    if d.ruta == ""
        return guardar_como(d)
    end
    return guardar_en(d, d.ruta)
end

func cambiados() -> Int
    n = 0
    for d in documentos
        if d.cambiado
            n = n + 1
        end
    end
    return n
end

# Las órdenes del menú Proyecto. Devuelve true si hay que salir.
func proyecto(ev: Int) -> Bool
    d = ed_actual()
    if ev == EV_NUEVO
        ed_abrir_texto("sin nombre.dash", "", NUEVO)
    elif ev == EV_ABRIR
        if file_open_dialog("Abrir", "#?.(dash|dashui)")
            ruta = file_fullpath()
            if abrir(ruta) and cajon_de(ruta) != proyecto_cajon
                proyecto_leer(cajon_de(ruta))
                mui_canvas_redraw(v.proyecto)
            end
        end
    elif ev == EV_GUARDAR and d != nil
        guardar(d)
    elif ev == EV_GUARDAR_COMO and d != nil
        guardar_como(d)
    elif ev == EV_CERRAR and d != nil
        if d.cambiado
            r = mui_request(v.window, TITULO_CAMBIOS, d.nombre + " tiene cambios sin guardar.", "_Guardar|_Descartar|_Cancelar")
            if r == 0 or (r == 1 and not guardar(d))
                return false
            end
        end
        ed_cerrar(activo)
        if documentos.length == 0
            ed_abrir_texto("sin nombre.dash", "", NUEVO)
        end
    elif ev == EV_SALIR
        n = cambiados()
        if n > 0
            texto = "Hay #{n} ficheros con cambios sin guardar."
            if n == 1
                texto = "Hay un fichero con cambios sin guardar."
            end
            r = mui_request(v.window, TITULO_CAMBIOS, texto, "_Guardar|_Descartar|_Cancelar")
            if r == 0
                return false
            end
            if r == 1
                for o in documentos
                    if o.cambiado and not guardar(o)
                        return false
                    end
                end
            end
        end
        return true
    end
    redibujar()
    return false
end

# --- Compilar y ejecutar ---

# dashc: ENV:Forja/dashc, o el que haya en el camino de órdenes
func dashc() -> String
    c = env_get("Forja/dashc")
    if c == ""
        c = "dashc"
    end
    return c
end

# "main.dash" -> "main"
func ejecutable_de(ruta: String) -> String
    if str_ends(str_lower(ruta), ".dash")
        return ruta[0:ruta.length - 5]
    end
    return ruta + ".exe"
end

func segundos(ms: Int) -> String
    return "#{ms / 1000},#{(ms % 1000) / 100} s"
end

func poner_tarea(t: Int)
    tarea = t
    mui_set_enabled(v.compilar, t == NADA)
    mui_set_enabled(v.ejecutar, t != COMPILANDO)
    mui_set_enabled(v.depurar, t == NADA)
    # al depurar, los botones del depurador en lugar de los de siempre (todos no caben: primero se ocultan unos y
    # luego se enseñan los otros)
    if t == DEPURANDO
        for b in [v.compilar, v.ejecutar, v.depurar]
            mui_set_visible(b, false)
        end
        for b in [v.seguir, v.paso, v.entrar, v.salir, v.parar]
            mui_set_visible(b, true)
        end
    else
        for b in [v.seguir, v.paso, v.entrar, v.salir, v.parar]
            mui_set_visible(b, false)
        end
        for b in [v.compilar, v.ejecutar, v.depurar]
            mui_set_visible(b, true)
        end
    end
    if t == EJECUTANDO
        mui_set_text(v.ejecutar, "Parar")
    else
        mui_set_text(v.ejecutar, "Ejecutar")
    end
    if sonda
        var nombres: [String] = ["libre", "compilando", "ejecutando", "depurando"]
        env_set("FORJA_ESTADO", nombres[t], false)
    end
end

func compilar(y_ejecutar: Bool)
    if tarea == EJECUTANDO
        run_break(tarea_run)
        return
    end
    if tarea != NADA
        return
    end
    d = ed_actual()
    if d == nil
        return
    end
    if d.ruta == "" and not guardar_como(d)
        return
    end
    # lo que haya sin guardar va al disco antes (dashc lee los ficheros)
    for o in documentos
        if o.cambiado and o.ruta != ""
            guardar_en(o, o.ruta)
        end
    end
    redibujar()
    tarea_exe = ejecutable_de(d.ruta)
    opciones = ""
    if depurar_despues
        opciones = " --debug"
    end
    orden = dashc() + opciones + " \"" + d.ruta + "\" -o \"" + tarea_exe + "\""
    avisar("Compilando " + d.nombre + "...", 0)
    tarea_run = run_start(orden, ESPERA_DASHC)
    if tarea_run == 0
        avisar("No se puede ejecutar " + dashc() + ". Pon su ruta en ENV:Forja/dashc.", 1)
        return
    end
    ejecutar_despues = y_ejecutar
    tarea_inicio = time_ms()
    poner_tarea(COMPILANDO)
    mui_timer(TIC_MS, EV_TIC)
end

func tic()
    if inferencia_espera > 0
        if inferencia_mandar()
            redibujar()
        else
            inferencia_espera = inferencia_espera - 1
            if inferencia_espera == 0
                avisar("Inferencia no aparece.", 1)
            elif tarea == NADA
                mui_timer(TIC_MS, EV_TIC)
            end
        end
    end
    if tarea == NADA
        return
    end
    if tarea == DEPURANDO
        # (la señal del depurador es lo normal; esto, por si se pierde)
        mirar_depuracion()
        if tarea == DEPURANDO
            mui_timer(TIC_MS * 3, EV_TIC)
        end
        return
    end
    if not run_ready(tarea_run)
        mui_timer(TIC_MS, EV_TIC)
        return
    end
    texto = run_finish(tarea_run)
    rc = run_rc()
    tarea_run = 0
    ms = time_ms() - tarea_inicio
    if tarea == COMPILANDO
        errores = 0
        errores_ultimos = ""
        for l in str_split(str_trim(texto), "\n")
            if salida_error_dashc(l)
                errores = errores + 1
                errores_ultimos = errores_ultimos + l + "\n"
            elif l != ""
                salida_anadir(l, 0)
            end
        end
        if rc != 0
            if errores == 1
                avisar("No compila: un error (clic en él para ir a su línea).", 1)
            else
                avisar("No compila: #{errores} errores (clic en uno para ir a su línea).", 1)
            end
            poner_tarea(NADA)
            depurar_despues = false
            return
        end
        avisar("Compilado en " + segundos(ms) + ": " + tarea_exe, 2)
        if depurar_despues
            depurar_despues = false
            empezar_depuracion()
            return
        end
        if not ejecutar_despues
            poner_tarea(NADA)
            return
        end
        avisar("Ejecutando " + nombre_de(tarea_exe) + "...", 0)
        tarea_run = run_start("\"" + tarea_exe + "\"", 0)
        if tarea_run == 0
            avisar("No se puede ejecutar " + tarea_exe, 1)
            poner_tarea(NADA)
            return
        end
        tarea_inicio = time_ms()
        poner_tarea(EJECUTANDO)
        mui_timer(TIC_MS, EV_TIC)
        return
    end
    # acabó el programa
    if str_trim(texto) != ""
        salida_anadir(str_trim(texto), 0)
    end
    tipo = 2
    if rc != 0
        tipo = 1
    end
    avisar(nombre_de(tarea_exe) + " acabó con código #{rc} en " + segundos(ms) + ".", tipo)
    poner_tarea(NADA)
end

# --- Depurar ---

func depurar()
    if tarea != NADA
        return
    end
    depurar_despues = true
    compilar(false)
    if tarea != COMPILANDO
        depurar_despues = false
    end
end

func empezar_depuracion()
    if not dbg_start(tarea_exe, "")
        avisar("No se puede depurar: " + dbg_error(), 1)
        poner_tarea(NADA)
        return
    end
    for d in documentos
        for p in d.puntos
            dbg_break(d.nombre, p)
        end
    end
    salida_vista = 0
    avisar("Depurando " + nombre_de(tarea_exe) + " (F5 seguir, F10 paso, F6 entrar, F7 salir, F9 punto de parada).", 0)
    poner_tarea(DEPURANDO)
    dbg_continue()
    mui_timer(TIC_MS * 3, EV_TIC)
    mirar_depuracion()
    publicar_depuracion()
end

# Lo nuevo que escribió el programa, a la salida
func salida_programa()
    t = dbg_output()
    if t.length > salida_vista
        nuevo = t[salida_vista:]
        salida_vista = t.length
        if nuevo.length > 0 and str_ends(nuevo, "\n")
            nuevo = nuevo[0:nuevo.length - 1]
        end
        avisar(nuevo, 0)
    end
end

# El depurador avisó (o un tic): ¿ha parado o ha acabado?
func mirar_depuracion()
    if tarea != DEPURANDO
        return
    end
    e = dbg_state()
    if e == 3
        al_parar()
    elif e == 4 or e == 0
        al_acabar()
    end
end

func al_parar()
    salida_programa()
    ruta = dbg_file()
    n = dbg_line()
    ed_dbg_ruta = ruta
    ed_dbg_linea = n
    if abrir(ruta)
        ed_ir_a(n, 1)
    end
    # la pila y las variables, en el panel de la izquierda
    depuracion_lineas.clear()
    depuracion_tipos.clear()
    depuracion_lineas.push("PILA")
    depuracion_tipos.push(0)
    i = 0
    while i < dbg_frames()
        depuracion_lineas.push(dbg_frame_function(i) + "  #{dbg_frame_line(i)}")
        if i == 0
            depuracion_tipos.push(2)
        else
            depuracion_tipos.push(1)
        end
        i = i + 1
    end
    depuracion_lineas.push("VARIABLES")
    depuracion_tipos.push(0)
    k = 0
    while k < dbg_vars(0)
        nombre = dbg_var_name(0, k)
        depuracion_lineas.push(nombre + " = " + dbg_value(0, nombre))
        depuracion_tipos.push(1)
        k = k + 1
    end
    if dbg_globals() > 0
        depuracion_lineas.push("GLOBALES")
        depuracion_tipos.push(0)
        g = 0
        while g < dbg_globals()
            nombre = dbg_global_name(g)
            depuracion_lineas.push(nombre + " = " + dbg_value(0, nombre))
            depuracion_tipos.push(1)
            g = g + 1
        end
    end
    mui_canvas_redraw(v.proyecto)
    redibujar()
    publicar_depuracion()
end

func al_acabar()
    salida_programa()
    avisar(nombre_de(tarea_exe) + " acabó con código #{dbg_rc()}.", 2)
    ed_dbg_ruta = ""
    ed_dbg_linea = 0
    depuracion_lineas.clear()
    depuracion_tipos.clear()
    poner_tarea(NADA)
    mui_canvas_redraw(v.proyecto)
    redibujar()
    publicar_depuracion()
end

# Seguir, paso, entrar, salir o parar
func orden_depurador(ev: Int)
    if tarea != DEPURANDO
        return
    end
    if ev == EV_PARAR
        dbg_end(3000)
        al_acabar()
        return
    end
    if dbg_state() != 3 and dbg_state() != 1
        return
    end
    ed_dbg_linea = 0
    if ev == EV_SEGUIR
        dbg_continue()
    elif ev == EV_PASO
        dbg_next()
    elif ev == EV_ENTRAR
        dbg_step()
    elif ev == EV_SALIR_FUNCION
        dbg_out()
    end
    redibujar()
    # (puede haber parado o acabado ya)
    mirar_depuracion()
    publicar_depuracion()
end

# Para las pruebas: ENV:FORJA_DEPURAR ("estado línea función") y ENV:FORJA_VARIABLES (las líneas del panel)
func publicar_depuracion()
    if not sonda
        return
    end
    # las variables antes que el estado: quien espera el estado ya las encuentra
    t = ""
    for l in depuracion_lineas
        t = t + l + "|"
    end
    env_set("FORJA_VARIABLES", t, false)
    env_set("FORJA_DEPURAR", "#{dbg_state()} #{dbg_line()} " + dbg_function(), false)
end

# Un clic en un error de la salida: a su fichero y su línea
func en_salida()
    if mui_canvas_button(v.salida) != 1
        return
    end
    i = salida_en(mui_canvas_mouse_y(v.salida))
    if i < 0 or salida_rutas[i] == ""
        return
    end
    ruta = salida_rutas[i]
    # una ruta relativa es del cajón del fichero activo
    if str_find(ruta, ":") < 0
        d = ed_actual()
        if d != nil
            ruta = ruta_unir(cajon_de(d.ruta), ruta)
        end
    end
    if abrir(ruta)
        ed_ir_a(salida_num[i], salida_col[i])
        redibujar()
    end
end

# Un clic en el panel del proyecto: un fichero se abre; un cajón se enseña
func en_proyecto()
    if mui_canvas_button(v.proyecto) != 1
        return
    end
    i = proyecto_en(mui_canvas_mouse_y(v.proyecto))
    if i < 0
        return
    end
    f = proyecto_ficheros[i]
    if f == "/"
        proyecto_leer(cajon_de(proyecto_cajon))
    elif str_ends(f, "/")
        proyecto_leer(ruta_unir(proyecto_cajon, f[0:f.length - 1]))
    else
        if abrir(ruta_unir(proyecto_cajon, f))
            redibujar()
        end
        return
    end
    mui_canvas_redraw(v.proyecto)
end

# La barra sigue al editor
func ajustar_barra()
    d = ed_actual()
    if d == nil
        return
    end
    if d.lineas.length != barra_total or ed_visibles != barra_visibles
        barra_total = d.lineas.length
        barra_visibles = ed_visibles
        mui_set_range(v.barra, barra_total, barra_visibles)
        barra_valor = -1
    end
    if d.primera != barra_valor
        barra_valor = d.primera
        mui_set_value(v.barra, d.primera)
    end
end

func redibujar()
    mui_canvas_redraw(v.editor)
    ajustar_barra()
    escribir_sonda()
end

func redibujar_linea(n: Int)
    d = ed_actual()
    fy = ed_fila_y(d, n)
    if fy < 0
        redibujar()
        return
    end
    ed_solo_linea = n
    mui_canvas_update_area(v.editor, 0, fy, ed_zona_ancho, ed_alto_fila)
    ed_solo_linea = -1
    escribir_sonda()
end

func escribir_sonda()
    if sonda
        d = ed_actual()
        file_write_text("RAM:forja-sonda.txt", "#{d.cl} #{d.cc} " + d.nombre + "\n" + ed_texto(d))
        env_set("FORJA_DIBUJO", "#{ed_ms_dibujo}", false)
        env_set("FORJA_DISENO", "#{dv_sel} #{dv_prop} #{dv_editando} " + dv_mensaje, false)
    end
end

# Las órdenes del menú Edición (también con Amiga sobre el editor)
func edicion(ev: Int)
    d = ed_actual()
    if d == nil
        return
    end
    if ev == EV_CORTAR or ev == EV_COPIAR
        s = ed_seleccion(d)
        if s != ""
            clip_write_text(latin1_to_utf8(s))
            if ev == EV_CORTAR
                ed_borrar_seleccion(d)
            end
        end
    elif ev == EV_PEGAR
        t = str_replace(utf8_to_latin1(clip_read_text()), "\r\n", "\n")
        if t != ""
            ed_escribir(d, str_replace(t, "\t", "    "))
        end
    elif ev == EV_DESHACER
        ed_deshacer(d)
    elif ev == EV_REHACER
        ed_rehacer(d)
    elif ev == EV_TODO
        ed_seleccionar_todo(d)
    elif ev == EV_DISENO
        if str_ends(str_lower(d.nombre), ".dashui")
            d.diseno = not d.diseno
            if d.diseno
                ed_cargar_diseno(d, true)
            end
        else
            avisar("El editor de ventanas es para ficheros .dashui.", 1)
        end
    elif ev == EV_VISTA
        if not d.diseno
            avisar("La vista previa es del editor de ventanas (Amiga-D en un .dashui).", 1)
        elif dv_error_carga == ""
            e = dv_vista_previa(EV_VISTA_CERRADA, false)
            if e != ""
                avisar("Vista previa: " + e, 1)
            end
        end
    end
    if d.diseno and (ev == EV_DESHACER or ev == EV_REHACER or ev == EV_PEGAR or ev == EV_CORTAR)
        ed_cargar_diseno(d, true)
        rehacer_vista()
    end
    ed_seguir_cursor(d)
    redibujar()
end

# Pone o quita un punto de parada; si se está depurando, también en el programa
func alternar_punto(d: Documento, n: Int)
    puesto = ed_alternar_punto(d, n)
    if tarea == DEPURANDO
        if puesto
            if not dbg_break(d.nombre, n)
                avisar("La línea #{n} no tiene código: el punto no para ahí.", 1)
            end
        else
            dbg_unbreak(d.nombre, n)
        end
    end
    redibujar()
end

# Si la vista previa está abierta, se rehace con lo cambiado
func rehacer_vista()
    if dv_vista != 0 and dv_error_carga == ""
        e = dv_vista_previa(EV_VISTA_CERRADA, true)
        if e != ""
            avisar("Vista previa: " + e, 1)
        end
    end
end

# Amiga + letra sobre el editor: el evento de su opción del menú (0 si no es ninguna)
func atajo(letra: String) -> Int
    var letras: [String] = ["x", "c", "v", "z", "r", "a", "q", "n", "o", "s", "w", "k", "e", "i", "d", "p"]
    var eventos: [Int] = [EV_CORTAR, EV_COPIAR, EV_PEGAR, EV_DESHACER, EV_REHACER, EV_TODO, EV_SALIR, EV_NUEVO, EV_ABRIR, EV_GUARDAR, EV_CERRAR, EV_COMPILAR, EV_EJECUTAR, EV_INFERENCIA, EV_DISENO, EV_VISTA]
    l = str_lower(letra)
    i = 0
    while i < letras.length
        if letras[i] == l
            return eventos[i]
        end
        i = i + 1
    end
    return 0
end

# Lo que pasa sobre el editor: un clic, la rueda o una tecla. Devuelve otro evento si es un atajo.
func en_editor() -> Int
    d = ed_actual()
    if d == nil
        return 0
    end
    rueda = mui_canvas_wheel(v.editor)
    teclas = mui_canvas_qualifiers(v.editor)
    if rueda != 0
        d.primera = d.primera - rueda * 3
        maximo = d.lineas.length - ed_visibles
        if d.primera > maximo
            d.primera = maximo
        end
        if d.primera < 0
            d.primera = 0
        end
        redibujar()
    elif mui_canvas_button(v.editor) == 1 and ed_pestana_en(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor)) >= 0
        activo = ed_pestana_en(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
        redibujar()
    elif mui_canvas_button(v.editor) == 1 and d.diseno
        dv_clic(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
        redibujar()
    elif mui_canvas_button(v.editor) == 1 and mui_canvas_mouse_x(v.editor) < ed_margen - 4 and mui_canvas_mouse_y(v.editor) >= ALTO_PESTANAS
        # un clic en el margen de los números: punto de parada
        alternar_punto(d, ed_linea_en(d, mui_canvas_mouse_y(v.editor)))
    elif mui_canvas_button(v.editor) == 1
        ed_clic(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor), (teclas & Q_MAYUS) != 0)
        redibujar()
    else
        codigo = mui_canvas_key(v.editor)
        if codigo < 0
            return 0
        end
        letra = mui_canvas_char(v.editor)
        if (teclas & Q_AMIGA) != 0
            return atajo(letra)
        end
        if codigo == T_F9
            alternar_punto(d, d.cl + 1)
            return 0
        end
        if codigo == T_F5
            if tarea == DEPURANDO
                return EV_SEGUIR
            end
            return EV_DEPURAR
        end
        if codigo == T_F10
            return EV_PASO
        end
        if codigo == T_F6
            return EV_ENTRAR
        end
        if codigo == T_F7
            return EV_SALIR_FUNCION
        end
        if d.diseno
            if dv_tecla(codigo, teclas, letra)
                ed_aplicar_diseno(d)
                rehacer_vista()
            end
            redibujar()
            return 0
        end
        # escribir dentro de una línea solo redibuja esa línea
        antes_lineas = d.lineas.length
        antes_cl = d.cl
        antes_primera = d.primera
        antes_izquierda = d.izquierda
        antes_cambiado = d.cambiado
        antes_sel = ed_hay_seleccion(d)
        if ed_tecla(codigo, teclas, letra)
            if d.lineas.length == antes_lineas and d.cl == antes_cl and d.primera == antes_primera and d.izquierda == antes_izquierda and antes_cambiado and not antes_sel and not ed_hay_seleccion(d)
                redibujar_linea(d.cl)
            else
                redibujar()
            end
        end
    end
    return 0
end

func publicar_sonda()
    e = "#{ed_zona_x} #{ed_zona_y} #{ed_zona_ancho} #{ed_zona_alto}"
    if e != sonda_editor
        sonda_editor = e
        env_set("FORJA_EDITOR", e, false)
    end
    p = "#{proyecto_zona_x} #{proyecto_zona_y + proyecto_y0} #{proyecto_fila}"
    if p != sonda_proyecto
        sonda_proyecto = p
        env_set("FORJA_PROYECTO", p, false)
    end
    s = "#{salida_zona_x} #{salida_zona_y + salida_y0} #{salida_fila} #{salida_desde} #{salida_lineas.length}"
    if s != sonda_salida
        sonda_salida = s
        env_set("FORJA_SALIDA", s, false)
        texto = ""
        for l in salida_lineas
            texto = texto + l + "\n"
        end
        file_write_text("RAM:forja-salida.txt", texto)
    end
    t = ed_pestanas_ventana()
    if t != sonda_pestanas
        sonda_pestanas = t
        env_set("FORJA_PESTANAS", t, false)
    end
end

# --- Inferencia ---

const PUERTO_INFERENCIA = "INFERENCIA.1"

func inferencia_ruta() -> String
    r = env_get("Forja/inferencia")
    if r == ""
        r = "Inferencia"
    end
    return r
end

# Manda a Inferencia el fichero activo (o las líneas elegidas) y la enseña; si no está abierta, la arranca y
# lo manda cuando aparezca su puerto (tic)
func boton_inferencia()
    d = ed_actual()
    if d == nil
        return
    end
    ed_lineas_seleccion(d)
    que = d.nombre
    texto = ed_texto(d)
    if ed_hay_seleccion(d)
        que = d.nombre + ", líneas #{ed_sel_desde} a #{ed_sel_hasta}"
        texto = ed_seleccion(d)
    end
    ruta = d.ruta
    if ruta == ""
        ruta = d.nombre
    end
    # "ADJUNTAR título" y el texto en las líneas siguientes: Inferencia no tiene que leerlo de Forja
    inferencia_pendiente = "ADJUNTAR " + que + " (" + ruta + ")\n" + texto
    if not inferencia_mandar()
        if inferencia_espera > 0
            return
        end
        if run_start("Run >NIL: \"" + inferencia_ruta() + "\"", 5000) == 0
            avisar("No se puede arrancar " + inferencia_ruta() + ". Pon su ruta en ENV:Forja/inferencia.", 1)
            return
        end
        avisar("Arrancando Inferencia...", 0)
        inferencia_espera = 150
        mui_timer(TIC_MS, EV_TIC)
    end
end

# true si Inferencia lo recibió
func inferencia_mandar() -> Bool
    rexx_send(PUERTO_INFERENCIA, inferencia_pendiente)
    if rexx_rc() == -1
        return false
    end
    if rexx_rc() != 0
        avisar("Inferencia no lo aceptó (RC #{rexx_rc()}).", 1)
    else
        rexx_send(PUERTO_INFERENCIA, "MOSTRAR")
        avisar("Mandado a Inferencia.", 2)
    end
    inferencia_pendiente = ""
    inferencia_espera = 0
    return true
end

# --- El puerto ARexx FORJA.1 ---

# Las palabras de una orden: un argumento entre comillas puede llevar espacios. resto_desde dice desde qué
# argumento (desde 0) se quiere el resto de la línea tal cual, en _resto.
var _resto: String = ""

func _partes(linea: String, resto_desde: Int) -> [String]
    var ps: [String] = []
    _resto = ""
    i = 0
    n = linea.length
    while i < n
        while i < n and linea[i:i + 1] == " "
            i = i + 1
        end
        if i >= n
            break
        end
        if ps.length == resto_desde
            _resto = linea[i:]
            if _resto.length >= 2 and str_starts(_resto, "\"") and str_ends(_resto, "\"")
                _resto = _resto[1:_resto.length - 1]
            end
            return ps
        end
        if linea[i:i + 1] == "\""
            j = str_find_from(linea, "\"", i + 1)
            if j < 0
                j = n
            end
            ps.push(linea[i + 1:j])
            i = j + 1
        else
            j = str_find_from(linea, " ", i)
            if j < 0
                j = n
            end
            ps.push(linea[i:j])
            i = j
        end
    end
    return ps
end

# El documento de esa ruta, abriéndolo si hace falta (nil si no se puede leer)
func _documento(ruta: String) -> Documento
    if not abrir(ruta)
        return nil
    end
    return ed_actual()
end

func orden_rexx(linea: String) -> String
    p = _partes(linea, 99)
    if p.length == 0
        mui_rexx_fail(10)
        return ""
    end
    orden = str_upper(p[0])
    if orden == "ABRIR" and p.length >= 2
        if _documento(p[1]) == nil
            mui_rexx_fail(10)
            return ""
        end
        if p.length >= 3
            ed_ir_a(Int(p[2]), 1)
        end
        redibujar()
        return ""
    elif orden == "ABIERTO" and p.length >= 2
        if ed_buscar_ruta(p[1]) >= 0
            return "1"
        end
        return "0"
    elif orden == "TEXTO" and p.length >= 2
        i = ed_buscar_ruta(p[1])
        if i < 0
            mui_rexx_fail(10)
            return ""
        end
        return ed_texto(documentos[i])
    elif orden == "SELECCION"
        d = ed_actual()
        if d == nil
            mui_rexx_fail(10)
            return ""
        end
        ed_lineas_seleccion(d)
        return d.ruta + "\n#{ed_sel_desde}\n#{ed_sel_hasta}\n" + ed_seleccion(d)
    elif orden == "CAMBIAR"
        p = _partes(linea, 4)
        if p.length < 4
            mui_rexx_fail(10)
            return ""
        end
        d = _documento(p[1])
        if d == nil or not ed_cambiar_lineas(d, Int(p[2]), Int(p[3]), _resto)
            mui_rexx_fail(10)
            return ""
        end
        redibujar()
        return ""
    elif orden == "GUARDAR"
        d = ed_actual()
        if p.length >= 2
            i = ed_buscar_ruta(p[1])
            d = nil
            if i >= 0
                d = documentos[i]
            end
        end
        if d == nil or d.ruta == "" or not guardar_en(d, d.ruta)
            mui_rexx_fail(10)
            return ""
        end
        redibujar()
        return ""
    elif orden == "COMPILAR" or orden == "EJECUTAR"
        if tarea != NADA
            mui_rexx_fail(5)
            return ""
        end
        errores_ultimos = ""
        compilar(orden == "EJECUTAR")
        return ""
    elif orden == "ESTADO"
        var nombres: [String] = ["libre", "compilando", "ejecutando"]
        return nombres[tarea]
    elif orden == "ERRORES"
        return errores_ultimos
    end
    mui_rexx_fail(10)
    return ""
end

Main
    app = mui_app_begin("Forja", "FORJA")
    if app == 0
        Print "Forja necesita MUI y un 68020 o mejor."
    else
        v = Principal_create()
        mui_canvas_on_draw(v.proyecto, dibujar_proyecto)
        mui_canvas_on_draw(v.editor, dibujar_editor)
        mui_canvas_on_draw(v.salida, dibujar_salida)
        mui_canvas_buffered(v.editor, true)
        mui_canvas_on_input(v.editor, EV_EDITOR)
        mui_canvas_on_drag(v.editor, EV_ARRASTRE)
        mui_canvas_on_input(v.proyecto, EV_PROYECTO)
        mui_canvas_on_input(v.salida, EV_SALIDA)
        mui_canvas_take_tab(v.editor, true)
        # lo que aún no hace nada, apagado
        mui_app_rexx(app, orden_rexx)
        poner_tarea(NADA)
        sonda = env_get("FORJA_SONDA") != ""

        ruta = env_get("FORJA_PRUEBA")
        if ruta == "" and arg_count() > 0
            ruta = arg(0)
        end
        if ruta == "" or not abrir(ruta)
            ed_abrir_texto("sin nombre.dash", "", NUEVO)
        end
        proyecto_leer(cajon_de(ruta))
        salida_anadir("Forja " + VERSION + ", con Dash 2.0.", 0)
        salida_anadir("Listo.", 2)

        mui_window_open(v.window)
        abierta = true
        mui_canvas_set_pointer(v.editor, 1)
        ajustar_barra()
        if sonda
            publicar_sonda()
            env_set("FORJA_ESTADO", "libre", false)
        end
        while true
            ev = mui_wait_event_signals(dbg_signal())
            if ev == 0
                mirar_depuracion()
            end
            if ev == EV_EDITOR
                otro = en_editor()
                if otro != 0
                    ev = otro
                end
            end
            if ev == -1
                ev = EV_SALIR
            end
            if ev == EV_SALIR or (ev >= EV_NUEVO and ev <= EV_CERRAR)
                if proyecto(ev)
                    break
                end
            end
            if ev == EV_PROYECTO
                en_proyecto()
            elif ev == EV_SALIDA
                en_salida()
            elif ev == EV_INFERENCIA
                boton_inferencia()
            elif ev == EV_DEPURAR
                depurar()
            elif ev >= EV_SEGUIR and ev <= EV_PARAR
                orden_depurador(ev)
            elif ev == EV_COMPILAR
                compilar(false)
            elif ev == EV_EJECUTAR
                compilar(true)
            elif ev == EV_TIC
                tic()
            elif ev == EV_VISTA_CERRADA
                dv_cerrar_vista()
            elif ev >= EV_CORTAR and ev <= EV_VISTA
                edicion(ev)
            elif ev == EV_ARRASTRE
                if mui_canvas_drag(v.editor) == 1
                    ed_arrastrar(mui_canvas_mouse_x(v.editor), mui_canvas_mouse_y(v.editor))
                    redibujar()
                end
            elif ev == EV_BARRA
                d = ed_actual()
                if d != nil and mui_get_value(v.barra) != d.primera
                    d.primera = mui_get_value(v.barra)
                    barra_valor = d.primera
                    mui_canvas_redraw(v.editor)
                end
            end
            ajustar_barra()
            if sonda
                publicar_sonda()
            end
        end
        mui_app_end()
    end
end
