# La barra de botones de arriba, dibujada en un lienzo: Compilar, Ejecutar y Depurar, los del depurador (Seguir,
# Paso, Entrar, Salir, Parar) y las zonas de las extensiones a la derecha. Cada uno lleva un icono de color y su nombre; el que
# está bajo el puntero se ilumina y los que no valen ahora salen en gris. Si no caben con nombre, los grises se
# quedan solo con el icono, y si aún no caben, todos.
#
#   bb_crear()                              # una vez, antes de abrir la ventana
#   bb_dibujar(x, y, ancho, alto)           # desde el mui_canvas_on_draw del lienzo
#   bb_poner(evento, activo)                # encender o apagar uno
#   ev = bb_clic(x)                         # el evento del botón en esa x (0 si ninguno o apagado)
#   if bb_mover(x, dentro) ...              # el puntero se movió: true si hay que redibujar

import "tema.dash"

const BB_ALTO = 24

struct BotonBarra
    nombre: String
    evento: Int
    rgb: [Int]          # el color de su icono
    icono: String       # cuál: el nombre de su dibujo en _bb_dibujo
    grupo: Int          # 0 los de siempre, 1 los del depurador, 2 a la derecha (ninguno hoy)
    activo: Bool
    x: Int              # dónde quedó al dibujarlo, y su ancho
    ancho: Int
    pen: Int            # el pen del color (lo busca bb_dibujar la primera vez)
    tramos: [Int]       # el icono en tramos de píxeles: x1, x2, y de cada uno
end

var bb_botones: [BotonBarra] = []
var bb_encima: Int = -1             # el botón bajo el puntero, o -1
var bb_pens: Bool = false
var bb_zona_x: Int = 0             # la esquina de la zona en la ventana (para las pruebas)
var bb_zona_y: Int = 0
var bb_zona_alto: Int = 0
var bb_pen_apagado: Int = 0
var bb_pen_encima: Int = 0
var bb_pen_fondo: Int = 0
var bb_pen_raya: Int = 0

# Las zonas de las extensiones (ZONA, docs/EXTENSIONES.md), a la derecha: un icono, un texto y un
# detalle en otro color (git: la rama y "3 cambios"). Si no cabe el detalle, va el corto ("3"); si tampoco, solo el
# texto; si tampoco, nada. Un clic ahí da BB_EV_ZONA, y bb_zona_clic dice de qué extensión.
const BB_EV_ZONA = 89

struct ZonaBarra
    ext: String
    icono: String
    tramos: [Int]
    texto: String
    detalle: String
    corto: String
    x: Int              # dónde quedó (desde el borde de la zona) y su ancho; -1 si no se ve
    ancho: Int
end

var bb_zonas: [ZonaBarra] = []
var bb_zona_clic: String = ""

# La zona de ext ("" de texto y de detalle: la quita); true si cambió
func bb_zona_poner(ext: String, icono: String, texto: String, detalle: String, corto: String) -> Bool
    i = 0
    while i < bb_zonas.length
        z = bb_zonas[i]
        if z.ext == ext
            if texto == "" and detalle == ""
                bb_zonas.remove(i)
                return true
            end
            if z.icono == icono and z.texto == texto and z.detalle == detalle and z.corto == corto
                return false
            end
            if z.icono != icono
                z.icono = icono
                z.tramos = _bb_tramos(icono)
            end
            z.texto = texto
            z.detalle = detalle
            z.corto = corto
            return true
        end
        i = i + 1
    end
    if texto == "" and detalle == ""
        return false
    end
    bb_zonas.push(ZonaBarra(ext, icono, _bb_tramos(icono), texto, detalle, corto, -1, 0))
    return true
end

func bb_zona_quitar(ext: String) -> Bool
    return bb_zona_poner(ext, "", "", "", "")
end

# Los iconos, de 12 por 12: "#" es un píxel del color del botón
func _bb_dibujo(nombre: String) -> [String]
    if nombre == "compilar"     # un martillo
        return ["............", "...######...", "..########..", "..########..", "...######...", "......##....", "......##....", "......##....", "......##....", "......##....", "......##....", "............"]
    elif nombre == "ejecutar"
        return ["............", "..##........", "..####......", "..######....", "..########..", "..#########.", "..#########.", "..########..", "..######....", "..####......", "..##........", "............"]
    elif nombre == "depurar"    # un bicho
        return ["............", "..#......#..", "...#....#...", "....####....", "#..######..#", ".##########.", "...######...", ".##########.", "#..######..#", "....####....", "...#....#...", "............"]
    elif nombre == "seguir"
        return ["............", "..#.##......", "..#.####....", "..#.######..", "..#.#######.", "..#.#######.", "..#.######..", "..#.####....", "..#.##......", "............", "............", "............"]
    elif nombre == "paso"
        return ["............", "...######...", "..#......#..", ".#........#.", ".#......###.", ".#.......##.", "..........#.", "............", "....####....", "....####....", "............", "............"]
    elif nombre == "entrar"
        return ["............", ".....##.....", ".....##.....", ".....##.....", "..########..", "...######...", "....####....", ".....##.....", "............", "..########..", "............", "............"]
    elif nombre == "salir"
        return ["............", "..########..", "............", ".....##.....", "....####....", "...######...", "..########..", ".....##.....", ".....##.....", ".....##.....", "............", "............"]
    elif nombre == "parar"
        return ["............", "............", "..########..", "..########..", "..########..", "..########..", "..########..", "..########..", "..########..", "..########..", "............", "............"]
    end
    if nombre == "rama"
        return ["............", "...#....#...", "...#....#...", "...#....#...", "...#...#....", "...#..#.....", "...###......", "...#........", "...#........", "...#........", "...#........", "............"]
    end
    # inferencia (para la zona del copiloto): un destello
    return ["............", ".....#......", ".....#......", "....###.....", "#..#####..#.", ".#########..", "...#####....", "....###...#.", ".....#...###", ".....#....#.", "............", "............"]
end

func _bb_tramos(icono: String) -> [Int]
    var t: [Int] = []
    if icono == ""
        return t
    end
    var filas: [String] = []
    if str_contains(icono, "/")
        # uno propio: 12 filas de 12, separadas por "/", con "#" los píxeles
        filas = str_split(icono, "/")
    else
        filas = _bb_dibujo(icono)
    end
    y = 0
    for f in filas
        i = 0
        while i < f.length
            if str_code(f, i) == 35
                a = i
                while i < f.length and str_code(f, i) == 35
                    i = i + 1
                end
                t.push(a)
                t.push(i - 1)
                t.push(y)
            else
                i = i + 1
            end
        end
        y = y + 1
    end
    return t
end

func _bb_anadir(nombre: String, evento: Int, rgb: [Int], icono: String, grupo: Int)
    bb_botones.push(BotonBarra(nombre, evento, rgb, icono, grupo, true, 0, 0, 0, _bb_tramos(icono)))
end

func bb_crear()
    amarillo = [255, 200, 80]
    azul = [90, 150, 230]
    rojo = [230, 80, 70]
    _bb_anadir(tr(325, "Compilar"), 10, amarillo, "compilar", 0)
    _bb_anadir(tr(326, "Ejecutar"), 11, [110, 200, 120], "ejecutar", 0)
    _bb_anadir(tr(327, "Depurar"), 12, rojo, "depurar", 0)
    _bb_anadir(tr(328, "Seguir"), 13, azul, "seguir", 1)
    _bb_anadir(tr(329, "Paso"), 14, azul, "paso", 1)
    _bb_anadir(tr(330, "Entrar"), 15, azul, "entrar", 1)
    _bb_anadir(tr(331, "Salir"), 16, azul, "salir", 1)
    _bb_anadir(tr(332, "Parar"), 17, rojo, "parar", 1)
end

func _bb_boton(evento: Int) -> BotonBarra
    for b in bb_botones
        if b.evento == evento
            return b
        end
    end
    return nil
end

# true si cambió (y hay que redibujar)
func bb_poner(evento: Int, activo: Bool) -> Bool
    b = _bb_boton(evento)
    if b == nil or b.activo == activo
        return false
    end
    b.activo = activo
    return true
end

# Ejecutar se vuelve Parar mientras corre el programa
func bb_ejecutando(si: Bool) -> Bool
    b = _bb_boton(11)
    icono = "ejecutar"
    nombre = tr(326, "Ejecutar")
    rgb = [110, 200, 120]
    if si
        icono = "parar"
        nombre = tr(7, "Parar")
        rgb = [230, 80, 70]
    end
    if b == nil or b.icono == icono
        return false
    end
    b.icono = icono
    b.nombre = nombre
    b.rgb = rgb
    b.tramos = _bb_tramos(icono)
    b.pen = color_pen(rgb[0], rgb[1], rgb[2])
    return true
end

# El ancho de un botón: con nombre, o solo el icono
func _bb_ancho(b: BotonBarra, con_nombre: Bool) -> Int
    if con_nombre
        return 6 + 12 + 5 + font_text_width(b.nombre) + 7
    end
    return 6 + 12 + 6
end

# 0 todos con nombre, 1 los grises sin nombre, 2 ninguno con nombre: lo primero que quepa, dejando sitio para el texto
# de las zonas de las extensiones (antes, el botón Inferencia de la derecha hacía que los grises perdieran el nombre y
# dejaba ese sitio; sin él, la zona de git no cabía en 640 de ancho)
func _bb_modo(ancho: Int) -> Int
    zonas = 0
    for z in bb_zonas
        zonas = zonas + _bb_zona_ancho(z, "") + 12
    end
    modo = 0
    while modo < 2
        total = 8 + 2 * 13 + zonas      # los márgenes, las dos rayas entre grupos y las zonas
        for b in bb_botones
            total = total + _bb_ancho(b, modo == 0 or (modo == 1 and b.activo)) + 2
        end
        if total <= ancho
            return modo
        end
        modo = modo + 1
    end
    return 2
end

func _bb_icono(b: BotonBarra, x: Int, y: Int)
    if b.activo
        gfx_pen(b.pen)
    else
        gfx_pen(bb_pen_apagado)
    end
    i = 0
    while i + 2 < b.tramos.length
        gfx_rect(x + b.tramos[i], y + b.tramos[i + 2], x + b.tramos[i + 1], y + b.tramos[i + 2])
        i = i + 3
    end
end

func _bb_pintar(b: BotonBarra, i: Int, x0: Int, y: Int, alto: Int, con_nombre: Bool)
    x = x0 + b.x
    if i == bb_encima and b.activo
        gfx_pen(bb_pen_encima)
        gfx_rect(x + 1, y + 3, x + b.ancho - 2, y + alto - 4)
        gfx_rect(x, y + 4, x + b.ancho - 1, y + alto - 5)      # las esquinas, un poco redondas
    end
    _bb_icono(b, x + 6, y + (alto - 12) / 2)
    if con_nombre
        if b.activo
            gfx_pen(tema.texto)
        else
            gfx_pen(bb_pen_apagado)
        end
        gfx_text_at(x + 6 + 12 + 5, y + (alto - font_height()) / 2 + font_baseline(), b.nombre)
    end
end

func bb_dibujar(x: Int, y: Int, ancho: Int, alto: Int)
    tema_preparar()
    if not bb_pens
        bb_pens = true
        bb_pen_apagado = color_pen(80, 80, 92)
        bb_pen_encima = color_pen(48, 48, 60)
        bb_pen_fondo = color_pen(20, 20, 24)
        bb_pen_raya = color_pen(44, 44, 52)
        for b in bb_botones
            b.pen = color_pen(b.rgb[0], b.rgb[1], b.rgb[2])
        end
    end
    bb_zona_x = x
    bb_zona_y = y
    bb_zona_alto = alto
    gfx_mode(0)
    gfx_pen(bb_pen_fondo)
    gfx_rect(x, y, x + ancho - 1, y + alto - 1)
    gfx_pen(bb_pen_raya)
    gfx_rect(x, y + alto - 1, x + ancho - 1, y + alto - 1)
    usar_panel(0)
    modo = _bb_modo(ancho)
    # los del grupo 2, a la derecha (las x de los botones, desde el borde de la zona, como las del ratón)
    derecha = ancho - 4
    for b in bb_botones
        if b.grupo == 2
            b.ancho = _bb_ancho(b, modo == 0 or (modo == 1 and b.activo))
            derecha = derecha - b.ancho
            b.x = derecha
        end
    end
    bx = 4
    grupo = 0
    for b in bb_botones
        if b.grupo != 2
            if b.grupo != grupo
                grupo = b.grupo
                gfx_pen(bb_pen_raya)
                gfx_rect(x + bx + 5, y + 5, x + bx + 5, y + alto - 6)
                bx = bx + 13
            end
            b.x = bx
            b.ancho = _bb_ancho(b, modo == 0 or (modo == 1 and b.activo))
            bx = bx + b.ancho + 2
        end
    end
    i = 0
    for b in bb_botones
        if b.x + b.ancho <= ancho
            _bb_pintar(b, i, x, y, alto, modo == 0 or (modo == 1 and b.activo))
        end
        i = i + 1
    end
    _bb_zonas(x, y, alto, bx + 8, derecha - 8)
    usar_codigo()
end

# Las zonas entre desde y hasta (x desde el borde de la zona), de derecha a izquierda; cada una, con el detalle, con el
# corto o sin nada, lo primero que quepa; si no cabe ni el texto, no se ve
func _bb_zonas(x0: Int, y: Int, alto: Int, desde: Int, hasta: Int)
    for z in bb_zonas
        z.x = -1
        detalle = z.detalle
        ancho = _bb_zona_ancho(z, detalle)
        if hasta - ancho < desde and z.corto != ""
            detalle = z.corto
            ancho = _bb_zona_ancho(z, detalle)
        end
        if hasta - ancho < desde
            detalle = ""
            ancho = _bb_zona_ancho(z, detalle)
        end
        if hasta - ancho < desde
            continue
        end
        bx = hasta - ancho
        z.x = bx
        z.ancho = ancho
        tx = bx
        if z.tramos.length > 0
            gfx_pen(bb_pen_apagado)
            i = 0
            while i + 2 < z.tramos.length
                gfx_rect(x0 + bx + z.tramos[i], y + (alto - 12) / 2 + z.tramos[i + 2], x0 + bx + z.tramos[i + 1], y + (alto - 12) / 2 + z.tramos[i + 2])
                i = i + 3
            end
            tx = bx + 16
        end
        base = y + (alto - font_height()) / 2 + font_baseline()
        if z.texto != ""
            gfx_pen(tema.texto)
            gfx_text_at(x0 + tx, base, z.texto)
        end
        if detalle != ""
            gfx_pen(tema.cursor)
            gfx_text_at(x0 + hasta - font_text_width(detalle), base, detalle)
        end
        hasta = bx - 12
    end
end

func _bb_zona_ancho(z: ZonaBarra, detalle: String) -> Int
    a = 0
    if z.tramos.length > 0
        a = 16
    end
    if z.texto != ""
        a = a + font_text_width(z.texto)
    end
    if detalle != ""
        if z.texto != ""
            a = a + 8
        end
        a = a + font_text_width(detalle)
    end
    return a
end

func _bb_en(x: Int) -> Int
    i = 0
    for b in bb_botones
        if x >= b.x and x < b.x + b.ancho
            return i
        end
        i = i + 1
    end
    return -1
end

# El evento del botón en esa x, o 0
func bb_clic(x: Int) -> Int
    for z in bb_zonas
        if z.x >= 0 and x >= z.x and x < z.x + z.ancho
            bb_zona_clic = z.ext
            return BB_EV_ZONA
        end
    end
    i = _bb_en(x)
    if i < 0 or not bb_botones[i].activo
        return 0
    end
    return bb_botones[i].evento
end

# El puntero se movió (o salió): true si cambió el botón iluminado
func bb_mover(x: Int, dentro: Bool) -> Bool
    i = -1
    if dentro
        i = _bb_en(x)
    end
    if i == bb_encima
        return false
    end
    bb_encima = i
    return true
end

# Para las pruebas: "x y alto encima" y por cada botón "evento:x:ancho:activo" (x desde la ventana; activo 1 o 0)
func bb_sonda() -> String
    t = "#{bb_zona_x} #{bb_zona_y} #{bb_zona_alto} #{bb_encima}"
    for b in bb_botones
        a = 0
        if b.activo
            a = 1
        end
        t = t + " #{b.evento}:#{bb_zona_x + b.x}:#{b.ancho}:#{a}"
    end
    for z in bb_zonas
        if z.x >= 0
            t = t + " #{BB_EV_ZONA}:#{bb_zona_x + z.x}:#{z.ancho}:1"
        end
    end
    return t
end
