# Hace de usuario de la piel de cebolla del editor de sprites y mira los píxeles de verdad en la pantalla
# (screen_pixel): con O, las celdas vacías enseñan un punto con el color del fotograma anterior.
# Sale con Amiga-Q (descartando). Lo arranca tests/sprites_cebolla.sh; anota en DH0:Prueba/sprites_cebolla.txt.

const AMIGA = 8
const RETROCESO = 0x41

var fallos: Int = 0
var registro: String = ""

func anotar(texto: String)
    registro = registro + texto + "\n"
    file_write_text("DH0:Prueba/sprites_cebolla.txt", registro)
end

func ver(paso: String, cierto: Bool, detalle: String)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso + ": [" + detalle + "]")
        fallos = fallos + 1
    end
end

func activar() -> Bool
    if input_active_title() != "Forja"
        w = window_find("Forja")
        if w != 0
            window_found_activate(w)
            time_delay(10)
        end
    end
    return input_active_title() == "Forja"
end

func campo(nombre: String, i: Int) -> Int
    return Int(str_split(env_get(nombre), " ")[i])
end

func sonda() -> [String]
    time_delay(25)
    t = file_read_text("RAM:forja-sonda.txt")
    if t == nil
        return [""]
    end
    return str_split(t, "\n")
end

func cabecera(i: Int) -> String
    return str_split(sonda()[1], " ")[i]
end

# Espera (como mucho 5 s) a que el campo i de la cabecera valga v
func esperar(i: Int, v: String) -> Bool
    n = 0
    while n < 10 and cabecera(i) != v
        n = n + 1
    end
    time_delay(10)
    return cabecera(i) == v
end

# El centro de la celda x, y en la ventana
func cx(x: Int) -> Int
    return campo("FORJA_EDITOR", 0) + campo("FORJA_SPRITE", 0) + x * campo("FORJA_SPRITE", 2) + campo("FORJA_SPRITE", 2) / 2
end

func cy(y: Int) -> Int
    return campo("FORJA_EDITOR", 1) + campo("FORJA_SPRITE", 1) + y * campo("FORJA_SPRITE", 2) + campo("FORJA_SPRITE", 2) / 2
end

# El color de pantalla en el centro de la celda x, y (por la sonda primero, para que el dibujo esté hecho)
func pantalla(x: Int, y: Int) -> Int
    sonda()
    w = window_find("Forja")
    return screen_pixel(window_found_box(w, 0) + cx(x), window_found_box(w, 1) + cy(y))
end

# ¿Hay algún píxel de ese color en la celda x, y? (el punto de la cebolla es un tercio del lado: con celdas
# pequeñas, de 4 píxeles en 640x256, es un píxel que no cae en el centro justo)
func en_celda(x: Int, y: Int, color: Int) -> Bool
    sonda()
    w = window_find("Forja")
    z = campo("FORJA_SPRITE", 2)
    x0 = window_found_box(w, 0) + campo("FORJA_EDITOR", 0) + campo("FORJA_SPRITE", 0) + x * z
    y0 = window_found_box(w, 1) + campo("FORJA_EDITOR", 1) + campo("FORJA_SPRITE", 1) + y * z
    j = 0
    while j < z
        i = 0
        while i < z
            if screen_pixel(x0 + i, y0 + j) == color
                return true
            end
            i = i + 1
        end
        j = j + 1
    end
    return false
end

Main
    n = 0
    while n < 600 and not (env_get("FORJA_SPRITE_BOTONES") != "" and activar())
        time_delay(5)
        n = n + 1
    end
    if n >= 600
        ver("la ventana de Forja aparece", false, "")
    else
        input_move(cx(8), cy(8))
        input_text("d")
        sonda()
        input_key(RETROCESO, 0)
        ver("un segundo fotograma vacío", cabecera(4) == "2" and sonda()[2 + 16] == "0000000000000000", sonda()[1])
        input_click(cx(8), cy(8), 0)
        n = 0
        while n < 10 and sonda()[2 + 16 + 8][8:9] != "1"
            n = n + 1
        end
        lleno = pantalla(8, 8)
        vacio = pantalla(5, 5)
        ver("sin cebolla, la celda 0,0 se ve vacía", pantalla(0, 0) == vacio and lleno != vacio, "#{pantalla(0, 0)} #{vacio} #{lleno}")
        input_text("o")
        ver("O enciende la cebolla", esperar(11, "true"), sonda()[1])
        p = pantalla(0, 0)
        ver("con cebolla, la 0,0 enseña el color 1 del anterior", p == lleno or en_celda(0, 0, lleno), "#{p} #{vacio} #{lleno}; geometría " + env_get("FORJA_SPRITE"))
        ver("y la 5,5 sigue vacía", pantalla(5, 5) == vacio, "#{pantalla(5, 5)}")
        input_text("o")
        e = esperar(11, "false")
        p = pantalla(0, 0)
        ver("O la apaga", e and p == vacio, sonda()[1] + " #{p}")
        time_delay(100)
    end
    if fallos == 0
        anotar("TODO BIEN")
    end
    activar()
    input_key(0x10, AMIGA)
    n = 0
    while n < 100 and input_active_title() != "Cambios sin guardar"
        time_delay(5)
        n = n + 1
    end
    time_delay(25)
    input_key(0x22, 0)
end
