# Lanza tests/git_panel.dash en la máquina coffin (MUI 3.8, 68040, RTG): copia el proyecto de prueba a RAM:Prueba,
# pone las variables de Forja, arranca la prueba aparte y Forja, y al acabar escribe el registro. Lo usa
# tests/git_panel_coffin.sh, que deja en DASHRUN: Forja, GitPanel, dashgit, la extensión Git (Git y manifiesto.txt) y
# los ficheros de juego/.
Main
    run_command("C:MakeDir RAM:Prueba RAM:Prueba/juego ENV:Forja RAM:Prueba/Extensiones RAM:Prueba/Extensiones/Git")
    for f in ["main.dash", "red.dash", "ventana.dashui"]
        file_copy("DASHRUN:" + f, "RAM:Prueba/juego/" + f)
    end
    # la extensión Git, en un cajón de extensiones propio
    file_copy("DASHRUN:Git", "RAM:Prueba/Extensiones/Git/Git")
    file_copy("DASHRUN:manifiesto.txt", "RAM:Prueba/Extensiones/Git/manifiesto.txt")
    env_set("Forja/extensiones", "RAM:Prueba/Extensiones", false)
    env_set("Forja/dashgit", "DASHRUN:dashgit", false)
    s = file_read_text("DASHRUN:servidor")
    if s != nil
        env_set("Forja/git_servidor", str_trim(s), false)
    end
    env_set("FORJA_SONDA", "1", false)
    env_set("FORJA_PRUEBA", "RAM:Prueba/juego/main.dash", false)
    env_set("GITPANEL_DIR", "RAM:Prueba", false)
    # PAUSA=segundos de git_panel_coffin.sh (para las capturas)
    p = file_read_text("DASHRUN:pausa")
    if p != nil
        env_set("PAUSA", str_trim(p), false)
    end
    run_program("DASHRUN:GitPanel")
    run_command("DASHRUN:Forja")
    t = file_read_text("RAM:Prueba/git_panel.txt")
    if t == nil
        Print "FALLO: no hay registro"
    else
        Print t
    end
end
