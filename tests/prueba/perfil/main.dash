# Para tests/perfil.dash: lenta gasta casi todo el tiempo; rapida se llama muchas veces y gasta poco.
func lenta(n: Int) -> Int
    s = 0
    for i in (1..n)
        s = s + i % 7
    end
    return s
end

func rapida(n: Int) -> Int
    return n + 1
end

Main
    t = 0
    for k in (1..60)
        t = t + lenta(30000)
        for j in (1..50)
            t = t + rapida(j)
        end
    end
    Print "t #{t}"
end
