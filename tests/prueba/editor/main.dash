# Barras de raster: la parte caliente en ensamblador en línea (de examples/asm_barras.dash de Dash)
import "util.dash"

const ARRIBA = 0x40     # la primera línea con barras

struct Barra
    centro: Int
    color: Int
end

func espera_linea(tabla: Pointer, fase: Int) -> Int
    asm in a1 = tabla, d4 = fase out salir = d0 uses d1-d7/a0
        lea     $dff000,a0
        move.w  d4,d0
        and.w   #255,d0
        add.w   #ARRIBA+8,d5
    .linea:
        move.b  6(a0),d0            ; VHPOSR: la línea, en el byte alto
        cmp.b   d1,d0
        bne.s   .linea
    end
    return salir
end

Main
    tabla = amiga_alloc(256)
    for i in (0..255)
        poke_byte(tabla + i, doble(i) / 4)
    end
    if tabla != nil
        Print "Barras: #{espera_linea(tabla, 0)}"
    end
end
