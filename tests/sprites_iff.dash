# Leer y escribir IFF ILBM con src/sprites.dash, y que bob_load y sprite_load de Dash lean lo escrito.
# tests/sprites_iff.sh pone en DH0:Prueba los pinceles de tests/iff.py y comprueba después los ficheros escritos.

import "../src/sprites.dash"

var fallos: Int = 0
var registro: String = ""

# A la consola y a DH0:Prueba/sprites_iff.txt (para ver hasta dónde llegó si se cuelga)
func anotar(texto: String)
    Print texto
    registro = registro + texto + "\n"
    file_write_text("DH0:Prueba/sprites_iff.txt", registro)
end

func ver(paso: String, cierto: Bool)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso)
        fallos = fallos + 1
    end
end

func hex(c: Int, cifras: Int) -> String
    t = str_upper(str_from_int(c, 16))
    while t.length < cifras
        t = "0" + t
    end
    return t
end

# Como "iff.py leer": "ancho alto planos", las filas de toda la tira y la paleta
func texto(s: Sprite) -> String
    cifras = 1
    if s.planos > 4
        cifras = 2
    end
    nf = s.fotos.length
    t = "#{s.ancho * nf} #{s.alto} #{s.planos}\n"
    y = 0
    while y < s.alto
        f = 0
        while f < nf
            x = 0
            while x < s.ancho
                t = t + hex(sp_px(s, f, x, y), cifras)
                x = x + 1
            end
            f = f + 1
        end
        t = t + "\n"
        y = y + 1
    end
    t = t + "paleta"
    i = 0
    while i < sp_colores(s)
        t = t + " " + hex(s.paleta[i], 6)
        i = i + 1
    end
    return t + "\n"
end

# El texto de iff.py sin las líneas FRJA y GRAB
func esperado(ruta: String) -> String
    t = ""
    for l in str_split(file_read_text(ruta), "\n")
        if l != "" and not str_starts(l, "FRJA") and not str_starts(l, "GRAB")
            t = t + l + "\n"
        end
    end
    return t
end

Main
    s = sp_leer("DH0:Prueba/pincel.iff")
    ver("leer un pincel con ByteRun1: " + sp_error, s != nil)
    if s != nil
        ver("tres fotogramas cuadrados de 16x16 (sin FRJA)", s.fotos.length == 3 and s.ancho == 16 and s.alto == 16 and not s.hardware)
        ver("sus píxeles y su paleta", texto(s) == esperado("DH0:Prueba/pincel.txt"))
        s.hardware = true
        s.velocidad = 9
        s.agarre_x = 2
        s.agarre_y = 5
        ver("escribir: " + sp_error, sp_escribir(s, "DH0:Prueba/sale.iff"))
        r = sp_leer("DH0:Prueba/sale.iff")
        ver("leer lo escrito", r != nil)
        if r != nil
            ver("igual que antes", texto(r) == texto(s))
            ver("FRJA y GRAB", r.hardware and r.velocidad == 9 and r.ancho == 16 and r.agarre_x == 2 and r.agarre_y == 5)
        end
    end
    g = sp_leer("DH0:Prueba/grande.iff")
    ver("leer 5 planos con plano de máscara: " + sp_error, g != nil)
    if g != nil
        ver("sin FRJA, 4 fotogramas cuadrados de 10x10, y el agarre", g.fotos.length == 4 and g.ancho == 10 and g.planos == 5 and g.agarre_x == 3 and g.agarre_y == 4)
        ver("sus píxeles y su paleta", texto(g) == esperado("DH0:Prueba/grande.txt"))
        ver("escribir 5 planos", sp_escribir(g, "DH0:Prueba/grande2.iff"))
    end
    a = sp_nuevo(true)
    sp_cambiar_tipo(a)
    ver("T en un sprite de hardware: acoplado de 16 colores", sp_acoplado(a) and sp_colores(a) == 16)
    sp_poner(a, 0, 4, 1, 13)
    ver("escribir el acoplado: " + sp_error, sp_escribir(a, "DH0:Prueba/acoplado.iff"))
    ra = sp_leer("DH0:Prueba/acoplado.iff")
    ver("leerlo: acoplado, 4 planos y su píxel", ra != nil and sp_acoplado(ra) and sp_px(ra, 0, 4, 1) == 13)
    codigo = sp_codigo(a, "acoplado.iff")
    ver("su código: sprite_load_attached y sprite_load_colors", str_contains(codigo, "sprite_load_attached(0, \"acoplado.iff\")") and str_contains(codigo, "sprite_load_colors(0, \"acoplado.iff\")"))
    anotar("bob_load...")
    ver("bob_load lo lee", bob_load(1, "DH0:Prueba/sale.iff"))
    anotar("pantalla...")
    if screen_open_custom(320, 200, 2, "Prueba")
        anotar("sprite_load...")
        ver("sprite_load lo lee", sprite_load(0, "DH0:Prueba/sale.iff"))
        sprite_free(0)
        ver("sprite_load_attached lee el acoplado", sprite_load_attached(0, "DH0:Prueba/acoplado.iff"))
        sprite_free(0)
        screen_close()
    else
        ver("abrir una pantalla para sprite_load", false)
    end
    ver("un fichero que no es IFF da error", sp_leer("DH0:Prueba/pincel.txt") == nil and sp_error != "")
    if fallos == 0
        anotar("TODO BIEN")
    end
end
