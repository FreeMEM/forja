    ed_desplegar_todo(d)
    ver("desplegar todo", not ed_oculta(d, 7))
    # lo que cuesta dibujar con algo plegado: las cuentas de una fila (fichero de 500 líneas, 50 bloques plegados)
    t = ""
    k = 0
    while k < 100
        t = t + "func f#{k}()\n    a = 1\n    b = 2\nend\n\n"
        k = k + 1
    end
    d = doc(t)
    k = 0
