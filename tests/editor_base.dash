    d.cl = 0
    d.cc = 0
    ed_tecla(T_RETURN, 0, "")
    ver("escribir arriba: lo plegado baja", ed_oculta(d, 3) and ed_oculta(d, 4) and not ed_oculta(d, 2))
    ed_deshacer(d)
    d.cl = 2
