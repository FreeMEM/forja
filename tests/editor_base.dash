# Prueba de src/editor.dash y src/sintaxis.dash sin ventana (fase 2 de docs/FORJA_LOOP.md): los colores sacados de
# la gramática (también los bloques asm), comentar, duplicar, mover y borrar líneas, cerrar solos paréntesis y
# comillas, el end solo, la pareja de un paréntesis y de un bloque; y lo que tarda cada cosa.
# tests/editor_base.sh la ejecuta.

import "../src/editor.dash"
import "../src/teclas.dash"
import "../src/buscar.dash"

var fallos: Int = 0

func ver(paso: String, cierto: Bool)
    if cierto
        Print "bien: " + paso
    else
        Print "FALLO: " + paso
        fallos = fallos + 1
    end
end

func igual(paso: String, visto: String, esperado: String)
    if visto == esperado
        Print "bien: " + paso
    else
        Print "FALLO: " + paso + ": [" + visto + "] en vez de [" + esperado + "]"
        fallos = fallos + 1
    end
end

# Los trozos de la última línea partida, "tipo:texto tipo:texto..." (sin los blancos sueltos)
func trozos(s: String) -> String
    r = ""
    k = 0
    while k < sx_desde.length
        a = sx_desde[k]
        b = s.length
        if k + 1 < sx_desde.length
            b = sx_desde[k + 1]
        end
        t = str_trim(s[a:b])
        if t != ""
            if r != ""
                r = r + " "
            end
            r = r + "#{sx_tipo[k]}:" + t
        end
        k = k + 1
    end
    return r
end

func dash(s: String) -> String
    sx_partir(s)
    return trozos(s)
end

func ensam(s: String) -> String
    sx_partir_asm(s)
    return trozos(s)
end

func doc(texto: String) -> Documento
    documentos.clear()
    ed_abrir_texto("prueba.dash", "RAM:prueba.dash", texto)
    return ed_actual()
end

func letra(d: Documento, l: String)
    ed_tecla(0x7F, 0, l)
end

func tiene_punto(d: Documento, n: Int) -> Bool
    return d.puntos.has(n)
end

func teclear(d: Documento, t: String)
    i = 0
    while i < t.length
        letra(d, t[i:i + 1])
        i = i + 1
    end
end

