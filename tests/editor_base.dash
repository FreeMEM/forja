    # --- 2.7 plegado ---
    ed_visibles = 20
    d = doc("func f()\n    if x\n        a = 1\n    end\n    b = 2\nend\nfunc g()\n    c = 3\nend")
    d.cl = 2
    ver("plegar el bloque del cursor", ed_plegar_cursor(d) and d.cl == 1)
    ver("ocultas", ed_oculta(d, 2) and ed_oculta(d, 3) and not ed_oculta(d, 1) and not ed_oculta(d, 4))
    ver("la fila de después", ed_fila_y(d, 4) == ed_fila_y(d, 1) + ed_alto_fila)
    ver("bajar se salta lo plegado", ed_filas_desde(d, 1, 1) == 4)
    ver("subir también", ed_filas_desde(d, 4, -1) == 1)
    d.cl = 0
    ed_plegar_cursor(d)
    ver("plegar el de fuera", ed_oculta(d, 4) and ed_oculta(d, 5) and ed_filas_desde(d, 0, 1) == 6)
