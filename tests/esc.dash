# Esc con un programa propio en marcha (lo vio el vídeo de Forja: Forja se cerraba; CoffinOS tiene una commodity que
# cierra la ventana activa con Esc, y Forja lo tomaba por cerrar Forja). El juego de la plantilla abre su
# pantalla sin ventana y mira Esc con key_down: el teclado sigue en la ventana de Forja, que recibe el Esc. Forja no
# debe cerrarse con Esc. Lo arranca tests/esc.sh; anota en DH0:Prueba/esc.txt
# y acaba con "TODO BIEN" si todo fue bien. En la máquina CoffinOS (EN_COFFIN), arranca Forja de Proyecto: y
# anota ahí.

const AMIGA = 8
const CTRL = 2
const MAYUS = 1
const ESC = 0x45

var fallos: Int = 0
var registro: String = ""
var cajon: String = "DH0:Prueba/"
const EN_COFFIN = false          # tests/esc.sh con COFFIN=1 lo pone a true: Forja está en Proyecto: y la arranca esto

func anotar(texto: String)
    registro = registro + texto + "\n"
    # (en CoffinOS, a veces alguien tiene el fichero abierto un momento: se reintenta)
    n = 0
    while n < 20 and not file_write_text(cajon + "esc.txt", registro)
        time_delay(10)
        n = n + 1
    end
end

func ver(paso: String, cierto: Bool, detalle: String)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso + ": [" + detalle + "]")
        fallos = fallos + 1
    end
end

func campo(nombre: String, i: Int) -> Int
    return Int(str_split(env_get(nombre), " ")[i])
end

func activar() -> Bool
    if input_active_title() != "Forja"
        w = window_find("Forja")
        if w != 0
            window_found_activate(w)
            time_delay(10)
        end
    end
    return input_active_title() == "Forja"
end

func al_editor()
    input_move(campo("FORJA_EDITOR", 0) + campo("FORJA_EDITOR", 2) / 2, campo("FORJA_EDITOR", 1) + campo("FORJA_EDITOR", 3) / 2)
    time_delay(5)
end

func esperar_estado(e: String, decimas: Int) -> Bool
    n = 0
    while n < decimas and env_get("FORJA_ESTADO") != e
        time_delay(5)
        n = n + 5
    end
    return env_get("FORJA_ESTADO") == e
end

# La primera línea del texto, de la sonda (RAM:forja-sonda.txt: "línea columna nombre" y el texto)
func primera_linea() -> String
    t = file_read_text("RAM:forja-sonda.txt")
    if t == nil
        return ""
    end
    ls = str_split(t, "\n")
    if ls.length < 2
        return ""
    end
    return ls[1]
end

func esperar_primera(texto: String) -> Bool
    n = 0
    while n < 30 and not str_starts(primera_linea(), texto)
        time_delay(10)
        n = n + 1
    end
    return str_starts(primera_linea(), texto)
end

func viva() -> Bool
    return window_find("Forja") != 0
end

# La tarea de Forja (para mandarle un Ctrl-C, como un Break)
func ejecutar_y_esperar(que: String) -> Bool
    activar()
    al_editor()
    input_key(0x12, AMIGA)
    ok = esperar_estado("ejecutando", 1800)
    ver(que + ": se ejecuta", ok, env_get("FORJA_ESTADO"))
    time_delay(150)         # que abra su pantalla
    return ok
end

Main
    if EN_COFFIN
        # CoffinOS: este programa arranca Forja (no hay Startup-Extra)
        cajon = "Proyecto:"
        dir_create("ENV:Forja")
        env_set("Forja/dashc", cajon + "Dash/dash", false)
        env_set("Forja/sesion", "", false)
        env_set("Forja/buscar_dash", "no", false)
        env_set("FORJA_SONDA", "1", false)
        env_set("FORJA_PRUEBA", cajon + "esc/main.dash", false)
        run_command("Run >NIL: " + cajon + "Forja")
    end
    n = 0
    while n < 600 and not (env_get("FORJA_EDITOR") != "" and activar())
        time_delay(5)
        n = n + 1
    end
    if n >= 600
        ver("la ventana de Forja", false, "")
    else
        time_delay(20)
        al_editor()
        input_key(ESC, 0)
        time_delay(100)
        ver("Esc sin nada en marcha: Forja sigue", viva(), env_get("FORJA_ESTADO"))
        if EN_COFFIN
            # Ctrl / con el mapa castellano de CoffinOS ("/" es Mayúsculas+6; con Ctrl daba un código de control y
            # no comentaba: lo vio el vídeo de Forja). La primera línea es un comentario: lo quita y lo vuelve a poner
            input_key(0x06, CTRL | MAYUS)
            ver("Ctrl / (Mayúsculas+6 en el mapa castellano) descomenta", esperar_primera("Esc: un juego"), primera_linea())
            input_key(0x06, CTRL | MAYUS)
            ver("y otra vez comenta", esperar_primera("# Esc: un juego"), primera_linea())
        end
        if ejecutar_y_esperar("el juego")
            anotar("  ventana activa: " + input_active_title())
            # Esc, con el puntero en distintos sitios (en el vídeo estaba en la pantalla del programa)
            input_key(ESC, 0)
            time_delay(100)
            ver("Esc: Forja sigue", viva(), env_get("FORJA_ESTADO"))
            input_move(5, 5)
            input_key(ESC, 0)
            time_delay(100)
            ver("otro Esc con el puntero en una esquina: Forja sigue", viva(), env_get("FORJA_ESTADO"))
            ver("el programa sigue en marcha", env_get("FORJA_ESTADO") == "ejecutando", env_get("FORJA_ESTADO"))
            # Parar con Amiga-E (Ejecutar es Parar mientras corre)
            input_key(0x12, AMIGA)
            ver("Amiga-E lo para", esperar_estado("libre", 300), env_get("FORJA_ESTADO"))
            time_delay(50)
            ver("Forja sigue tras pararlo", viva(), "")
        end
    end
    if fallos == 0
        anotar("TODO BIEN")
    else
        anotar("FALLOS: #{fallos}")
    end
    time_delay(50)          # (que el registro llegue al PC antes de que el emulador se apague)
    if viva()
        activar()
        al_editor()
        input_key(0x10, AMIGA)
        if EN_COFFIN
            time_delay(100)
            input_key(0x22, 0)     # (Ctrl / dos veces deja el texto como estaba, pero con cambios: Descartar)
        end
    end
end
