# Hace de usuario de la extensión Sprites con Forja: Forja abre nave.iff (FORJA_PRUEBA) en la ventana de la
# extensión, el panel del proyecto lo lista y lo vuelve a poner delante, Amiga-S lo guarda (y Forja lo dice), Amiga-B
# en Forja crea un BOB (lo hace la extensión), y compilar desde el sprite compila el main.dash de su cajón. Sale con
# Amiga-Q en Forja, que pregunta por el BOB sin guardar.
# Lo arranca tests/sprites_forja.sh; anota en DH0:Prueba/sprites_forja.txt.

const AMIGA = 8

var fallos: Int = 0
var registro: String = ""

func anotar(texto: String)
    registro = registro + texto + "\n"
    file_write_text("DH0:Prueba/sprites_forja.txt", registro)
end

func ver(paso: String, cierto: Bool, detalle: String)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso + ": [" + detalle + "]")
        fallos = fallos + 1
    end
end

func activar_titulo(t: String) -> Bool
    if not str_starts(input_active_title(), t)
        w = window_find(t)
        if w != 0
            window_found_activate(w)
            time_delay(10)
        end
    end
    return str_starts(input_active_title(), t)
end

# La ventana del editor (la extensión Sprites)
func activar() -> Bool
    return activar_titulo("Sprites")
end

func activar_forja() -> Bool
    return activar_titulo("Forja")
end

func campo(nombre: String, i: Int) -> Int
    return Int(str_split(env_get(nombre), " ")[i])
end

func al_editor()
    input_move(campo("FORJA_SPRITES_LIENZO", 0) + campo("FORJA_SPRITES_LIENZO", 2) / 2, campo("FORJA_SPRITES_LIENZO", 1) + campo("FORJA_SPRITES_LIENZO", 3) / 2)
    time_delay(5)
end

func sonda() -> String
    time_delay(25)
    t = file_read_text("RAM:forja-sprites-sonda.txt")
    n = 0
    while t == nil and n < 10
        time_delay(5)
        t = file_read_text("RAM:forja-sprites-sonda.txt")
        n = n + 1
    end
    if t == nil
        return ""
    end
    return t
end

# La primera línea de la sonda ("0 0 nombre") y la segunda (la del sprite)
func linea(i: Int) -> String
    l = str_split(sonda(), "\n")
    if i >= l.length
        return ""
    end
    return l[i]
end

# Espera (como mucho 5 s) a que la pestaña activa sea esa
func esperar_nombre(nombre: String) -> String
    n = 0
    while n < 10 and linea(0) != "0 0 " + nombre and not str_ends(linea(0), " " + nombre)
        n = n + 1
    end
    return linea(0)
end

func salida() -> String
    time_delay(25)
    t = file_read_text("RAM:forja-salida.txt")
    if t == nil
        return ""
    end
    return t
end

# (el panel del proyecto es de la ventana de Forja)
func fila_proyecto(i: Int)
    activar_forja()
    f = campo("FORJA_PROYECTO", 2)
    input_click(campo("FORJA_PROYECTO", 0) + 30, campo("FORJA_PROYECTO", 1) + i * f + f / 2, 0)
end

func esperar_ventana(titulo: String) -> Bool
    n = 0
    while n < 100
        if input_active_title() == titulo
            return true
        end
        time_delay(5)
        n = n + 1
    end
    return false
end

# La primera línea de la sonda de Forja ("línea columna nombre"): el fichero de delante en Forja
func forja_activo() -> String
    time_delay(25)
    t = file_read_text("RAM:forja-sonda.txt")
    if t == nil
        return ""
    end
    return str_split(t, "\n")[0]
end

Main
    n = 0
    while n < 600 and not (env_get("FORJA_SPRITE_BOTONES") != "" and env_get("FORJA_PROYECTO") != "" and activar())
        time_delay(5)
        n = n + 1
    end
    if n >= 600
        ver("la ventana de la extensión Sprites aparece", false, "")
    else
        al_editor()
        ver("abre nave.iff en la extensión Sprites", linea(0) == "0 0 nave.iff" and str_starts(input_active_title(), "Sprites: nave.iff"), linea(0) + " / " + input_active_title())
        ver("sprite de hardware de 3 fotogramas", linea(1) == "16 16 2 true 3 0 1 0 6 0 0 false false 0", linea(1))
        # el proyecto (en Forja): "/", main.dash, nave.iff, red.dash, ventana.dashui
        fila_proyecto(3)
        n = 0
        while n < 10 and not str_ends(forja_activo(), " red.dash")
            n = n + 1
        end
        ver("abrir red.dash desde el proyecto (en Forja)", str_ends(forja_activo(), " red.dash"), forja_activo() + " / " + env_get("FORJA_PROYECTO"))
        fila_proyecto(2)
        ver("nave.iff desde el proyecto pone delante su ventana", esperar_ventana("Sprites: nave.iff") and linea(0) == "0 0 nave.iff", input_active_title() + " / " + linea(0))
        activar()
        al_editor()
        input_key(0x21, AMIGA)
        time_delay(50)
        ver("Amiga-S guarda nave.iff (y Forja lo dice)", str_contains(salida(), "Guardado: DH0:Prueba/juego/nave.iff"), salida())
        # Amiga-B en Forja: la petición con lo que hacen las extensiones (Sprite, BOB); B elige un BOB
        activar_forja()
        input_key(0x35, AMIGA)
        if esperar_ventana("Nuevo")
            time_delay(25)
            input_key(0x35, 0)
        else
            ver("Amiga-B en Forja pregunta qué hacer", false, input_active_title())
        end
        ver("un BOB nuevo, en la ventana de Sprites", esperar_ventana("Sprites: sin nombre.iff") and linea(0) == "0 0 sin nombre.iff" and linea(1) == "32 32 4 false 1 0 1 0 6 0 0 false false 0", input_active_title() + " / " + linea(0) + " / " + linea(1))
        # compilar desde un sprite compila el programa de su cajón: aquí, el main.dash del sprite sin nombre no
        # hay (no tiene cajón), así que primero nave.iff, en DH0:Prueba/juego (aquí no hay compilador: basta con
        # que lo intente)
        activar()
        n = 0
        while n < 20 and not str_ends(input_active_title(), "nave.iff")
            input_click(campo("FORJA_SPRITES_LIENZO", 0) + Int(str_split(str_split(env_get("FORJA_SPRITES_PESTANAS"), " ")[0], ",")[0]), campo("FORJA_SPRITES_LIENZO", 1) + 9, 0)
            time_delay(25)
            n = n + 1
        end
        al_editor()
        input_key(0x27, AMIGA)
        time_delay(50)
        ver("Amiga-K en un sprite compila main.dash, el programa de su cajón", str_contains(salida(), "Compilando main.dash"), salida())
        time_delay(100)
    end
    if fallos == 0
        anotar("TODO BIEN")
    end
    activar_forja()
    input_key(0x10, AMIGA)
    # el BOB sin guardar: Forja pregunta (Descartar)
    if esperar_ventana("Cambios sin guardar")
        time_delay(25)
        input_key(0x22, 0)
    end
end
