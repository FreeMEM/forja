# Hace de usuario del editor de sprites de principio a fin: abre un pincel comprimido de DPaint (pincel.iff, sin
# FRJA: un BOB de 3 fotogramas de 16x16), dibuja, rellena y deshace, duplica y voltea un fotograma, lo pasa a
# sprite de hardware, guarda con Amiga-S y comprueba que bob_load y sprite_load leen lo guardado. Mide el cambio de
# pestaña entre el sprite y un texto. Después crea un BOB con Amiga-B, lo toca y sale descartando.
# Lo arranca tests/sprites.sh; anota en DH0:Prueba/sprites.txt y deja lo que debe haber en el fichero en
# DH0:Prueba/esperado.txt (las filas de la sonda) para que el script lo compare con tests/iff.py.

const AMIGA = 8
const ALT = 4

var fallos: Int = 0
var registro: String = ""

func anotar(texto: String)
    registro = registro + texto + "\n"
    file_write_text("DH0:Prueba/sprites.txt", registro)
end

func ver(paso: String, cierto: Bool, detalle: String)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso + ": [" + detalle + "]")
        fallos = fallos + 1
    end
end

func activar() -> Bool
    if input_active_title() != "Forja"
        w = window_find("Forja")
        if w != 0
            window_found_activate(w)
            time_delay(10)
        end
    end
    return input_active_title() == "Forja"
end

func campo(nombre: String, i: Int) -> Int
    return Int(str_split(env_get(nombre), " ")[i])
end

func sonda_texto() -> String
    time_delay(25)
    t = file_read_text("RAM:forja-sonda.txt")
    if t == nil
        return ""
    end
    return t
end

func sonda() -> [String]
    return str_split(sonda_texto(), "\n")
end

func cabecera(i: Int) -> String
    p = str_split(sonda()[1], " ")
    if i >= p.length
        return "?"
    end
    return p[i]
end

# Espera (como mucho 5 s) a que el campo i de la cabecera valga v
func esperar(i: Int, v: String) -> Bool
    n = 0
    c = cabecera(i)
    while n < 10 and c != v
        n = n + 1
        c = cabecera(i)
    end
    return c == v       # sin volver a leer: la sonda podía estar a medio escribir
end

func px(f: Int, x: Int, y: Int) -> String
    l = sonda()
    i = 2 + f * 16 + y
    if i >= l.length
        return "?"
    end
    return l[i][x:x + 1]
end

func cx(x: Int) -> Int
    return campo("FORJA_EDITOR", 0) + campo("FORJA_SPRITE", 0) + x * campo("FORJA_SPRITE", 2) + campo("FORJA_SPRITE", 2) / 2
end

func cy(y: Int) -> Int
    return campo("FORJA_EDITOR", 1) + campo("FORJA_SPRITE", 1) + y * campo("FORJA_SPRITE", 2) + campo("FORJA_SPRITE", 2) / 2
end

func fila_proyecto(i: Int)
    f = campo("FORJA_PROYECTO", 2)
    input_click(campo("FORJA_PROYECTO", 0) + 30, campo("FORJA_PROYECTO", 1) + i * f + f / 2, 0)
end

# Abre la fila i del proyecto y espera a que esté delante; los milisegundos que tardó
func abrir_fila(i: Int, nombre: String) -> Int
    t0 = time_ms()
    fila_proyecto(i)
    n = 0
    while n < 200
        t = file_read_text("RAM:forja-sonda.txt")
        if t != nil and str_ends(str_split(t, "\n")[0], " " + nombre)
            return time_ms() - t0
        end
        time_delay(2)
        n = n + 1
    end
    return -1
end

var perdidas: Int = 0

# Una tecla que tiene que cambiar el campo i de la cabecera a v; si no llega en 5 s, se anota como perdida y se
# repite una vez (el lienzo de Dash guarda un solo evento: tarea 15e)
func letra(t: String, i: Int, v: String) -> Bool
    input_text(t)
    if esperar(i, v)
        return true
    end
    perdidas = perdidas + 1
    anotar("tecla perdida: " + t + "; eventos: " + file_read_text("RAM:forja-eventos.txt"))
    input_text(t)
    return esperar(i, v)
end

# Espera (como mucho 5 s) a que la fila l de la sonda sea esa
func esperar_fila(l: Int, t: String) -> Bool
    n = 0
    while n < 10 and sonda()[l] != t
        n = n + 1
    end
    return sonda()[l] == t
end

func esperar_ventana(titulo: String) -> Bool
    n = 0
    while n < 100
        if input_active_title() == titulo
            return true
        end
        time_delay(5)
        n = n + 1
    end
    return false
end

Main
    n = 0
    while n < 600 and not (env_get("FORJA_SPRITE_BOTONES") != "" and activar())
        time_delay(5)
        n = n + 1
    end
    if n >= 600
        ver("la ventana de Forja aparece", false, "")
    else
        input_move(cx(8), cy(8))
        ver("el pincel de DPaint: un BOB de 3 fotogramas de 16x16", cabecera(0) == "16" and cabecera(2) == "2" and cabecera(3) == "false" and cabecera(4) == "3", sonda()[1])
        letra("3", 6, "3")
        input_click(cx(1), cy(1), 0)
        n = 0
        while n < 10 and px(0, 1, 1) != "3"
            n = n + 1
        end
        ver("pintar con el color 3", px(0, 1, 1) == "3", sonda()[3])
        letra("l", 7, "1")
        input_drag(cx(0), cy(10), cx(15), cy(10))
        ver("una línea entera", esperar_fila(12, "3333333333333333"), sonda()[12])
        letra("f", 7, "3")
        antes = sonda()[2 + 4]
        input_click(cx(0), cy(4), 0)
        n = 0
        while n < 10 and sonda()[2 + 4] == antes
            n = n + 1
        end
        ver("el relleno cambia la fila 4", sonda()[2 + 4] != antes, sonda()[2 + 4])
        input_key(0x31, AMIGA)
        ver("deshacer el relleno", esperar_fila(2 + 4, antes), sonda()[2 + 4] + " / " + antes)
        ver("D duplica", letra("d", 4, "4"), sonda()[1])
        input_text("h")
        n = 0
        while n < 10 and px(1, 14, 1) != "3"
            n = n + 1
        end
        ver("H voltea el nuevo: el píxel 1,1 pasa al 14,1", px(1, 14, 1) == "3" and px(1, 1, 10) == "3", sonda()[2 + 16 + 1])
        ver("T: sprite de hardware", letra("t", 3, "true"), sonda()[1])
        # lo que debe quedar en el fichero
        file_write_text("DH0:Prueba/esperado.txt", sonda_texto())
        input_key(0x21, AMIGA)
        n = 0
        while n < 20 and not str_contains(file_read_text("RAM:forja-salida.txt"), "Guardado: DH0:Prueba/juego/pincel.iff")
            time_delay(25)
            n = n + 1
        end
        ver("Amiga-S guarda", str_contains(file_read_text("RAM:forja-salida.txt"), "Guardado: DH0:Prueba/juego/pincel.iff"), file_read_text("RAM:forja-salida.txt"))
        ver("bob_load lee lo guardado", bob_load(1, "DH0:Prueba/juego/pincel.iff"), "")
        bob_free(1)
        # el cambio de pestaña entre el sprite y un texto (el proyecto: "/", main.dash, pincel.iff, red.dash...)
        ms1 = abrir_fila(1, "main.dash")
        time_delay(50)
        ms2 = abrir_fila(2, "pincel.iff")
        if ms2 < 0
            anotar("clic perdido en el proyecto: se repite")
            ms2 = abrir_fila(2, "pincel.iff")
        end
        anotar("cambio de pestaña: al texto #{ms1} ms, al sprite #{ms2} ms (con la espera de la sonda)")
        ver("los cambios de pestaña llegan", ms1 >= 0 and ms2 >= 0, "#{ms1} #{ms2}")
        # un BOB nuevo, tocado, y salir descartando
        activar()
        input_move(cx(8), cy(8))
        input_key(0x35, AMIGA)
        if esperar_ventana("Nuevo sprite")
            time_delay(25)
            input_key(0x35, 0)
        end
        time_delay(25)
        activar()
        ver("un BOB nuevo de 32x32", str_ends(sonda()[0], " sin nombre.iff") and cabecera(0) == "32", sonda()[0] + " / " + sonda()[1])
        input_move(cx(4), cy(4))
        input_click(cx(4), cy(4), 0)
        time_delay(50)
    end
    anotar("teclas perdidas (repetidas): #{perdidas}")
    if fallos == 0
        anotar("TODO BIEN")
    end
    activar()
    input_key(0x10, AMIGA)
    if esperar_ventana("Cambios sin guardar")
        anotar("bien: salir con el BOB tocado pregunta")
        time_delay(25)
        input_key(0x22, 0)
    else
        anotar("FALLO: salir con el BOB tocado no pregunta")
    end
end
