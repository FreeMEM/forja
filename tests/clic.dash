# Hace de usuario de Forja con el ratón mientras depura (lo contó David Martínez): un clic en el editor no mueve el
# código (antes, el tic del depurador volvía a atender la parada y centraba la línea: el código daba un salto) ni
# se lleva el cursor a la línea de la parada, y un clic en el panel de las variables no abre el fichero de la lista
# que hay debajo. Lo arranca tests/clic.sh con gravedad/main.dash (y otro.dash al lado); anota en
# DH0:Prueba/clic.txt y acaba con "TODO BIEN" si todo fue bien.

const AMIGA = 8
const CTRL = 2
const ABAJO = 0x4D
const ARRIBA = 0x4C
const F9 = 0x58
const ALTO_PESTANAS = 18

var fallos: Int = 0
var registro: String = ""

func anotar(texto: String)
    registro = registro + texto + "\n"
    file_write_text("DH0:Prueba/clic.txt", registro)
end

func ver(paso: String, cierto: Bool, detalle: String)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso + ": [" + detalle + "]")
        fallos = fallos + 1
    end
end

func activar() -> Bool
    if input_active_title() != "Forja"
        w = window_find("Forja")
        if w != 0
            window_found_activate(w)
            time_delay(10)
        end
    end
    return input_active_title() == "Forja"
end

func campo(nombre: String, i: Int) -> Int
    return Int(str_split(env_get(nombre), " ")[i])
end

# La primera línea de cada dibujo entero del editor, desde que empezó
func vistas() -> [String]
    t = file_read_text("RAM:forja-vistas.txt")
    if t == nil
        return []
    end
    return str_split(str_trim(t), " ")
end

# La línea (desde 0) y el nombre del documento activo, de la sonda
func sonda() -> [String]
    t = file_read_text("RAM:forja-sonda.txt")
    n = 0
    while (t == nil or t == "") and n < 10
        time_delay(5)
        t = file_read_text("RAM:forja-sonda.txt")
        n = n + 1
    end
    while n < 20
        if t != nil
            c = str_split(str_split(t, "\n")[0], " ")
            if c.length >= 3 and c[0] != "" and c[2] != ""
                return c
            end
        end
        time_delay(5)
        t = file_read_text("RAM:forja-sonda.txt")
        n = n + 1
    end
    return ["?", "?", "?"]
end

# Un clic en la línea n (desde 1) del editor, hacia la mitad del ancho
func clic_linea(n: Int)
    primera = campo("FORJA_VISTA", 0)
    fila = campo("FORJA_VISTA", 1)
    x = campo("FORJA_EDITOR", 0) + campo("FORJA_EDITOR", 2) / 2
    y = campo("FORJA_EDITOR", 1) + ALTO_PESTANAS + 2 + (n - 1 - primera) * fila + fila / 2
    input_move(x, y)
    time_delay(5)
    input_click(x, y, 0)
    anotar("  (clic en #{x},#{y}: editor " + env_get("FORJA_EDITOR") + ", vista " + env_get("FORJA_VISTA") + ")")
end

func al_editor()
    input_move(campo("FORJA_EDITOR", 0) + campo("FORJA_EDITOR", 2) / 2, campo("FORJA_EDITOR", 1) + campo("FORJA_EDITOR", 3) / 2)
    time_delay(5)
end

func esperar_parada(que: String) -> String
    n = 0
    while n < 900
        e = env_get("FORJA_DEPURAR")
        if str_starts(e, que)
            return e
        end
        time_delay(10)
        n = n + 1
    end
    return env_get("FORJA_DEPURAR")
end

# Los dibujos desde el k-ésimo: todos con la misma primera línea p
func quietas(desde: Int, p: String) -> Bool
    vs = vistas()
    i = desde
    while i < vs.length
        if vs[i] != p
            return false
        end
        i = i + 1
    end
    return true
end

func tras(desde: Int) -> String
    vs = vistas()
    t = ""
    i = desde
    while i < vs.length
        t = t + vs[i] + " "
        i = i + 1
    end
    return t
end

Main
    n = 0
    while n < 600 and not (env_get("FORJA_EDITOR") != "" and env_get("FORJA_VISTA") != "" and activar())
        time_delay(5)
        n = n + 1
    end
    if n >= 600
        ver("la ventana de Forja", false, "")
    else
        time_delay(20)
        # 1. sin depurar: un clic en la línea 5 (la ventana del emulador es pequeña: se ven unas 8)
        k = vistas().length
        p = "#{campo("FORJA_VISTA", 0)}"
        clic_linea(5)
        time_delay(50)
        s = sonda()
        ver("sin depurar: el clic pone el cursor en la 5", s[0] == "4", s[0])
        ver("sin depurar: el código no se mueve", quietas(k, p), p + " / " + tras(k))
        # 1b. arrastrar con el ratón elige: de la línea 2 a la 3 (ARexx SELECCION: ruta, desde, hasta y el texto)
        fila_alto = campo("FORJA_VISTA", 1)
        ex = campo("FORJA_EDITOR", 0)
        ey = campo("FORJA_EDITOR", 1) + ALTO_PESTANAS + 2 - campo("FORJA_VISTA", 0) * fila_alto
        x1 = ex + campo("FORJA_VISTA", 2) + 30
        input_drag(x1, ey + 1 * fila_alto + fila_alto / 2, x1 + 40, ey + 2 * fila_alto + fila_alto / 2)
        time_delay(40)
        r = rexx_send("FORJA.1", "SELECCION")
        sel = str_split(r, "\n")
        ver("arrastrar elige de la línea 2 a la 3", sel.length >= 5 and sel[1] == "2" and sel[2] == "3" and sel[3] != "", r)
        clic_linea(5)
        time_delay(20)
        # 2. depurando, parado en la 21 (con el editor a la vista desde la 1)
        al_editor()
        input_key(ARRIBA, CTRL)
        k = 0
        while k < 20
            input_key(ABAJO, 0)
            k = k + 1
        end
        input_key(F9, 0)
        input_key(0x24, AMIGA)
        e = esperar_parada("3 21 ")
        ver("para en el punto de la línea 21", str_starts(e, "3 21 "), e)
        time_delay(50)
        p = "#{campo("FORJA_VISTA", 0)}"
        k = vistas().length
        # la segunda línea que se ve (no la de la parada)
        clic_linea(Int(p) + 2)
        # el tic del depurador va cada 0,3 s: unos cuantos
        time_delay(150)
        s = sonda()
        ver("depurando: el clic pone el cursor donde se pulsó y ahí se queda", s[0] == "#{Int(p) + 1}", s[0] + ", vista " + p)
        ver("depurando: el código no salta tras el clic", quietas(k, p), p + " / " + tras(k))
        # 3. el panel de la izquierda es el de las variables: un clic en sus filas no abre ficheros
        antes = sonda()[2]
        px = campo("FORJA_PROYECTO", 0) + 30
        py = campo("FORJA_PROYECTO", 1)
        fila = campo("FORJA_PROYECTO", 2)
        # (de abajo arriba: la fila 0 de la lista es "/", que cambiaría de cajón)
        f = 3
        while f >= 1
            input_click(px, py + f * fila + fila / 2, 0)
            time_delay(30)
            f = f - 1
        end
        s = sonda()
        ver("un clic en las variables no abre ficheros", s[2] == antes, antes + " / " + s[2])
        # parar (el botón de la barra)
        b = str_split(env_get("FORJA_BOTONES"), " ")
        i = 4
        while i < b.length
            q = str_split(b[i], ":")
            if q[0] == "17"
                input_click(Int(q[1]) + Int(q[2]) / 2, Int(b[1]) + Int(b[2]) / 2, 0)
            end
            i = i + 1
        end
        time_delay(100)
        # 4. ya sin depurar, el panel vuelve a ser la lista: un clic en otro.dash lo abre
        y = py + 2 * fila + fila / 2
        input_click(px, y, 0)
        time_delay(50)
        s = sonda()
        ver("sin depurar, un clic en la lista abre otro.dash", s[2] == "otro.dash", s[2] + " (" + env_get("FORJA_ESTADO") + ")")
    end
    if fallos == 0
        anotar("TODO BIEN")
    else
        anotar("FALLOS: #{fallos}")
    end
    activar()
    input_move(campo("FORJA_EDITOR", 0) + campo("FORJA_EDITOR", 2) / 2, campo("FORJA_EDITOR", 1) + campo("FORJA_EDITOR", 3) / 2)
    time_delay(5)
    input_key(0x10, AMIGA)
end
