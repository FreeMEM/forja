# Las extensiones de Forja en el emulador (docs/EXTENSIONES.md), como un usuario y por ARexx:
#   - Contar (extensiones/Contar) arranca con Forja y pone la cuenta en la barra; su menú la dice en la salida; su
#     tecla (Ctrl Alt D) mete la fecha en el cursor; al escribir, la cuenta sigue (CAMBIADO);
#   - la API: ACTIVO, LINEAS, LINEA, CURSOR, ELEGIR, ELEGIDO, INSERTAR, LOTE, AVISO, BARRA, PROYECTO, ABIERTOS,
#     MARCAS y MARCASPROYECTO (con capturas);
#   - Eco (tests/extensiones/Eco) arranca al elegir su menú y apunta los sucesos: MENU, GUARDADO, ABIERTO, ACTIVO,
#     CERRADO, EDITAR (un .eco, que no abre Forja), MARCA (un clic en su marca) y COMPILADO;
#   - una extensión que cae (Forja lo dice y la vuelve a arrancar con su menú) y otra colgada (Forja sigue
#     contestando, su cola tiene tope);
#   - las teclas de una extensión con el puntero en la salida, el proyecto y la barra de botones, y sus paneles en la
#     ventana de Forja (pestañas, clic en una línea, flechas y Return, la entrada, los botones; PANELES);
#   - el gestor: desactivar Contar (se va y se guarda en la preferencia) y volver a activarla.
# Lo arranca tests/extensiones.sh; anota en DH0:Prueba/extensiones.txt.

const FORJA = "FORJA.1"
const MAIN = "DH0:Prueba/juego/main.dash"
const RED = "DH0:Prueba/juego/red.dash"
const ECO = "DH0:Prueba/dibujo.eco"
const AMIGA = 8
const ALT = 4
const CTRL = 2
const M_EXT = 5            # el menú Extensiones
const M_CONTAR = 2         # sus opciones: gestor, raya, Contar las palabras, Insertar la fecha, Eco, Caerse, Colgarse
const M_ECO = 4
const M_CAERSE = 5
const M_COLGARSE = 6
const M_PANELES = 7

var fallos: Int = 0
var registro: String = ""

func anotar(texto: String)
    registro = registro + texto + "\n"
    file_write_text("DH0:Prueba/extensiones.txt", registro)
end

func ver(paso: String, cierto: Bool, detalle: String)
    if cierto
        anotar("bien: " + paso)
    else
        anotar("FALLO: " + paso + ": [" + detalle + "]")
        fallos = fallos + 1
    end
end

func rexx(orden: String) -> String
    return rexx_send(FORJA, orden)
end

func activar(titulo: String) -> Bool
    n = 0
    while n < 40 and input_active_title() != titulo
        w = window_find(titulo)
        if w != 0
            window_found_activate(w)
        end
        time_delay(5)
        n = n + 1
    end
    return input_active_title() == titulo
end

func campo(nombre: String, i: Int) -> Int
    return Int(str_split(env_get(nombre), " ")[i])
end

# El puntero sobre el editor de Forja (activa): el teclado va a él
func al_editor() -> Bool
    if not activar("Forja")
        return false
    end
    input_move(campo("FORJA_EDITOR", 0) + campo("FORJA_EDITOR", 2) / 2, campo("FORJA_EDITOR", 1) + campo("FORJA_EDITOR", 3) / 2)
    time_delay(5)
    return true
end

# Una opción del menú Extensiones. input_menu no sirve con los menús de MUI: con la sonda, ENV:FORJA_EVENTO lleva el
# evento de la opción (180 el gestor, 200 y siguientes las de las extensiones), y una tecla (Esc) lo hace mirar
func menu(item: Int) -> Bool
    ev = 180
    if item >= 2
        ev = 200 + item - 2
    end
    env_set("FORJA_EVENTO", "#{ev}", false)
    if not al_editor()
        return false
    end
    input_key(0x45, 0)
    time_delay(10)
    return env_get("FORJA_EVENTO") == ""
end

# Lo que apuntó Eco
func eco() -> String
    t = file_read_text("DH0:Prueba/eco.txt")
    n = 0
    while t == nil and n < 5 and file_exists("DH0:Prueba/eco.txt")
        time_delay(2)
        t = file_read_text("DH0:Prueba/eco.txt")
        n = n + 1
    end
    if t == nil
        return ""
    end
    return t
end

# Espera (hasta decimas décimas) a que Eco apunte esa línea
func eco_dice(linea: String, decimas: Int) -> Bool
    n = 0
    while n < decimas
        if str_contains("\n" + eco(), "\n" + linea + "\n")
            return true
        end
        time_delay(5)
        n = n + 1
    end
    return false
end

func barra_dice(texto: String, decimas: Int) -> Bool
    n = 0
    while n < decimas
        if str_contains(rexx("BARRA"), texto)
            return true
        end
        time_delay(5)
        n = n + 1
    end
    return false
end

func salida_dice(texto: String, decimas: Int) -> Bool
    n = 0
    while n < decimas
        if str_contains(rexx("SALIDA"), texto)
            return true
        end
        time_delay(5)
        n = n + 1
    end
    return false
end

func puerto(nombre: String) -> Bool
    n = ports_read()
    i = 0
    while i < n
        if port_name(i) == nombre
            return true
        end
        i = i + 1
    end
    return false
end

func sin_puerto(nombre: String, decimas: Int) -> Bool
    n = 0
    while n < decimas and puerto(nombre)
        time_delay(5)
        n = n + 1
    end
    return not puerto(nombre)
end

# Lo que cuenta Contar, con el texto que tiene Forja
func cuenta() -> String
    t = rexx("TEXTO")
    lineas = str_split(t, "\n").length
    palabras = 0
    for p in str_split(str_replace(t, "\n", " "), " ")
        if p != ""
            palabras = palabras + 1
        end
    end
    return "#{lineas} líneas, #{palabras} palabras"
end

# Los paneles de las extensiones, de la sonda (ENV:FORJA_PANELES): la línea de un lado
func panel_lado(lado: Int) -> String
    for l in str_split(env_get("FORJA_PANELES"), str_char(30))
        if str_starts(l, "lado #{lado}:")
            return l
        end
    end
    return ""
end

# Un número de la línea de un lado: tras "o=" (0 x, 1 y), una pestaña k ("pest=": 2k x1, 2k+1 x2)...
func panel_origen(lado: Int, i: Int) -> Int
    l = panel_lado(lado)
    p = str_find(l, "o=")
    q = str_find(l, " pest=")
    if p < 0 or q < 0
        return 0
    end
    return Int(str_split(l[p + 2:q], ",")[i])
end

# El centro de la pestaña k de un lado (0 la de Forja), desde la esquina de la ventana
func pestana_x(lado: Int, k: Int) -> Int
    l = panel_lado(lado)
    p = str_find(l, "pest=")
    q = str_find(l, " y=")
    if p < 0 or q < 0
        return 0
    end
    ps = str_split(l[p + 5:q], ",")
    if k >= ps.length or ps[k] == ""
        return 0
    end
    ab = str_split(ps[k], "-")
    return (Int(ab[0]) + Int(ab[1])) / 2
end

# La parte n (separadas por " | ") de la línea del lado con su panel delante: 2 líneas "x,y,fila,desde,caben", 3 la
# y de la entrada, 4 los botones
func panel_parte(lado: Int, n: Int) -> String
    ps = str_split(panel_lado(lado), " | ")
    if n >= ps.length
        return ""
    end
    return ps[n]
end

func panel_num(lado: Int, n: Int, i: Int) -> Int
    return Int(str_split(panel_parte(lado, n), ",")[i])
end

# Un clic en la ventana de Forja (activa), desde su esquina
func clic_forja(x: Int, y: Int)
    activar("Forja")
    input_move(x, y)
    time_delay(5)
    input_click(x, y, 0)
    time_delay(15)
end

func veces(texto: String, trozo: String) -> Int
    n = 0
    p = str_find(texto, trozo)
    while p >= 0
        n = n + 1
        p = str_find_from(texto, trozo, p + trozo.length)
    end
    return n
end

# Espera a que Eco haya apuntado n veces MENU eco
func veces_espera(n: Int) -> Bool
    k = 0
    while k < 60
        if veces(eco(), "\nMENU eco\n") >= n
            return true
        end
        time_delay(5)
        k = k + 1
    end
    return false
end

func paneles_dice(trozo: String, decimas: Int) -> Bool
    n = 0
    while n < decimas
        if str_contains(rexx("PANELES"), trozo)
            return true
        end
        time_delay(5)
        n = n + 1
    end
    return false
end

Main
    run_command("Run >NIL: DH0:Prueba/Forja")
    n = 0
    while n < 600 and rexx("ESTADO") != "libre"
        time_delay(10)
        n = n + 1
    end
    ver("el puerto contesta", n < 600, "")
    n = 0
    while n < 200 and env_get("FORJA_EDITOR") == ""
        time_delay(5)
        n = n + 1
    end

    # --- Contar ---
    ver("Contar arranca con Forja y pone la cuenta en la barra", barra_dice(cuenta(), 300), rexx("BARRA") + " / " + cuenta())
    ver("su puerto FORJAEXT.CONTAR", puerto("FORJAEXT.CONTAR"), "")
    ver("Extensiones > Contar las palabras", menu(M_CONTAR) and salida_dice(MAIN + ": " + cuenta() + ".", 100), rexx("SALIDA"))
    rexx("CURSOR 1 1")
    fecha = date_text("%d-%m-%Y")
    if al_editor()
        input_key(0x22, CTRL + ALT)
    end
    n = 0
    while n < 60 and not str_starts(rexx("LINEA 1"), fecha)
        time_delay(5)
        n = n + 1
    end
    ver("Ctrl Alt D mete la fecha en el cursor", str_starts(rexx("LINEA 1"), fecha), rexx("LINEA 1"))
    antes = cuenta()
    if al_editor()
        input_text(" hola mundo")
    end
    ver("al escribir, la cuenta sigue (CAMBIADO)", barra_dice(cuenta(), 200) and cuenta() != antes, rexx("BARRA") + " / " + cuenta())

    # --- La API ---
    a = str_split(rexx("ACTIVO"), "\n")
    ver("ACTIVO", a.length == 5 and a[0] == MAIN and a[1] == "main.dash" and a[2] == "1" and a[3] == "texto", rexx("ACTIVO"))
    t = str_split(rexx("TEXTO"), "\n")
    ver("LINEAS 2 3", rexx("LINEAS 2 3") == t[1] + "\n" + t[2], rexx("LINEAS 2 3"))
    ver("LINEA de otro fichero (abierto)", rexx("ABRIR " + RED) == "" and rexx("ABRIR " + MAIN) == "" and rexx("LINEA 1 " + RED) != "", "rc #{rexx_rc()}")
    rexx("CURSOR 2 3")
    ver("CURSOR", rexx("CURSOR") == "2 3", rexx("CURSOR"))
    rexx("CURSOR 2 999")
    ver("CURSOR más allá del final de la línea: al final", rexx("CURSOR") == "2 #{t[1].length + 1}", rexx("CURSOR"))
    rexx("ELEGIR 2 1 2 5")
    ver("ELEGIR y ELEGIDO", rexx("ELEGIDO") == "2 1 2 5\n" + t[1][0:4], rexx("ELEGIDO"))
    rexx("INSERTAR     uno\n    dos\n")
    ver("INSERTAR en lugar de lo elegido, con espacios y saltos", rexx("LINEAS 2 4") == "    uno\n    dos\n" + t[1][4:], rexx("LINEAS 2 4"))
    # deshacer (Amiga-Z) lo de INSERTAR: de una vez
    al_editor()
    input_key(0x31, AMIGA)
    time_delay(25)
    ver("y vuelve lo de antes", rexx("LINEA 2") == t[1], rexx("LINEA 2"))
    l = str_split(rexx("LOTE\nESTADO\n\nCURSOR\nNOEXISTE\nLINEA 2"), str_char(30))
    ver("LOTE: cuatro respuestas (vacía la que no existe), RC 0", l.length == 4 and l[0] == "libre" and l[2] == "" and l[3] == t[1] and rexx_rc() == 0, "#{l.length} rc #{rexx_rc()}")
    # lo que cuesta una orden (con REAL=1, en un A1200): una sola, tres sueltas y tres en un lote
    t0 = time_ms()
    i = 0
    while i < 20
        rexx("CURSOR")
        i = i + 1
    end
    t1 = time_ms()
    i = 0
    while i < 20
        rexx("ACTIVO")
        rexx("CURSOR")
        rexx("LINEA 2")
        i = i + 1
    end
    t2 = time_ms()
    i = 0
    while i < 20
        rexx("LOTE\nACTIVO\nCURSOR\nLINEA 2")
        i = i + 1
    end
    t3 = time_ms()
    anotar("una orden: #{(t1 - t0) / 20} ms; tres sueltas: #{(t2 - t1) / 20} ms; tres en un lote: #{(t3 - t2) / 20} ms")
    rexx("AVISO 2 Hola desde la prueba")
    ver("AVISO", salida_dice("Hola desde la prueba", 20), "")
    rexx("BARRA Prueba rama main")
    ver("BARRA", str_contains(rexx("BARRA"), "rama main") and str_contains(rexx("BARRA"), "palabras"), rexx("BARRA"))
    p = str_split(rexx("PROYECTO"), "\n")
    ver("PROYECTO", p[0] == "DH0:Prueba/juego" and str_contains(rexx("PROYECTO"), "\nred.dash\n"), rexx("PROYECTO"))
    ver("ABIERTOS", rexx("ABIERTOS") == MAIN + "\n" + RED + "\n", rexx("ABIERTOS"))
    rexx("MARCAS Prueba " + MAIN + "\n2 +\n3 +\n5 ~\n7 -\n9 !")
    rexx("MARCASPROYECTO Prueba\nM " + MAIN + "\n? " + RED)
    ver("MARCAS y MARCASPROYECTO", rexx_rc() == 0, "rc #{rexx_rc()}")
    time_delay(25)
    screen_save_png("DH0:Prueba/marcas.png")
    rexx("BARRA Prueba")
    ver("BARRA sin texto la quita", not str_contains(rexx("BARRA"), "rama main"), rexx("BARRA"))

    # --- Eco: arranca con su menú ---
    file_delete("DH0:Prueba/eco.txt")
    ver("Eco no está hasta que se elige su menú", not puerto("FORJAEXT.ECO"), "")
    ver("Extensiones > Eco la arranca", menu(M_ECO) and eco_dice("MENU eco", 200), eco())
    ver("Eco saluda con la versión de Forja", str_starts(eco(), "HOLA 0."), eco())
    ver("al arrancar le llegan el fichero activo y el proyecto", eco_dice("ACTIVO " + MAIN, 20) and eco_dice("PROYECTO DH0:Prueba/juego", 20), eco())
    rexx("GUARDAR " + MAIN)
    ver("GUARDADO", eco_dice("GUARDADO " + MAIN, 60), eco())
    rexx("ABRIR " + RED)
    ver("ACTIVO al cambiar de pestaña", eco_dice("ACTIVO " + RED, 60), eco())
    ver("un .eco lo abre Eco (EDITAR), no Forja", rexx("ABRIR " + ECO) == "" and rexx_rc() == 0 and eco_dice("EDITAR " + ECO, 60) and rexx("ABIERTO " + ECO) == "0", eco())
    # un clic en su marca: MARCA a ella
    rexx("ABRIR " + MAIN)
    rexx("MARCAS Eco " + MAIN + "\n4 !")
    time_delay(25)
    if al_editor()
        # (la columna de las marcas, entre los números y el texto: ENV:FORJA_VISTA da el margen y el alto de fila)
        input_key(0x45, 0)
        time_delay(10)
        v = str_split(env_get("FORJA_VISTA"), " ")
        primera = Int(v[0])
        fila = Int(v[1])
        margen = Int(v[2])
        input_click(campo("FORJA_EDITOR", 0) + margen - 10, campo("FORJA_EDITOR", 1) + 18 + 2 + (3 - primera) * fila + fila / 2, 0)
    end
    ver("un clic en su marca: MARCA", eco_dice("MARCA " + MAIN + " 4", 60), eco() + " / " + env_get("FORJA_VISTA"))
    # cerrar la pestaña de red.dash (Amiga-W)
    rexx("ABRIR " + RED)
    if al_editor()
        input_key(0x11, AMIGA)
    end
    ver("CERRADO", eco_dice("CERRADO " + RED, 60), eco())
    if file_exists("DH0:Dash/dashc")
        rexx("ABRIR " + MAIN)
        rexx("COMPILAR")
        n = 0
        while n < 1800 and not str_contains(eco(), "\nCOMPILADO ")
            time_delay(10)
            n = n + 1
        end
        ver("COMPILADO (con los errores de la fecha metida arriba)", str_contains(eco(), "\nCOMPILADO ") and not str_contains(eco(), "\nCOMPILADO 0"), eco())
    end


    # --- Teclas fuera del editor y paneles (API 6) ---
    rexx("ABRIR " + MAIN)
    t_linea1 = rexx("LINEA 1")
    ver("Paneles: Eco pone los suyos", menu(M_PANELES) and eco_dice("MENU paneles", 100) and paneles_dice("Eco|Charla|abajo|0|0|1|", 60), rexx("PANELES"))
    ver("PANELES", str_contains(rexx("PANELES"), "Eco|Lista|izquierda|0|0|3|\n"), rexx("PANELES"))
    time_delay(25)
    n_eco = veces(eco(), "\nMENU eco\n")
    # Ctrl Alt E (la tecla de Eco) con el puntero sobre la salida, sobre el proyecto y sobre la barra de botones
    activar("Forja")
    input_move(campo("FORJA_SALIDA", 0) + 60, campo("FORJA_SALIDA", 1) + 4)
    time_delay(5)
    input_key(0x12, CTRL + ALT)
    ver("la tecla de una extensión con el puntero en la salida", eco_dice("MENU eco", 1) and veces_espera(n_eco + 1), eco())
    input_move(panel_origen(0, 0) + 30, panel_origen(0, 1) + 60)
    time_delay(5)
    input_key(0x12, CTRL + ALT)
    ver("y en el proyecto", veces_espera(n_eco + 2), eco())
    input_move(campo("FORJA_EDITOR", 0) + 30, campo("FORJA_EDITOR", 1) - 12)
    time_delay(5)
    input_key(0x12, CTRL + ALT)
    ver("y en la barra de botones", veces_espera(n_eco + 3), eco())
    # las pestañas: un clic en la de Lista la pone delante
    clic_forja(pestana_x(0, 1), panel_origen(0, 1) + 9)
    ver("un clic en su pestaña pone delante el panel", paneles_dice("Eco|Lista|izquierda|1|", 40), rexx("PANELES") + " / " + panel_lado(0))
    screen_save_png("DH0:Prueba/panel-lista.png")
    # un clic en la segunda línea: PANEL a Eco
    clic_forja(panel_num(0, 2, 0) + 20, panel_num(0, 2, 1) + panel_num(0, 2, 2) + 2)
    ver("un clic en una línea: PANEL título|línea|columna|otra_vez", eco_dice("PANEL Lista|2|2|0", 60), eco() + " / " + panel_lado(0))
    # el panel tiene el teclado: flecha abajo y Return
    input_key(0x4D, 0)
    time_delay(10)
    input_key(0x44, 0)
    ver("con el teclado en el panel, flechas y Return: PANELTECLA", eco_dice("PANELTECLA Lista|return|3", 60), eco())
    input_key(0x22, 0)
    ver("y una letra", eco_dice("PANELTECLA Lista|d|3", 60), eco())
    ver("el texto del editor no cambia", rexx("LINEA 1") == t_linea1, rexx("LINEA 1"))
    input_key(0x12, CTRL + ALT)
    ver("la tecla de la extensión sigue valiendo", veces_espera(n_eco + 4), eco())
    # abajo: la pestaña Charla, la entrada y Return
    clic_forja(pestana_x(1, 1), panel_origen(1, 1) + 9)
    ver("la pestaña de abajo", paneles_dice("Eco|Charla|abajo|1|", 40), rexx("PANELES") + " / " + panel_lado(1))
    ey = Int(panel_parte(1, 3))
    clic_forja(panel_origen(1, 0) + 120, ey + 4)
    ver("un clic en la entrada le da el teclado", str_contains(env_get("FORJA_PANELES"), "|entrada|"), env_get("FORJA_PANELES"))
    input_text("hola panel")
    input_key(0x44, 0)
    ver("Return en la entrada: PANELTEXTO", eco_dice("PANELTEXTO Charla|hola panel", 60), eco())
    ver("y Eco lo añade y vacía la entrada", paneles_dice("Eco|Charla|abajo|1|0|2|\n", 60), rexx("PANELES"))
    screen_save_png("DH0:Prueba/panel-charla.png")
    b = str_split(panel_parte(1, 4), ";")
    bc = str_split(b[0], ",")
    clic_forja((Int(bc[0]) + Int(bc[2])) / 2, (Int(bc[1]) + Int(bc[3])) / 2)
    ver("un botón: PANELBOTON", eco_dice("PANELBOTON Charla|limpiar", 60) and paneles_dice("Eco|Charla|abajo|1|0|0|", 60), eco() + " / " + rexx("PANELES"))
    bc = str_split(b[1], ",")
    clic_forja((Int(bc[0]) + Int(bc[2])) / 2, (Int(bc[1]) + Int(bc[3])) / 2)
    ver("el otro cierra la Lista (PANELCERRAR)", eco_dice("PANELBOTON Charla|cerrar", 60) and not paneles_dice("Eco|Lista", 20), rexx("PANELES"))
    ver("y a la izquierda vuelve el proyecto, sin pestañas", str_contains(panel_lado(0), "pest= y="), panel_lado(0))
    # la salida otra vez delante con su pestaña, y un clic en el editor le devuelve el teclado
    clic_forja(pestana_x(1, 0), panel_origen(1, 1) + 9)
    ver("la pestaña de la salida", paneles_dice("Eco|Charla|abajo|0|", 40), rexx("PANELES"))
    clic_forja(campo("FORJA_EDITOR", 0) + campo("FORJA_EDITOR", 2) / 2, campo("FORJA_EDITOR", 1) + campo("FORJA_EDITOR", 3) / 2)
    rexx("CURSOR 1 1")
    input_text("z")
    time_delay(25)
    ver("un clic en el editor le devuelve el teclado", str_starts(rexx("LINEA 1"), "z"), rexx("LINEA 1"))
    al_editor()
    input_key(0x31, AMIGA)
    time_delay(25)
    rexx("PANELVER Eco \"Charla\" entrada")
    ver("PANELVER con entrada: delante y con el teclado", paneles_dice("Eco|Charla|abajo|1|", 20) and str_contains(env_get("FORJA_PANELES"), "Charla|1|0|0|entrada|"), rexx("PANELES") + " / " + env_get("FORJA_PANELES"))
    input_key(0x45, 0)
    input_key(0x45, 0)
    time_delay(10)
    ver("Esc dos veces: el teclado vuelve al editor", not str_contains(env_get("FORJA_PANELES"), "|entrada|") and not str_contains(env_get("FORJA_PANELES"), "|lista|"), env_get("FORJA_PANELES"))

    # --- SUGERENCIA en medio de una línea y de varias líneas (API 6) ---
    rexx("ABRIR " + MAIN)
    l2 = rexx("LINEA 2")
    rexx("CURSOR 2 3")
    v = rexx("VERSION")
    rexx("SUGERENCIA Prueba 2 3 " + v + "\nAAA\nBBB")
    ver("SUGERENCIA en medio de una línea, de dos líneas", rexx("SUGERENCIA") == "2 3 AAA\nBBB", rexx("SUGERENCIA") + " rc #{rexx_rc()}")
    time_delay(25)
    screen_save_png("DH0:Prueba/sugerencia-varias.png")
    al_editor()
    input_key(0x42, 0)
    time_delay(20)
    ver("Tab la mete: lo de detrás del cursor queda tras la última", rexx("LINEAS 2 3") == l2[0:2] + "AAA\nBBB" + l2[2:], rexx("LINEAS 2 3"))
    input_key(0x31, AMIGA)
    time_delay(20)
    ver("Amiga-Z la quita de una vez", rexx("LINEA 2") == l2, rexx("LINEA 2"))

    # --- Una extensión que cae ---
    ver("Eco se cae (sin despedirse)", menu(M_CAERSE) and sin_puerto("FORJAEXT.ECO", 100), "")
    rexx("GUARDAR " + MAIN)
    time_delay(50 * 16)
    rexx("GUARDAR " + MAIN)
    ver("Forja lo dice cuando no recoge sus sucesos", salida_dice("La extensión Eco se ha cerrado.", 40), rexx("SALIDA"))
    ver("y quita sus paneles", rexx("PANELES") == "", rexx("PANELES"))
    file_delete("DH0:Prueba/eco.txt")
    ver("su menú la vuelve a arrancar", menu(M_ECO) and eco_dice("MENU eco", 200), eco())

    # --- Una extensión colgada ---
    menu(M_COLGARSE)
    ver("Eco se cuelga", eco_dice("MENU colgarse", 100), eco())
    peor = 0
    i = 0
    while i < 70
        t0 = time_ms()
        rexx("GUARDAR " + MAIN)
        rexx("ESTADO")
        ms = time_ms() - t0
        if ms > peor
            peor = ms
        end
        i = i + 1
    end
    anotar("con Eco colgada, lo más que tardó GUARDAR y ESTADO: #{peor} ms")
    ver("Forja sigue contestando", peor < 2000, "#{peor} ms")
    ver("y dice que Eco no recoge sus avisos", salida_dice("La extensión Eco no recoge sus avisos", 20), rexx("SALIDA"))
    ver("Eco despierta y recoge lo último", eco_dice("despierta", 900) and eco_dice("GUARDADO " + MAIN, 100), eco())

    # --- El gestor ---
    abierto = false
    intentos = 0
    while not abierto and intentos < 3
        m = menu(0)
        abierto = activar("Extensiones de Forja")
        if not abierto
            anotar("el gestor no se ve (menú #{m}, ventana #{window_find("Extensiones de Forja")}, activa " + input_active_title() + ")")
        end
        intentos = intentos + 1
    end
    if abierto
        time_delay(50)
        screen_save_png("DH0:Prueba/gestor.png")
        # la primera de la lista es Contar: _Activar (que pone Desactivar) la apaga
        input_key(0x20, 0)
        time_delay(25)
        ver("desactivar Contar: se va y quita lo suyo de la barra", sin_puerto("FORJAEXT.CONTAR", 100) and not str_contains(rexx("BARRA"), "palabras"), rexx("BARRA"))
        ver("guardado en la preferencia", env_get("Forja/extensiones_apagadas") == "Contar", env_get("Forja/extensiones_apagadas"))
        screen_save_png("DH0:Prueba/gestor-apagada.png")
        activar("Extensiones de Forja")
        input_key(0x20, 0)
        ver("activarla: arranca otra vez", barra_dice("palabras", 300) and env_get("Forja/extensiones_apagadas") == "", rexx("BARRA"))
        ver("el menú Extensiones lleva sus opciones (mui_menu_extend)", str_contains(env_get("FORJA_MENU_EXT"), ":Contar las palabras") and str_contains(env_get("FORJA_MENU_EXT"), ":Eco"), env_get("FORJA_MENU_EXT"))
        # instalar desde un cajón con el gestor (la ruta, sin la petición de ASL: ENV:FORJA_INSTALAR con la sonda)
        env_set("FORJA_INSTALAR", "DH0:Fuera/Saludo/manifiesto.txt", false)
        activar("Extensiones de Forja")
        input_key(0x17, 0)
        n = 0
        while n < 40 and not activar("Instalar una extensión")
            time_delay(10)
            n = n + 1
        end
        pregunta = activar("Instalar una extensión")
        ver("Instalar pregunta qué es", pregunta, input_active_title())
        if pregunta
            time_delay(20)
            input_key(0x20, 0)
            time_delay(50)
            ver("y la instala en el cajón de las extensiones", file_exists("DH0:Prueba/Extensiones/Saludo/manifiesto.txt") and file_exists("DH0:Prueba/Extensiones/Saludo/Saludo"), "")
            n = 0
            while n < 30 and not str_contains(env_get("FORJA_MENU_EXT"), ":Saludar")
                time_delay(10)
                n = n + 1
            end
            ver("activa: su opción sale en el menú Extensiones", str_contains(env_get("FORJA_MENU_EXT"), ":Saludar"), env_get("FORJA_MENU_EXT"))
            ver("y lo dice", str_contains(rexx("SALIDA"), "Instalada la extensión Saludo"), "")
        end
        activar("Extensiones de Forja")
        input_key(0x33, 0)
        time_delay(25)
        activar("Forja")
        ver("VUELTA al volver a la ventana de Forja", eco_dice("VUELTA ", 100), eco())
    else
        ver("el gestor se abre", false, input_active_title())
    end

    rexx("QUIT")
    ver("Forja se cierra", sin_puerto("FORJA.1", 200), "")
    ver("al salir, Contar se va", sin_puerto("FORJAEXT.CONTAR", 40), "")
    ver("y Eco también", sin_puerto("FORJAEXT.ECO", 40), "")
    if fallos == 0
        anotar("TODO BIEN")
    else
        anotar("FALLOS: #{fallos}")
    end
end
